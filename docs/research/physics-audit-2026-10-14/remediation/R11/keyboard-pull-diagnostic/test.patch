diff --git a/app/tests/test_avanti_keyboard.gd b/app/tests/test_avanti_keyboard.gd
index 17581599..d00027fa 100644
--- a/app/tests/test_avanti_keyboard.gd
+++ b/app/tests/test_avanti_keyboard.gd
@@ -58,7 +58,15 @@ func _initialize() -> void:
 	var tap := run_case(45.0, 0.5)
