+## EXPERIMENT: strip i's attached loading relative to the wing mean (induced-map row sum / mean row sum).
+static func _loading_ratio(env: Dictionary, i: int) -> float:
+	var rs: PackedFloat64Array = env.get("strip_row_sum", PackedFloat64Array())
+	if rs.is_empty():
+		return 1.0
+	var mean := 0.0
+	for v in rs:
+		mean += v / rs.size()
+	return rs[i] / mean
