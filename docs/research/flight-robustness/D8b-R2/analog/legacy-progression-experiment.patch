+## EXPERIMENT (D8b-R2d): legacy-blend separation angle scaled by the strip's relative loading.
+static func _loading_ratio(env: Dictionary, i: int) -> float:
+	var rs: PackedFloat64Array = env.get("strip_row_sum", PackedFloat64Array())
+	if rs.is_empty():
+		return 1.0
+	var mean := 0.0
+	for v in rs:
+		mean += v / rs.size()
+	return rs[i] / mean
