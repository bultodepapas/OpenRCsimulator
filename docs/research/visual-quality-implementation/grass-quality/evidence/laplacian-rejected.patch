diff --git a/app/render/turf_detail.gdshaderinc b/app/render/turf_detail.gdshaderinc
--- a/app/render/turf_detail.gdshaderinc
+++ b/app/render/turf_detail.gdshaderinc
@@ -1,4 +1,4 @@
-// L9e: two explicit-gradient samples of packed linear turf data (ours, MIT).
+// L9e-R1 candidate: clean-room three-band Laplacian blend (ours, MIT).
 // Decorrelation retains world orientation: rotating UVs would also require rotating slopes.
 // Slopes are averaged before normalization; unresolved blades return to the old flat material.
 uniform sampler2D turf_detail : filter_linear_mipmap_anisotropic, repeat_enable;
@@ -7,8 +7,28 @@
 vec3 turf_sample(vec2 p, vec2 gx, vec2 gy) {
 	vec2 uv = p * 0.5; // Generated tile spans 2 m; dimensions are artistic estimates.
 	float k = vnoise(p * 0.37 + 83.0) * 8.0;
 	float index = floor(k);
-	vec3 a = textureGrad(turf_detail, uv + hash22(vec2(index, 71.0)), gx * 0.5, gy * 0.5).rgb;
-	vec3 b = textureGrad(turf_detail, uv + hash22(vec2(index + 1.0, 71.0)), gx * 0.5, gy * 0.5).rgb;
-	return mix(a, b, smoothstep(0.2, 0.8, fract(k)));
+	vec2 offset_a = hash22(vec2(index, 71.0));
+	vec2 offset_b = hash22(vec2(index + 1.0, 71.0));
+	float mask0 = smoothstep(0.2, 0.8, fract(k));
+	vec2 grad_x = gx * 0.5;
+	vec2 grad_y = gy * 0.5;
+
+	vec3 a_level = textureGrad(turf_detail, uv + offset_a, grad_x, grad_y).rgb;
+	vec3 b_level = textureGrad(turf_detail, uv + offset_b, grad_x, grad_y).rgb;
+	vec3 blended = vec3(0.0);
+	for (int level = 0; level < 3; level++) {
+		float next_scale = exp2(float(level + 1));
+		vec3 a_coarse = textureGrad(turf_detail, uv + offset_a, grad_x * next_scale, grad_y * next_scale).rgb;
+		vec3 b_coarse = textureGrad(turf_detail, uv + offset_b, grad_x * next_scale, grad_y * next_scale).rgb;
+		float mask_scale = exp2(float(level));
+		float band_mask = clamp(0.5 + (mask0 - 0.5) / mask_scale, 0.0, 1.0);
+		blended += mix(a_level - a_coarse, b_level - b_coarse, band_mask);
+		a_level = a_coarse;
+		b_level = b_coarse;
+	}
+	float gaussian_mask = clamp(0.5 + (mask0 - 0.5) / 8.0, 0.0, 1.0);
+	blended += mix(a_level, b_level, gaussian_mask);
+	// The packed R/G slopes and B tone are linear [0,1] data; bound Laplacian overshoot.
+	return clamp(blended, vec3(0.0), vec3(1.0));
 }
