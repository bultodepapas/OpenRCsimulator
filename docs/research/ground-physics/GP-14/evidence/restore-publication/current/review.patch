+			core.model.input_size = 8
+			core.state[0] = 999.0)
+		var callback := func():
+			match kind:
+				"mass", "fault-reentry", "fault-mutation": core.mass = 0.0
+				"model": core.model.input_size = 8
+				"array": core.state[0] = 999.0
+				"step": core.step()
+				"reset": core.reset(body(999.0))
+				"restore": core.restore_checkpoint(target)
