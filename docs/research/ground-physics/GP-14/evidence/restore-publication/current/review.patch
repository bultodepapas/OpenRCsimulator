+
+func _validation_reentry() -> void:
+	for kind: String in ["closing", "preflight", "final"]:
+		var f := flight(true)
+		var target: Dictionary = f.checkpoint()
+		for i: int in 3: f.sim.step()
+		var b := begin(f, "reentry-" + kind)
