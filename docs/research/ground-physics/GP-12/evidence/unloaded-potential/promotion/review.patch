+		candidate.aux[7] = maxf(candidate.aux[7], loaded)
+		candidate.aux[8] = maxf(candidate.aux[8], receipt.accepted_substeps)
+		candidate.aux[9] = maxf(candidate.aux[9], candidate.aux[5])
