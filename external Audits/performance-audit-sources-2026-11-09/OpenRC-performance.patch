 		"changed phase=%s isolated phase=%s" % [str(changed.phase), str(isolated.phase)])
 
 
+func _interpolation_parity_checks() -> void:
+	# With settled RPM and amplitude, the independent fixed-frequency entry point
+	# uses sample() for every value. Match its PCM and final phase across wraps.
+	var maximum := 700000.0
+	for rpm: float in [2800.0, MAX_STIK_RPM, 110250.0, 661500.0]:
+		for start_phase: float in [0.0, 0.2718281828459045, 1.0 - pow(2.0, -40.0)]:
+			var voice := Voice.new()
+			voice.reset(rpm, maximum)
+			voice.phase = start_phase
+			var expected: Array = Voice.synthesize(start_phase, rpm / 60.0,
+				Voice.level(rpm, maximum), 1024, EXPECTED_RATE)
+			var mono: PackedFloat32Array = expected[0]
+			var actual: PackedVector2Array = voice.render(rpm, maximum, mono.size())
+			var matches := actual.size() == mono.size()
+			for i in mini(actual.size(), mono.size()):
+				if actual[i] != Vector2(mono[i], mono[i]):
+					matches = false
+					break
+			_check("settled runtime interpolation matches helper PCM and phase",
+				matches and voice.phase == float(expected[1]), "rpm=%s phase=%s" % [rpm, start_phase])
+
+	# Exercise changing targets and inputs that take the original helper path.
+	# The expected sample is read before rendering, at the pre-update phase.
+	var cases: Array[Dictionary] = [
+		{phase = 0.2, frequency = 100.0, rpm = 11149.0},
+		{phase = 1.0 - pow(2.0, -40.0), frequency = 90.0, rpm = 2800.0},
+		{phase = -0.5, frequency = 100.0, rpm = 2800.0},
+		{phase = 0.5, frequency = -10.0, rpm = 2800.0},
+	]
+	var alpha := 1.0 - exp(-1.0 / (SMOOTH_SECONDS * EXPECTED_RATE))
+	for item: Dictionary in cases:
+		var voice := Voice.new()
+		voice.reset(2800.0, MAX_STIK_RPM)
+		voice.phase = item.phase
+		voice.frequency = item.frequency
+		var target: float = float(item.rpm) / 60.0
+		var table: PackedFloat32Array = Voice._tables[Voice.band(maxf(voice.frequency, target), EXPECTED_RATE)]
+		var next_amplitude: float = voice.amplitude + alpha * (Voice.level(item.rpm, MAX_STIK_RPM) - voice.amplitude)
+		var expected_sample := Vector2.ONE * (next_amplitude * Voice.sample(table, voice.phase))
+		var actual: PackedVector2Array = voice.render(item.rpm, MAX_STIK_RPM, 1)
+		_check("transition and fallback interpolation match helper",
+			actual.size() == 1 and actual[0] == expected_sample, "phase=%s frequency=%s" % [item.phase, item.frequency])
+
+
 func _vector_x(values: PackedVector2Array) -> PackedFloat32Array:
