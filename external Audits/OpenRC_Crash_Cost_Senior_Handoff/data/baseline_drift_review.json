      "path": "AGENTS.md",
      "patch": "@@ -36,6 +36,8 @@ Use this order for planning, optimization and acceptance evidence. A 720p viewpo\n \n The production application is `app/`. The three.js bake-off in `prototypes/stage0/three/` is frozen. Runtime code, configuration and accepted data define implemented behavior; plans describe remaining work, and research records dated evidence.\n \n+Make visual enhancements optional and scalable from modest computers to high-end PCs through quality presets and independent controls for geometry detail, vegetation density, lighting, shadows, reflections and effects. Recommend an initial preset using detected hardware and measured performance, and preserve saved user overrides. Optimize CPU, GPU, RAM and VRAM use at every quality level, including maximum settings; disabled features must avoid unnecessary processing and memory allocations. Graphics settings must leave simulation physics unchanged. Validate performance on real hardware, following the 1080p-first resolution priorities above.\n+\n ## Discover code\n \n Prefer codebase-memory-mcp: `search_graph`, `trace_path`, `get_code_snippet`, `query_graph`, then `get_architecture`. Index the repository first if absent. Stored line ranges may lag the working tree; verify the current source before editing. Use `rg` for literals, configuration, non-code files or insufficient graph results."
    },
    {
      "path": "app/main.gd",
      "patch": "@@ -79,6 +79,7 @@ const World := preload(\"res://render/world/world.gd\")\n const FieldError = preload(\"res://ui/field_error.gd\")\n const Hud := preload(\"res://render/hud.gd\")\n const FrameSamples := preload(\"res://render/frame_samples.gd\")\n+const SceneDetail := preload(\"res://render/scene_detail.gd\")\n const ViewportColor := preload(\"res://render/viewport_color.gd\")\n const Reconstruction := preload(\"res://render/reconstruction.gd\")\n const Air := preload(\"res://physics/air_data.gd\")\n@@ -3475,6 +3476,13 @@ func _finish_frame_time(exit_code: int = OK) -> void:\n \t\tticks = int(sample_ticks[sample_ticks.size() - 1] - sample_ticks[0]) if sample_ticks.size() > 1 else 0,\n \t}\n \tvar run_args: Dictionary = _user_args()\n+\t# The current preference can describe the NEXT world. Read the installed props and\n+\t# collision inventory instead of inferring them from SceneDetail.level().\n+\tvar installed_scenery: Node = _field_node.get_node_or_null(\"Scenery\") if is_instance_valid(_field_node) else null\n+\tvar scenery_stats: Dictionary = installed_scenery.get_meta(\"stats\", {}) if installed_scenery != null else {}\n+\tvar installed_world: Dictionary = session.collision_world()\n+\tvar meadow: Node = _field_node.get_node_or_null(\"RunwayMeadow\") if is_instance_valid(_field_node) else null\n+\tvar detail_instances := FrameSamples.field_tree_detail_instances(_field_node, field)\n \tvar route_name: String = frametimes_route if not frametimes_route.is_empty() else \\\n \t\t(\"scripted-fixed\" if _frametimes_scripted_fixed else \"live-input\")\n \t# Endpoint evidence is read once after sampling; no new per-tick observer.\n@@ -3493,6 +3501,20 @@ func _finish_frame_time(exit_code: int = OK) -> void:\n \t\troute = route_name,\n \t\tpreset = \"high-experimental\" if Atmosphere.HighGraphics.active() else \"current-default\",\n \t\tgraphics_profile = Atmosphere.HighGraphics.describe(),\n+\t\tscene_at_report = {\n+\t\t\tscope = \"end of collection only; not settings or visibility history\",\n+\t\t\tlandscape_id = landscape_id,\n+\t\t\tcollision_world_status = \"installed\" if not installed_world.is_empty() else \"absent\",\n+\t\t\tcollision_world_identity = installed_world.get(\"identity\", \"\"),\n+\t\t\tscenery_present = installed_scenery != null,\n+\t\t\tinstalled_scenery_quality = scenery_stats.get(\"quality\", \"absent\" if installed_scenery == null else \"unknown\"),\n+\t\t\trequested_scene_detail = SceneDetail.level(),\n+\t\t\tmesh_lod_threshold_px = get_viewport().mesh_lod_threshold,\n+\t\t\tfield_tree_detail_instances = detail_instances,\n+\t\t\trunway_meadow = {present = meadow != null,\n+\t\t\t\tplants = meadow.get_meta(\"plants\", 0) if meadow != null else 0,\n+\t\t\t\tsource_triangles = meadow.get_meta(\"source_triangles\", 0) if meadow != null else 0},\n+\t\t},\n \t\tshadows = Atmosphere.ShadowSettings.describe(),\n \t\tbackend = RenderingServer.get_current_rendering_method(),\n \t\trendering_driver = RenderingServer.get_current_rendering_driver_name(),\n@@ -3521,6 +3543,7 @@ func _finish_frame_time(exit_code: int = OK) -> void:\n \t\tarchitecture = Engine.get_architecture_name(),\n \t\tpid = OS.get_process_id(),\n \t\twindow = \"%dx%d\" % [get_viewport().get_visible_rect().size.x, get_viewport().get_visible_rect().size.y],\n+\t\twindow_size_at_report = [DisplayServer.window_get_size().x, DisplayServer.window_get_size().y],\n \t\tvsync = DisplayServer.window_get_vsync_mode() != DisplayServer.VSYNC_DISABLED,\n \t\t# A CLI cap can differ from the shipped default even when VSync is enabled.\n \t\tmax_fps = Engine.max_fps,"
    },
    {
      "path": "app/sim/flight_session.gd",
      "patch": "@@ -671,6 +671,23 @@ func air_data(s: PackedFloat64Array, time_s: float = NAN) -> Dictionary:\n \treturn Air.compute(s, wind_at(at, s), air_density(s))\n \n \n+## One accepted-endpoint observation. A successful spatial Air receipt already contains its datum wind;\n+## detach it from the stage sampler. A refused station still needs the independent datum wind for the HUD.\n+## Derived sessions retain their existing wind_at/air_data dispatch, including overrides of either method.\n+func observer_air_and_wind(s: PackedFloat64Array, time_s: float) -> Dictionary:\n+\tif get_script() != load(\"res://sim/flight_session.gd\") or sim == null \\\n+\t\t\tor not _weather.is_spatial() or _weather_pending_reset \\\n+\t\t\tor PackedFloat64Array([time_s]).to_byte_array() != PackedFloat64Array([sim.time()]).to_byte_array() \\\n+\t\t\tor s.to_byte_array() != sim.state.to_byte_array():\n+\t\tvar wind: PackedFloat64Array = wind_at(time_s)\n+\t\treturn {wind = wind.duplicate(), air = air_data(s, time_s)}\n+\tvar air: Dictionary = air_data(s, time_s)\n+\tif air.has(\"spatial_sampler\"):\n+\t\tvar wind: PackedFloat64Array = air.spatial_sampler.reference_wind\n+\t\treturn {wind = wind.duplicate(), air = air}\n+\treturn {wind = wind_at(time_s).duplicate(), air = air}\n+\n+\n ## Pure reset-time producer for each runway candidate; independent of the accepted tick and OU window.\n func _initial_air_sampler(model: Dictionary) -> Callable:\n \tif not _weather.is_spatial():"
    }
