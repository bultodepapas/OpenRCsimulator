extends SceneTree
const Workshop := preload("res://ui/workshop.gd")
const Profile := preload("res://workshop/presentation.gd")
const Customization := preload("res://render/aircraft_customization.gd")
const Catalog := preload("res://app_state/aircraft_catalog.gd")
const Trial := preload("res://workshop/trial.gd")
const Store := preload("res://workshop/store.gd")
const Bundle := preload("res://workshop/bundle.gd")
const Launch := preload("res://workshop/launch.gd")
const CustomizationPanel := preload("res://ui/workshop_customization.gd")
var failures := 0
func _initialize() -> void: run.call_deferred()
func check(label: String, passed: bool) -> void:
	print(("ok   " if passed else "FAIL ") + label)
	if not passed: failures += 1
func run() -> void:
	var editor := Workshop.new()
	editor.variants_root = "user://test_workshop_customization"
	root.add_child(editor)
	await process_frame
	var bindings: Dictionary = Customization.describe(Catalog.DEFAULT_ID).bindings
	var stock := editor.get_presentation()
	var appearance_probe := CustomizationPanel.new()
	appearance_probe.page_kind = "appearance"
	root.add_child(appearance_probe)
	await process_frame
	appearance_probe.configure(bindings, stock)
	var appearance_events := {"events": []}
	appearance_probe.validity_changed.connect(func(_page: String, pending: bool) -> void: appearance_events.events.append(pending))
	var probe_inscription: LineEdit = appearance_probe.get("_marking_text")
	probe_inscription.text = "PENDING"
	probe_inscription.text_changed.emit(probe_inscription.text)
	check("appearance text edits notify validity", appearance_events.events == [true])
	appearance_events.events.clear()
	appearance_probe.configure(bindings, stock)
	check("appearance configure emits one true event and preserves pending inscription",
		appearance_events.events == [true] and probe_inscription.text == "PENDING")
	print("appearance_configure_events=", appearance_events.events)
	var appearance_state: Dictionary = appearance_probe.get_editor_state()
	appearance_events.events.clear()
	check("appearance editor-state restore emits one final true event",
		appearance_probe.restore_editor_state(appearance_state) and appearance_events.events == [true] and probe_inscription.text == "PENDING")
	var smoke_probe := CustomizationPanel.new()
	smoke_probe.page_kind = "smoke"
	root.add_child(smoke_probe)
	await process_frame
	smoke_probe.configure(bindings, stock)
	var probe_emitter: OptionButton = smoke_probe.get("_slot")
	if probe_emitter.item_count > 0:
		probe_emitter.select(0)
		smoke_probe.sync_fields()
	var smoke_events := {"events": []}
	smoke_probe.validity_changed.connect(func(_page: String, pending: bool) -> void: smoke_events.events.append(pending))
	smoke_probe.configure(bindings, stock)
	check("smoke configure emits one final event", smoke_events.events.size() == 1)
	print("smoke_configure_events=", smoke_events.events)
	var probe_color: LineEdit = smoke_probe.get("_custom_color")
	probe_color.text = "#BAD"
	probe_color.text_changed.emit(probe_color.text)
	check("smoke text edits notify validity", smoke_events.events == [false, true])
	smoke_events.events.clear()
	smoke_probe.configure(bindings, stock)
	check("smoke configure emits one true event and preserves pending color",
		smoke_events.events == [true] and probe_color.text == "#BAD")
	var smoke_state: Dictionary = smoke_probe.get_editor_state()
	smoke_events.events.clear()
	check("smoke editor-state restore emits one final true event",
		smoke_probe.restore_editor_state(smoke_state) and smoke_events.events == [true] and probe_color.text == "#BAD")
	smoke_events.events.clear()
	probe_color.text = "#BA"
	probe_color.text_changed.emit(probe_color.text)
	probe_color.text = "#BAD"
	probe_color.text_changed.emit(probe_color.text)
	check("ordinary smoke text changes each notify validity", smoke_events.events == [true, true])
	appearance_probe.free()
	smoke_probe.free()
	var stock_page: Node = editor.get("_page_nodes").appearance
	check("unpainted material is shown as Stock without a fabricated flat color", stock_page.get("_custom_color").text.is_empty() and stock_page.get("_color").get_item_text(stock_page.get("_color").selected) == "Stock")
	var profile := stock.duplicate(true)
	profile.paint = [{"slot": bindings.paint_slots[0].id, "color": "#327DE8FF", "pattern": "solid", "accent": "none"}]
	editor.set_presentation(profile)
	check("paint edits mark full draft dirty", editor.has_unsaved_changes() and editor.get_presentation().paint == profile.paint)
	editor.set_recipe({control_multiplier = 1.1})
	editor.call("_undo")
	check("shared undo restores physical recipe while retaining paint", editor.get_recipe().control_multiplier == 1.0 and editor.get_presentation().paint == profile.paint)
	editor.call("_undo")
	check("second undo restores exact stock profile and baseline", editor.get_presentation() == stock and not editor.has_unsaved_changes())
	editor.call("_redo")
	check("redo restores appearance", editor.get_presentation().paint == profile.paint)
	var appearance_page: Node = editor.get("_page_nodes").appearance
	appearance_page.call("reset_paint_region")
	check("selected paint region restores its authored material", editor.get_presentation().paint.is_empty())
	editor.call("_undo")
	check("region restore participates in shared Undo", editor.get_presentation().paint == profile.paint)
	editor.call("_set_page", "appearance")
	var inscription: LineEdit = appearance_page.get("_marking_text")
	inscription.text = "Ñ-ÁVION 12"
	inscription.text_changed.emit(inscription.text)
	check("unapplied inscription blocks save and trial", not editor.call("_edit_valid") and editor.get("_trial_button").disabled)
	var paint_buffer: LineEdit = appearance_page.get("_custom_color")
	paint_buffer.text_changed.emit(paint_buffer.text)
	check("unchanged color cannot clear a pending inscription", not editor.call("_edit_valid"))
	editor.call("_review_issues")
	check("review focuses the pending inscription", root.gui_get_focus_owner() == inscription)
	appearance_page.call("apply_marking")
	check("English and Spanish registration applies as one validated edit", editor.call("_edit_valid") and editor.get_presentation().markings[0].text == "Ñ-ÁVION 12")
	inscription.text = "Bad@"
	inscription.text_changed.emit(inscription.text)
	appearance_page.call("apply_marking")
	check("unsupported registration cannot replace accepted text", not editor.call("_edit_valid") and editor.get_presentation().markings[0].text == "Ñ-ÁVION 12")
	editor.call("_request_close")
	check("Back cancels the active text buffer before navigation", editor.call("_edit_valid") and inscription.text == "Ñ-ÁVION 12" and not is_instance_valid(editor.get("_guard_dialog")))
	var marked := editor.get_presentation()
	editor.call("_reset_recipe")
	check("Appearance reset restores paint and inscriptions together", editor.get_presentation().paint.is_empty() and editor.get_presentation().markings.is_empty())
	editor.call("_undo")
	check("Appearance reset is undoable", editor.get_presentation() == marked)
	var smoke_page: Node = editor.get("_page_nodes").smoke
	smoke_page.call("apply_preset", 5)
	check("Rainbow Burst selects a fan and a timed palette", smoke_page.call("current_entry").shape == "fan" and smoke_page.call("current_entry").palette.size() == 5)
	var raw_state: Dictionary = smoke_page.call("get_editor_state")
	raw_state.color_text = "#BAD"
	check("recovery restores raw invalid text without changing the accepted profile", smoke_page.call("restore_editor_state", raw_state) and not editor.call("_edit_valid") and smoke_page.call("current_entry").shape == "fan")
	var emitter: OptionButton = smoke_page.get("_slot")
	var selected_emitter := emitter.selected
	emitter.select((selected_emitter + 1) % emitter.item_count)
	emitter.item_selected.emit(emitter.selected)
	check("emitter navigation cannot discard pending text", emitter.selected == selected_emitter and smoke_page.get("_custom_color").text == "#BAD")
	var step: OptionButton = smoke_page.get("_palette_selector")
	step.select(1)
	step.item_selected.emit(1)
	check("palette navigation cannot redirect a pending color", step.selected == 0 and smoke_page.get("_custom_color").text == "#BAD")
	smoke_page.call("change", "amount", 0.7)
	check("unrelated accepted edits retain pending text and blocking state", smoke_page.get("_custom_color").text == "#BAD" and not editor.call("_edit_valid") and smoke_page.call("current_entry").amount == 0.7)
	var malformed := raw_state.duplicate(true)
	malformed.palette_step = 7
	check("recovery refuses unavailable palette steps without mutation", not smoke_page.call("restore_editor_state", malformed) and smoke_page.call("get_editor_state").color_text == "#BAD")
	smoke_page.call("cancel_pending_edit")
	check("explicit cancel restores the accepted color and launch validity", editor.call("_edit_valid"))
	smoke_page.call("edit_palette", 1)
	smoke_page.get("_palette_selector").select(2)
	smoke_page.call("change", "color", "#123456FF")
	check("palette color edits only the selected step", smoke_page.call("current_entry").palette[2] == "#123456FF" and smoke_page.call("current_entry").palette.size() == 6)
	smoke_page.call("edit_palette", 0)
	check("single color preserves the selected palette color", smoke_page.call("current_entry").palette.is_empty() and smoke_page.call("current_entry").color == "#123456FF")
	editor.call("_undo")
	check("Undo restores the full timed palette", smoke_page.call("current_entry").palette.size() == 6 and smoke_page.call("current_entry").palette[2] == "#123456FF")
	smoke_page.call("apply_preset", 2)
	var ribbons := editor.get_presentation()
	check("Twin Ribbons uses exactly the registered pair", ribbons.smoke.size() == 2 and ribbons.smoke[0].color != ribbons.smoke[1].color)
	var preview: Node = editor.get("_preview")
	check("show-only preview does not advertise a running source", not preview.get("_source_preview_label").visible)
	smoke_page.call("apply_preset", 6)
	check("source preview labels its illustrative sample and keeps the authored kind", preview.get("_source_preview_label").visible and preview.call("_preview_source_sample").kind == preview.get("_airplane").physical_propulsion_kind)
	smoke_page.call("apply_preset", 2)
	if editor.get("_compact"): editor.call("_toggle_compact_view")
	check("custom preview owns a separate World3D", preview.get("_viewport").own_world_3d)
	check("preview starts still", not preview.get("_playing") and preview.get("_playhead_tick") == 0)
	preview.call("toggle_playback")
	preview.call("_process", 1.0 / 30.0)
	var tick: int = preview.get("_playhead_tick")
	check("preview playhead uses integer 240 Hz ticks (tick=%d, playing=%s, visible=%s)" % [tick, preview.get("_playing"), preview.is_visible_in_tree()], tick == 8)
	preview.call("toggle_playback")
	preview.call("_process", 1.0)
	check("paused preview retains its playhead", preview.get("_playhead_tick") == tick)
	preview.call("reset_playback")
	check("restart clears the preview clock", preview.get("_playhead_tick") == 0 and not preview.get("_playing"))
	preview.call("toggle_playback")
	preview.hide()
	check("hiding preview pauses its independent clock and rendering", not preview.get("_playing") and not preview.is_processing() and preview.get("_viewport").render_target_update_mode != SubViewport.UPDATE_ALWAYS)
	preview.show()
	var source := FileAccess.get_file_as_bytes(Catalog.entry(Catalog.DEFAULT_ID).data)
	var before := Trial.freeze({base_id = Catalog.DEFAULT_ID, base_bytes = source, recipe = {}})
	var after := Trial.freeze({base_id = Catalog.DEFAULT_ID, base_bytes = source, recipe = {}, presentation_profile = ribbons})
	check("customization preserves exact physical model and input identity", before.ok and after.ok and before.identity == after.identity and before.raw_bytes == after.raw_bytes)
	check("customization has its own identity", before.ok and after.ok and before.presentation_identity.sha256 != after.presentation_identity.sha256)
	editor.set_variant_name("Paint and smoke integration")
	editor.save_named_variant()
	var id: String = editor.get("_saved_variant_id")
	var revision: int = editor.get("_saved_variant_revision")
	var loaded := Store.load_variant(id, editor.variants_root)
	check("one revision round trips complete physical and visual build", loaded.ok and loaded.variant.presentation_profile == ribbons and not editor.has_unsaved_changes())
	var exported := Bundle.export_variant(loaded.variant)
	var path := ProjectSettings.globalize_path("user://workshop-cli-integration.json")
	var output := FileAccess.open(path, FileAccess.WRITE)
	output.store_buffer(exported.bytes)
	output.close()
	var before_library: Array = Store.list_variants(editor.variants_root)
	var launched := Launch.from_args({"aircraft-variant": path})
	check("technical launch freezes complete build without importing it", launched.ok and launched.trial.presentation_profile == ribbons and Store.list_variants(editor.variants_root) == before_library)
	for conflicting: String in ["aircraft", "battery", "electric-demo", "experimental-aircraft-data", "scripted"]:
		var args := {"aircraft-variant": path}
		args[conflicting] = true
		check("technical launch refuses conflicting " + conflicting, not Launch.from_args(args).ok)
	DirAccess.remove_absolute(path)
	editor.set_presentation(stock)
	editor.call("_load_variant_snapshot", id)
	check("library restores frozen presentation", editor.get_presentation() == ribbons and not editor.has_unsaved_changes())
	editor.call("_open_library")
	editor.call("_choose_bundle_import")
	check("file selection remains nested inside the library", editor.get("_bundle_dialog").visible and editor.get("_library_dialog").visible)
	check("window close dismisses file selection before the library", editor.call("dismiss_modal_for_exit") and not editor.get("_bundle_dialog").visible and editor.get("_library_dialog").visible and editor.get_presentation() == ribbons)
	editor.call("_close_library")
	if not id.is_empty(): Store.delete_variant(id, editor.variants_root, revision)
	editor.free()
	await process_frame
	print("Workshop customization integration: %d failures" % failures)
	quit(1 if failures else 0)
