{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "openrc-cost-profiles-v3.schema.json",
  "title": "OpenRC game-cost companion v3: scoped assessment, purchase book and labor",
  "description": "Explicit financial children and versioned local game rules. Cross-references, source pins, numerical bands and per-target response coverage are additionally checked by build_profiles.py and cost_profile.gd.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "format",
    "policy_version",
    "price_date",
    "assumptions",
    "aircraft"
  ],
  "properties": {
    "format": {
      "const": "openrc-cost-profiles v3"
    },
    "policy_version": {
      "const": "local-contact-v2"
    },
    "price_date": {
      "type": "string",
      "format": "date"
    },
    "assumptions": {
      "type": "array",
      "minItems": 1,
      "maxItems": 8,
      "items": {
        "type": "string",
        "minLength": 1,
        "maxLength": 2048
      }
    },
    "generated_from": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "source_sha256",
        "legacy_catalog_sha256",
        "generator_sha256"
      ],
      "properties": {
        "source_sha256": {
          "type": "string",
          "pattern": "^[0-9a-f]{64}$"
        },
        "legacy_catalog_sha256": {
          "type": "string",
          "pattern": "^[0-9a-f]{64}$"
        },
        "generator_sha256": {
          "type": "string",
          "pattern": "^[0-9a-f]{64}$"
        }
      }
    },
    "aircraft": {
      "type": "object",
      "minProperties": 1,
      "maxProperties": 32,
      "additionalProperties": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "components",
          "zones",
          "propeller_component_id",
          "propeller_inspection_ids",
          "assumptions",
          "shared_parent_children",
          "source_hashes",
          "construction_class",
          "propeller_followups",
          "packages",
          "labor_policy"
        ],
        "properties": {
          "components": {
            "type": "array",
            "minItems": 1,
            "maxItems": 128,
            "items": {
              "type": "object",
              "additionalProperties": false,
              "required": [
                "id",
                "quantity",
                "unit_minor",
                "low_unit_minor",
                "high_unit_minor",
                "physical_inventory_ids",
                "price_basis",
                "offer_id",
                "notes"
              ],
              "properties": {
                "id": {
                  "type": "string",
                  "minLength": 1,
                  "maxLength": 128
                },
                "quantity": {
                  "type": "integer",
                  "minimum": 1,
                  "maximum": 1000000
                },
                "unit_minor": {
                  "type": "integer",
                  "minimum": 0,
                  "maximum": 9000000000000000
                },
                "low_unit_minor": {
                  "type": "integer",
                  "minimum": 0,
                  "maximum": 9000000000000000
                },
                "high_unit_minor": {
                  "type": "integer",
                  "minimum": 0,
                  "maximum": 9000000000000000
                },
                "physical_inventory_ids": {
                  "type": "array",
                  "maxItems": 128,
                  "uniqueItems": true,
                  "items": {
                    "type": "string",
                    "minLength": 1,
                    "maxLength": 128
                  },
                  "minItems": 1
                },
                "price_basis": {
                  "enum": [
                    "estimated",
                    "price_proxy",
                    "exact_product_price"
                  ]
                },
                "offer_id": {
                  "type": [
                    "string",
                    "null"
                  ]
                },
                "notes": {
                  "type": "string",
                  "minLength": 1,
                  "maxLength": 2048
                }
              }
            }
          },
          "zones": {
            "type": "array",
            "minItems": 1,
            "maxItems": 256,
            "items": {
              "type": "object",
              "additionalProperties": false,
              "required": [
                "source",
                "probe_id",
                "component_ids",
                "response",
                "component_responses"
              ],
              "properties": {
                "source": {
                  "enum": [
                    "hull",
                    "gear",
                    "propeller"
                  ]
                },
                "probe_id": {
                  "type": "string",
                  "minLength": 1,
                  "maxLength": 128
                },
                "component_ids": {
                  "type": "array",
                  "minItems": 1,
                  "maxItems": 128,
                  "uniqueItems": true,
                  "items": {
                    "type": "string",
                    "minLength": 1,
                    "maxLength": 128
                  }
                },
                "response": {
                  "oneOf": [
                    {
                      "type": "object",
                      "additionalProperties": false,
                      "required": [
                        "kind"
                      ],
                      "properties": {
                        "kind": {
                          "const": "inspect"
                        }
                      }
                    },
                    {
                      "type": "object",
                      "additionalProperties": false,
                      "required": [
                        "kind",
                        "channel",
                        "clear_below",
                        "replace_at",
                        "terminal_replace",
                        "middle_action",
                        "service_minor_by_component"
                      ],
                      "properties": {
                        "kind": {
                          "const": "channel_bands"
                        },
                        "channel": {
                          "enum": [
                            "depth_m",
                            "compression_ratio",
                            "normal_speed_mps",
                            "slide_speed_mps",
                            "speed_mps",
                            "down_speed_mps",
                            "endpoint_normal_speed_mps",
                            "contact_normal_proxy_mps"
                          ]
                        },
                        "clear_below": {
                          "type": "number",
                          "minimum": 0,
                          "maximum": 10000
                        },
                        "replace_at": {
                          "type": "number",
                          "minimum": 0,
                          "maximum": 10000
                        },
                        "terminal_replace": {
                          "type": "boolean"
                        },
                        "middle_action": {
                          "enum": [
                            "inspect",
                            "repair",
                            "scope_clear"
                          ]
                        },
                        "service_minor_by_component": {
                          "type": "object",
                          "maxProperties": 128,
                          "additionalProperties": {
                            "type": "integer",
                            "minimum": 0,
                            "maximum": 9000000000000000
                          }
                        }
                      }
                    }
                  ]
                },
                "component_responses": {
                  "type": "object",
                  "maxProperties": 128,
                  "additionalProperties": {
                    "oneOf": [
                      {
                        "type": "object",
                        "additionalProperties": false,
                        "required": [
                          "kind"
                        ],
                        "properties": {
                          "kind": {
                            "const": "inspect"
                          }
                        }
                      },
                      {
                        "type": "object",
                        "additionalProperties": false,
                        "required": [
                          "kind",
                          "channel",
                          "clear_below",
                          "replace_at",
                          "terminal_replace",
                          "middle_action",
                          "service_minor_by_component"
                        ],
                        "properties": {
                          "kind": {
                            "const": "channel_bands"
                          },
                          "channel": {
                            "enum": [
                              "depth_m",
                              "compression_ratio",
                              "normal_speed_mps",
                              "slide_speed_mps",
                              "speed_mps",
                              "down_speed_mps",
                              "endpoint_normal_speed_mps",
                              "contact_normal_proxy_mps"
                            ]
                          },
                          "clear_below": {
                            "type": "number",
                            "minimum": 0,
                            "maximum": 10000
                          },
                          "replace_at": {
                            "type": "number",
                            "minimum": 0,
                            "maximum": 10000
                          },
                          "terminal_replace": {
                            "type": "boolean"
                          },
                          "middle_action": {
                            "enum": [
                              "inspect",
                              "repair",
                              "scope_clear"
                            ]
                          },
                          "service_minor_by_component": {
                            "type": "object",
                            "maxProperties": 128,
                            "additionalProperties": {
                              "type": "integer",
                              "minimum": 0,
                              "maximum": 9000000000000000
                            }
                          }
                        }
                      }
                    ]
                  }
                }
              }
            }
          },
          "propeller_component_id": {
            "type": "string",
            "maxLength": 128
          },
          "propeller_inspection_ids": {
            "type": "array",
            "maxItems": 128,
            "uniqueItems": true,
            "items": {
              "type": "string",
              "minLength": 1,
              "maxLength": 128
            }
          },
          "assumptions": {
            "type": "array",
            "minItems": 1,
            "maxItems": 8,
            "items": {
              "type": "string",
              "minLength": 1,
              "maxLength": 2048
            }
          },
          "shared_parent_children": {
            "type": "object",
            "maxProperties": 128,
            "additionalProperties": {
              "type": "array",
              "minItems": 2,
              "maxItems": 128,
              "uniqueItems": true,
              "items": {
                "type": "string",
                "minLength": 1,
                "maxLength": 128
              }
            }
          },
          "source_hashes": {
            "type": "array",
            "minItems": 1,
            "maxItems": 2,
            "uniqueItems": true,
            "items": {
              "type": "string",
              "pattern": "^[0-9a-f]{64}$"
            }
          },
          "construction_class": {
            "enum": [
              "wood",
              "foam",
              "composite"
            ]
          },
          "propeller_followups": {
            "type": "array",
            "maxItems": 128,
            "items": {
              "type": "object",
              "additionalProperties": false,
              "required": [
                "component_id",
                "kind",
                "clear_speed_mps",
                "clear_rpm",
                "replace_speed_mps",
                "replace_rpm",
                "middle_action",
                "service_minor"
              ],
              "properties": {
                "component_id": {
                  "type": "string",
                  "minLength": 1,
                  "maxLength": 128
                },
                "kind": {
                  "const": "powered_envelope_bands"
                },
                "clear_speed_mps": {
                  "type": "number",
                  "minimum": 0,
                  "maximum": 100000
                },
                "clear_rpm": {
                  "type": "number",
                  "minimum": 0,
                  "maximum": 100000
                },
                "replace_speed_mps": {
                  "type": "number",
                  "minimum": 0,
                  "maximum": 100000
                },
                "replace_rpm": {
                  "type": "number",
                  "minimum": 0,
                  "maximum": 100000
                },
                "middle_action": {
                  "enum": [
                    "inspect",
                    "repair",
                    "scope_clear"
                  ]
                },
                "service_minor": {
                  "type": [
                    "integer",
                    "null"
                  ],
                  "minimum": 0,
                  "maximum": 9000000000000000
                }
              }
            }
          },
          "packages": {
            "type": "array",
            "maxItems": 64,
            "items": {
              "type": "object",
              "additionalProperties": false,
              "required": [
                "id",
                "component_quantities",
                "cost_cents",
                "available",
                "compatible",
                "provenance"
              ],
              "properties": {
                "id": {
                  "type": "string",
                  "minLength": 1,
                  "maxLength": 128
                },
                "component_quantities": {
                  "type": "object",
                  "minProperties": 1,
                  "maxProperties": 64,
                  "additionalProperties": {
                    "type": "integer",
                    "minimum": 1,
                    "maximum": 64
                  }
                },
                "cost_cents": {
                  "type": [
                    "integer",
                    "null"
                  ],
                  "minimum": 0,
                  "maximum": 9000000000000000
                },
                "available": {
                  "type": [
                    "boolean",
                    "null"
                  ]
                },
                "compatible": {
                  "type": [
                    "boolean",
                    "null"
                  ]
                },
                "provenance": {
                  "type": "string",
                  "minLength": 1,
                  "maxLength": 2048
                }
              }
            }
          },
          "labor_policy": {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "format",
              "currency",
              "paid_rate_minor_per_hour",
              "minutes_by_component",
              "shared_setup_minutes",
              "basis",
              "evidence"
            ],
            "properties": {
              "format": {
                "const": "openrc-game-labor-policy v1"
              },
              "currency": {
                "const": "USD"
              },
              "paid_rate_minor_per_hour": {
                "type": "integer",
                "minimum": 0,
                "maximum": 1000000
              },
              "minutes_by_component": {
                "type": "object",
                "maxProperties": 128,
                "additionalProperties": {
                  "type": "integer",
                  "minimum": 0,
                  "maximum": 60000
                }
              },
              "shared_setup_minutes": {
                "type": "integer",
                "minimum": 0,
                "maximum": 60000
              },
              "basis": {
                "const": "authored_game_policy"
              },
              "evidence": {
                "type": "string",
                "minLength": 1,
                "maxLength": 2048
              }
            }
          }
        }
      }
    }
  }
}
