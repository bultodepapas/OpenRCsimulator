{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "OpenRC aircraft v2 runtime structural contract",
  "description": "Small runtime vocabulary for closed object shapes, quantities, selectors and supported capability relations. Numeric ranges remain in the generated schema and AircraftData physical derivation. Runtime-coupled invariants are implemented in AircraftContract; static counterparts are mirrored in the generated schema where possible.",
  "spec_version": 1,
  "format": "openrc-aircraft v2",
  "convention_id": "openrc-le-frd-v1",
  "capabilities": {
    "controls": [
      "conventional"
    ],
    "gear": [
      "fixed_tricycle",
      "fixed_taildragger",
      "locked_down_taildragger",
      "locked_up",
      "retractable_tricycle",
      "retractable_taildragger"
    ],
    "propulsion_layout": [
      "single_tractor",
      "single_centerline_jet"
    ],
    "energy": [
      "prescribed_fuel",
      "fixed_voltage",
      "ocv_resistance",
      "finite_glow_fuel",
      "finite_liquid_fuel",
      "pack_ecm"
    ],
    "damage": [
      "terminal_hull"
    ],
    "flaps": [
      "not_simulated",
      "simulated"
    ]
  },
  "object_rules": [
