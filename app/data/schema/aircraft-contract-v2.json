      "required": [
        "controls",
        "gear",
        "propulsion_layout",
        "energy",
        "damage",
        "flaps"
      ],
      "allowed": [
        "controls",
        "gear",
        "propulsion_layout",
        "energy",
        "damage",
        "flaps"
      ]
    },
    {
      "path": "/reference",
