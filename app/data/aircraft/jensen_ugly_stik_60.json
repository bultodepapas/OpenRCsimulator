      "rates": "p_hat = p·b/(2V), q_hat = q·c/(2V), r_hat = r·b/(2V)",
      "elevator": "per radian, positive = trailing edge DOWN (dCm/dElev < 0)",
      "aileron": "per radian per surface, positive = trailing edge DOWN; right and left listed separately",
