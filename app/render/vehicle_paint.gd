## Stock paint schemes for the HX-700 helicopter and the RC cars (render only).
## Each vehicle has an always-on `base` (fixes the export lost, such as the HX-700 carbon fibre that Blender
## kept as an unbaked procedural) and optional named skins. Bindings match imported glTF material names and
## replace them with one StandardMaterial3D copy per source material, so later consumers (lights, rotor blur,
## damage, custom paint kits) keep working on ordinary per-instance surface overrides. Shared imported
## resources are never modified. Textures are generated by tools/skins/build_vehicle_paints.py.
extends RefCounted

const SceneDetail := preload("res://render/scene_detail.gd")
const ExtraFinish := preload("res://aircraft/extra_300s_finish.gd")
const TimberPaint := preload("res://render/timber_stock_paint.gd")
const DATA_PATH := "res://data/vehicle_paints.json"
const FORMAT := "openrc-vehicle-paints-v1"
const ORIGIN_META := "vehicle_paint_origin"
const COPY_META := "vehicle_paint_copy"
const ORIGINAL_LOD_BIAS := &"vehicle_paint_original_lod_bias"

static var _data: Dictionary = {}


## Paint family of a roster id: the HX-700 visual for the X-Cell research helicopter, the car ids as they are.
static func family_for(vehicle_id: String) -> String:
	if vehicle_id == "xcell-60-research":
		return "hx-700"
	return vehicle_id if _vehicles().has(vehicle_id) else ""


static func has_family(vehicle_id: String) -> bool:
	return not family_for(vehicle_id).is_empty()


## Picker choices [{id, label}], the default paint first with id "". [] for a vehicle without stock skins.
static func choices(vehicle_id: String) -> Array:
	var entry: Dictionary = _vehicles().get(family_for(vehicle_id), {})
	if entry.is_empty():
		return []
	var out: Array = [{id = "", label = str(entry.get("default_label", "Factory"))}]
	for skin: Dictionary in entry.get("skins", []):
		out.append({id = str(skin.id), label = str(skin.label)})
	return out


static func contains(vehicle_id: String, skin_id: String) -> bool:
	return skin_id.is_empty() and has_family(vehicle_id) or not _skin(vehicle_id, skin_id).is_empty()


## `wanted` when the vehicle offers it, else "" (the default paint).
static func resolve(vehicle_id: String, wanted: String) -> String:
	return wanted if not wanted.is_empty() and not _skin(vehicle_id, wanted).is_empty() else ""


static func label(vehicle_id: String, skin_id: String) -> String:
	for choice: Dictionary in choices(vehicle_id):
		if choice.id == skin_id:
			return str(choice.label)
	return ""


## Apply the vehicle's base fixes and then `skin_id` (an unknown id paints the default) to every mesh under
## `root`. `layers` names optional overlays from the vehicle's `layers` (for example the HX-700 "inspection"
## colour code); a layer may bind by material name and, under `nodes`, by mesh-node glob ("Brazo_Servo_*") with
## "*" for every material of that node. Painting is authoritative for this module's own copies: a surface whose
## binding disappeared (a layer switched off) returns to its imported material.
## Returns {ok, skin, materials} where `materials` counts the prepared material copies.
static func apply(root: Node, vehicle_id: String, skin_id := "", layers: Array = []) -> Dictionary:
	var family := family_for(vehicle_id)
	if root == null or family.is_empty():
		return {ok = false, skin = "", materials = 0, error = "no stock paint for " + vehicle_id}
	var resolved := resolve(vehicle_id, skin_id)
	var skin := _skin(vehicle_id, resolved)
	if family == TimberPaint.FAMILY:
		return TimberPaint.apply(root as Node3D, resolved, str(skin.get("covering", "")))
	var entry: Dictionary = _vehicles()[family]
	# Families built by the same generator share one definition (the glow and electric Ugly Stik gear).
	if entry.has("same_as"):
		entry = _vehicles().get(str(entry.same_as), {})
	var bindings: Dictionary = (entry.get("base", {}) as Dictionary).duplicate()
	var covering: ShaderMaterial
	var stock_covering: Shader
	if family == "gp-extra-300s-60":
		stock_covering = ExtraFinish.material(ExtraFinish.WING).shader
		if skin.has("covering"):
			covering = load(str(skin.covering)) as ShaderMaterial
	_merge_materials(bindings, skin.get("materials", {}))
	var node_lod_bias: Dictionary = skin.get("node_lod_bias", {})
	var node_layers: Array[Dictionary] = []
	# Always-on part finishes (TiN shock shafts, powder-coated springs...). They merge over the material and skin
	# bindings, so they should set finish (metallic, roughness, coating) rather than colours a skin changes.
	if entry.has("base_nodes"):
		node_layers.append(entry.base_nodes)
	# A skin may give individual parts their own colours (for example shock bodies apart from the chassis).
	var skin_nodes: Dictionary = skin.get("nodes", {}) if not resolved.is_empty() else entry.get("default_nodes", {})
	if not skin_nodes.is_empty():
		node_layers.append(skin_nodes)
	for layer_name: Variant in layers:
		var layer: Dictionary = entry.get("layers", {}).get(str(layer_name), {})
		_merge_materials(bindings, layer.get("materials", {}))
		if layer.has("nodes"):
			node_layers.append(layer.nodes)
	var copies := {}
	var textures := {}
	for node: Node in root.find_children("*", "MeshInstance3D", true, false):
		var mesh_node := node as MeshInstance3D
		# LOD simplification can distort narrow UV stripes. Restore the instance's
		# original bias when its next paint no longer needs the extra mesh detail.
		if node_lod_bias.has(str(mesh_node.name)):
			if not mesh_node.has_meta(ORIGINAL_LOD_BIAS):
				mesh_node.set_meta(ORIGINAL_LOD_BIAS, mesh_node.lod_bias)
			mesh_node.lod_bias = maxf(float(mesh_node.get_meta(ORIGINAL_LOD_BIAS)), float(node_lod_bias[str(mesh_node.name)]))
		elif mesh_node.has_meta(ORIGINAL_LOD_BIAS):
			mesh_node.lod_bias = float(mesh_node.get_meta(ORIGINAL_LOD_BIAS))
			mesh_node.remove_meta(ORIGINAL_LOD_BIAS)
		if mesh_node.mesh == null or mesh_node.material_override != null:
			continue
		for surface in mesh_node.mesh.get_surface_count():
			var active := mesh_node.get_active_material(surface)
			if active is ShaderMaterial and stock_covering != null:
				var original := active.get_meta(ORIGIN_META, active) as ShaderMaterial
				if original != null and original.shader == stock_covering:
					if covering != null:
						var id := original.get_instance_id()
						if not copies.has(id):
							var clone := covering.duplicate() as ShaderMaterial
							clone.set_shader_parameter("part", original.get_shader_parameter("part"))
							clone.set_shader_parameter("cowl_rear_z", original.get_shader_parameter("cowl_rear_z"))
							clone.set_meta(ORIGIN_META, original)
							clone.set_meta(COPY_META, clone.get_instance_id())
							copies[id] = clone
						mesh_node.set_surface_override_material(surface, copies[id])
					elif _is_own_copy(active):
						mesh_node.set_surface_override_material(surface, null)
				continue
			if not active is StandardMaterial3D:
				continue
			# A second apply (base, then a skin) repaints from the imported material, never from an earlier copy.
			var source: StandardMaterial3D = active.get_meta(ORIGIN_META, active)
			var binding: Dictionary = bindings.get(source.resource_name, {})
			for nodes: Dictionary in node_layers:
				for pattern: String in nodes:
					if mesh_node.name.match(pattern):
						var by_node: Dictionary = nodes[pattern]
						binding = _merged(binding, by_node.get("*", {}))
						binding = _merged(binding, by_node.get(source.resource_name, {}))
			if binding.is_empty():
				if _is_own_copy(active):
					mesh_node.set_surface_override_material(surface, null)
				continue
			var key := "%d:%d" % [source.get_instance_id(), hash(binding)]
			if not copies.has(key):
				copies[key] = _paint(source, binding, textures)
			mesh_node.set_surface_override_material(surface, copies[key])
	if root is Node3D:
		(root as Node3D).set_meta("vehicle_paint", resolved)
		(root as Node3D).set_meta("vehicle_paint_layers", layers.duplicate())
	return {ok = true, skin = resolved, materials = copies.size()}


static func _merge_materials(bindings: Dictionary, overrides: Dictionary) -> void:
	for material_name: String in overrides:
		bindings[material_name] = _merged(bindings.get(material_name, {}), overrides[material_name])


static func _merged(under: Dictionary, over: Dictionary) -> Dictionary:
	if over.is_empty():
		return under
	var merged := under.duplicate()
	merged.merge(over, true)
	return merged


## A copy this module made, not a later duplicate of it (lights and paint kits duplicate painted materials).
static func _is_own_copy(material: Material) -> bool:
	return material.has_meta(ORIGIN_META) and int(material.get_meta(COPY_META, 0)) == material.get_instance_id()


static func _paint(source: StandardMaterial3D, binding: Dictionary, textures: Dictionary) -> StandardMaterial3D:
	var painted := source.duplicate() as StandardMaterial3D
	painted.set_meta(ORIGIN_META, source)
	painted.set_meta(COPY_META, painted.get_instance_id())
	if binding.has("albedo"):
		painted.albedo_color = Color(str(binding.albedo))
	# A null texture removes the imported one: a plain finish over a part the stock model maps with a pattern
	# (the Avanti's tiled carbon trim), or no glow where the stock paint has an emission map.
	if binding.has("albedo_texture") and binding.albedo_texture == null:
		painted.albedo_texture = null
	elif binding.has("albedo_texture"):
		var albedo_texture := _texture(str(binding.albedo_texture), textures)
		if albedo_texture != null:
			painted.albedo_texture = albedo_texture
	if binding.has("emission_texture") and binding.emission_texture == null:
		painted.emission_enabled = false
		painted.emission_texture = null
	elif binding.has("emission_texture"):
		var emission_texture := _texture(str(binding.emission_texture), textures)
		if emission_texture != null:
			painted.emission_texture = emission_texture
	var detail := detail_enabled()
	# At Low scene detail a binding whose only projected maps are detail maps keeps its plain UV mapping.
	if binding.has("triplanar_scale") and (detail or binding.has("albedo_texture")):
		# Object-space triplanar: the paint follows the vehicle, independent of the exported UVs.
		var scale := float(binding.triplanar_scale)
		painted.uv1_triplanar = true
		painted.uv1_world_triplanar = false
		painted.uv1_scale = Vector3(scale, scale, scale)
		painted.uv1_triplanar_sharpness = 4.0
	if binding.has("metallic"):
		painted.metallic = float(binding.metallic)
		painted.metallic_texture = null
	if binding.has("metallic_texture"):
		# Metal/paint boundaries are part of the finish, so retain this mask at Low.
		var metallic_texture := _texture(str(binding.metallic_texture), textures)
		if metallic_texture != null:
			painted.metallic_texture = metallic_texture
			painted.metallic_texture_channel = BaseMaterial3D.TEXTURE_CHANNEL_GRAYSCALE
	if binding.has("specular"):
		painted.metallic_specular = float(binding.specular)
	if binding.has("roughness"):
		# With a roughness map this is its multiplier (Godot multiplies the value by the map). When the map is
		# skipped (Low scene detail), the multiplier times the map's mean keeps the same overall sheen.
		painted.roughness = float(binding.roughness)
		if binding.has("roughness_texture") and not detail:
			painted.roughness *= float(_detail_means().get(str(binding.roughness_texture), 1.0))
		painted.roughness_texture = null
	if binding.has("clearcoat"):
		# Lacquer over paint, resin over carbon: a second, sharper highlight (supported by every renderer).
		painted.clearcoat_enabled = float(binding.clearcoat) > 0.0
		painted.clearcoat = float(binding.clearcoat)
		painted.clearcoat_roughness = float(binding.get("clearcoat_roughness", 0.05))
	if detail:
		# Surface detail maps (weave, brushing, rubber grain) are skipped at Low scene detail.
		if binding.has("normal_texture"):
			var normal_texture := _texture(str(binding.normal_texture), textures)
			if normal_texture != null:
				painted.normal_enabled = true
				painted.normal_texture = normal_texture
				painted.normal_scale = float(binding.get("normal_scale", 1.0))
		if binding.has("roughness_texture"):
			var roughness_texture := _texture(str(binding.roughness_texture), textures)
			if roughness_texture != null:
				painted.roughness_texture = roughness_texture
				painted.roughness_texture_channel = BaseMaterial3D.TEXTURE_CHANNEL_GRAYSCALE
	elif binding.has("normal_texture"):
		# A replacement finish must not fall back to the source's normal map
		# (for example, metal plates inheriting the Stik's sagging film at Low).
		painted.normal_enabled = false
		painted.normal_texture = null
	if painted.albedo_texture != null or painted.normal_texture != null or painted.roughness_texture != null or painted.metallic_texture != null:
		# Grazing views of fine weaves and lettering stay crisp instead of smearing or shimmering.
		painted.texture_filter = BaseMaterial3D.TEXTURE_FILTER_LINEAR_WITH_MIPMAPS_ANISOTROPIC
	if binding.has("emission"):
		painted.emission_enabled = true
		painted.emission = Color(str(binding.emission))
		# Light rigs that drive emission themselves (MonsterCar2Lights) read the painted colour from here.
		painted.set_meta("vehicle_paint_emission", painted.emission)
	return painted


## Detail maps follow the Scene detail preset (Settings > Graphics): every level but Low draws them.
static func detail_enabled() -> bool:
	return SceneDetail.level() != "low"


static func _texture(path: String, cache: Dictionary) -> Texture2D:
	if not cache.has(path):
		cache[path] = load(path) as Texture2D
	return cache[path]


static func _skin(vehicle_id: String, skin_id: String) -> Dictionary:
	if skin_id.is_empty():
		return {}
	for skin: Dictionary in _vehicles().get(family_for(vehicle_id), {}).get("skins", []):
		if str(skin.get("id", "")) == skin_id:
			return skin
	return {}


static func _detail_means() -> Dictionary:
	_vehicles()
	return _data.get("detail_map_means", {})


static func _vehicles() -> Dictionary:
	if _data.is_empty():
		var parsed: Variant = JSON.parse_string(FileAccess.get_file_as_string(DATA_PATH))
		if parsed is Dictionary and parsed.get("format") == FORMAT and parsed.get("vehicles") is Dictionary:
			_data = parsed
		else:
			push_error("vehicle_paint: %s is missing or malformed" % DATA_PATH)
			_data = {vehicles = {}}
	return _data.vehicles
