## Stock paint schemes for the HX-700 helicopter and the RC cars (render only).
## Each vehicle has an always-on `base` (fixes the export lost, such as the HX-700 carbon fibre that Blender
## kept as an unbaked procedural) and optional named skins. Bindings match imported glTF material names and
## replace them with one StandardMaterial3D copy per source material, so later consumers (lights, rotor blur,
## damage, custom paint kits) keep working on ordinary per-instance surface overrides. Shared imported
## resources are never modified. Textures are generated by tools/skins/build_vehicle_paints.py.
extends RefCounted

const DATA_PATH := "res://data/vehicle_paints.json"
const FORMAT := "openrc-vehicle-paints-v1"
const ORIGIN_META := "vehicle_paint_origin"

static var _data: Dictionary = {}


## Paint family of a roster id: the HX-700 visual for the X-Cell research helicopter, the car ids as they are.
static func family_for(vehicle_id: String) -> String:
	if vehicle_id == "xcell-60-research":
		return "hx-700"
	return vehicle_id if _vehicles().has(vehicle_id) else ""


static func has_family(vehicle_id: String) -> bool:
	return not family_for(vehicle_id).is_empty()


## Picker choices [{id, label}], the default paint first with id "". [] for a vehicle without stock skins.
static func choices(vehicle_id: String) -> Array:
	var entry: Dictionary = _vehicles().get(family_for(vehicle_id), {})
	if entry.is_empty():
		return []
	var out: Array = [{id = "", label = str(entry.get("default_label", "Factory"))}]
	for skin: Dictionary in entry.get("skins", []):
		out.append({id = str(skin.id), label = str(skin.label)})
	return out


static func contains(vehicle_id: String, skin_id: String) -> bool:
	return skin_id.is_empty() and has_family(vehicle_id) or not _skin(vehicle_id, skin_id).is_empty()


## `wanted` when the vehicle offers it, else "" (the default paint).
static func resolve(vehicle_id: String, wanted: String) -> String:
	return wanted if not wanted.is_empty() and not _skin(vehicle_id, wanted).is_empty() else ""


static func label(vehicle_id: String, skin_id: String) -> String:
	for choice: Dictionary in choices(vehicle_id):
		if choice.id == skin_id:
			return str(choice.label)
	return ""


## Apply the vehicle's base fixes and then `skin_id` (an unknown id paints the default) to every mesh under
## `root`. Returns {ok, skin, materials} where `materials` counts the prepared material copies.
static func apply(root: Node, vehicle_id: String, skin_id := "") -> Dictionary:
	var family := family_for(vehicle_id)
	if root == null or family.is_empty():
		return {ok = false, skin = "", materials = 0, error = "no stock paint for " + vehicle_id}
	var entry: Dictionary = _vehicles()[family]
	var bindings: Dictionary = (entry.get("base", {}) as Dictionary).duplicate()
	var resolved := resolve(vehicle_id, skin_id)
	if not resolved.is_empty():
		var skin_materials: Dictionary = _skin(vehicle_id, resolved).get("materials", {})
		for material_name: String in skin_materials:
			var merged: Dictionary = (bindings.get(material_name, {}) as Dictionary).duplicate()
			merged.merge(skin_materials[material_name], true)
			bindings[material_name] = merged
	var copies := {}
	var textures := {}
	for node: Node in root.find_children("*", "MeshInstance3D", true, false):
		var mesh_node := node as MeshInstance3D
		if mesh_node.mesh == null or mesh_node.material_override != null:
			continue
		for surface in mesh_node.mesh.get_surface_count():
			var active := mesh_node.get_active_material(surface) as StandardMaterial3D
			if active == null:
				continue
			# A second apply (base, then a skin) repaints from the imported material, never from an earlier copy.
			var source: StandardMaterial3D = active.get_meta(ORIGIN_META, active)
			if not bindings.has(source.resource_name):
				continue
			var key := source.get_instance_id()
			if not copies.has(key):
				copies[key] = _paint(source, bindings[source.resource_name], textures)
			mesh_node.set_surface_override_material(surface, copies[key])
	if root is Node3D:
		(root as Node3D).set_meta("vehicle_paint", resolved)
	return {ok = true, skin = resolved, materials = copies.size()}


static func _paint(source: StandardMaterial3D, binding: Dictionary, textures: Dictionary) -> StandardMaterial3D:
	var painted := source.duplicate() as StandardMaterial3D
	painted.set_meta(ORIGIN_META, source)
	if binding.has("albedo"):
		painted.albedo_color = Color(str(binding.albedo))
	if binding.has("albedo_texture"):
		var albedo_texture := _texture(str(binding.albedo_texture), textures)
		if albedo_texture != null:
			painted.albedo_texture = albedo_texture
	if binding.has("emission_texture"):
		var emission_texture := _texture(str(binding.emission_texture), textures)
		if emission_texture != null:
			painted.emission_texture = emission_texture
	if binding.has("triplanar_scale"):
		# Object-space triplanar: the paint follows the vehicle, independent of the exported UVs.
		var scale := float(binding.triplanar_scale)
		painted.uv1_triplanar = true
		painted.uv1_world_triplanar = false
		painted.uv1_scale = Vector3(scale, scale, scale)
		painted.uv1_triplanar_sharpness = 4.0
	if binding.has("metallic"):
		painted.metallic = float(binding.metallic)
		painted.metallic_texture = null
	if binding.has("roughness"):
		painted.roughness = float(binding.roughness)
		painted.roughness_texture = null
	if binding.has("emission"):
		painted.emission_enabled = true
		painted.emission = Color(str(binding.emission))
		# Light rigs that drive emission themselves (MonsterCar2Lights) read the painted colour from here.
		painted.set_meta("vehicle_paint_emission", painted.emission)
	return painted


static func _texture(path: String, cache: Dictionary) -> Texture2D:
	if not cache.has(path):
		cache[path] = load(path) as Texture2D
	return cache[path]


static func _skin(vehicle_id: String, skin_id: String) -> Dictionary:
	if skin_id.is_empty():
		return {}
	for skin: Dictionary in _vehicles().get(family_for(vehicle_id), {}).get("skins", []):
		if str(skin.get("id", "")) == skin_id:
			return skin
	return {}


static func _vehicles() -> Dictionary:
	if _data.is_empty():
		var parsed: Variant = JSON.parse_string(FileAccess.get_file_as_string(DATA_PATH))
		if parsed is Dictionary and parsed.get("format") == FORMAT and parsed.get("vehicles") is Dictionary:
			_data = parsed
		else:
			push_error("vehicle_paint: %s is missing or malformed" % DATA_PATH)
			_data = {vehicles = {}}
	return _data.vehicles
