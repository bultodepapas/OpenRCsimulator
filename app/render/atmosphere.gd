# Atmosphere (LANDSCAPE-PLAN L1a, L1b, L2): ONE source of truth, Spec.ATMOSPHERE, for the sky shader, the Environment
# (tonemap, exponential haze), the ground's custom fog and the sun's DirectionalLight3D. The sky's horizon, the
# engine's object fog and the ground's fog use one colour formula (GLES3 fog_process), so they can never disagree.
# Note (investigation 02): fog_aerial_perspective is a no-op in 4.7.2 Compatibility, and sky fog has no horizon
# dependence, so the sky draws the haze itself (fog_sky_affect = 0).
extends RefCounted

const Spec := preload("res://spec.gd")
const Frames := preload("res://render/frames.gd")
const SKY_SHADER := preload("res://render/sky.gdshader")
const GROUND_SHADER := preload("res://render/ground.gdshader")
const NEAR_GRASS_SHADER := preload("res://render/near_grass.gdshader")
const SkyConfig := preload("res://environment/sky_appearance_config.gd")
const SkyAppearance := preload("res://render/weather/sky_appearance.gd")
const CloudTransport := preload("res://render/weather/cloud_transport.gd")
const SkyState := preload("res://render/world/sky_state.gd")
const SunOptics := preload("res://render/sun/sun_optics.gd")
const HighGraphics := preload("res://render/high_graphics_profile.gd")
const ShadowSettings := preload("res://render/shadow_settings.gd")
## FW-MOON-05: the moon's albedo and LOLA normal map (generated by tools/world/moon_texture.py), loaded on first use.
const MOON_ALBEDO_PATH := "res://assets/sky/moon/moon_albedo_2k.jpg"
const MOON_NORMAL_PATH := "res://assets/sky/moon/moon_normal_1k.png"
static var _moon_albedo: Texture2D
static var _moon_normal: Texture2D

## The cloud noise's lattice period in cells (render/cloud_field.gdshaderinc CLOUD_PERIOD).
const CLOUD_PERIOD := 64.0

# L15d: one active flight environment, like ShaderClock. A global offset also reaches duplicated
# mown/runway materials. Register lazily before any ground material is rendered.
static var _cloud_registered := false
static var last_cloud_offset := Vector2.ZERO

## Visual sky configuration is intentionally separate from the validated flight/weather state.
static var _appearance_selection: Dictionary = {}
static var _appearance_profile: Dictionary = {}
static var _appearance: Dictionary = {}
static var _appearance_enabled := false
static var _cloud_transport: Dictionary = {}
static var _last_cloud_sim_time := 0.0
## One active presentation cache. Offsets and the packed sky arrays are bounded by MAX_LAYERS.
## Material uniforms are still checked on every call so a newly built sky receives them.
static var _last_cloud_offsets: Array = []
static var _last_cloud_offsets_valid := false
static var _cloud_arrays_cache: Dictionary = {}
static var _cloud_arrays_cache_offsets: Array = []
static var _cloud_arrays_cache_valid := false


## Koschmieder: visual range = 3.912 / β (2 % contrast threshold).
const KOSCHMIEDER := 3.912

## L7 artistic weather presets, metres of meteorological visibility; default preserves L2 calibration.
const VISIBILITY_PRESETS: Dictionary = {"default": 23000.0, "hazy": 12000.0, "clear": 40000.0}
static var visibility_m: float = _visibility_from_args()


static func _visibility_from_args() -> float:
	for arg: String in OS.get_cmdline_user_args():
		if arg.begins_with("--visibility="):
			var preset: String = arg.trim_prefix("--visibility=")
			if VISIBILITY_PRESETS.has(preset):
				return float(VISIBILITY_PRESETS[preset])
			push_warning("Unknown visibility preset '%s'; using default (default/hazy/clear)" % preset)
	return Spec.ATMOSPHERE.visibility_m

## FW-22/23 time of day: render/world/sky_state.gd's output for the chosen hour, set by render/world/world.gd before
## the environment is built. Empty (the default) = the calibrated fixed 45° sun of Spec.ATMOSPHERE, byte for byte.
## In time-of-day mode the directional light is the brighter of sun and moon, and the haze's sunward brightening is
## the physical horizon lobe (lobe_*) drawn identically by the sky and the ground's own fog; the engine's fog keeps
## only the uniform haze (fog_sun_scatter = 0), which affects near objects by a few percent at most.
static var state: Dictionary = {}

## UI-06d: engine (PSSM) shadows are on for interactive worlds at the owner's request.
## The existing Compatibility cost/color limitations remain (L3); reference captures select off explicitly.
static var engine_shadows: bool = engine_shadows_enabled()

## Resources retain their own lighting inputs: Workshop may keep another world
## alive while the current world's global time/appearance state changes.
const SHADOW_LIGHTING_SWEEP_INTERVAL := 64
static var _shadow_lighting_resources: Dictionary = {}
static var _shadow_lighting_registrations := 0


static func engine_shadows_enabled(args: Dictionary = {}, interactive: bool = true) -> bool:
	var fallback := OS.get_environment("OPENRC_ENGINE_SHADOWS")
	if fallback.is_empty():
		fallback = "on" if interactive else "off"
	return ["on", "1", "true", "yes"].has(str(args.get("engine_shadows", fallback)).to_lower())


## Defaults preserve the fixed daylight; an explicit scene snapshot takes precedence over the flowing FW state.
static func parameters(lighting: Dictionary = {}) -> Dictionary:
	return Spec.ATMOSPHERE if lighting.is_empty() else lighting


static func _uses_flow_state(lighting: Dictionary = {}) -> bool:
	return lighting.is_empty() and not state.is_empty()


## Validate and install one visual preset without touching the flight/weather configuration.
## `mean_wind_ned` is the deterministic session mean, never the instantaneous turbulence sample.
static func configure_appearance(selection: Dictionary, mean_wind_ned: Array = [0.0, 0.0, 0.0], anchor_time_s := 0.0) -> bool:
	if not is_finite(anchor_time_s) or anchor_time_s < 0.0 or mean_wind_ned.size() != 3:
		return false
	for component: Variant in mean_wind_ned:
		if typeof(component) not in [TYPE_INT, TYPE_FLOAT] or not is_finite(float(component)) or absf(float(component)) > 1000.0:
			return false
	var checked: Dictionary = SkyConfig.validate(selection)
	if not checked.get("ok", false):
		return false
	var resolved: Dictionary = SkyAppearance.resolve(checked.profile, checked.config)
	if resolved.is_empty():
		return false
	var prior_offsets := [Vector2.ZERO] if anchor_time_s == 0.0 else _cloud_offsets_at(anchor_time_s)
	if prior_offsets.is_empty():
		prior_offsets.append(_legacy_cloud_offset_at(anchor_time_s))
	var transport := CloudTransport.build(checked.config, resolved.cloud_layers, mean_wind_ned, anchor_time_s,
		float(Spec.ATMOSPHERE.cloud_update_s), Spec.ATMOSPHERE.cloud_drift_cells_per_s, prior_offsets,
		float(Spec.ATMOSPHERE.cloud_deck_m) / maxf(float(Spec.ATMOSPHERE.cloud_scale), 1.0e-6))
	if transport.is_empty():
		return false
	_appearance_selection = checked.config.duplicate(true)
	_appearance_profile = checked.profile.duplicate(true)
	_appearance = resolved.duplicate(true)
	_appearance_enabled = not bool(resolved.legacy)
	_cloud_transport = transport
	_last_cloud_sim_time = anchor_time_s
	_invalidate_cloud_derived_cache()
	if anchor_time_s == 0.0:
		_set_cloud_offset(Vector2.ZERO)
	return true


static func appearance_config() -> Dictionary:
	return SkyConfig.defaults() if _appearance_selection.is_empty() else _appearance_selection.duplicate(true)


## The selected seed also drives the calibrated classic branch. Its default remains Spec's original seed (1253).
static func selected_cloud_seed(fallback: int = Spec.ATMOSPHERE.cloud_seed) -> int:
	return int(_appearance_selection.get("seed", fallback))


static func cloud_transport_checkpoint() -> Dictionary:
	if not CloudTransport.validate(_cloud_transport):
		var selection := SkyConfig.defaults()
		var checked: Dictionary = SkyConfig.validate(selection)
		var resolved: Dictionary = SkyAppearance.resolve(checked.profile, checked.config)
		return CloudTransport.build(selection, resolved.cloud_layers, [0.0, 0.0, 0.0], _last_cloud_sim_time,
			float(Spec.ATMOSPHERE.cloud_update_s), Spec.ATMOSPHERE.cloud_drift_cells_per_s,
			[_legacy_cloud_offset_at(_last_cloud_sim_time)],
			float(Spec.ATMOSPHERE.cloud_deck_m) / maxf(float(Spec.ATMOSPHERE.cloud_scale), 1.0e-6))
	return CloudTransport.rebase(_cloud_transport, _last_cloud_sim_time)


static func validate_cloud_transport(raw: Variant) -> bool:
	return CloudTransport.validate(raw)


## Check that a valid transport actually belongs to the selected sky profile and motion mode.
## `expected_mean_wind_ned` binds follow-wind checkpoints to the deterministic weather selection.
static func validate_cloud_transport_for(selection: Dictionary, raw: Variant, expected_mean_wind_ned: Array = []) -> bool:
	if not CloudTransport.validate(raw):
		return false
	var checked: Dictionary = SkyConfig.validate(selection)
	if not checked.get("ok", false):
		return false
	var transport: Dictionary = raw
	if transport.motion != checked.config.motion or not is_equal_approx(float(transport.step_s), float(Spec.ATMOSPHERE.cloud_update_s)):
		return false
	var mean: Array = transport.mean_wind_ned
	if not expected_mean_wind_ned.is_empty():
		if expected_mean_wind_ned.size() != 3:
			return false
		for axis in 3:
			if not is_equal_approx(float(mean[axis]), float(expected_mean_wind_ned[axis])):
				return false
	var resolved: Dictionary = SkyAppearance.resolve(checked.profile, checked.config)
	var expected_layers: Array = resolved.get("cloud_layers", [])
	if transport.layers.size() != expected_layers.size():
		return false
	var base_offsets: Array = [transport.legacy_anchor_offset]
	for layer: Dictionary in transport.layers:
		base_offsets.append(layer.anchor_offset)
	var expected := CloudTransport.build(checked.config, expected_layers, mean, float(transport.anchor_time_s),
			float(transport.step_s), Spec.ATMOSPHERE.cloud_drift_cells_per_s, base_offsets)
	if expected.is_empty() or not _vector_array_approx(transport.legacy_velocity_cells_s, expected.legacy_velocity_cells_s):
		return false
	for index in expected_layers.size():
		var actual_layer: Dictionary = transport.layers[index]
		var profile_layer: Dictionary = expected_layers[index]
		var expected_layer: Dictionary = expected.layers[index]
		for key: String in ["type", "seed", "scale_m", "drift_multiplier", "cluster_strength"]:
			if actual_layer.get(key) != profile_layer.get(key):
				return false
		if not _vector_array_approx(actual_layer.velocity_cells_s, expected_layer.velocity_cells_s):
			return false
	return true


static func restore_cloud_transport(raw: Variant) -> bool:
	if not CloudTransport.validate(raw):
		return false
	var restored: Dictionary = raw.duplicate(true)
	_cloud_transport = restored
	_last_cloud_sim_time = float(restored.anchor_time_s)
	_invalidate_cloud_derived_cache()
	return true


## Detached cloud data shared by the sky shader and the localized storm-cloud overlay.
static func cloud_state_snapshot() -> Dictionary:
	var layers: Array = []
	var profile_layers: Array = _appearance.get("cloud_layers", [])
	var current_offsets: Array = _cloud_offsets_for_last_time()
	for index in mini(profile_layers.size(), CloudTransport.MAX_LAYERS):
		var layer: Dictionary = profile_layers[index].duplicate(true)
		layer.offset = _cloud_offset_from_array(current_offsets, index if _appearance_enabled else 0)
		layers.append(layer)
	var shadow_index := _shadow_layer_index()
	var shadow_layer: Dictionary = layers[shadow_index] if shadow_index >= 0 else {}
	return {
		"profile_id": str(_appearance.get("id", "classic")),
		"seed": int(_appearance_selection.get("seed", Spec.ATMOSPHERE.cloud_seed)),
		"cloud_cover": float(_appearance.get("cloud_cover", Spec.ATMOSPHERE.cloud_coverage)),
		"cloud_density": float(_appearance.get("cloud_density", 0.0)),
		"cloud_shadow": float(_appearance.get("cloud_shadow", Spec.ATMOSPHERE.cloud_shadow_strength)),
		"cloud_shadow_strength": float(_appearance.get("cloud_shadow", Spec.ATMOSPHERE.cloud_shadow_strength)) * float(shadow_layer.get("density", 1.0)),
		"cloud_color": _appearance.get("cloud_lin", _linear_color(Spec.ATMOSPHERE.cloud_color)),
		"deck_height_m": float(shadow_layer.get("altitude_m", Spec.ATMOSPHERE.cloud_deck_m)),
		"cloud_layers": layers,
		"offset": _selected_cloud_offset(_last_cloud_sim_time, current_offsets),
	}


static func _invalidate_cloud_derived_cache() -> void:
	_last_cloud_offsets.clear()
	_last_cloud_offsets_valid = false
	_cloud_arrays_cache.clear()
	_cloud_arrays_cache_offsets.clear()
	_cloud_arrays_cache_valid = false


static func _cloud_offsets_for_last_time() -> Array:
	if not _last_cloud_offsets_valid:
		_last_cloud_offsets = _cloud_offsets_at(_last_cloud_sim_time)
		_last_cloud_offsets_valid = true
	return _last_cloud_offsets


static func _cloud_offset_from_array(offsets: Array, index: int) -> Vector2:
	if index < 0 or index >= offsets.size():
		return Vector2.ZERO
	var raw: Variant = offsets[index]
	if raw is Vector2:
		return raw
	if typeof(raw) == TYPE_ARRAY and raw.size() == 2:
		return Vector2(float(raw[0]), float(raw[1]))
	return Vector2.ZERO


static func _shadow_layer_index() -> int:
	var layers: Array = _appearance.get("cloud_layers", [])
	var best_index := -1
	var best_altitude := INF
	for index in layers.size():
		var layer: Dictionary = layers[index]
		var kind := str(layer.get("type", ""))
		if kind in ["cirrus", "anvil"]:
			continue # high ice decks cast no useful ground shadow in this 2D deck model
		if float(layer.get("coverage", 0.0)) <= 0.0 or float(layer.get("density", 0.0)) <= 0.0:
			continue
		var altitude := float(layer.get("altitude_m", INF))
		if altitude < best_altitude:
			best_altitude = altitude
			best_index = index
	return best_index


static func _cloud_offsets_at(sim_time_s: float) -> Array:
	if CloudTransport.validate(_cloud_transport):
		if not _appearance_enabled:
			return [CloudTransport.legacy_offset_pair(_cloud_transport, sim_time_s)]
		if not _cloud_transport.layers.is_empty():
			return CloudTransport.offsets(_cloud_transport, sim_time_s)
		return [CloudTransport.legacy_offset_pair(_cloud_transport, sim_time_s)]
	return [_legacy_cloud_offset_at(sim_time_s)]


static func _legacy_cloud_offset_at(sim_time_s: float) -> Vector2:
	return CloudTransport.legacy_offset(_cloud_transport, sim_time_s) if CloudTransport.validate(_cloud_transport) else cloud_offset(sim_time_s)


static func _linear_color(color: Color) -> Vector3:
	var value := color.srgb_to_linear()
	return Vector3(value.r, value.g, value.b)


static func _vector_array_approx(a: Variant, b: Variant) -> bool:
	if typeof(a) != TYPE_ARRAY or typeof(b) != TYPE_ARRAY or a.size() != 2 or b.size() != 2:
		return false
	return is_equal_approx(float(a[0]), float(b[0])) and is_equal_approx(float(a[1]), float(b[1]))


static func _profile_ratio(target: Vector3, reference: Vector3) -> Vector3:
	return Vector3(target.x / maxf(reference.x, 1.0e-6), target.y / maxf(reference.y, 1.0e-6), target.z / maxf(reference.z, 1.0e-6))


static func _profile_haze_linear(base: Vector3) -> Vector3:
	if not _appearance_enabled:
		return base
	return base * _profile_ratio(_appearance.horizon_lin, _linear_color(Spec.ATMOSPHERE.haze))


static func _profile_sky_tints(mat: ShaderMaterial, lighting: Dictionary = {}) -> void:
	if not _appearance_enabled:
		return
	var base_zenith: Vector3 = state.zenith_lin if _uses_flow_state(lighting) else _linear_color(parameters(lighting).zenith)
	var base_cloud: Vector3 = state.cloud_lin if _uses_flow_state(lighting) else _linear_color(parameters(lighting).cloud_color)
	mat.set_shader_parameter("zenith_lin", base_zenith * _profile_ratio(_appearance.zenith_lin, _linear_color(Spec.ATMOSPHERE.zenith)))
	mat.set_shader_parameter("cloud_lin", base_cloud * _profile_ratio(_appearance.cloud_lin, _linear_color(Spec.ATMOSPHERE.cloud_color)))


static func _apply_profile_environment(env: Environment, lighting: Dictionary = {}) -> void:
	if not _appearance_enabled:
		return
	var haze := _profile_haze_linear(haze_linear(lighting))
	env.fog_light_color = Color(haze.x, haze.y, haze.z).linear_to_srgb()
	env.fog_light_energy = 1.0
	env.fog_density = beta() * float(_appearance.haze_scale)
	var ambient: Vector3 = _appearance.ambient_lin * float(_appearance.ambient_intensity)
	if _uses_flow_state(lighting):
		var current: Vector3 = state.ambient_lin
		var reference := _linear_color(Spec.ATMOSPHERE.haze) * 0.6 + _linear_color(Spec.ATMOSPHERE.zenith) * 0.4
		ambient = current * _profile_ratio(_appearance.ambient_lin, reference) * float(_appearance.ambient_intensity)
	env.ambient_light_source = Environment.AMBIENT_SOURCE_COLOR
	env.ambient_light_color = Color(ambient.x, ambient.y, ambient.z).linear_to_srgb()
	env.ambient_light_energy = 1.0


static func shadow_strength(lighting: Dictionary = {}) -> float:
	if _uses_flow_state(lighting):
		return float(state.get("shadow_strength", 1.0)) # FW-MOON-03: moon shadows fade with the light's direct share
	return float(lighting.get("shadow_strength", 1.0))


## Unit vector toward the sun in render axes (the light shines along the opposite direction).
static func sun_direction(lighting: Dictionary = {}) -> Vector3:
	if _uses_flow_state(lighting):
		return state.light_dir
	var a: Dictionary = parameters(lighting)
	var az := deg_to_rad(a.sun_azimuth_deg)
	var el := deg_to_rad(a.sun_elevation_deg)
	return Frames.ned_to_render([cos(az) * cos(el), sin(az) * cos(el), -sin(el)]).normalized()


## Apparent solar disc. The directional light remains above the ground at sunrise and sunset.
static func disc_direction(lighting: Dictionary = {}) -> Vector3:
	if not lighting.has("disc_elevation_deg"):
		return sun_direction(lighting)
	var disc: Dictionary = lighting.duplicate()
	disc.sun_elevation_deg = lighting.disc_elevation_deg
	return sun_direction(disc)


## Haze extinction coefficient β (1/m) from the visual range.
static func beta() -> float:
	return KOSCHMIEDER / visibility_m


## Fraction of an object's own light that reaches the eye through d metres of haze (64-bit mirror of the shaders).
static func transmittance(d: float) -> float:
	return exp(-beta() * d)


## Fog light colour in linear units, as the engine uses it (fog_light_color · fog_light_energy).
static func haze_linear(lighting: Dictionary = {}) -> Vector3:
	if _uses_flow_state(lighting):
		return state.haze_lin
	var a: Dictionary = parameters(lighting)
	var c: Color = a.haze.srgb_to_linear()
	return Vector3(c.r, c.g, c.b) * a.haze_energy


## Compensation for Compatibility's sRGB blending of shadowed lights, used only with engine shadows (L3).
static func shadow_compensation() -> float:
	# Forward+ blends lighting in linear HDR: applying the GLES3 correction there
	# dims even unoccluded surfaces when shadow maps are enabled (VQ-07).
	return Spec.ATMOSPHERE.shadow_energy_compat \
		if engine_shadows and RenderingServer.get_current_rendering_method() == "gl_compatibility" \
		and ShadowSettings.native_enabled() else 1.0


## Cache the original inputs, not a ratio of previously rounded output values.
static func _shadow_energy_source(lighting: Dictionary) -> Dictionary:
	var flowing := _uses_flow_state(lighting)
	var a: Dictionary = parameters(lighting)
	return {
		"engine_shadows": engine_shadows,
		"energy": float(state.light_energy if flowing else a.sun_energy),
		"intensity": float(_appearance.sun_intensity) if _appearance_enabled else 1.0,
	}


static func _shadow_scatter_source(lighting: Dictionary) -> Dictionary:
	return {"engine_shadows": engine_shadows,
		"scatter": 0.0 if _uses_flow_state(lighting) else float(parameters(lighting).sun_scatter)}


static func _shadow_material_source(lighting: Dictionary) -> Dictionary:
	var source := _shadow_energy_source(lighting)
	var color := light_color(lighting).srgb_to_linear()
	source["color"] = Vector3(color.r, color.g, color.b)
	source["scatter"] = _shadow_scatter_source(lighting).scatter
	return source


static func _remember_shadow_lighting(resource: Object, entry: Dictionary) -> void:
	if RenderingServer.get_current_rendering_method() != "gl_compatibility":
		return
	var id := resource.get_instance_id()
	var old: Dictionary = _shadow_lighting_resources.get(id, {})
	if old.is_empty() or old.reference.get_ref() != resource:
		_shadow_lighting_registrations += 1
		if _shadow_lighting_registrations >= SHADOW_LIGHTING_SWEEP_INTERVAL:
			_prune_shadow_lighting()
	entry["reference"] = weakref(resource)
	_shadow_lighting_resources[id] = entry
	ShadowSettings.set_lighting_refresh(_refresh_shadow_lighting)


static func _prune_shadow_lighting() -> void:
	for id: int in _shadow_lighting_resources.keys():
		if _shadow_lighting_resources[id].reference.get_ref() == null:
			_shadow_lighting_resources.erase(id)
	_shadow_lighting_registrations = 0


static func _track_shadow_material(material: ShaderMaterial, lighting: Dictionary) -> void:
	if RenderingServer.get_current_rendering_method() != "gl_compatibility":
		return
	var previous: Dictionary = _shadow_lighting_resources.get(material.get_instance_id(), {})
	var entry := {"kind": "material", "source": _shadow_material_source(lighting)}
	if not previous.is_empty() and previous.reference.get_ref() == material and previous.has("aureole"):
		entry["aureole"] = previous.aureole
	_remember_shadow_lighting(material, entry)


## Adapters that set the same haze uniforms directly register their local snapshot.
static func track_shadow_material(material: ShaderMaterial, lighting: Dictionary = {}) -> void:
	_track_shadow_material(material, lighting)


## A duplicated field surface inherits its source's already-applied lighting.
static func track_shadow_material_copy(material: ShaderMaterial, source: ShaderMaterial) -> void:
	var entry: Dictionary = _shadow_lighting_resources.get(source.get_instance_id(), {})
	if not entry.is_empty() and entry.reference.get_ref() == source:
		_remember_shadow_lighting(material, entry.duplicate(true))


static func _refresh_shadow_lighting(native_enabled: bool) -> void:
	var compatibility := RenderingServer.get_current_rendering_method() == "gl_compatibility"
	for id: int in _shadow_lighting_resources.keys():
		var entry: Dictionary = _shadow_lighting_resources[id]
		var resource: Variant = entry.reference.get_ref()
		if resource == null:
			_shadow_lighting_resources.erase(id)
			continue
		var source: Dictionary = entry.source
		var compensation: float = Spec.ATMOSPHERE.shadow_energy_compat \
			if compatibility and bool(source.engine_shadows) and native_enabled else 1.0
		match entry.kind:
			"light":
				(resource as DirectionalLight3D).light_energy = float(source.energy) * compensation * float(source.intensity)
			"environment":
				(resource as Environment).fog_sun_scatter = float(source.scatter) / compensation
			"material":
				var material := resource as ShaderMaterial
				var energy := float(source.energy) * compensation * float(source.intensity)
				var solar: Vector3 = (source.color as Vector3) * energy * PI
				material.set_shader_parameter("sun_lin", solar)
				material.set_shader_parameter("sun_scatter", float(source.scatter) / compensation)
				if entry.has("aureole"):
					material.set_shader_parameter("sun_aureole_lin", SunOptics.aureole_lin(
						solar / compensation, float(entry.aureole.aerosol), float(entry.aureole.disc)))
	_shadow_lighting_registrations = 0


## The light's actual energy.
static func light_energy(lighting: Dictionary = {}) -> float:
	var a: Dictionary = parameters(lighting)
	var energy: float = state.light_energy if _uses_flow_state(lighting) else a.sun_energy
	return energy * shadow_compensation() * (float(_appearance.sun_intensity) if _appearance_enabled else 1.0)


## Fog sun scatter as set on the engine: divided by the compensation, so the haze's sun term never changes.
static func sun_scatter(lighting: Dictionary = {}) -> float:
	if _uses_flow_state(lighting):
		return 0.0
	return parameters(lighting).sun_scatter / shadow_compensation()


## The sun's light in the units of the engine's fog scatter term (linear colour · actual light energy · π).
static func sun_linear(lighting: Dictionary = {}) -> Vector3:
	var c: Color = light_color(lighting).srgb_to_linear()
	return Vector3(c.r, c.g, c.b) * light_energy(lighting) * PI


## The directional light's colour (sRGB): the calibrated sun, or the time-of-day sun/moon.
static func light_color(lighting: Dictionary = {}) -> Color:
	var color: Color = state.light_color if _uses_flow_state(lighting) else parameters(lighting).sun_color
	if not _appearance_enabled:
		return color
	var tinted := _linear_color(color) * _profile_ratio(_appearance.sun_lin, _linear_color(Spec.ATMOSPHERE.sun_color))
	return Color(tinted.x, tinted.y, tinted.z).linear_to_srgb()


## Direction for the planar pilot-aid shadow: the light, with its elevation held at ≥ SHADOW_MIN_ELEVATION_DEG so a
## low sun gives a long but bounded shadow instead of one stretched to the horizon (estimate).
const SHADOW_MIN_ELEVATION_DEG := 12.0


static func shadow_direction(lighting: Dictionary = {}) -> Vector3:
	var d := sun_direction(lighting)
	var min_y := sin(deg_to_rad(SHADOW_MIN_ELEVATION_DEG))
	if d.y >= min_y:
		return d
	var flat := Vector2(d.x, d.z).normalized() * cos(deg_to_rad(SHADOW_MIN_ELEVATION_DEG))
	return Vector3(flat.x, min_y, flat.y)


static func _set_haze_uniforms(mat: ShaderMaterial, lighting: Dictionary = {}) -> void:
	mat.set_shader_parameter("haze_lin", _profile_haze_linear(haze_linear(lighting)))
	mat.set_shader_parameter("sun_dir", sun_direction(lighting))
	mat.set_shader_parameter("sun_lin", sun_linear(lighting))
	mat.set_shader_parameter("sun_scatter", sun_scatter(lighting))
	_track_shadow_material(mat, lighting)
	mat.set_shader_parameter("lobe_lin", state.lobe_lin if _uses_flow_state(lighting) else lighting.get("lobe_lin", Vector3.ZERO))
	mat.set_shader_parameter("lobe_dir", state.lobe_dir if _uses_flow_state(lighting) else lighting.get("lobe_dir", Vector3(1.0, 0.0, 0.0)))
	mat.set_shader_parameter("lobe_k", state.lobe_k if _uses_flow_state(lighting) else lighting.get("lobe_k", 8.0))
	mat.set_shader_parameter("lobe_height", state.lobe_height if _uses_flow_state(lighting) else lighting.get("lobe_height", 1.5708))


## SUN-01: the disc's limb darkening, refraction flattening and aerosol aureole (sky.gdshader, render/sun/sun_optics.gd).
## Written with the other solar uniforms (build, sky steps, FW-MOON-06d frames), never per frame from a renderer, so
## the calibrated day and the snapshots render their radiance once. In flow the light may be the moon: sun_disc = 0
## then, and the aureole is zero.
static func _set_sun_uniforms(mat: ShaderMaterial, lighting: Dictionary = {}) -> void:
	var flow := _uses_flow_state(lighting)
	var a: Dictionary = parameters(lighting)
	var disc := float(state.sun_disc) if flow else float(a.get("sun_disc", 1.0))
	var elevation := float(state.sun_elevation_deg) if flow else float(a.get("disc_elevation_deg", a.sun_elevation_deg))
	mat.set_shader_parameter("sun_limb", 1.0)
	mat.set_shader_parameter("sun_squash", SunOptics.squash(elevation))
	# The aureole is sky light: the Compatibility shadow compensation in sun_linear() is divided out (like haze()).
	mat.set_shader_parameter("sun_aureole_lin", SunOptics.aureole_lin(sun_linear(lighting) / shadow_compensation(), aureole_aerosol_factor(), disc))
	mat.set_shader_parameter("sun_aureole_k", SunOptics.AUREOLE_K)
	var tracked: Dictionary = _shadow_lighting_resources.get(mat.get_instance_id(), {})
	if not tracked.is_empty() and tracked.reference.get_ref() == mat:
		tracked["aureole"] = {"aerosol": aureole_aerosol_factor(), "disc": disc}


static func _set_sky_uniform_if_changed(mat: ShaderMaterial, uniform_name: StringName, value: Variant) -> bool:
	if mat.get_shader_parameter(uniform_name) == value:
		return false
	mat.set_shader_parameter(uniform_name, value)
	return true


static func _apply_cloud_uniforms(mat: ShaderMaterial, sim_time_s: float, precomputed_offsets: Array = [],
		offsets_precomputed: bool = false) -> bool:
	var offsets: Array = precomputed_offsets if offsets_precomputed else _cloud_offsets_at(sim_time_s)
	var changed := false
	if _appearance_enabled:
		var arrays := _cloud_shader_arrays(offsets)
		changed = _set_sky_uniform_if_changed(mat, &"layered_appearance", true) or changed
		changed = _set_sky_uniform_if_changed(mat, &"disc_cloud_occlusion", true) or changed
		changed = _set_sky_uniform_if_changed(mat, &"appearance_layer_count", arrays.layer_count) or changed
		changed = _set_sky_uniform_if_changed(mat, &"appearance_layer_parameters", arrays.layer_parameters) or changed
		changed = _set_sky_uniform_if_changed(mat, &"appearance_layer_motion", arrays.layer_motion) or changed
		changed = _set_sky_uniform_if_changed(mat, &"appearance_layer_seeds", arrays.layer_seeds) or changed
		changed = _set_sky_uniform_if_changed(mat, &"appearance_cloud_density", arrays.cloud_density) or changed
	else:
		changed = _set_sky_uniform_if_changed(mat, &"layered_appearance", false) or changed
		changed = _set_sky_uniform_if_changed(mat, &"cloud_offset", _cloud_offset_for_legacy_branch(sim_time_s, offsets)) or changed
	return changed


static func _cloud_shader_arrays(offsets: Array) -> Dictionary:
	if _cloud_arrays_cache_valid and offsets == _cloud_arrays_cache_offsets:
		return _cloud_arrays_cache
	_cloud_arrays_cache = SkyAppearance.shader_arrays(_appearance.cloud_layers, offsets,
		float(_appearance.cloud_cover), float(_appearance.cloud_density))
	_cloud_arrays_cache_offsets = offsets.duplicate(true)
	_cloud_arrays_cache_valid = true
	return _cloud_arrays_cache


static func _cloud_offset_for_legacy_branch(sim_time_s: float, offsets: Array = []) -> Vector2:
	if str(_appearance_selection.get("motion", "legacy")) != "legacy" and not offsets.is_empty():
		var raw: Variant = offsets[0]
		if typeof(raw) == TYPE_ARRAY and raw.size() == 2:
			return Vector2(float(raw[0]), float(raw[1]))
	return _legacy_cloud_offset_at(sim_time_s)


static func _selected_cloud_offset(sim_time_s: float, offsets: Array = []) -> Vector2:
	if not _appearance_enabled:
		return _cloud_offset_for_legacy_branch(sim_time_s, offsets)
	var index := _shadow_layer_index()
	if index < 0 and not offsets.is_empty():
		index = 0
	return _cloud_offset_from_array(offsets, index)


static func _set_profile_shadow_uniforms(mat: ShaderMaterial, lighting: Dictionary = {}) -> void:
	if mat.shader != GROUND_SHADER and mat.shader != NEAR_GRASS_SHADER:
		return
	if not _appearance_enabled:
		mat.set_shader_parameter("appearance_cloud_shadow", false)
		return
	mat.set_shader_parameter("appearance_cloud_shadow", true)
	var index := _shadow_layer_index()
	if index < 0:
		mat.set_shader_parameter("cloud_shadow_strength", 0.0)
		mat.set_shader_parameter("appearance_shadow_density", 0.0)
		mat.set_shader_parameter("cloud_coverage", 0.0)
		return
	var layer: Dictionary = _appearance.cloud_layers[index]
	var cover := clampf(float(layer.coverage) + (float(_appearance.cloud_cover) - 0.5) * 0.5, 0.0, 1.0)
	mat.set_shader_parameter("cloud_coverage", float(_appearance.cloud_cover))
	mat.set_shader_parameter("cloud_deck_m", float(layer.altitude_m))
	mat.set_shader_parameter("cloud_shadow_strength", float(_appearance.cloud_shadow))
	mat.set_shader_parameter("appearance_shadow_scale_m", float(layer.scale_m))
	mat.set_shader_parameter("appearance_shadow_coverage", cover)
	mat.set_shader_parameter("appearance_shadow_density", float(layer.density) * float(_appearance.cloud_density))
	mat.set_shader_parameter("appearance_shadow_seed", int(layer.seed))
	mat.set_shader_parameter("appearance_shadow_cluster", float(layer.cluster_strength))


static func sky_material(lighting: Dictionary = {}) -> ShaderMaterial:
	var mat: ShaderMaterial = ShaderMaterial.new()
	mat.shader = SKY_SHADER
	update_sky_material(mat, lighting)
	return mat


## TOD-09b: update the solar snapshot in place, preserving the scene's cloud animation.
static func update_sky_material(mat: ShaderMaterial, lighting: Dictionary = {}) -> void:
	var a: Dictionary = parameters(lighting)
	var z: Color = a.zenith.srgb_to_linear()
	mat.set_shader_parameter("zenith_lin", Vector3(z.r, z.g, z.b))
	mat.set_shader_parameter("gradient_curve", a.gradient_curve)
	mat.set_shader_parameter("sun_radius", deg_to_rad(a.sun_diameter_deg) / 2.0)
	var cl: Color = a.cloud_color.srgb_to_linear()
	mat.set_shader_parameter("cloud_lin", Vector3(cl.r, cl.g, cl.b))
	mat.set_shader_parameter("cloud_coverage", a.cloud_coverage)
	mat.set_shader_parameter("cloud_scale", a.cloud_scale)
	mat.set_shader_parameter("cloud_seed", selected_cloud_seed(int(a.cloud_seed)))
	mat.set_shader_parameter("cluster_strength", a.cloud_cluster_strength)
	mat.set_shader_parameter("cirrus_strength", a.cloud_cirrus_strength)
	mat.set_shader_parameter("silver_strength", a.cloud_silver_strength)
	mat.set_shader_parameter("disc_cloud_occlusion", a.get("disc_cloud_occlusion", false))
	mat.set_shader_parameter("disc_dir", disc_direction(lighting))
	_set_haze_uniforms(mat, lighting)
	_set_sun_uniforms(mat, lighting)
	if _uses_flow_state(lighting):
		apply_state_to_sky(mat)
	else:
		# Clear moon/twilight uniforms when returning from FW flow or switching to a scene snapshot.
		mat.set_shader_parameter("sun_disc", a.get("sun_disc", 1.0))
		mat.set_shader_parameter("moon_dir", a.get("moon_dir", Vector3.DOWN))
		mat.set_shader_parameter("moon_lin", a.get("moon_lin", Vector3.ZERO))
		mat.set_shader_parameter("moon_sun_dir", a.get("moon_sun_dir", Vector3.UP))
		mat.set_shader_parameter("lobe2_lin", Vector3.ZERO)
		mat.set_shader_parameter("light1_weight", 1.0)
		mat.set_shader_parameter("light2_weight", 0.0)
		mat.set_shader_parameter("moon_aureole_lin", Vector3.ZERO)
		mat.set_shader_parameter("moon_eclipse", false)
		mat.set_shader_parameter("moon_eclipse_dim", 1.0)
	_profile_sky_tints(mat, lighting)
	_apply_cloud_uniforms(mat, _last_cloud_sim_time)


## FW-MOON-08a: the aerosol optical depth over Krisciunas & Schaefer's sites, which scales the aureole (their aerosol
## term was fitted to clean observatory air). τ_a = (β·haze − β_Rayleigh)·H_aerosol, with β from the visibility and
## the weather profile's haze scale (1 without a profile); clamped to [0.25, 4]. At the default 23 km visibility
## without a profile: 1.9; the classic profile 1.3, clear 1.0, electrical storm 3.6.
const AUREOLE_RAYLEIGH_BETA := 1.16e-5 # sea-level Rayleigh extinction at 550 nm, 1/m (borrowed)
const AUREOLE_AEROSOL_HEIGHT_M := 1200.0 # aerosol scale height (estimate)
const AUREOLE_KS91_TAU := 0.10 # KS91's V extinction 0.172 mag at Mauna Kea, less ~0.06 Rayleigh (estimate)


static func aureole_aerosol_factor() -> float:
	var haze := float(_appearance.haze_scale) if _appearance_enabled else 1.0
	var tau := maxf(beta() * haze - AUREOLE_RAYLEIGH_BETA, 0.0) * AUREOLE_AEROSOL_HEIGHT_M
	return clampf(tau / AUREOLE_KS91_TAU, 0.25, 4.0)


## FW-22/61: the time-of-day state's sky uniforms (also called when time flows).
static func apply_state_to_sky(mat: ShaderMaterial) -> void:
	mat.set_shader_parameter("zenith_lin", state.zenith_lin)
	mat.set_shader_parameter("cloud_lin", state.cloud_lin)
	mat.set_shader_parameter("sun_disc", state.sun_disc)
	mat.set_shader_parameter("moon_dir", state.moon_dir)
	mat.set_shader_parameter("moon_lin", state.moon_lin)
	# FW-MOON-03: photometric disc (moon_disc.gdshaderinc): true sun direction at the moon, size, phase law, earthshine.
	mat.set_shader_parameter("moon_sun_dir", state.get("moon_sun_dir", state.sun_dir))
	mat.set_shader_parameter("moon_radius", state.get("moon_radius", 0.0045379))
	mat.set_shader_parameter("moon_phase_l", state.get("moon_phase_l", 1.0))
	mat.set_shader_parameter("moon_phase_k", state.get("moon_phase_k", 1.0))
	mat.set_shader_parameter("moon_earthshine", state.get("moon_earthshine", Vector3.ZERO))
	mat.set_shader_parameter("moon_display_scale", state.get("moon_display_scale", 1.0))
	mat.set_shader_parameter("moon_display_gamma", state.get("moon_display_gamma", 1.0))
	# FW-MOON-05: textured, oriented disc (NASA SVS CGI Moon Kit, tools/world/moon_texture.py).
	var textured: bool = state.get("moon_textured", false)
	mat.set_shader_parameter("moon_textured", textured)
	if textured:
		if _moon_albedo == null:
			_moon_albedo = load(MOON_ALBEDO_PATH)
			_moon_normal = load(MOON_NORMAL_PATH)
		mat.set_shader_parameter("moon_albedo", _moon_albedo)
		mat.set_shader_parameter("moon_normal", _moon_normal)
		mat.set_shader_parameter("moon_render_to_body", state.moon_render_to_body)
		mat.set_shader_parameter("moon_albedo_scale", 1.0 / SkyState.MOON_ALBEDO_NEAR_SIDE_MEAN)
		mat.set_shader_parameter("moon_squash", state.get("moon_squash", 1.0))
	mat.set_shader_parameter("disc_cloud_occlusion", false)
	mat.set_shader_parameter("disc_dir", state.sun_dir)
	_set_haze_uniforms(mat)
	_set_sun_uniforms(mat)
	# FW-MOON-06c: the other source's horizon lobe and both sources' weights in the clouds' directional shading, so the
	# sky keeps both at twilight.
	mat.set_shader_parameter("lobe2_lin", state.get("sky_lobe2_lin", Vector3.ZERO))
	mat.set_shader_parameter("lobe2_dir", state.get("sky_lobe2_dir", Vector3(1.0, 0.0, 0.0)))
	mat.set_shader_parameter("lobe2_k", state.get("sky_lobe2_k", 8.0))
	mat.set_shader_parameter("lobe2_height", state.get("sky_lobe2_height", 1.5708))
	mat.set_shader_parameter("light2_dir", state.get("cloud_light2_dir", Vector3.UP))
	mat.set_shader_parameter("light1_weight", state.get("cloud_light1_weight", 1.0))
	mat.set_shader_parameter("light2_weight", state.get("cloud_light2_weight", 0.0))
	# FW-MOON-08a: the moon's aureole, scaled by the air's aerosols (visibility and the weather profile's haze).
	mat.set_shader_parameter("moon_aureole_lin", (state.get("moon_aureole_lin", Vector3.ZERO) as Vector3) * aureole_aerosol_factor())
	# FW-MOON-10: Earth's shadow on the disc.
	mat.set_shader_parameter("moon_eclipse", state.get("moon_eclipse", false))
	mat.set_shader_parameter("moon_shadow_axis", state.get("moon_shadow_axis", Vector3.DOWN))
	mat.set_shader_parameter("moon_shadow_offset", state.get("moon_shadow_offset", Vector3.ZERO))
	mat.set_shader_parameter("moon_umbra_radius", state.get("moon_umbra_radius", 0.0))
	mat.set_shader_parameter("moon_penumbra_radius", state.get("moon_penumbra_radius", 0.0))
	# The aureole's knee follows the eclipsed disc as shown (1 exactly without an eclipse).
	var dim: Vector3 = state.get("moon_eclipse_factor", Vector3.ONE)
	mat.set_shader_parameter("moon_eclipse_dim", 0.2126 * dim.x + 0.7152 * dim.y + 0.0722 * dim.z if state.get("moon_eclipse", false) else 1.0)
	_profile_sky_tints(mat)
	_apply_cloud_uniforms(mat, _last_cloud_sim_time)


## FW-23/61: time-of-day haze, ambient colour and tonemapper. Compatibility disables sky reflections because its
## cubemap double-applies exposure (sky_state.gd); the native High trial restores them. Exposure is World.adapt's.
static func apply_state_to_environment(env: Environment) -> void:
	var h: Vector3 = state.haze_lin
	env.fog_light_color = Color(h.x, h.y, h.z).linear_to_srgb()
	env.fog_light_energy = 1.0
	env.fog_sun_scatter = sun_scatter()
	_remember_shadow_lighting(env, {"kind": "environment", "source": _shadow_scatter_source({})})
	var amb: Vector3 = state.ambient_lin
	env.ambient_light_source = Environment.AMBIENT_SOURCE_COLOR
	env.ambient_light_color = Color(amb.x, amb.y, amb.z).linear_to_srgb()
	env.ambient_light_energy = 1.0
	env.reflected_light_source = Environment.REFLECTION_SOURCE_DISABLED
	env.tonemap_mode = Environment.TONE_MAPPER_AGX if state.get("tonemapper", "aces") == "agx" else Environment.TONE_MAPPER_ACES
	_apply_profile_environment(env)
	HighGraphics.apply_environment(env)


## The directional light from the current state (or the calibrated sun): colour, energy, direction.
static func apply_light(light: DirectionalLight3D) -> void:
	light.light_color = light_color()
	light.light_energy = light_energy()
	_remember_shadow_lighting(light, {"kind": "light", "source": _shadow_energy_source({})})
	_apply_shadow(light)
	# The light shines along its −Z: toward the origin from the sun's side. Built directly (no scene tree needed).
	var d := sun_direction()
	light.transform = Transform3D(Basis.looking_at(-d, Vector3.UP if absf(d.y) < 0.999 else Vector3.FORWARD), d * 100.0)


static func _set_cloud_offset(off: Vector2) -> void:
	if not _cloud_registered:
		RenderingServer.global_shader_parameter_add(&"cloud_drift_offset", RenderingServer.GLOBAL_VAR_TYPE_VEC2, off)
		_cloud_registered = true
	elif last_cloud_offset != off:
		RenderingServer.global_shader_parameter_set(&"cloud_drift_offset", off)
	last_cloud_offset = off


## L4: cloud drift for a simulation time (s): quantised to cloud_update_s and wrapped in float64 to the noise period,
## so the sky changes at most once per update interval and never jumps.
static func cloud_offset(sim_time: float) -> Vector2:
	var a: Dictionary = Spec.ATMOSPHERE
	var step: float = a.cloud_update_s
	var t := floorf(sim_time / step) * step
	var d: Vector2 = a.cloud_drift_cells_per_s
	return Vector2(fposmod(d.x * t, CLOUD_PERIOD), fposmod(d.y * t, CLOUD_PERIOD))


## Moves the clouds of an environment's sky to a simulation time; returns true when the sky actually changed.
static func update_clouds(env: Environment, sim_time: float) -> bool:
	var mat: ShaderMaterial = env.sky.sky_material
	var offsets := _cloud_offsets_at(sim_time)
	var off := _selected_cloud_offset(sim_time, offsets)
	var global_offset_changed: bool = last_cloud_offset != off
	_set_cloud_offset(off) # also updates all ground surfaces, even when the sky is already at this time
	var sky_changed := _apply_cloud_uniforms(mat, sim_time, offsets, true)
	_last_cloud_sim_time = sim_time
	_last_cloud_offsets = offsets
	_last_cloud_offsets_valid = true
	return global_offset_changed or sky_changed


## Refresh field materials and cached reflections after an explicit sky edit or restoration.
## The sky Environment and sun are updated separately; continuous cloud drift does not call this path.
static func update_cloud_appearance(root: Node) -> void:
	if root == null or not is_instance_valid(root):
		return
	var materials: Array = root.get_meta("lighting_materials", [])
	var lighting: Dictionary = root.get_meta("lighting_snapshot", {})
	for material_value: Variant in materials:
		if material_value is ShaderMaterial and is_instance_valid(material_value):
			update_ground_material(material_value as ShaderMaterial, lighting)
	for probe: Node in root.find_children("*", "ReflectionProbe", true, false):
		if probe.has_method("request_refresh"):
			probe.request_refresh()


## The ground's material: grass texture in world space + the haze as custom fog with the rim fade.
static func ground_material(grass: Texture2D, lighting: Dictionary = {}) -> ShaderMaterial:
	var mat: ShaderMaterial = ShaderMaterial.new()
	_set_cloud_offset(last_cloud_offset) # register before assigning a shader, also in an empty-project pack probe
	mat.shader = GROUND_SHADER
	mat.set_shader_parameter("grass", grass)
	mat.set_shader_parameter("tile_m", Spec.GROUND.tile_m)
	update_ground_material(mat, lighting)
	return mat


## Shared by each ground surface and near-grass material; placement and texture uniforms remain scene-owned.
static func update_ground_material(mat: ShaderMaterial, lighting: Dictionary = {}) -> void:
	var a: Dictionary = parameters(lighting)
	mat.set_shader_parameter("cloud_coverage", a.cloud_coverage)
	mat.set_shader_parameter("cloud_scale", a.cloud_scale)
	mat.set_shader_parameter("cloud_seed", selected_cloud_seed(int(a.cloud_seed)))
	mat.set_shader_parameter("cluster_strength", a.cloud_cluster_strength)
	mat.set_shader_parameter("cloud_deck_m", a.cloud_deck_m)
	mat.set_shader_parameter("cloud_shadow_strength", a.cloud_shadow_strength)
	mat.set_shader_parameter("beta", beta())
	if mat.shader == GROUND_SHADER:
		# L7: spread the artistic rim closure in inverse distance at high visibility.
		mat.set_shader_parameter("rim_start", a.rim_start_m if visibility_m <= a.visibility_m else 3000.0)
		mat.set_shader_parameter("rim_end", a.rim_end_m)
		mat.set_shader_parameter("rim_angular", visibility_m > a.visibility_m)
	_set_haze_uniforms(mat, lighting)
	_set_profile_shadow_uniforms(mat, lighting)


## The world environment. L1a: the sky drawn per pixel as background; its radiance (rendered once, QUALITY) lights
## the scene as ambient light and reflections. L1b: ACES at exposure 0.6, glow off: the best readability of 14 settings
## swept twice (before and after L2's sky colour-space fix). With the correct sky: 3 m view contrast −0.335, ΔE 30.0;
## 30 m view −0.431, ΔE 41.4 (Filmic 0.8: −0.280 / 27.4). Ambient energy has no measurable effect here.
## L2: exponential haze for every object (the ground writes its own), density β, colour = the sky's horizon.
static func environment(lighting: Dictionary = {}) -> Environment:
	var sky := Sky.new()
	sky.sky_material = sky_material(lighting)
	sky.process_mode = Sky.PROCESS_MODE_QUALITY # deterministic radiance; uniform changes refresh it (no shader TIME)
	var env := Environment.new()
	env.background_mode = Environment.BG_SKY
	env.sky = sky
	env.glow_enabled = false
	env.fog_enabled = true
	env.fog_mode = Environment.FOG_MODE_EXPONENTIAL
	env.fog_sky_affect = 0.0
	env.fog_aerial_perspective = 0.0
	env.fog_height_density = 0.0
	_update_environment_parameters(env, lighting)
	if _uses_flow_state(lighting):
		apply_state_to_environment(env)
	_apply_profile_environment(env, lighting)
	HighGraphics.apply_environment(env)
	return env


## The sun: a DirectionalLight3D shining from sun_direction(lighting); PSSM shadows only with engine_shadows (L3).
static func create_sun(parent: Node, lighting: Dictionary = {}) -> DirectionalLight3D:
	var sun: DirectionalLight3D = DirectionalLight3D.new()
	sun.directional_shadow_mode = DirectionalLight3D.SHADOW_PARALLEL_2_SPLITS
	sun.directional_shadow_max_distance = Spec.ATMOSPHERE.shadow_max_distance_m
	update_sun(sun, lighting)
	parent.add_child(sun)
	return sun


## Update a scene-local Environment without replacing its Sky resource or touching the global FW state.
static func update_environment(env: Environment, lighting: Dictionary = {}) -> void:
	update_sky_material(env.sky.sky_material as ShaderMaterial, lighting)
	_update_environment_parameters(env, lighting)
	if _uses_flow_state(lighting):
		apply_state_to_environment(env)
	_apply_profile_environment(env, lighting)
	HighGraphics.apply_environment(env)


static func _update_environment_parameters(env: Environment, lighting: Dictionary) -> void:
	var a: Dictionary = parameters(lighting)
	env.ambient_light_source = Environment.AMBIENT_SOURCE_SKY
	env.ambient_light_energy = 1.0
	env.reflected_light_source = Environment.REFLECTION_SOURCE_SKY
	env.tonemap_mode = Environment.TONE_MAPPER_AGX if a.get("tonemapper", "aces") == "agx" else Environment.TONE_MAPPER_ACES
	env.tonemap_exposure = state.exposure if _uses_flow_state(lighting) else a.exposure
	env.tonemap_white = a.white
	env.fog_density = beta()
	env.fog_light_color = a.haze
	env.fog_light_energy = a.haze_energy
	env.fog_sun_scatter = sun_scatter(lighting)
	_remember_shadow_lighting(env, {"kind": "environment", "source": _shadow_scatter_source(lighting)})


## Engine shadows follow the shadow strength. FW-MOON-06b: with time flowing (every step, not only at build) the
## PSSM opacity is the strength itself, so moon and setting-sun shadows fade like the projected and planar shadows;
## the calibrated day and explicit snapshots keep on/off at full opacity.
static func _apply_shadow(light: DirectionalLight3D, lighting: Dictionary = {}) -> void:
	var strength := shadow_strength(lighting)
	light.shadow_enabled = engine_shadows and strength > 0.0
	light.shadow_opacity = clampf(strength, 0.0, 1.0) if _uses_flow_state(lighting) else 1.0
	HighGraphics.apply_sun(light)
	ShadowSettings.apply_sun(light, engine_shadows and strength > 0.0)


static func update_sun(sun: DirectionalLight3D, lighting: Dictionary = {}) -> void:
	sun.light_color = light_color(lighting)
	sun.light_energy = light_energy(lighting)
	_remember_shadow_lighting(sun, {"kind": "light", "source": _shadow_energy_source(lighting)})
	_apply_shadow(sun, lighting)
	# The light shines along its -Z. Choose a stable up axis for the zenith case.
	var direction: Vector3 = sun_direction(lighting)
	var up: Vector3 = Vector3.FORWARD if absf(direction.dot(Vector3.UP)) > 0.9999 else Vector3.UP
	sun.transform = Transform3D(Basis.looking_at(-direction, up), direction * 100.0)
