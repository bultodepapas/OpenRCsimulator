; OpenRC Simulator (Godot 4.7). Started as the Stage 0/1 bake-off build (prototypes/stage0/SPEC.md).
config_version=5

[application]

config/name="OpenRC Simulator"
run/main_scene="res://main.tscn"
config/features=PackedStringArray("4.7")

[display]

window/size/viewport_width=1280
window/size/viewport_height=720

[rendering]

; Compatibility renderer: the only one Godot can export to the web, and the closest match to WebGL 2.
renderer/rendering_method="gl_compatibility"
renderer/rendering_method.mobile="gl_compatibility"
anti_aliasing/quality/msaa_3d=2
