; OpenRC Simulator (Godot 4.7). Started as the Stage 0/1 bake-off build (prototypes/stage0/SPEC.md).
config_version=5

[application]

config/name="OpenRC Simulator"
run/main_scene="res://main.tscn"
config/features=PackedStringArray("4.7")

[display]

window/size/viewport_width=1280
window/size/viewport_height=720

[physics]

; Simulation steps at a fixed 240 Hz. Up to 12 catch-up steps per frame keeps real time down to 20 fps;
; slower than that, the simulation runs in slow motion instead of spiraling.
common/physics_ticks_per_second=240
common/max_physics_steps_per_frame=12

[rendering]

; Compatibility renderer: the only one Godot can export to the web, and the closest match to WebGL 2.
renderer/rendering_method="gl_compatibility"
renderer/rendering_method.mobile="gl_compatibility"
anti_aliasing/quality/msaa_3d=2
; Required by Godot's macOS exporter for universal/arm64 builds (PT1); the app imports no textures, so nothing else changes.
textures/vram_compression/import_etc2_astc=true
