; OpenRC Simulator (Godot 4.8). Started as the Stage 0/1 bake-off build (prototypes/stage0/SPEC.md).
config_version=5

[application]

config/name="OpenRC Simulator"
; UI-04a: numeric x.y.z only (Windows and macOS version fields take integers). The full identity (tag, commits,
; SHA, dirty) is res://build_info.json, written into the pack at export. export.sh checks the tag's x.y.z matches.
config/version="0.1.9"
; The lightweight brand entrance hands off to app_root, which owns route selection.
run/main_scene="res://ui/startup.tscn"
boot_splash/show_image=false
boot_splash/bg_color=Color(0.003, 0.006, 0.012, 1)
config/features=PackedStringArray("4.8")

[autoload]

; Install bundled CJK glyphs before startup without replacing the engine Latin font.
InterfaceFonts="*res://i18n/fonts.gd"

[display]

; GDU-03: the application owns fullscreen transitions and persisted display settings.
window/size/enable_toggle_fullscreen_shortcut=false
window/size/viewport_width=1280
window/size/viewport_height=720

[input]

smoke_pump={
"deadzone": 0.5,
"events": [Object(InputEventKey,"physical_keycode":72)]
}

[gui]

; Preserve the existing explicit keyboard-focus behavior across the engine upgrade.
common/auto_focus_strategy=0

[input_devices]

joypads/ignore_joypad_on_unfocused_application=false

[physics]

; Simulation steps at a fixed 240 Hz. Up to 12 catch-up steps per frame keeps real time down to 20 fps;
; slower than that, the simulation runs in slow motion instead of spiraling.
common/physics_ticks_per_second=240
common/max_physics_steps_per_frame=12
; CAM-25: the flight presents its own interpolation of the 240 Hz state (Engine.get_physics_interpolation_fraction);
; Godot's docs ask for jitter fix 0 with a custom interpolation. At 50 fps the default 0.5 tripled the presented-time
; error against the wall clock on the dev VM (docs/research/camera-views/CAM-AUD-2026-10-24). Ticks stay fixed steps.
common/physics_jitter_fix=0.0

[rendering]

; VQ-07d: the native DLSS build uses the validated transformer preset.
streamline/dlss_preset="K"

; Compatibility renderer: the only one Godot can export to the web, and the closest match to WebGL 2.
renderer/rendering_method="gl_compatibility"
renderer/rendering_method.mobile="gl_compatibility"
; GDU-11h: Forward+ reads this before scripts run. Compatibility/Mobile ignore it.
; Product High uses Forward+; bare technical Forward+ launches also inherit this option.
lights_and_shadows/multi_bounce_occlusion/enabled=true
anti_aliasing/quality/msaa_3d=2
; LU-25: one lake probe. The default 64-slot atlas reserves ~256 MiB on Compatibility.
reflections/reflection_atlas/reflection_count=2
; Required by Godot's macOS exporter for universal/arm64 builds (PT1); the app imports no textures, so nothing else changes.
textures/vram_compression/import_etc2_astc=true

[internationalization]

; UI-01d: English is the source and default language (set by app_root, not the OS locale); one gettext .po per
; other language. .po files load without an import step and are exported with all_resources (probe 23).
locale/translations=PackedStringArray("res://i18n/es.po", "res://i18n/zh_Hans.po", "res://i18n/pt_BR.po", "res://i18n/de.po", "res://i18n/fr.po", "res://i18n/it.po", "res://i18n/ru.po", "res://i18n/ja.po")

[editor_plugins]

; UI-04a: writes res://build_info.json into exported packs (addons/build_info; excluded from the packs themselves).
enabled=PackedStringArray("res://addons/build_info/plugin.cfg", "res://addons/aircraft_contract/plugin.cfg", "res://addons/native_kernel/plugin.cfg")
