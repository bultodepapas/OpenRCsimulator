extends RefCounted
## Loads and verifies generated Workshop metadata against an exact aircraft snapshot.

const FORMAT: String = "openrc-aircraft-workshop v3"
const V2_FORMAT: String = "openrc-aircraft-workshop v2"
const LEGACY_FORMAT: String = "openrc-aircraft-workshop v1"
const Modules := preload("res://physics/aircraft_modules.gd")
const PhysicalIdentity := preload("res://physics/physical_identity.gd")
const GENERATED_MARKER: String = "Generated by research/aircraft-editor/build_descriptors.py; do not edit."
const DEFAULT_ROOT: String = "res://data/workshop"
const MAX_DESCRIPTOR_BYTES: int = 1024 * 1024
const MAX_BASE_BYTES: int = 16 * 1024 * 1024
const MAX_JSON_DEPTH: int = 64
const MAX_JSON_NODES: int = 250000
const TOP_LEVEL_KEYS: PackedStringArray = [
	"_generated_do_not_edit",
	"format",
	"base_id",
	"base_sha256",
	"inventory_bindings",
	"modules",
	"presentation",
]
const BINDING_KEYS: PackedStringArray = ["key", "index", "name_sha256"]
const IDENTITY_BINDING_KEYS: PackedStringArray = ["key"]
const PRESENTATION_KEYS: PackedStringArray = ["visual_family", "model_manifest_sha256", "scale_root"]
const LEGACY_PRESENTATION_KEYS: PackedStringArray = ["visual_id", "scale_root"]


static func load_for(base_id: String, base_bytes: PackedByteArray, root: String = DEFAULT_ROOT) -> Dictionary:
	var errors := PackedStringArray()
	if not _valid_base_id(base_id):
		errors.append("Base aircraft ID is invalid.")
		return _result(false, errors)
	if not _safe_root(root):
		errors.append("Descriptor root must be a safe res:// or user:// directory.")
		return _result(false, errors)
	var path: String = root.path_join(base_id + ".json")
	var file: FileAccess = FileAccess.open(path, FileAccess.READ)
	if file == null:
		errors.append("Workshop descriptor could not be opened: %s." % error_string(FileAccess.get_open_error()))
		return _result(false, errors)
	var length: int = file.get_length()
	if length <= 0 or length > MAX_DESCRIPTOR_BYTES:
		file.close()
		errors.append("Workshop descriptor is empty or exceeds the size limit.")
		return _result(false, errors)
	var descriptor_bytes: PackedByteArray = file.get_buffer(length)
	var read_error: Error = file.get_error()
	file.close()
	if read_error != OK or descriptor_bytes.size() != length:
		errors.append("Workshop descriptor could not be read completely.")
		return _result(false, errors)
	var descriptor_text: String = descriptor_bytes.get_string_from_utf8()
	if descriptor_text.to_utf8_buffer() != descriptor_bytes:
		errors.append("Workshop descriptor is not valid UTF-8.")
		return _result(false, errors)
	var parser := JSON.new()
	var parse_error: Error = parser.parse(descriptor_text)
	if parse_error != OK:
		errors.append("Workshop descriptor JSON could not be parsed: %s." % parser.get_error_message())
		return _result(false, errors)
	return validate(parser.data, base_id, base_bytes)


static func validate(value: Variant, base_id: String, base_bytes: PackedByteArray) -> Dictionary:
	var errors := PackedStringArray()
	if not _valid_base_id(base_id):
		errors.append("Base aircraft ID is invalid.")
		return _result(false, errors)
	if base_bytes.is_empty() or base_bytes.size() > MAX_BASE_BYTES:
		errors.append("Base aircraft snapshot is empty or exceeds the size limit.")
		return _result(false, errors)
	var source_text: String = base_bytes.get_string_from_utf8()
	if source_text.to_utf8_buffer() != base_bytes:
		errors.append("Base aircraft snapshot is not valid UTF-8.")
		return _result(false, errors)
	var source_parser := JSON.new()
	var source_error: Error = source_parser.parse(source_text)
	if source_error != OK or typeof(source_parser.data) != TYPE_DICTIONARY:
		errors.append("Base aircraft snapshot must be a valid JSON object.")
		return _result(false, errors)
	var base: Dictionary = source_parser.data
	var tree_result: Dictionary = _validate_json_tree(base)
	if not bool(tree_result["ok"]):
		errors.append_array(tree_result["errors"])
		return _result(false, errors)
	if base.get("format", "") != "openrc-aircraft v2" or base.get("id", "") != base_id:
		errors.append("Base bytes do not identify the requested openrc-aircraft v2 source.")
		return _result(false, errors)
	if typeof(value) != TYPE_DICTIONARY:
		errors.append("Workshop descriptor must be a JSON object.")
		return _result(false, errors)
	var descriptor: Dictionary = value
	if not _has_exact_keys(descriptor, TOP_LEVEL_KEYS):
		errors.append("Workshop descriptor has missing or unsupported fields.")
		return _result(false, errors)
	if descriptor["_generated_do_not_edit"] != GENERATED_MARKER:
		errors.append("Workshop descriptor is missing its generated-file marker.")
	if descriptor["format"] not in [FORMAT, V2_FORMAT, LEGACY_FORMAT]:
		errors.append("Workshop descriptor format is unsupported.")
	if typeof(descriptor["base_id"]) != TYPE_STRING or descriptor["base_id"] != base_id:
		errors.append("Workshop descriptor base ID does not match the aircraft source.")
	var expected_base_hash: String = _sha256(base_bytes)
	if typeof(descriptor["base_sha256"]) != TYPE_STRING or descriptor["base_sha256"] != expected_base_hash:
		errors.append("Workshop descriptor source SHA-256 does not match the exact aircraft bytes.")
	var binding_result: Dictionary = _validate_bindings(descriptor["inventory_bindings"], base, str(descriptor["format"]))
	if not bool(binding_result["ok"]):
		errors.append_array(binding_result["errors"])
	var expected_modules: Dictionary = Modules.classify(base)
	if not bool(expected_modules["ok"]):
		errors.append_array(expected_modules["errors"])
	elif typeof(descriptor["modules"]) != TYPE_ARRAY or descriptor["modules"] != expected_modules["modules"]:
		errors.append("Workshop module assertions do not match the aircraft's declared capabilities.")
	var presentation_result: Dictionary = _validate_presentation(descriptor["presentation"], base_id, str(descriptor["format"]))
	if not bool(presentation_result["ok"]):
		errors.append_array(presentation_result["errors"])
	var descriptor_tree: Dictionary = _validate_json_tree(descriptor)
	if not bool(descriptor_tree["ok"]):
		errors.append_array(descriptor_tree["errors"])
	if not errors.is_empty():
		return _result(false, errors)
	return _result(true, errors, descriptor.duplicate(true))


static func _validate_bindings(value: Variant, base: Dictionary, format: String) -> Dictionary:
	if format == FORMAT:
		return _validate_identity_bindings(value, base)
	return _validate_legacy_bindings(value, base)


static func _validate_legacy_bindings(value: Variant, base: Dictionary) -> Dictionary:
	var errors := PackedStringArray()
	if base.has("physical_identity_version") or _has_physical_identity_metadata(base):
		errors.append("Stable physical identities require an openrc-aircraft-workshop v3 descriptor.")
		return {"ok": false, "errors": errors}
	if typeof(value) != TYPE_ARRAY:
		errors.append("Inventory bindings must be an array.")
		return {"ok": false, "errors": errors}
	var inventory: Variant = base.get("inventory", null)
	if typeof(inventory) != TYPE_ARRAY or value.size() != inventory.size():
		errors.append("Inventory bindings must cover the exact source inventory.")
		return {"ok": false, "errors": errors}
	var seen_keys: Dictionary = {}
	for index: int in range(value.size()):
		var binding: Variant = value[index]
		if typeof(binding) != TYPE_DICTIONARY or not _has_exact_keys(binding, BINDING_KEYS):
			errors.append("Inventory binding %d has missing or unsupported fields." % index)
			return {"ok": false, "errors": errors}
		if not _integer_number(binding["index"]) or int(binding["index"]) != index:
			errors.append("Inventory binding %d has a stale source index." % index)
			return {"ok": false, "errors": errors}
		var item: Variant = inventory[index]
		if typeof(item) != TYPE_DICTIONARY or typeof(item.get("name", null)) != TYPE_STRING or str(item["name"]).is_empty():
			errors.append("Source inventory item %d has no stable name." % index)
			return {"ok": false, "errors": errors}
		var expected_hash: String = _sha256(str(item["name"]).to_utf8_buffer())
		var expected_key: String = "inventory-%03d-%s" % [index, expected_hash.substr(0, 12)]
		if typeof(binding["name_sha256"]) != TYPE_STRING or binding["name_sha256"] != expected_hash or binding["key"] != expected_key:
			errors.append("Inventory binding %d is stale; its source name or stable key changed." % index)
			return {"ok": false, "errors": errors}
		if typeof(binding["key"]) != TYPE_STRING or seen_keys.has(binding["key"]):
			errors.append("Inventory binding keys must be unique strings.")
			return {"ok": false, "errors": errors}
		seen_keys[binding["key"]] = true
	return {"ok": true, "errors": errors}


static func _validate_identity_bindings(value: Variant, base: Dictionary) -> Dictionary:
	var errors := PackedStringArray()
	var identity_version: Variant = base.get("physical_identity_version", null)
	if not _integer_number(identity_version) or int(identity_version) != 1:
		errors.append("Stable inventory bindings require physical_identity_version integer 1.")
		return {"ok": false, "errors": errors}
	var identity_errors: PackedStringArray = PhysicalIdentity.validate(base)
	if not identity_errors.is_empty():
		errors.append_array(identity_errors)
		return {"ok": false, "errors": errors}
	var identity: Dictionary = PhysicalIdentity.describe(base)
	var source_indices: Variant = identity.get("inventory_index_by_id", null)
	var inventory: Variant = base.get("inventory", null)
	if typeof(source_indices) != TYPE_DICTIONARY or typeof(inventory) != TYPE_ARRAY:
		errors.append("Validated physical identities do not describe source inventory IDs.")
		return {"ok": false, "errors": errors}
	if typeof(value) != TYPE_ARRAY or value.size() != inventory.size():
		errors.append("Stable inventory bindings must cover the exact source inventory.")
		return {"ok": false, "errors": errors}
	var seen_keys: Dictionary = {}
	for index: int in range(value.size()):
		var binding: Variant = value[index]
		if typeof(binding) != TYPE_DICTIONARY or not _has_exact_keys(binding, IDENTITY_BINDING_KEYS):
			errors.append("Stable inventory binding %d must contain only its key." % index)
			return {"ok": false, "errors": errors}
		var key_value: Variant = binding["key"]
		if typeof(key_value) != TYPE_STRING or not _valid_inventory_id(str(key_value)):
			errors.append("Stable inventory binding %d has an invalid ID key." % index)
			return {"ok": false, "errors": errors}
		var key: String = key_value
		if seen_keys.has(key):
			errors.append("Stable inventory binding IDs must be unique.")
			return {"ok": false, "errors": errors}
		if not source_indices.has(key):
			errors.append("Stable inventory binding '%s' does not resolve in the source snapshot." % key)
			return {"ok": false, "errors": errors}
		seen_keys[key] = true
	if seen_keys.size() != source_indices.size():
		errors.append("Stable inventory bindings are missing one or more source IDs.")
		return {"ok": false, "errors": errors}
	return {"ok": true, "errors": errors}


## Resolve a validated v3 binding against the exact source snapshot by authored ID.
## The returned index is source-local and may change when the source inventory is reordered.
static func resolve_inventory_index(descriptor: Dictionary, key: String, base: Dictionary) -> int:
	if str(descriptor.get("format", "")) != FORMAT:
		return -1
	var checked: Dictionary = _validate_identity_bindings(descriptor.get("inventory_bindings", null), base)
	if not bool(checked.get("ok", false)):
		return -1
	var identity: Dictionary = PhysicalIdentity.describe(base)
	var indices: Dictionary = identity.get("inventory_index_by_id", {})
	if not indices.has(key):
		return -1
	return int(indices[key])


static func _valid_inventory_id(value: String) -> bool:
	if value.is_empty() or value.length() > 80:
		return false
	var previous_was_underscore: bool = false
	for index: int in range(value.length()):
		var code: int = value.unicode_at(index)
		var letter: bool = code >= 97 and code <= 122
		var digit: bool = code >= 48 and code <= 57
		if index == 0 and not letter:
			return false
		if code == 95:
			if previous_was_underscore or index == value.length() - 1:
				return false
			previous_was_underscore = true
		elif letter or digit:
			previous_was_underscore = false
		else:
			return false
	return true


static func _has_physical_identity_metadata(base: Dictionary) -> bool:
	var inventory: Variant = base.get("inventory", [])
	if typeof(inventory) == TYPE_ARRAY:
		for item: Variant in inventory:
			if item is Dictionary and item.has("id"):
				return true
	var gear: Variant = base.get("landing_gear", {})
	if gear is Dictionary and gear.get("contacts", []) is Array:
		for item: Variant in gear.contacts:
			if item is Dictionary and item.has("id"):
				return true
	var propulsion: Variant = base.get("propulsion", {})
	var controls: Variant = base.get("controls", {})
	return (propulsion is Dictionary and propulsion.has("id")) or base.has("crash_hull_ids") \
		or (controls is Dictionary and controls.has("surface_ids"))


## Structural validation deliberately does not resolve live dependencies: old saved variants stay readable.
static func _validate_presentation(value: Variant, base_id: String, format: String) -> Dictionary:
	var errors := PackedStringArray()
	var legacy: bool = format == LEGACY_FORMAT
	var keys: PackedStringArray = LEGACY_PRESENTATION_KEYS if legacy else PRESENTATION_KEYS
	if typeof(value) != TYPE_DICTIONARY or not _has_exact_keys(value, keys):
		errors.append("Workshop presentation has missing or unsupported fields.")
		return {"ok": false, "errors": errors}
	if legacy:
		if typeof(value["visual_id"]) != TYPE_STRING or value["visual_id"] != base_id:
			errors.append("Workshop visual ID must match the catalog aircraft identity.")
	else:
		if typeof(value["visual_family"]) != TYPE_STRING or not _valid_base_id(value["visual_family"]):
			errors.append("Workshop visual family must be a stable model identity.")
		if typeof(value["model_manifest_sha256"]) != TYPE_STRING or not _valid_sha256(value["model_manifest_sha256"]):
			errors.append("Workshop model manifest must have a SHA-256 binding.")
	if typeof(value["scale_root"]) != TYPE_STRING or value["scale_root"] != "airplane":
		errors.append("Workshop scale root must be the stable airplane node.")
	return {"ok": errors.is_empty(), "errors": errors}


## Recheck at trial preparation, never while merely listing saved variants or on a physics tick.
## v1 retains its historical catalog resolution; v2 additionally pins the exact generated model manifest.
static func verify_presentation(descriptor: Dictionary) -> Dictionary:
	var catalog: Script = load("res://app_state/aircraft_catalog.gd")
	var registry: Script = load("res://aircraft/model_registry.gd")
	var base_id: String = str(descriptor.get("base_id", ""))
	var format: String = str(descriptor.get("format", ""))
	var presentation: Variant = descriptor.get("presentation", {})
	var shape: Dictionary = _validate_presentation(presentation, base_id, format)
	if not shape.ok or format not in [FORMAT, V2_FORMAT, LEGACY_FORMAT]:
		return {ok = false, errors = PackedStringArray(["Invalid Workshop presentation contract."])}
	var family: String = catalog.visual_family(base_id) if format == LEGACY_FORMAT else str(presentation.visual_family)
	if family.is_empty():
		return {ok = false, errors = PackedStringArray(["No model family is registered for this saved aircraft."])}
	if format in [FORMAT, V2_FORMAT]:
		var current_family: String = catalog.visual_family(base_id)
		if not current_family.is_empty() and current_family != family:
			return {ok = false, errors = PackedStringArray(["The saved visual family differs from the registered aircraft model."])}

	var result: Dictionary = registry.describe(family)
	if not result.get("ok", false):
		return result
	if format in [FORMAT, V2_FORMAT] and result.manifest_sha256 != presentation.model_manifest_sha256:
		return {ok = false, errors = PackedStringArray(["The saved model manifest is missing or changed; the saved variant remains unchanged."])}
	return {ok = true, errors = PackedStringArray(), manifest = result.manifest, manifest_sha256 = result.manifest_sha256}


static func _valid_sha256(value: String) -> bool:
	if value.length() != 64:
		return false
	for character: String in value:
		if character not in "0123456789abcdef":
			return false
	return true


static func _validate_json_tree(value: Variant, depth: int = 0, budget: Dictionary = {}) -> Dictionary:
	var errors := PackedStringArray()
	if budget.is_empty():
		budget["remaining"] = MAX_JSON_NODES
	if depth > MAX_JSON_DEPTH:
		errors.append("JSON document exceeds the maximum nesting depth.")
		return {"ok": false, "errors": errors}
	budget["remaining"] = int(budget["remaining"]) - 1
	if int(budget["remaining"]) < 0:
		errors.append("JSON document exceeds the maximum node count.")
		return {"ok": false, "errors": errors}
	match typeof(value):
		TYPE_NIL, TYPE_BOOL, TYPE_INT, TYPE_STRING:
			return {"ok": true, "errors": errors}
		TYPE_FLOAT:
			if not is_finite(float(value)):
				errors.append("JSON document contains a non-finite number.")
		TYPE_ARRAY:
			for item: Variant in value:
				var nested: Dictionary = _validate_json_tree(item, depth + 1, budget)
				if not bool(nested["ok"]):
					errors.append_array(nested["errors"])
					break
		TYPE_DICTIONARY:
			for key: Variant in value.keys():
				if typeof(key) != TYPE_STRING:
					errors.append("JSON object keys must be strings.")
					break
				var nested: Dictionary = _validate_json_tree(value[key], depth + 1, budget)
				if not bool(nested["ok"]):
					errors.append_array(nested["errors"])
					break
		_:
			errors.append("JSON document contains a non-JSON value.")
	return {"ok": errors.is_empty(), "errors": errors}


static func _safe_root(root: String) -> bool:
	if not (root.begins_with("res://") or root.begins_with("user://")) or root.contains("\\"):
		return false
	var relative: String = root.substr(root.find("://") + 3)
	if relative.is_empty() or relative.contains(":"):
		return false
	for segment: String in relative.split("/", false):
		if segment.is_empty() or segment == "." or segment == "..":
			return false
	return true


static func _valid_base_id(value: String) -> bool:
	if value.is_empty() or value.length() > 128:
		return false
	for index: int in range(value.length()):
		var code: int = value.unicode_at(index)
		var valid: bool = (code >= 48 and code <= 57) or (code >= 97 and code <= 122) or code == 45 or code == 95 or code == 46
		if index == 0 and not ((code >= 48 and code <= 57) or (code >= 97 and code <= 122)):
			return false
		if not valid:
			return false
	return true


static func _integer_number(value: Variant) -> bool:
	if typeof(value) == TYPE_INT:
		return true
	if typeof(value) != TYPE_FLOAT or not is_finite(float(value)):
		return false
	return floor(float(value)) == float(value)


static func _has_exact_keys(value: Dictionary, keys: PackedStringArray) -> bool:
	if value.size() != keys.size():
		return false
	return value.has_all(keys)


static func _sha256(bytes: PackedByteArray) -> String:
	var context := HashingContext.new()
	if context.start(HashingContext.HASH_SHA256) != OK:
		return ""
	context.update(bytes)
	return context.finish().hex_encode()


static func _result(ok: bool, errors: PackedStringArray, descriptor: Dictionary = {}) -> Dictionary:
	return {"ok": ok, "errors": errors, "descriptor": descriptor}
