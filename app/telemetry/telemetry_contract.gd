## TELEM-02: the client half of the v1 telemetry wire contract. The canonical schema is generated by
## research/telemetry/generate_contracts.py (contracts/batch.schema.json); test_telemetry_contract.gd keeps the two in
## step. Every object is closed: this file builds and checks only the listed keys, never a sanitized copy of
## anything wider. Pure functions; no I/O, hardware probe or network.
extends RefCounted

const SCHEMA_VERSION := 1
## Changing the notice text, recipients or data categories requires a new identifier (and a new grant).
const NOTICE_VERSION := "2026-11-18"
const ENGINE_MINOR := "4.8"
const MAX_BODY_BYTES := 32768
const MAX_EVENTS := 16
const MAX_SEQ := 1000000
const HISTOGRAM_UPPER_US: Array[int] = [8333, 16667, 33333, 50000, 100000, 250000, 1000000, 5000000]
const WINDOW_COMPLETE_US := 30000000
const WINDOW_HARD_US := 60000000
const WINDOW_MAX_COUNT := 60000
const WINDOW_MAX_FRAMES := 60000
const GAP_EXCLUDE_US := 5000000
const MAX_EXCLUDED := 1000
const ACTIVITY_MAX_ACTIVE_S := 1800
const ACTIVITY_MAX_SIMULATED_S := 3600
const ACTIVITY_MAX_COUNT := 1000
const ERROR_MAX_COUNT := 1000

const FIXED_WING_VEHICLES: Array[String] = [
	"jensen-das-ugly-stik-60", "stik-electric-6s", "gp-extra-300s-60", "p51d-mustang-120",
	"f4u-corsair-250", "sebart-avanti-s-a200-p100rx", "turbo-lumber-evolution", "moonrunner-x99",
]
## Stock vehicles the receiver accepts. A new stock vehicle needs a schema change first; until then it is "unknown".
const STOCK_VEHICLES: Array[String] = [
	"jensen-das-ugly-stik-60", "stik-electric-6s", "gp-extra-300s-60", "p51d-mustang-120",
	"f4u-corsair-250", "sebart-avanti-s-a200-p100rx", "turbo-lumber-evolution", "moonrunner-x99",
	"xcell-60-research", "openrc-fpv5-x1", "rc-blimp-5m", "mt8-bisonte", "monster-car-2",
]
const MODES: Array[String] = ["home", "flight", "workshop", "other"]
const PHASES: Array[String] = ["warmup", "steady"]
const OUTCOMES: Array[String] = ["returned_home", "reset", "interrupted", "slice", "unknown"]
const ERROR_CATEGORIES: Array[String] = ["renderer_unavailable", "asset_load_failed", "aircraft_validation_failed",
	"simulation_fault"]
const GPU_STATUSES: Array[String] = ["not_measured", "zero_ambiguous", "positive_freshness_unverified", "invalid_reading"]
const CHANNELS: Array[String] = ["stable", "preview"]
## Context keys in wire order with their closed value sets.
const CONTEXT_KEYS: Array[String] = ["os_family", "architecture", "cpu_family", "logical_threads_bucket",
	"ram_gib_bucket", "gpu_family", "renderer", "driver", "resolution_class", "resolution_basis", "vsync",
	"fps_cap_bucket", "graphics_profile", "input_class"]
const CONTEXT_VALUES := {
	"os_family": ["windows", "macos", "linux", "other", "unknown"],
	"architecture": ["x86_64", "arm64", "other", "unknown"],
	"cpu_family": ["intel_core", "amd_ryzen", "apple_silicon", "other", "unknown"],
	"logical_threads_bucket": ["le4", "5_8", "9_16", "17_plus", "unknown"],
	"ram_gib_bucket": ["le4", "5_8", "9_16", "17_32", "33_64", "65_plus", "unknown"],
	"gpu_family": ["nvidia_gtx", "nvidia_rtx", "amd_radeon", "intel_arc", "intel_integrated", "apple_silicon",
		"software", "other", "unknown"],
	"renderer": ["gl_compatibility", "mobile", "forward_plus", "unknown"],
	"driver": ["opengl3", "opengl3_es", "opengl3_angle", "metal", "vulkan", "d3d12", "unknown"],
	"resolution_class": ["below1080p", "1080p", "1440p", "2160p", "above2160p", "other", "unknown"],
	"resolution_basis": ["viewport_coordinates", "native_drawable_verified", "unknown"],
	"vsync": ["off", "on", "adaptive", "mailbox", "unknown"],
	"fps_cap_bucket": ["unlimited", "le30", "31_60", "61_120", "121_plus", "unknown"],
	"graphics_profile": ["current_default", "custom", "unknown"],
	"input_class": ["keyboard", "gamepad", "rc", "other", "unknown"],
}
## Identical to the schema pattern; "(?![\s\S])" (not "$") so a trailing newline cannot pass.
const RELEASE_PATTERN := "^v[0-9]{1,3}\\.[0-9]{1,3}\\.[0-9]{1,3}(-(alpha|beta|rc)\\.?[0-9]{1,3})?(?![\\s\\S])"
const ID_PATTERN := "^[0-9a-f]{32}$"

const PERFORMANCE_KEYS: Array[String] = ["name", "seq", "mode", "vehicle_id", "phase", "window_complete",
	"interval_count", "interval_sum_us", "rendered_frames", "draw_counter_status", "interval_histogram",
	"excluded_gap_count", "gpu_status", "gpu_ms"]
const ACTIVITY_KEYS: Array[String] = ["name", "seq", "vehicle_id", "active_seconds", "simulated_seconds", "outcome",
	"complete_observation", "classification", "takeoffs", "landings", "aircraft_crashes"]
const ERROR_KEYS: Array[String] = ["name", "seq", "category", "count"]


## A stock catalog/roster id, "custom" for player or Workshop content, otherwise "unknown". Never the raw string.
static func vehicle_id(raw: String, custom := false) -> String:
	if custom:
		return "custom"
	return raw if raw in STOCK_VEHICLES else "unknown"


## Whether `tag` is a published release identity the wire accepts (v0.2.8, v0.1.0-rc2, v0.1.9-beta.1).
static func valid_release(tag: String) -> bool:
	return tag.length() <= 32 and RegEx.create_from_string(RELEASE_PATTERN).search(tag) != null


static func random_id() -> String:
	return Crypto.new().generate_random_bytes(16).hex_encode()


static func session_started(seq: int) -> Dictionary:
	return {"name": "session_started", "seq": seq}


static func error_count(seq: int, category: String, count: int) -> Dictionary:
	return {"name": "error_count", "seq": seq, "category": category, "count": count}


## Compact UTF-8 JSON in construction order (the receiver re-parses; no canonical ordering is implied).
static func encode(batch: Dictionary) -> PackedByteArray:
	return JSON.stringify(batch, "", false).to_utf8_buffer()


## "" when `batch` satisfies the closed v1 schema plus the receiver's semantic rules, otherwise a fixed category.
## The receiver validates independently; this check keeps a client defect from ever leaving the machine.
static func check_batch(batch: Variant) -> String:
	if not batch is Dictionary:
		return "batch"
	var keys: Array[String] = ["schema_version", "notice_version", "session_id", "batch_id", "build", "context", "events"]
	if not _closed(batch, keys):
		return "batch_keys"
	if not _int_in(batch.schema_version, SCHEMA_VERSION, SCHEMA_VERSION) or not same_text(batch.notice_version, NOTICE_VERSION):
		return "version"
	for key: String in ["session_id", "batch_id"]:
		if typeof(batch[key]) != TYPE_STRING or RegEx.create_from_string(ID_PATTERN).search(batch[key]) == null:
			return key
	var build: Variant = batch.build
	if not _closed(build, ["release_id", "channel", "engine_minor"]) or typeof(build.release_id) != TYPE_STRING \
			or not valid_release(build.release_id) or not _string_in(build.channel, CHANNELS) \
			or not same_text(build.engine_minor, ENGINE_MINOR):
		return "build"
	var context_error := check_context(batch.context)
	if context_error != "":
		return context_error
	var events: Variant = batch.events
	if not events is Array or events.is_empty() or events.size() > MAX_EVENTS:
		return "events"
	var previous := 0
	for event: Variant in events:
		var error := check_event(event)
		if error != "":
			return error
		if int(event.seq) <= previous:
			return "sequence_order"
		previous = int(event.seq)
	if encode(batch).size() > MAX_BODY_BYTES:
		return "body_too_large"
	return ""


static func check_context(context: Variant) -> String:
	if not _closed(context, CONTEXT_KEYS):
		return "context_keys"
	for key: String in CONTEXT_KEYS:
		if typeof(context[key]) != TYPE_STRING or not context[key] in CONTEXT_VALUES[key]:
			return "context"
	return ""


static func check_event(event: Variant) -> String:
	if not event is Dictionary or typeof(event.get("name")) != TYPE_STRING:
		return "event"
	if not _int_in(event.get("seq"), 1, MAX_SEQ):
		return "seq"
	match str(event.name):
		"session_started":
			return "" if _closed(event, ["name", "seq"]) else "event_keys"
		"error_count":
			if not _closed(event, ERROR_KEYS) or not _string_in(event.category, ERROR_CATEGORIES) \
					or not _int_in(event.count, 1, ERROR_MAX_COUNT):
				return "error_count"
			return ""
		"performance_window":
			return _check_performance(event)
		"activity_summary":
			return _check_activity(event)
	return "event_name"


static func _check_performance(e: Dictionary) -> String:
	if not _closed(e, PERFORMANCE_KEYS):
		return "event_keys"
	if not _string_in(e.mode, MODES) or not _string_in(e.vehicle_id, ["none", "custom", "unknown"] + STOCK_VEHICLES) \
			or not _string_in(e.phase, PHASES) or typeof(e.window_complete) != TYPE_BOOL \
			or not _int_in(e.interval_count, 1, WINDOW_MAX_COUNT) or not _int_in(e.interval_sum_us, 1, WINDOW_HARD_US) \
			or not _int_in(e.excluded_gap_count, 0, MAX_EXCLUDED) or not _string_in(e.gpu_status, GPU_STATUSES):
		return "performance_window"
	if same_text(e.draw_counter_status, "observed"):
		if not _int_in(e.rendered_frames, 0, WINDOW_MAX_FRAMES):
			return "rendered_frames"
	elif not same_text(e.draw_counter_status, "unavailable") or typeof(e.rendered_frames) != TYPE_NIL:
		return "rendered_frames"
	if same_text(e.gpu_status, "positive_freshness_unverified"):
		if not typeof(e.gpu_ms) in [TYPE_INT, TYPE_FLOAT] or not is_finite(float(e.gpu_ms)) or float(e.gpu_ms) <= 0.0 \
				or float(e.gpu_ms) > 10000.0:
			return "gpu_ms"
	elif typeof(e.gpu_ms) != TYPE_NIL:
		return "gpu_ms"
	if e.window_complete and int(e.interval_sum_us) < WINDOW_COMPLETE_US:
		return "incomplete_window"
	var histogram: Variant = e.interval_histogram
	if not histogram is Array or histogram.size() != HISTOGRAM_UPPER_US.size():
		return "histogram"
	var count := 0
	var minimum := 0
	var maximum := 0
	var lower := 1
	for index: int in histogram.size():
		if not _int_in(histogram[index], 0, WINDOW_MAX_COUNT):
			return "histogram"
		count += int(histogram[index])
		minimum += int(histogram[index]) * lower
		maximum += int(histogram[index]) * HISTOGRAM_UPPER_US[index]
		lower = HISTOGRAM_UPPER_US[index] + 1
	if count != int(e.interval_count):
		return "histogram_count"
	if int(e.interval_sum_us) < minimum or int(e.interval_sum_us) > maximum:
		return "histogram_duration"
	return ""


static func _check_activity(e: Dictionary) -> String:
	if not _closed(e, ACTIVITY_KEYS):
		return "event_keys"
	if not _string_in(e.vehicle_id, ["custom", "unknown"] + STOCK_VEHICLES) \
			or not _int_in(e.active_seconds, 0, ACTIVITY_MAX_ACTIVE_S) \
			or not _int_in(e.simulated_seconds, 0, ACTIVITY_MAX_SIMULATED_S) or not _string_in(e.outcome, OUTCOMES) \
			or typeof(e.complete_observation) != TYPE_BOOL:
		return "activity_summary"
	if same_text(e.classification, "unsupported"):
		for key: String in ["takeoffs", "landings", "aircraft_crashes"]:
			if typeof(e[key]) != TYPE_NIL:
				return "activity_counts"
	elif same_text(e.classification, "accepted_fixed_wing"):
		if not str(e.vehicle_id) in FIXED_WING_VEHICLES:
			return "activity_classification"
		for key: String in ["takeoffs", "landings", "aircraft_crashes"]:
			if not _int_in(e[key], 0, ACTIVITY_MAX_COUNT):
				return "activity_counts"
	else:
		return "activity_classification"
	return ""


## Type-safe comparisons: GDScript raises (instead of answering false) when a bool or String is compared with a
## value of another type, so every untrusted fact goes through these and a wrong type simply fails closed.
static func is_true(value: Variant) -> bool:
	return typeof(value) == TYPE_BOOL and value


static func is_false(value: Variant) -> bool:
	return typeof(value) == TYPE_BOOL and not value


static func same_text(value: Variant, expected: String) -> bool:
	return typeof(value) in [TYPE_STRING, TYPE_STRING_NAME] and str(value) == expected


## Exactly `keys`, compared as strings (GDScript literal keys may be StringNames).
static func _closed(value: Variant, keys: Array[String]) -> bool:
	if not value is Dictionary or value.size() != keys.size():
		return false
	for key: String in keys:
		if not value.has(key):
			return false
	return true


static func _int_in(value: Variant, low: int, high: int) -> bool:
	return typeof(value) == TYPE_INT and int(value) >= low and int(value) <= high


static func _string_in(value: Variant, allowed: Array) -> bool:
	return typeof(value) == TYPE_STRING and value in allowed
