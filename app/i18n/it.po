msgstr "Raffica verticale ascendente (−8–8 m/s)"

msgid "Gust duration (0.5–20 s)"
msgstr "Durata della raffica (0,5–20 s)"

msgid "Gust period (0.5–120 s)"
msgstr "Intervallo tra raffiche (0,5–120 s)"

