msgstr "Densità"

msgid "Emission rate"
msgstr "Frequenza di emissione"

msgid "Palette phase offset"
msgstr "Sfasamento di fase della tavolozza"

msgid "Jet speed"
msgstr "Velocità del getto"

msgid "Dispersion"
msgstr "Dispersione"

