msgid "Wind speed (0–15 m/s)"
msgstr "Velocità del vento (0–15 m/s)"

msgid "Direction FROM (0–360°)"
msgstr "Direzione di provenienza (0–360°)"

msgid "Horizontal gust peak (0–8 m/s)"
msgstr "Picco della raffica orizzontale (0–8 m/s)"

