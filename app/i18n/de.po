msgstr "Herunterladen"

msgid "Hide"
msgstr "Ausblenden"

msgid "Opens the release page in your browser."
msgstr "Öffnet die Versionsseite im Browser."

msgid "Hides this notice until a newer version is published."
msgstr ""
"Blendet diesen Hinweis aus, bis eine neuere Version veröffentlicht wird."

