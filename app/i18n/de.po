msgstr "RMS Nord (0–3 m/s)"

msgid "East RMS (0–3 m/s)"
msgstr "RMS Ost (0–3 m/s)"

msgid "Up RMS (0–3 m/s)"
msgstr "RMS Aufwärts (0–3 m/s)"

msgid "Correlation time tau (0.2–30 s)"
msgstr "Korrelationszeit tau (0,2–30 s)"

