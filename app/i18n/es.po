# Spanish interface texts for OpenRC Simulator (UI-01d). English is the source language: msgid is the English text.
# Product, aircraft and field proper names are not translated. Keep placeholders (%s) and whole sentences.
# Add a language: copy this file to <code>.po, translate msgstr, list it in project.godot
# (internationalization/locale/translations) and in app_state/preferences.gd LANGUAGES.
msgid ""
msgstr ""
"Project-Id-Version: OpenRC Simulator\n"
"Language: es\n"
"MIME-Version: 1.0\n"
"Content-Type: text/plain; charset=UTF-8\n"
"Content-Transfer-Encoding: 8bit\n"
"Plural-Forms: nplurals=2; plural=(n != 1);\n"

msgid "development build"
msgstr "versión de desarrollo"

msgid "NEXT FLIGHT"
msgstr "PRÓXIMO VUELO"

msgid "Test field · Free flight"
msgstr "Campo de pruebas · Vuelo libre"

msgid "Starts in the air. A crash restarts the flight."
msgstr "Empieza en el aire. Un accidente reinicia el vuelo."

msgid "FLY"
msgstr "VOLAR"

msgid "Quit"
msgstr "Salir"

msgid "Language: %s"
msgstr "Idioma: %s"

msgid "CONTROLS"
msgstr "CONTROLES"

msgid "Keyboard — no radio connected."
msgstr "Teclado — sin radio conectada."

msgid "Radio “%s”. Lower the throttle to arm the engine. To fly with the keyboard, unplug it."
msgstr "Radio «%s». Baja el acelerador para habilitar el motor. Para volar con teclado, desconéctala."

msgid "Controller “%s”. Lower the throttle to arm the engine. To fly with the keyboard, unplug it."
msgstr "Mando «%s». Baja el acelerador para habilitar el motor. Para volar con teclado, desconéctalo."

msgid "Roll"
msgstr "Alabeo"

msgid "Pitch"
msgstr "Profundidad"

msgid "Rudder"
msgstr "Timón"

msgid "Throttle"
msgstr "Acelerador"

msgid "Could not save settings (error %d)."
msgstr "No se pudieron guardar los ajustes (error %d)."

msgid "Weather"
msgstr "Viento"

msgid "Turbulence"
msgstr "Turbulencia"

msgid "Calm"
msgstr "Calma"

msgid "%s m/s from %03.0f°"
msgstr "%s m/s desde %03.0f°"

msgid "gust %s m/s"
msgstr "racha %s m/s"

msgid "up %s m/s"
msgstr "ascenso %s m/s"

msgid "%s m/s · %03.0f°"
msgstr "%s m/s · %03.0f°"

msgid "Gust %s m/s"
msgstr "Racha %s m/s"

msgid "Updraft %s m/s"
msgstr "Corriente ascendente %s m/s"

msgid "Downdraft %s m/s"
msgstr "Corriente descendente %s m/s"

msgid "Uniform wind with smooth repeating gusts."
msgstr "Viento uniforme con rachas suaves y periódicas."

msgid "Wind is uniform across the field; optional turbulence changes smoothly over time."
msgstr "El viento es uniforme en todo el campo; la turbulencia opcional cambia suavemente con el tiempo."

msgid "Flight conditions"
msgstr "Condiciones de vuelo"

msgid "Uniform wind and smooth repeating gusts. No turbulence or spatial variation."
msgstr "Viento uniforme y rachas suaves y periódicas. Sin turbulencia ni variación espacial."

msgid "Uniform wind and repeating gusts with optional seeded turbulence."
msgstr "Viento uniforme y rachas periódicas con turbulencia opcional con semilla."

msgid "Seeded turbulence changes smoothly over time. RMS sets strength by direction; tau controls how quickly it changes."
msgstr "La turbulencia con semilla cambia suavemente con el tiempo. RMS indica la intensidad por dirección; tau controla su rapidez."

msgid "Uniform wind and repeating gusts, with optional seeded turbulence."
msgstr "Viento uniforme y rachas periódicas, con turbulencia opcional con semilla."

msgid "Enable turbulence"
msgstr "Activar turbulencia"

msgid "Wind & Gusts"
msgstr "Viento y rachas"

msgid "Preset"
msgstr "Preajuste"

msgid "Custom"
msgstr "Personalizado"

msgid "Cancel"
msgstr "Cancelar"

msgid "Apply"
msgstr "Aplicar"

msgid "Steady breeze"
msgstr "Brisa constante"

msgid "Crosswind"
msgstr "Viento cruzado"

msgid "Gusty"
msgstr "Racheado"

msgid "Updraft"
msgstr "Corriente ascendente"

msgid "ground speed %.1f m/s  wind %.1f m/s from %s  up %+.1f m/s"
msgstr "vel. suelo %.1f m/s  viento %.1f m/s desde %s  ascend. %+.1f m/s"

msgid "Wind speed (0–15 m/s)"
msgstr "Velocidad del viento (0–15 m/s)"

msgid "Direction FROM (0–360°)"
msgstr "Dirección DESDE (0–360°)"

msgid "Horizontal gust peak (0–8 m/s)"
msgstr "Pico de racha horizontal (0–8 m/s)"

msgid "Vertical gust, up (−8 to 8 m/s)"
msgstr "Racha vertical, hacia arriba (−8 a 8 m/s)"

msgid "Gust duration (0.5–20 s)"
msgstr "Duración de la racha (0.5–20 s)"

msgid "Gust period (0.5–120 s)"
msgstr "Periodo de la racha (0.5–120 s)"

msgid "North RMS (0–3 m/s)"
msgstr "RMS norte (0–3 m/s)"

msgid "East RMS (0–3 m/s)"
msgstr "RMS este (0–3 m/s)"

msgid "Up RMS (0–3 m/s)"
msgstr "RMS ascendente (0–3 m/s)"

msgid "Correlation time tau (0.2–30 s)"
msgstr "Tiempo de correlación tau (0,2–30 s)"

msgid "Seed (0–4294967295)"
msgstr "Semilla (0–4294967295)"

msgid "Turbulence RMS N/E/Up: %s / %s / %s m/s; tau %s s; seed %s"
msgstr "RMS de turbulencia N/E/arriba: %s / %s / %s m/s; tau %s s; semilla %s"

msgid "Turbulence practice"
msgstr "Práctica de turbulencia"

msgid "Enter valid numbers within the shown limits; gust period must be at least its duration."
msgstr "Introduce números válidos dentro de los límites indicados; el periodo debe ser al menos igual a la duración."

msgid "Enter values within the shown limits; gust period must be at least its duration. Seed must contain digits only."
msgstr "Introduce valores dentro de los límites indicados; el periodo debe ser al menos igual a la duración. La semilla solo puede contener dígitos."

msgid "Flights start in the air. Wind is uniform across the field; smooth gusts repeat on a timer. No turbulence or spatial variation. Wheel landings are experimental; a crash restarts the flight."
msgstr "El vuelo empieza en el aire. Viento uniforme y rachas suaves periódicas, sin turbulencia ni variación espacial. Los aterrizajes son experimentales; un accidente reinicia el vuelo."

msgid "Flights start in the air. Weather adds uniform wind, repeating gusts and seeded turbulence. Wheel landings are experimental; crashes restart the flight."
msgstr "Los vuelos empiezan en el aire. El clima añade viento uniforme, rachas periódicas y turbulencia con semilla. Los aterrizajes con ruedas son experimentales; los choques reinician el vuelo."

msgid "PAUSED"
msgstr "PAUSA"

msgid "Continue"
msgstr "Continuar"

msgid "Restart flight"
msgstr "Reiniciar vuelo"

msgid "End flight"
msgstr "Terminar vuelo"

msgid "This flight cannot continue: %s"
msgstr "Este vuelo no puede continuar: %s"

msgid "Crashed. The flight restarts by itself after you continue."
msgstr "Accidente. El vuelo se reinicia solo al continuar."

msgid "The radio was disconnected: engine at idle, sticks centred. Continue flies with the keyboard, or plug the radio back in."
msgstr "La radio se desconectó: motor al ralentí y mandos centrados. Continuar vuela con el teclado, o vuelve a conectar la radio."

msgid "Radio calibration cancelled; the previous profile stays."
msgstr "Calibración de la radio cancelada; se mantiene el perfil anterior."

msgid "Could not save the flight trace (error %d). Press End flight again to end without it."
msgstr "No se pudo guardar la traza del vuelo (error %d). Pulsa Terminar vuelo otra vez para terminar sin ella."

msgid "Could not save the flight trace (error %d). Press Quit again to quit without it."
msgstr "No se pudo guardar la traza del vuelo (error %d). Pulsa Salir otra vez para salir sin ella."

msgid "Help"
msgstr "Ayuda"

msgid "Close"
msgstr "Cerrar"

msgid "WHILE FLYING"
msgstr "DURANTE EL VUELO"

msgid "RADIO"
msgstr "RADIO"

msgid "RIGHT NOW"
msgstr "POR AHORA"

msgid "ABOUT"
msgstr "ACERCA DE"

msgid "Keys are shown as your keyboard layout prints them."
msgstr "Las teclas se muestran como las rotula tu distribución de teclado."

msgid "Connect an EdgeTX radio over USB (Model setup → USB Joystick: Advanced, Joystick). It flies while connected; the engine starts once the throttle stick has been low. Unplugging it pauses the flight with the engine at idle. K calibrates it."
msgstr "Conecta una radio EdgeTX por USB (Model setup → USB Joystick: Advanced, Joystick). Vuela mientras está conectada; el motor arranca cuando el acelerador ha estado abajo. Desconectarla pausa el vuelo con el motor al ralentí. K la calibra."

msgid "Pause menu (in the radio calibration: cancel it)"
msgstr "Menú de pausa (en la calibración: cancelarla)"

msgid "Restart the flight"
msgstr "Reiniciar el vuelo"

msgid "Resume after a radio failsafe"
msgstr "Reanudar tras un failsafe de la radio"

msgid "Camera: pilot view or close-up"
msgstr "Cámara: vista del piloto o de cerca"

msgid "Auto-zoom on or off"
msgstr "Autozoom sí o no"

msgid "Ground shadow: sun, vertical or off"
msgstr "Sombra en el suelo: sol, vertical o ninguna"

msgid "Record a flight trace (press again to save it)"
msgstr "Grabar una traza (otra vez: guardarla)"

msgid "Calibrate the radio"
msgstr "Calibrar la radio"

msgid "Next radio calibration step"
msgstr "Siguiente paso de la calibración de la radio"

msgid "Performance numbers"
msgstr "Cifras de rendimiento"

msgid "Reload the aircraft data file"
msgstr "Recargar el archivo de datos del avión"

msgid "Fly with the arrows"
msgstr "Vuela con las flechas"

msgid "Pause"
msgstr "Pausa"

msgid "Esc"
msgstr "Esc"

msgid "Enter"
msgstr "Intro"

msgid "Num Enter"
msgstr "Intro num."

msgid "Left arrow"
msgstr "Flecha izquierda"

msgid "Right arrow"
msgstr "Flecha derecha"

msgid "Up arrow"
msgstr "Flecha arriba"

msgid "Down arrow"
msgstr "Flecha abajo"

msgid "OpenRC Simulator %s (build %s, commit %s%s, %s)"
msgstr "OpenRC Simulator %s (build %s, commit %s%s, %s)"

msgid ", with local changes"
msgstr ", con cambios locales"

msgid "OpenRC Simulator %s, development build (run from the source tree)"
msgstr "OpenRC Simulator %s, versión de desarrollo (ejecutada desde el código fuente)"

msgid "MIT licence"
msgstr "licencia MIT"

msgid "Jensen Das Ugly Stik designed by Phil Kraft · font Open Sans (SIL OFL)"
msgstr "Jensen Das Ugly Stik diseñado por Phil Kraft · fuente Open Sans (SIL OFL)"

msgid "Aircraft %d of %d"
msgstr "Avión %d de %d"

msgid "Previous aircraft"
msgstr "Avión anterior"

msgid "Next aircraft"
msgstr "Avión siguiente"

msgid "High-wing sport trainer · 1.52 m · .61 glow"
msgstr "Entrenador deportivo de ala alta · 1,52 m · glow .61"

msgid "Low-wing aerobat · 1.63 m · .61 glow"
msgstr "Acrobático de ala baja · 1,63 m · glow .61"

msgid "Sport jet · 2.00 m · JetCat P100-RX turbine"
msgstr "Reactor deportivo · 2,00 m · turbina JetCat P100-RX"

msgid "Flight model under evaluation."
msgstr "Modelo de vuelo en evaluación."

msgid "Experimental: first physics estimate from the plans, not yet flight-tested."
msgstr "Experimental: primera estimación física a partir de los planos, aún sin contrastar en vuelo."

msgid "Experimental: first physics estimate (turbine, kit and owner data), not yet flight-tested. Flaps up, gear up: in-air start only."
msgstr "Experimental: primera estimación física (turbina, datos del kit y de propietarios), aún sin contrastar en vuelo. Flaps arriba, tren recogido: solo inicio en vuelo."

msgid "Preview only: turbine propulsion is not simulated yet."
msgstr "Solo vista previa: la propulsión por turbina aún no se simula."

msgid "The field could not be loaded."
msgstr "No se pudo cargar el campo."

msgid "Flight is unavailable. Restore the field data and restart the simulator."
msgstr "El vuelo no está disponible. Restaura los datos del campo y reinicia el simulador."

msgid "Start: in the air"
msgstr "Inicio: en el aire"

msgid "Start: runway (experimental)"
msgstr "Inicio: pista (experimental)"

msgid "Starts at idle on the runway. Experimental ground handling."
msgstr "Motor al ralentí en pista. Rodaje experimental."

msgid "Could not start flight: %s"
msgstr "No se pudo iniciar el vuelo: %s"
