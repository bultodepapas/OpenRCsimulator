msgstr "Temperatura (−20 a 45 °C)"

msgid "QNH (870 to 1085 hPa)"
msgstr "QNH (870 a 1085 hPa)"

msgid "Relative humidity (0 to 100%)"
msgstr "Umidade relativa (0 a 100%)"

