msgid "development build"
msgstr "versão de desenvolvimento"

msgid "Lighting"
msgstr "Iluminação"

msgid "Classic RC"
msgstr "RC clássico"

msgid "Night Radian"
msgstr "Night Radian"

msgid "Neon RGB"
msgstr "Neon RGB"

