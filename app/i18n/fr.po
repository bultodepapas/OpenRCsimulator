msgid "Start: helicopter pad"
msgstr "Départ : aire pour hélicoptère"

msgid "Choose a stopped rotor on the pad or a trimmed practice hover."
msgstr ""
"Sur l’aire, choisissez un départ avec le rotor à l’arrêt ou un vol "
"stationnaire d’entraînement avec le trim réglé."

msgid ""
"Experimental helicopter. On the pad: arm, release hold, wait for RPM, then "
"raise collective."
msgstr ""
"Hélicoptère expérimental. Sur l’aire : armez, démarrez le rotor avec H, "
"attendez qu’il atteigne son régime, puis augmentez le pas collectif."

msgid ""
"Experimental: X-Cell .60 reference physics with an HX-700 visual surrogate; "
"ground pad or practice hover; not flight-validated."
msgstr ""
"Expérimental : physique de référence X-Cell .60 avec substitut visuel HX-700"
" ; départ sur l’aire ou en vol stationnaire d’entraînement ; non validé en "
"vol."

msgid "Restart the selected helicopter start"
msgstr "Redémarrer le départ sélectionné de l’hélicoptère"

msgid "Arm / disarm helicopter motor"
msgstr "Armer / désarmer le moteur de l’hélicoptère"

msgid "Arm, then release hold"
msgstr "Armez, puis appuyez sur H pour démarrer le rotor."

msgid "Helicopter: arm / disarm"
msgstr "Hélicoptère : armer / désarmer"

msgid "Helicopter: toggle rotor hold"
msgstr "Hélicoptère : basculer le verrouillage moteur"

