msgstr "%s · heure locale %s · %s · %s · %s"

msgid "Check the time, date and location to preview the lighting phase."
msgstr ""
"Vérifiez l’heure, la date et le lieu pour afficher la phase d’éclairage."

msgid "Check the time, date and location."
msgstr "Vérifiez l’heure, la date et le lieu."

msgid "Fix the time and location before choosing a preset."
msgstr "Corrigez l’heure et le lieu avant de choisir un préréglage."

msgid "This preset is unavailable for the current date and location."
msgstr "Ce préréglage n’est pas disponible pour la date et le lieu actuels."

msgid "Enter a local time as HH:MM or HH:MM:SS."
msgstr "Saisissez l’heure locale au format HH:MM ou HH:MM:SS."

msgid "Lighting phase unavailable."
msgstr "Phase d’éclairage indisponible."

msgid "Invalid saved time-of-day settings; using legacy daylight."
msgstr ""
"Les paramètres d’heure enregistrés sont invalides ; la lumière du jour "
"classique sera utilisée."

msgid ""
"Flights start in the air. Wheel landings are experimental; a crash restarts "
"the flight. No wind yet."
msgstr ""
"Les vols commencent en l’air. Les atterrissages sur roues sont expérimentaux"
" ; un accident relance le vol. Pas encore de vent."

