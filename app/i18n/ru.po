msgstr "Службы контроллеров недоступны."

msgid "Controller profile storage is not available."
msgstr "Хранилище профилей контроллеров недоступно."

msgid "Could not load controller profiles: %s"
msgstr "Не удалось загрузить профили контроллеров: %s"

msgid "Controller profiles recovered: %s"
msgstr "Профили контроллеров восстановлены: %s"

msgid ""
"This profile is not a gamepad preset. Use legacy recovery to change its "
"controller semantics."
msgstr ""
"Этот профиль не является профилем геймпада. Используйте восстановление "
"старого профиля, чтобы изменить схему управления."

msgid "Could not restore the selected gamepad preset."
msgstr "Не удалось восстановить выбранный профиль геймпада."

msgid "Preset restored. Save the profile to keep this mapping."
msgstr "Профиль восстановлен. Сохраните его, чтобы оставить эту схему."

msgid "Profile duplicated. Save it to add a separate profile."
msgstr "Профиль продублирован. Сохраните копию как отдельный профиль."

msgid ""
"Live values are read only. No controller input reaches the aircraft from "
"this screen."
msgstr ""
"Текущие значения доступны только для чтения. С этого экрана команды "
"контроллера не передаются самолёту."

msgid ""
"Press a keyboard key or an input on the selected flight controller. Escape "
"cancels remapping."
msgstr ""
"Нажмите клавишу клавиатуры или элемент выбранного контроллера полёта. Escape"
" отменяет переназначение."

msgid "That binding conflicts with another action or removes recovery."
msgstr ""
"Это назначение конфликтует с другим действием или удаляет возможность "
"восстановления."

msgid "Binding updated. Save the profile to keep it."
msgstr "Назначение изменено. Сохраните профиль, чтобы оставить его."

msgid "Remapping cancelled."
msgstr "Переназначение отменено."

msgid "The flight controller changed; remapping was cancelled."
msgstr "Контроллер полёта изменился; переназначение отменено."

msgid "The selected flight controller disconnected; remapping was cancelled."
msgstr "Выбранный контроллер полёта отключился; переназначение отменено."

msgid "Finish or cancel remapping before saving."
msgstr "Завершите или отмените переназначение перед сохранением."

msgid "The selected menu controller is disconnected."
msgstr "Выбранный контроллер меню отключён."

msgid "The selected flight controller is disconnected."
msgstr "Выбранный контроллер полёта отключён."

msgid "Device selection applied. Profile changes still need Save."
msgstr "Устройства выбраны. Не забудьте сохранить изменения профиля."

msgid "There is no controller profile to save."
msgstr "Нет профиля контроллера для сохранения."

msgid "Apply the flight device selection before saving its profile."
msgstr "Перед сохранением профиля примените выбор устройства для полёта."

msgid "Enter a profile name before saving."
msgstr "Укажите название профиля перед сохранением."

msgid "Action bindings need a valid Back and Pause recovery path."
msgstr ""
"Для действий «Назад» и «Пауза» должны быть назначены команды восстановления."

msgid "Profile cannot be saved: %s"
msgstr "Не удалось сохранить профиль: %s"

msgid "Profile was not saved: %s"
msgstr "Профиль не сохранён: %s"

