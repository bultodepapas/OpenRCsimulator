msgstr "Переключить камеру"

msgid "Reset view"
msgstr "Сбросить вид"

msgid "Trim left"
msgstr "Триммер влево"

msgid "Trim right"
msgstr "Триммер вправо"

msgid "Trim up"
msgstr "Триммер вверх"

msgid "Trim down"
msgstr "Триммер вниз"

