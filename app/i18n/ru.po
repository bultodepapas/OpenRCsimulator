msgstr "Вверх"

msgid "Navigate down"
msgstr "Вниз"

msgid "Navigate left"
msgstr "Влево"

msgid "Navigate right"
msgstr "Вправо"

msgid "Pause / resume"
msgstr "Пауза / продолжить"

