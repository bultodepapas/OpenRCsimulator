msgstr "Насос дыма: включён"

msgid "Smoke pump: off"
msgstr "Насос дыма: выключен"

msgid "Toggle smoke pump"
msgstr "Переключить насос дыма"

msgid "Flaps up"
msgstr "Убрать закрылки"

msgid "Flaps down"
msgstr "Выпустить закрылки"

