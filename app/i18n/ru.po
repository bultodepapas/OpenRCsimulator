msgstr "Режим 1 · газ без автоцентрирования"

msgid "Mode 2 · rate throttle"
msgstr "Режим 2 · газ без автоцентрирования"

msgid "Trigger throttle"
msgstr "Газ на курке"

msgid "Mode 1: left X yaw, left Y pitch; right X roll, right Y throttle."
msgstr ""
"Режим 1: рыскание — X левого стика, тангаж — Y левого; крен — X правого, газ"
" — Y правого."

