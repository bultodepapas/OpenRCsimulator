msgstr ""
"Успешные посадки учитывают зарегистрированные касания поверхности; доля "
"полных остановок учитывает завершение каждого полёта."

msgid "No flight records in this view."
msgstr "В этом представлении нет записей о полётах."

msgid "Page %d of %d · %d records"
msgstr "Страница %d из %d · записей: %d"

msgid "Flight %d"
msgstr "Полёт %d"

msgid "Takeoffs %d · Full stops %d · Touch-and-go %d"
msgstr "Взлёты: %d · Посадки с остановкой: %d · Касание и взлёт: %d"

msgid "Coverage"
msgstr "Охват"

msgid "Scenario"
msgstr "Сценарий"

msgid "Events"
msgstr "События"

msgid ""
"Counters and history management are available while no flight is active."
msgstr ""
"Управлять счётчиками и историей можно только при отсутствии активного "
"полёта."

msgid "End the active flight before changing counters or history."
msgstr "Завершите текущий полёт, прежде чем менять счётчики или историю."

msgid "Some records are partial."
msgstr "Некоторые записи неполные."

msgid "Partial records: %d"
msgstr "Частичные записи: %d"

msgid "A flight is in progress."
msgstr "Полёт выполняется."

msgid "Flights in progress: %d"
msgstr "Полёты в процессе: %d"

