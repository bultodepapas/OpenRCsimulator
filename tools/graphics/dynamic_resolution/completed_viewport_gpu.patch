+void RendererViewport::_handle_gpu_timestamp(const String &p_timestamp, uint64_t p_cpu_time, uint64_t p_gpu_time) {
+	const bool is_begin = p_timestamp.begins_with("vp_drs_begin_");
+	const uint64_t tag = p_timestamp.get_slicec('_', 3).to_int();
+	GpuTimestampPair &pair = gpu_timestamp_history[tag % GPU_TIMESTAMP_HISTORY];
+	if (tag == 0 || pair.tag != tag) {
+		return;
+	}
+	if (is_begin) {
+		pair.batch = timestamp_batch;
+		pair.begin_gpu = p_gpu_time;
+		pair.begin_cpu = p_cpu_time;
+		return;
+	}
+	if (pair.batch != timestamp_batch || pair.begin_gpu == 0 || p_gpu_time <= pair.begin_gpu || p_cpu_time < pair.begin_cpu) {
+		return;
+	}
+	Viewport *viewport = viewport_owner.get_or_null(pair.viewport);
+	if (!viewport || !viewport->measure_render_time || !viewport->completed_gpu_sampling ||
+			viewport->gpu_configuration != pair.frame.generation) {
+		return;
+	}
+
+	// Keep the existing GPU/CPU time readers on the same completed interval.
+	viewport->time_cpu_begin = pair.begin_cpu;
+	viewport->time_cpu_end = p_cpu_time;
+	viewport->time_gpu_begin = pair.begin_gpu;
+	viewport->time_gpu_end = p_gpu_time;
+	if (pair.frame.input_size.x <= 0 || pair.frame.input_size.y <= 0 ||
+			pair.frame.output_size.x <= 0 || pair.frame.output_size.y <= 0) {
+		return;
+	}
+
+	MutexLock lock(gpu_frame_mutex);
+	const GpuFrame *previous = completed_gpu_frames.getptr(pair.viewport);
+	if (!previous || previous->frame_id < pair.frame.frame_id) {
+		pair.frame.recorded_usec = pair.begin_cpu;
+		pair.frame.gpu_usec = double(p_gpu_time - pair.begin_gpu) / 1000.0;
+		completed_gpu_frames.insert(pair.viewport, pair.frame);
+	}
+}
