diff --git a/servers/rendering/storage/metalfx_alpha_diagnostic.h b/servers/rendering/storage/metalfx_alpha_diagnostic.h
new file mode 100644
--- /dev/null
+++ b/servers/rendering/storage/metalfx_alpha_diagnostic.h
@@ -0,0 +1,33 @@
+// SPDX-License-Identifier: MIT
+// Bounded, value-only pages of the historical Forward+ alpha render list.
+#pragma once
+
+#include <array>
+#include <cstdint>
+
+template <typename Entry, uint32_t Capacity = 8>
+struct MetalFXAlphaSnapshot {
+	static_assert(Capacity > 0, "A diagnostic page must have a finite capacity");
+	std::array<Entry, Capacity> entries{};
+	uint64_t frame = 0;
+	uint32_t total = 0;
+	uint32_t offset = 0;
+	uint32_t count = 0;
+	uint32_t next_page = 0;
+
+	void begin(uint64_t p_frame, uint32_t p_total) {
+		frame = p_frame;
+		total = p_total;
+		count = 0;
+		const uint64_t pages = p_total ? (uint64_t(p_total) + Capacity - 1) / Capacity : 1;
+		if (next_page >= pages) { next_page = 0; }
+		offset = p_total ? uint32_t(uint64_t(next_page) * Capacity) : 0;
+		if (p_total && ++next_page >= pages) { next_page = 0; }
+	}
+	bool append(const Entry &p_entry) {
+		if (count >= Capacity || uint64_t(offset) + count >= total) { return false; }
+		entries[count++] = p_entry;
+		return true;
+	}
+	bool truncated() const { return total > count; }
+};
