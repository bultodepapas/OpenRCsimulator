+void RenderForwardClustered::_capture_metalfx_alpha_diagnostic(Ref<RenderSceneBuffersRD> p_buffers) {
+	// This is only called for an explicitly requested diagnostic after the
+	// ordinary rejection. It copies value identities, not live object pointers.
+	const auto &alpha = render_list[RENDER_LIST_ALPHA].elements;
+	if (alpha.is_empty()) { return; }
+	MetalFXAlphaDiagnostic *snapshot = p_buffers->begin_metalfx_alpha_diagnostic(RSG::rasterizer->get_frame_number(), alpha.size());
+	if (!snapshot) { return; }
+	auto &page = snapshot->page;
+	RendererRD::MeshStorage *meshes = RendererRD::MeshStorage::get_singleton();
+	RendererRD::ParticlesStorage *particles = RendererRD::ParticlesStorage::get_singleton();
+	for (uint32_t i = 0; i < 8 && uint64_t(page.offset) + i < page.total; ++i) {
+		const GeometryInstanceSurfaceDataCache *surface = alpha[page.offset + i];
+		MetalFXAlphaDiagnosticEntry entry;
+		if (surface) {
+			entry.surface = surface->surface_index;
+			entry.flags = surface->flags;
+			entry.mesh_local_index = surface->sort.geometry_id;
+			entry.shader_local_index = surface->sort.shader_id;
+			entry.material_from_alpha_pass = (surface->flags & GeometryInstanceSurfaceDataCache::FLAG_PASS_ALPHA) != 0;
+			if (surface->material) {
+				RID material = surface->material->get_diagnostic_rid();
+				uint32_t material_local = (uint32_t(surface->sort.material_id_hi) << 24) | uint32_t(surface->sort.material_id_lo);
+				if (material.is_valid() && material.get_local_index() == material_local) { entry.material = material; }
+			}
+			if (surface->shader) {
+				entry.shader_available = true;
+				entry.shader_path = surface->shader->path.length() > 256 ? surface->shader->path.substr(0, 256) : surface->shader->path;
+			}
+			const GeometryInstanceForwardClustered *owner = surface->owner;
+			if (owner && owner->data) {
+				entry.base = owner->data->base;
+				entry.base_type = uint32_t(owner->data->base_type);
+				entry.instance_count = owner->instance_count;
+				entry.world_bounds = owner->transformed_aabb;
+				RID mesh;
+				switch (owner->data->base_type) {
+					case RSE::INSTANCE_MESH:
+						mesh = entry.base;
+						break;
+					case RSE::INSTANCE_MULTIMESH:
+						mesh = meshes->multimesh_get_mesh(entry.base);
+						break;
+					case RSE::INSTANCE_PARTICLES: {
+						int passes = particles->particles_get_draw_passes(entry.base);
+						if (passes > 32) { entry.mesh_lookup_truncated = true; break; }
+						for (int pass = 0; pass < passes; ++pass) {
+							RID candidate = particles->particles_get_draw_pass_mesh(entry.base, pass);
+							if (candidate.is_null() || candidate.get_local_index() != entry.mesh_local_index ||
+									meshes->mesh_get_surface_count(candidate) <= int(entry.surface) ||
+									meshes->mesh_get_surface(candidate, entry.surface) != surface->surface) { continue; }
+							if (mesh.is_valid() && mesh != candidate) { mesh = RID(); break; }
+							mesh = candidate;
+						}
+					} break;
+					default:
+						break;
+				}
+				if (mesh.is_valid() && mesh.get_local_index() == entry.mesh_local_index &&
+						meshes->mesh_get_surface_count(mesh) > int(entry.surface) &&
+						meshes->mesh_get_surface(mesh, entry.surface) == surface->surface) {
+					entry.mesh = mesh;
+				}
+			}
+		}
+		page.append(entry);
+	}
+}
