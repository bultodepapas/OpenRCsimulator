+void RendererViewport::prepare_metalfx_shutdown() {
+#if defined(METAL_ENABLED) && defined(MACOS_ENABLED)
+	for (auto &source : mfx_sources) {
+		if (source) {
+			source->request_cancel();
+		}
+	}
+	for (RID id : viewport_owner.get_owned_list()) {
+		Viewport *viewport = viewport_owner.get_or_null(id);
+		if (viewport && viewport->render_buffers.is_valid()) {
+			viewport->render_buffers->set_metalfx_frame_composition_requested(false);
+		}
+	}
+#endif
+}
+
+void RendererViewport::finish_metalfx_shutdown() {
+#if defined(METAL_ENABLED) && defined(MACOS_ENABLED)
+	CRASH_COND_MSG(!mfx_sources_quiescent(), "MetalFX presentation source did not quiesce before renderer shutdown.");
+#endif
+}
