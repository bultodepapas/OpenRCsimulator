+bool RenderSceneBuffersRD::acquire_metalfx_pending_pair(uint64_t p_frame, MetalFXPendingPair &r_pair) {
+#if defined(METAL_ENABLED) && defined(MACOS_ENABLED)
+	if (!is_metalfx_frame_composition_requested() || mfx_composition_handoff < 0 || p_frame != mfx_composition_current_frame) {
+		return false;
+	}
+	MFXCompositionSlot &slot = mfx_composition_slots[mfx_composition_handoff];
+	if (!slot.submitted || !slot.eligible || !slot.state || slot.state->frame != p_frame || !slot.lease ||
+			!slot.state->presentation_proof || slot.state->presentation_proof->is_cancelled() ||
+			!slot.state->presentation_source || slot.state->presentation_source->is_cancelled() ||
+			slot.state->presentation_source != get_metalfx_presentation_source()) {
+		return false;
+	}
+	int free_index = -1;
+	for (int i = 0; i < 8; ++i) {
+		if (mfx_presentation_proofs[i].expired()) {
+			free_index = i;
+			break;
+		}
+	}
+	if (free_index < 0) {
+		return false; // Never evict a live proof just to admit another pair.
+	}
+	RendererRD::TextureStorage *storage = RendererRD::TextureStorage::get_singleton();
+	RID generated = storage->render_target_get_rd_texture(slot.generated_target);
+	RID real = storage->render_target_get_rd_texture(slot.real_target);
+	if (!generated.is_valid() || !real.is_valid() || generated == real) {
+		return false;
+	}
+	auto ticket = OpenRCMetalPresent::Ticket::acquire(slot.lease);
+	if (!ticket) {
+		return false;
+	}
+	r_pair.generated_texture = generated;
+	r_pair.real_texture = real;
+	r_pair.real_interval = slot.state->real_interval;
+	r_pair.proof = slot.state->presentation_proof;
+	r_pair.ticket = ticket;
+	mfx_presentation_proofs[free_index] = r_pair.proof;
+	mfx_composition_handoff = -1;
+	return true;
+#else
+	return false;
+#endif
 }
 
