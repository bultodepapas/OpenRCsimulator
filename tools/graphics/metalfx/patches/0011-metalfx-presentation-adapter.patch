+// Source generations can outlive a viewport. Keep canceled generations until
+// their presenter critical section is quiescent before publishing any new
+// main-window output, including a real-only frame. Admission is bounded.
+static std::shared_ptr<OpenRCMetalPresent::SourceGeneration> mfx_sources[4];
+static bool mfx_sources_quiescent() {
+	for (auto &source : mfx_sources) {
+		if (source && source->is_cancelled()) {
+			if (!source->try_cancel_complete()) {
+				return false;
+			}
+			source.reset();
+		}
+	}
+	return true;
+}
+static std::shared_ptr<OpenRCMetalPresent::SourceGeneration> mfx_new_source() {
+	if (!mfx_sources_quiescent()) {
+		return {};
+	}
+	for (auto &source : mfx_sources) {
+		if (source && !source->is_cancelled()) {
+			return source; // One source generation covers the whole main window.
+		}
+	}
+	for (auto &source : mfx_sources) {
+		if (!source) {
+			source = std::make_shared<OpenRCMetalPresent::SourceGeneration>();
+			return source;
+		}
+	}
+	return {};
