+void RenderSceneBuffersRD::collect_metalfx_retired_slots() {
+	RendererRD::TextureStorage *storage = RendererRD::TextureStorage::get_singleton();
+	for (int i = mfx_retired_composition_slots.size() - 1; i >= 0; --i) {
+		MFXRetiredCompositionSlot &slot = mfx_retired_composition_slots.write[i];
+		if (slot.lease && slot.lease->held.load(std::memory_order_acquire)) {
+			continue;
+		}
+		storage->render_target_free(slot.generated_target);
+		storage->render_target_free(slot.real_target);
+		mfx_retired_composition_slots.remove_at(i);
+		--mfx_live_composition_slots;
+	}
+}
+
+void RenderSceneBuffersRD::finalize_metalfx_retirements() {
+	// The compositor has already flushed the RD graph and stopped its owner.
+	// Completion handlers may run shortly after the fence wakes; never free a
+	// held source or let an old-owner RID enter a later renderer generation.
+	for (int i = 0; i < 200 && mfx_live_composition_slots; ++i) {
+		collect_metalfx_retired_slots();
+		if (mfx_live_composition_slots) {
+			OS::get_singleton()->delay_usec(1000);
+		}
+	}
+	CRASH_COND_MSG(mfx_live_composition_slots != 0 || !mfx_retired_composition_slots.is_empty(), "MetalFX source tickets did not retire before renderer shutdown.");
+}
+#endif
 
