+// Collected under the scheduler lock, released only after that lock is gone.
+// At most four occupied slots can be retired by one locked operation.
+struct Retired {
+	std::array<std::shared_ptr<void>, 4> leases;
+	unsigned count = 0;
+	void keep(std::shared_ptr<void> &p_lease) {
+		if (!p_lease) { return; }
+		if (count >= leases.size()) { std::terminate(); }
+		leases[count++] = std::move(p_lease);
+	}
+	void clear() { for (unsigned i = 0; i < count; ++i) { leases[i].reset(); } count = 0; }
+};
