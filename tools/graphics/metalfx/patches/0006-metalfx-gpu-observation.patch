index 0000000000000000000000000000000000000000..375d5e760b04ea0f32edacdc17128860b5f4f74b
--- /dev/null
+++ b/servers/rendering/storage/metalfx_gpu_observation.h
@@ -0,0 +1,96 @@
+// SPDX-License-Identifier: MIT
+// Optional command-buffer observations. No viewport, renderer or Metal object
+// is retained here; completion handlers hold only this generation's shared state.
+#pragma once
+
+#include <cmath>
+#include <cstdint>
+#include <limits>
+#include <mutex>
+
+struct MetalFXGPUObservation {
+	static constexpr uint64_t MAX_COUNTER = uint64_t(std::numeric_limits<int64_t>::max());
+	struct Sample {
+		uint64_t ticket = 0;
+		uint64_t frame = 0;
+		uint64_t epoch = 0;
+		uint64_t reset_serial = 0;
+		int64_t command_status = 0;
+		bool error_present = false;
+		int64_t error_code = 0;
+		bool succeeded = false;
+		bool gpu_timing_available = false;
+		double gpu_start_seconds = 0;
+		double gpu_end_seconds = 0;
+		uint64_t callback_observer_usec = 0;
+	};
+	struct Snapshot {
+		Sample encoded;
+		Sample completed;
+		Sample first_observed_failure;
+		uint64_t reset_completed_serial = 0;
+		bool counter_exhausted = false;
+		bool unexpected_callback = false;
+	};
+
+private:
+	mutable std::mutex mutex;
+	Snapshot observation;
+
+public:
+	Sample encoded(uint64_t p_frame, uint64_t p_epoch = 0, uint64_t p_reset_serial = 0) {
+		std::lock_guard<std::mutex> guard(mutex);
+		if (observation.counter_exhausted || observation.encoded.ticket == MAX_COUNTER || p_frame > MAX_COUNTER || p_epoch > MAX_COUNTER || p_reset_serial > MAX_COUNTER) {
+			observation.counter_exhausted = true;
+			return Sample();
+		}
+		Sample sample;
+		sample.ticket = observation.encoded.ticket + 1;
+		sample.frame = p_frame;
+		sample.epoch = p_epoch;
+		sample.reset_serial = p_reset_serial;
+		observation.encoded = sample;
+		return sample;
+	}
+
+	// A later callback may arrive first. The greatest observed ticket is not a
+	// count of all completed buffers or a contiguous completion fence. Failures
+	// remain latched even when an earlier ticket arrives after a later success.
+	bool completed(Sample p_sample, bool p_terminal, bool p_succeeded, int64_t p_status,
+			bool p_error_present, int64_t p_error_code, double p_gpu_start, double p_gpu_end, uint64_t p_callback_usec) {
+		std::lock_guard<std::mutex> guard(mutex);
+		if (!p_sample.ticket || p_sample.ticket > observation.encoded.ticket) {
+			return false;
+		}
+		if (!p_terminal) {
+			observation.unexpected_callback = true;
+			return false;
+		}
+		p_sample.command_status = p_status;
+		p_sample.error_present = p_error_present;
+		p_sample.error_code = p_error_code;
+		p_sample.succeeded = p_succeeded && !p_error_present;
+		p_sample.callback_observer_usec = p_callback_usec <= MAX_COUNTER ? p_callback_usec : 0;
+		p_sample.gpu_timing_available = p_sample.succeeded && std::isfinite(p_gpu_start) && std::isfinite(p_gpu_end) &&
+				p_gpu_start > 0 && p_gpu_end >= p_gpu_start && std::isfinite((p_gpu_end - p_gpu_start) * 1000.0);
+		if (p_sample.gpu_timing_available) {
+			p_sample.gpu_start_seconds = p_gpu_start;
+			p_sample.gpu_end_seconds = p_gpu_end;
+		}
+		if (!p_sample.succeeded && !observation.first_observed_failure.ticket) {
+			observation.first_observed_failure = p_sample;
+		}
+		if (p_sample.succeeded && p_sample.reset_serial > observation.reset_completed_serial) {
+			observation.reset_completed_serial = p_sample.reset_serial;
+		}
+		if (p_sample.ticket > observation.completed.ticket) {
+			observation.completed = p_sample;
+		}
+		return true;
+	}
+
+	Snapshot snapshot() const {
+		std::lock_guard<std::mutex> guard(mutex);
+		return observation;
+	}
