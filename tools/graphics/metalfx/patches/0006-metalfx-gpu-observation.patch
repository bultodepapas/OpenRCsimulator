+// Registered only by an explicit per-viewport observation request. Capture no
+// Godot owner or driver pointer: the shared generation may outlive its viewport.
+static void mfx_observe_gpu(MTL::CommandBuffer *p_command, const std::shared_ptr<MetalFXGPUObservation> &p_state,
+		uint64_t p_frame, uint64_t p_epoch = 0, uint64_t p_reset_serial = 0) {
+	if (!p_state || !p_command) {
+		return;
+	}
+	MetalFXGPUObservation::Sample sample = p_state->encoded(p_frame, p_epoch, p_reset_serial);
+	if (!sample.ticket) {
+		return;
+	}
+	p_command->addCompletedHandler([state = p_state, sample](MTL::CommandBuffer *command) {
+		MTL::CommandBufferStatus status = command->status();
+		NS::Error *error = command->error();
+		bool terminal = status == MTL::CommandBufferStatusCompleted || status == MTL::CommandBufferStatusError;
+		bool succeeded = status == MTL::CommandBufferStatusCompleted && !error;
+		double gpu_start = succeeded ? command->GPUStartTime() : 0;
+		double gpu_end = succeeded ? command->GPUEndTime() : 0;
+		auto ticks = std::chrono::duration_cast<std::chrono::microseconds>(std::chrono::steady_clock::now().time_since_epoch()).count();
+		uint64_t observer_usec = ticks > 0 && uint64_t(ticks) <= MetalFXGPUObservation::MAX_COUNTER ? uint64_t(ticks) : 0;
+		state->completed(sample, terminal, succeeded, int64_t(status), error != nullptr,
+				error ? int64_t(error->code()) : 0, gpu_start, gpu_end, observer_usec);
+	});
+}
