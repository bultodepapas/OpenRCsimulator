+void RendererViewport::viewport_set_metalfx_gpu_observation_requested(RID p_viewport, bool p_enabled) {
+	Viewport *viewport = viewport_owner.get_or_null(p_viewport);
+	ERR_FAIL_NULL(viewport);
+	if (viewport->metal_fx_gpu_observation_requested == p_enabled) {
+		return;
+	}
+	viewport->metal_fx_gpu_observation_requested = p_enabled;
+	if (viewport->render_buffers.is_valid()) {
+		viewport->render_buffers->set_metalfx_gpu_observation_requested(p_enabled);
+	}
+}
+
+Dictionary RendererViewport::viewport_get_metalfx_gpu_status(RID p_viewport) const {
+	Viewport *viewport = viewport_owner.get_or_null(p_viewport);
+	ERR_FAIL_NULL_V(viewport, Dictionary());
+	Dictionary result;
+	if (viewport->render_buffers.is_valid()) {
+		result = viewport->render_buffers->get_metalfx_gpu_status();
+	}
+	result["requested_by_caller"] = viewport->metal_fx_gpu_observation_requested;
+	result["viewport_generation"] = int64_t(viewport->metal_fx_generation);
+	result["frame_generation"] = int64_t(viewport->metal_fx_frame_generation);
+	result["render_buffers_available"] = viewport->render_buffers.is_valid();
+	return result;
+}
