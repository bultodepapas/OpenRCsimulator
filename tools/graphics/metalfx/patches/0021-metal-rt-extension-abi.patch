+	void set_##m_member##_checked(int64_t p_##m_member) { base.m_member = p_##m_member; }
+
+#define RD_BIND_CHECKED(m_class, m_member, m_maximum) \
+	rd_bind_checked_integer(m_class::get_class_static(), "set_" _MKSTR(m_member), \
+			&m_class::set_##m_member, &m_class::set_##m_member##_checked, m_maximum, "p_" _MKSTR(member)); \
+	ClassDB::bind_method(D_METHOD("get_" _MKSTR(m_member)), &m_class::get_##m_member); \
+	ADD_PROPERTY(PropertyInfo(Variant::INT, #m_member), "set_" _MKSTR(m_member), "get_" _MKSTR(m_member))
+
 #define RD_SETGET(m_type, m_member) \
