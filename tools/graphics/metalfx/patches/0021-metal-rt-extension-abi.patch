+// Keep the upstream unsigned GDExtension signature while retaining full
+// Variant integers until the existing acceleration-structure checks run.
+// Godot's ptrcall ABI transports uint8, uint32 and int64 as int64 slots.
+class RDCheckedIntegerMethodBind final : public MethodBind {
+	MethodBind *native_bind;
+	MethodBind *checked_bind;
+	uint64_t maximum;
+
+protected:
+	Variant::Type _gen_argument_type(int p_arg) const override {
+		return native_bind->get_argument_type(p_arg);
+	}
+	PropertyInfo _gen_argument_type_info(int p_arg) const override {
+		return p_arg < 0 ? native_bind->get_return_info() : native_bind->get_argument_info(p_arg);
+	}
+
+public:
+#ifdef DEBUG_ENABLED
+	GodotTypeInfo::Metadata get_argument_meta(int p_arg) const override {
+		return native_bind->get_argument_meta(p_arg);
+	}
+#endif
+	Variant call(Object *p_object, const Variant **p_args, int p_arg_count, Callable::CallError &r_error) const override {
+		return checked_bind->call(p_object, p_args, p_arg_count, r_error);
+	}
+	void validated_call(Object *p_object, const Variant **p_args, Variant *r_ret) const override {
+		checked_bind->validated_call(p_object, p_args, r_ret);
+	}
+	void ptrcall(Object *p_object, const void **p_args, void *r_ret) const override {
+		const int64_t value = *reinterpret_cast<const int64_t *>(p_args[0]);
+		if (value < 0 || uint64_t(value) > maximum) {
+			checked_bind->ptrcall(p_object, p_args, r_ret);
+		} else {
+			native_bind->ptrcall(p_object, p_args, r_ret);
+		}
+	}
+	RDCheckedIntegerMethodBind(MethodBind *p_native, MethodBind *p_checked, uint64_t p_maximum) :
+			native_bind(p_native), checked_bind(p_checked), maximum(p_maximum) {
+		set_instance_class(native_bind->get_instance_class());
+		_set_returns(native_bind->has_return());
+		_generate_argument_types(native_bind->get_argument_count());
+	}
+	~RDCheckedIntegerMethodBind() override {
+		memdelete(native_bind);
+		memdelete(checked_bind);
+	}
+};
+
+template <typename NativeMethod, typename CheckedMethod>
+static void rd_bind_checked_integer(const StringName &p_class, const StringName &p_name,
+		NativeMethod p_native, CheckedMethod p_checked, uint64_t p_maximum,
+		const char *p_arg0, const char *p_arg1 = nullptr) {
+	MethodBind *native_bind = create_method_bind(p_native);
+	MethodBind *checked_bind = create_method_bind(p_checked);
+	RDCheckedIntegerMethodBind *bound = memnew(RDCheckedIntegerMethodBind(native_bind, checked_bind, p_maximum));
+	bound->set_name(p_name);
+	native_bind->set_name(p_name);
+	checked_bind->set_name(p_name);
+#ifdef DEBUG_ENABLED
+	Vector<StringName> names;
+	names.push_back(p_arg0);
+	if (p_arg1 != nullptr) {
+		names.push_back(p_arg1);
+	}
+	bound->set_argument_names(names);
+	native_bind->set_argument_names(names);
+	checked_bind->set_argument_names(names);
+#else
+	(void)p_arg0;
+	(void)p_arg1;
+#endif
+	ClassDB::bind_method_custom(p_class, bound);
+}
+
