+// A handler can be registered before final admission and may arrive early.
+// The token contains no native object or texture ownership. Atomics close the
+// race between early callbacks and the render thread's final claim.
+class SubmissionReceipt {
+	enum class Phase : unsigned { PREPARED, CLAIMED, ADMITTED, COMMIT_REQUESTED, ABORTED };
+	std::atomic<Phase> phase{ Phase::PREPARED };
+	std::shared_ptr<void> retained_output;
+	enum : unsigned { PRESENT_REQUESTED = 1, COMPLETION_OBSERVED = 2, TERMINAL_FAILURE = 4 };
+	std::atomic<unsigned> events{ 0 };
+	std::atomic<bool> scheduled_seen{ false }, presented_seen{ false };
+	std::atomic<bool> unrequested_seen{ false }, aborted_completion_seen{ false }, nonterminal_seen{ false };
+	static bool take_once(std::atomic<bool> &p_seen) { return !p_seen.exchange(true, std::memory_order_acq_rel); }
+
+public:
+	explicit SubmissionReceipt(std::shared_ptr<void> p_output) : retained_output(std::move(p_output)) {}
+	bool claim() {
+		Phase expected = Phase::PREPARED;
+		return phase.compare_exchange_strong(expected, Phase::CLAIMED, std::memory_order_acq_rel);
+	}
+	void abort() { phase.store(Phase::ABORTED, std::memory_order_release); }
+	bool observe_handler() {
+		Phase observed = phase.load(std::memory_order_acquire);
+		while (observed == Phase::PREPARED || observed == Phase::CLAIMED || observed == Phase::ADMITTED) {
+			if (phase.compare_exchange_weak(observed, Phase::ABORTED, std::memory_order_acq_rel)) { return false; }
+		}
+		return observed == Phase::COMMIT_REQUESTED;
+	}
+	bool admit() {
+		Phase expected = Phase::CLAIMED;
+		return phase.compare_exchange_strong(expected, Phase::ADMITTED, std::memory_order_acq_rel);
+	}
+	bool begin_commit() {
+		Phase expected = Phase::ADMITTED;
+		return phase.compare_exchange_strong(expected, Phase::COMMIT_REQUESTED, std::memory_order_acq_rel);
+	}
+	bool claimed() const { return phase.load(std::memory_order_acquire) == Phase::COMMIT_REQUESTED; }
+	bool commit_was_requested() const { return claimed(); }
+	bool claim_present() {
+		unsigned observed = events.load(std::memory_order_acquire);
+		for (;;) {
+			if (observed & (PRESENT_REQUESTED | TERMINAL_FAILURE)) { return false; }
+			if (events.compare_exchange_weak(observed, observed | PRESENT_REQUESTED, std::memory_order_acq_rel)) { return true; }
+		}
+	}
+	bool present_was_requested() const { return (events.load(std::memory_order_acquire) & PRESENT_REQUESTED) != 0; }
+	bool take_terminal(bool p_succeeded) {
+		unsigned observed = events.load(std::memory_order_acquire);
+		for (;;) {
+			if (observed & COMPLETION_OBSERVED) { return false; }
+			const unsigned next = observed | COMPLETION_OBSERVED | (p_succeeded ? 0u : TERMINAL_FAILURE);
+			if (events.compare_exchange_weak(observed, next, std::memory_order_acq_rel)) { return true; }
+		}
+	}
+	// Only the first terminal callback calls this; the drawable receipt can
+	// then outlive GPU completion without retaining the compositor slot.
+	std::shared_ptr<void> take_completed_output() {
+		if (!(events.load(std::memory_order_acquire) & COMPLETION_OBSERVED)) { return {}; }
+		return std::move(retained_output);
+	}
+	bool take_scheduled() { return take_once(scheduled_seen); }
+	bool take_presented() { return take_once(presented_seen); }
+	bool take_unrequested() { return take_once(unrequested_seen); }
+	bool take_aborted_completion() { return take_once(aborted_completion_seen); }
+	bool take_nonterminal() { return take_once(nonterminal_seen); }
+};
+
+// A process-lifetime bounded quarantine keeps unresolved native source leases
+// alive across surface destruction. Call retain/release outside Shared::mutex.
+class SubmissionRetentions {
+	std::mutex gate;
+	std::array<std::shared_ptr<SubmissionReceipt>, 4> entries;
+	std::atomic<unsigned> used{ 0 };
+	std::atomic<uint64_t> rejected{ 0 };
+
+public:
+	bool retain(const std::shared_ptr<SubmissionReceipt> &p_receipt) {
+		if (!p_receipt) { return false; }
+		std::lock_guard<std::mutex> guard(gate);
+		for (const auto &entry : entries) { if (entry == p_receipt) { return false; } }
+		for (auto &entry : entries) {
+			if (!entry) { entry = p_receipt; used.fetch_add(1, std::memory_order_relaxed); return true; }
+		}
+		rejected.fetch_add(1, std::memory_order_relaxed);
+		return false;
+	}
+	void release(const std::shared_ptr<SubmissionReceipt> &p_receipt) {
+		std::shared_ptr<SubmissionReceipt> retired;
+		{
+			std::lock_guard<std::mutex> guard(gate);
+			for (auto &entry : entries) {
+				if (entry == p_receipt && entry) { retired = std::move(entry); used.fetch_sub(1, std::memory_order_relaxed); break; }
+			}
+		}
+	}
+	unsigned count() const { return used.load(std::memory_order_relaxed); }
+	uint64_t rejection_count() const { return rejected.load(std::memory_order_relaxed); }
+};
