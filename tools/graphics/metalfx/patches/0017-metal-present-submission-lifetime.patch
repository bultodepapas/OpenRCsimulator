+class SubmissionRetentionGuard {
+	SubmissionRetentions &retentions;
+	std::shared_ptr<SubmissionReceipt> receipt;
+	bool committed = false;
+public:
+	SubmissionRetentionGuard(SubmissionRetentions &p_retentions, const std::shared_ptr<SubmissionReceipt> &p_receipt) : retentions(p_retentions), receipt(p_receipt) {}
+	SubmissionRetentionGuard(const SubmissionRetentionGuard &) = delete;
+	SubmissionRetentionGuard &operator=(const SubmissionRetentionGuard &) = delete;
+	void retain_until_terminal() { committed = true; }
+	~SubmissionRetentionGuard() { if (!committed) { retentions.release(receipt); } }
 };
 
