 	ERR_FAIL_COND_V_MSG(sizes.accelerationStructureSize == 0 || sizes.buildScratchBufferSize == 0 || sizes.buildScratchBufferSize > UINT32_MAX, AccelerationStructureID(), "Invalid Metal acceleration-structure allocation sizes.");
+	// The scene-ingestion experiment bounds the sum of native AS and build
+	// scratch sizes over the entire process, including failed attempts and
+	// resources pending frame-fence retirement. No budget is reclaimed early.
+	static const bool scene_budget_enabled = OS::get_singleton()->get_environment("OPENRC_METAL_RT_SCENE") == "1";
+	if (scene_budget_enabled) {
+		constexpr uint64_t limit = 256u * 1024u * 1024u;
+		const uint64_t allocation = sizes.accelerationStructureSize;
+		const uint64_t scratch = sizes.buildScratchBufferSize;
+		if (allocation > limit || scratch > limit - allocation) {
+			return AccelerationStructureID();
+		}
+		const uint64_t amount = allocation + scratch;
+		static std::atomic<uint64_t> spent{ 0 };
+		uint64_t previous = spent.load(std::memory_order_relaxed);
+		do {
+			if (previous > limit - amount) {
+				return AccelerationStructureID();
+			}
+		} while (!spent.compare_exchange_weak(previous, previous + amount, std::memory_order_relaxed));
+	}
