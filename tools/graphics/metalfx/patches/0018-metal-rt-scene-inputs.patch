new file mode 100644
--- /dev/null
+++ b/servers/rendering/storage/metalfx_rt_geometry.h
@@ -0,0 +1,122 @@
+// SPDX-License-Identifier: MIT
+/*
+ * OpenRC experimental Metal triangle-query geometry ingestion.
+ * The input is Godot's post-compatibility, uncompressed float3 position block.
+ * It is not a general ArrayMesh decoder or a shading/material representation.
+ */
+#pragma once
+
+#include <cmath>
+#include <cstddef>
+#include <cstdint>
+#include <cstring>
+#include <limits>
+
+namespace OpenRCRTGeometry {
+
+enum class Result : uint8_t {
+	OK,
+	INVALID_ARGUMENT,
+	INVALID_TOPOLOGY,
+	GEOMETRY_OVERFLOW,
+	INDEX_OUT_OF_RANGE,
+	NONFINITE_POSITION,
+};
+
+struct Input {
+	const uint8_t *positions = nullptr;
+	uint64_t position_bytes = 0;
+	uint64_t vertex_count = 0;
+	const uint8_t *indices = nullptr;
+	uint64_t index_bytes = 0;
+	uint64_t index_count = 0;
+	uint32_t index_width = 0;
+};
+
+// Budget counts every attempted expanded source allocation, including failed
+// allocations and buffers whose destruction is pending. It deliberately does
+// not claim to count Metal AS/scratch, transfer staging, or raster allocations.
+struct InputBudget {
+	uint64_t spent = 0;
+	uint64_t limit = 0;
+	bool consume(uint64_t p_bytes) {
+		if (p_bytes == 0 || p_bytes > limit || spent > limit - p_bytes) {
+			return false;
+		}
+		spent += p_bytes;
+		return true;
+	}
+};
+
+inline Result validate(const Input &p_input, uint64_t &r_output_bytes) {
+	r_output_bytes = 0;
+	constexpr uint64_t vertex_size = 12;
+	if (!p_input.positions || !p_input.vertex_count) {
+		return Result::INVALID_ARGUMENT;
+	}
+	if (p_input.vertex_count > UINT32_MAX || p_input.vertex_count > std::numeric_limits<uint64_t>::max() / vertex_size ||
+			p_input.vertex_count * vertex_size > p_input.position_bytes || p_input.vertex_count * vertex_size > 64u * 1024u * 1024u) {
+		return Result::GEOMETRY_OVERFLOW;
+	}
+	const bool indexed = p_input.index_count != 0;
+	if (indexed != (p_input.indices != nullptr) || (indexed && p_input.index_width != 2 && p_input.index_width != 4) ||
+			(!indexed && (p_input.index_width || p_input.index_bytes))) {
+		return Result::INVALID_ARGUMENT;
+	}
+	const uint64_t output_count = indexed ? p_input.index_count : p_input.vertex_count;
+	if (output_count % 3) {
+		return Result::INVALID_TOPOLOGY;
+	}
+	if (output_count > UINT32_MAX / vertex_size || output_count * vertex_size > 64u * 1024u * 1024u || (indexed &&
+			(p_input.index_count > std::numeric_limits<uint64_t>::max() / p_input.index_width ||
+					p_input.index_count * p_input.index_width > p_input.index_bytes))) {
+		return Result::GEOMETRY_OVERFLOW;
+	}
+	for (uint64_t i = 0; i < p_input.vertex_count; ++i) {
+		float v[3];
+		std::memcpy(v, p_input.positions + i * vertex_size, vertex_size);
+		if (!std::isfinite(v[0]) || !std::isfinite(v[1]) || !std::isfinite(v[2])) {
+			return Result::NONFINITE_POSITION;
+		}
+	}
+	for (uint64_t i = 0; i < p_input.index_count; ++i) {
+		uint32_t index = 0;
+		if (p_input.index_width == 2) {
+			uint16_t short_index;
+			std::memcpy(&short_index, p_input.indices + i * 2, 2);
+			index = short_index;
+		} else {
+			std::memcpy(&index, p_input.indices + i * 4, 4);
+		}
+		if (index >= p_input.vertex_count) {
+			return Result::INDEX_OUT_OF_RANGE;
+		}
+	}
+	r_output_bytes = output_count * vertex_size;
+	return Result::OK;
+}
+
+inline bool expand(const Input &p_input, uint8_t *p_output, uint64_t p_output_bytes) {
+	uint64_t required = 0;
+	if (validate(p_input, required) != Result::OK || !p_output || p_output_bytes != required) {
+		return false;
+	}
+	if (!p_input.index_count) {
+		std::memcpy(p_output, p_input.positions, required);
+		return true;
+	}
+	for (uint64_t i = 0; i < p_input.index_count; ++i) {
+		uint32_t index = 0;
+		if (p_input.index_width == 2) {
+			uint16_t short_index;
+			std::memcpy(&short_index, p_input.indices + i * 2, 2);
+			index = short_index;
+		} else {
+			std::memcpy(&index, p_input.indices + i * 4, 4);
+		}
+		std::memcpy(p_output + i * 12, p_input.positions + uint64_t(index) * 12, 12);
+	}
+	return true;
+}
+
+} // namespace OpenRCRTGeometry
