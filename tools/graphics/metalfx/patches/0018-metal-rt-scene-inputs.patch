@@ -4110,6 +4126,34 @@
 /***********************/
 /**** VERTEX BUFFER ****/
 /***********************/
+
+RID RenderingDevice::vertex_buffer_create_metalfx_rt_input(uint32_t p_size_bytes, Span<uint8_t> p_data) {
+	if (!driver || !has_feature(SUPPORTS_METAL_TRIANGLE_QUERY) || !driver->has_feature(SUPPORTS_GPU_MAPPABLE_BUFFER) ||
+			p_size_bytes == 0 || p_data.size() != p_size_bytes || !p_data.ptr()) {
+		return RID();
+	}
+	Buffer buffer;
+	buffer.size = p_size_bytes;
+	buffer.usage = RDD::BUFFER_USAGE_TRANSFER_FROM_BIT | RDD::BUFFER_USAGE_TRANSFER_TO_BIT |
+			RDD::BUFFER_USAGE_VERTEX_BIT | RDD::BUFFER_USAGE_ACCELERATION_STRUCTURE_BUILD_INPUT_READ_ONLY_BIT;
+	buffer.alloc_type = RDD::MEMORY_ALLOCATION_TYPE_GPU_MAPPABLE;
+	buffer.driver_id = driver->buffer_create(buffer.size, buffer.usage, buffer.alloc_type, frames_drawn);
+	if (!buffer.driver_id) { return RID(); }
+	uint8_t *mapped = driver->buffer_map(buffer.driver_id);
+	if (!mapped) {
+		driver->buffer_free(buffer.driver_id);
+		return RID();
+	}
+	memcpy(mapped, p_data.ptr(), p_size_bytes);
+	driver->buffer_unmap(buffer.driver_id);
+	buffer_memory.add(buffer.size);
+	RID id = vertex_buffer_owner.make_rid(buffer);
+	if (!id.is_valid()) {
+		buffer_memory.sub(buffer.size);
+		driver->buffer_free(buffer.driver_id);
+	}
+	return id;
+}
 
