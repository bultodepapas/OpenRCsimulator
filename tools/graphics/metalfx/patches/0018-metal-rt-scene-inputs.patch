+void MeshStorage::_rt_source_create(Mesh *p_mesh, Mesh::Surface *p_surface, const RenderingServerTypes::SurfaceData &p_data) {
+	if (!rt_sources) { return; }
+	{
+		MutexLock lock(rt_sources->mutex);
+		if (rt_sources->probe_active) {
+			rt_sources->probe_changed = true;
+			return; // No new source can enter this transaction or its retirement set.
+		}
+	}
+	if (p_data.primitive != RSE::PRIMITIVE_TRIANGLES ||
+			!(p_data.format & RSE::ARRAY_FORMAT_VERTEX) ||
+			(p_data.format & (RSE::ARRAY_FLAG_USE_2D_VERTICES | RSE::ARRAY_FLAG_COMPRESS_ATTRIBUTES |
+					RSE::ARRAY_FORMAT_BONES | RSE::ARRAY_FORMAT_WEIGHTS)) ||
+			p_mesh->blend_shape_count || !p_data.skin_data.is_empty() || !p_data.lods.is_empty()) {
+		return;
+	}
+	OpenRCRTGeometry::Input input;
+	input.positions = p_data.vertex_data.ptr();
+	input.position_bytes = p_data.vertex_data.size();
+	input.vertex_count = p_data.vertex_count;
+	input.index_count = p_data.index_count;
+	if (input.index_count) {
+		input.indices = p_data.index_data.ptr();
+		input.index_bytes = p_data.index_data.size();
+		input.index_width = input.vertex_count <= 65536 ? 2 : 4;
+	} else if (!p_data.index_data.is_empty()) {
+		return;
+	}
+	uint64_t bytes = 0;
+	if (OpenRCRTGeometry::validate(input, bytes) != OpenRCRTGeometry::Result::OK) {
+		return;
+	}
+	MutexLock lock(rt_sources->mutex);
+	if (rt_sources->sources.size() >= RTSourceCache::SOURCE_LIMIT || rt_sources->next_serial >= INT64_MAX || !rt_sources->budget.consume(bytes)) {
+		return;
+	}
+	Vector<uint8_t> expanded;
+	if (expanded.resize(bytes) != OK || !OpenRCRTGeometry::expand(input, expanded.ptrw(), bytes)) {
+		return;
+	}
+	RID vertices = RD::get_singleton()->vertex_buffer_create_metalfx_rt_input(uint32_t(bytes), expanded);
+	if (!vertices.is_valid()) {
+		return;
+	}
+	RTSource source;
+	source.vertices = vertices;
+	source.vertex_count = uint32_t(bytes / 12);
+	source.serial = rt_sources->next_serial++;
+	rt_sources->sources.insert(p_surface, source);
+}
+
+void MeshStorage::_rt_source_invalidate(Mesh::Surface *p_surface) {
+	if (!rt_sources) {
+		return;
+	}
+	RID vertices;
+	{
+		MutexLock lock(rt_sources->mutex);
+		RTSource *source = rt_sources->sources.getptr(p_surface);
+		if (!source) {
+			return;
+		}
+		vertices = source->vertices;
+		rt_sources->sources.erase(p_surface);
+		if (rt_sources->probe_active) {
+			// The transaction admits no new sources and starts with at most
+			// SOURCE_LIMIT entries, so this fixed retirement array cannot overflow.
+			DEV_ASSERT(rt_sources->deferred_count < RTSourceCache::SOURCE_LIMIT);
+			rt_sources->deferred_sources[rt_sources->deferred_count++] = vertices;
+			rt_sources->probe_changed = true;
+			return;
+		}
+	}
+	// RD recursively invalidates dependent BLAS/TLAS and defers native release
+	// until the frame fence. The cumulative input budget is not refunded.
+	RD::get_singleton()->free_rid(vertices);
+}
+
+bool MeshStorage::rt_source_get(RID p_mesh, int p_surface, RID &r_vertices, uint32_t &r_count, uint64_t &r_serial) {
+	if (!rt_sources || p_surface < 0) {
+		return false;
+	}
+	Mesh *mesh = mesh_owner.get_or_null(p_mesh);
+	if (!mesh || uint32_t(p_surface) >= mesh->surface_count) {
+		return false;
+	}
+	MutexLock lock(rt_sources->mutex);
+	const RTSource *source = rt_sources->sources.getptr(mesh->surfaces[p_surface]);
+	if (!source) {
+		return false;
+	}
+	r_vertices = source->vertices;
+	r_count = source->vertex_count;
+	r_serial = source->serial;
+	return true;
+}
+
+uint64_t MeshStorage::rt_input_budget_spent() const {
+	if (!rt_sources) {
+		return 0;
+	}
+	MutexLock lock(rt_sources->mutex);
+	return rt_sources->budget.spent;
+}
+
+bool MeshStorage::rt_probe_source_begin() {
+	if (!rt_sources) { return false; }
+	MutexLock lock(rt_sources->mutex);
+	if (rt_sources->probe_active || rt_sources->deferred_count) { return false; }
+	rt_sources->probe_active = true;
+	rt_sources->probe_changed = false;
+	return true;
+}
+
+bool MeshStorage::rt_probe_source_changed() const {
+	if (!rt_sources) { return true; }
+	MutexLock lock(rt_sources->mutex);
+	return !rt_sources->probe_active || rt_sources->probe_changed;
+}
+
+void MeshStorage::rt_probe_source_end() {
+	if (!rt_sources) { return; }
+	MutexLock lock(rt_sources->mutex);
+	if (!rt_sources->probe_active) { return; }
+	// Called after the transaction has retired its logical BLAS/TLAS. Native
+	// destruction remains subject to RD's normal deferred frame ownership.
+	for (uint32_t i = 0; i < rt_sources->deferred_count; ++i) {
+		RD::get_singleton()->free_rid(rt_sources->deferred_sources[i]);
+		rt_sources->deferred_sources[i] = RID();
+	}
+	rt_sources->deferred_count = 0;
+	rt_sources->probe_active = false;
+	rt_sources->probe_changed = false;
 }
 
