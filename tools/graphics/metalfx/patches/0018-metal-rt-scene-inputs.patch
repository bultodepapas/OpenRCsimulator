+	const int64_t hit = result["hit_flag"];
+	const int64_t id = result["instance_id"];
+	const int64_t primitive = result["primitive"];
+	const double distance = result["distance"];
+	const int64_t distance_bits = result["distance_bits"];
+	const int64_t write_marker = result["write_marker"];
+	const Array entries = result["entries"];
+	const double maximum = result["submitted_max_distance"];
+	const double minimum = result["submitted_min_distance"];
+	bool invalid_hit = write_marker != 0x52435431 || (hit != 0 && hit != 1);
+	if (hit == 0) {
+		invalid_hit = invalid_hit || id != 0 || primitive != 0 || distance_bits != 0;
+	} else if (hit == 1) {
+		invalid_hit = invalid_hit || id <= 0 || id > entries.size() || !Math::is_finite(distance) || distance < minimum || distance > maximum;
+		if (!invalid_hit) {
+			const Dictionary entry = entries[id - 1];
+			const int64_t triangle_count = entry["triangle_count"];
+			invalid_hit = primitive < 0 || primitive >= triangle_count;
+		}
+	}
+	if (invalid_hit) {
+		result["status"] = "invalid_or_missing_gpu_result";
+	} else {
+		result["status"] = "ok";
+		result["gpu_end_seconds"] = completion.samples[0].gpu_end_seconds;
+		result["historical_snapshot"] = true;
+	}
+	rt_probe_pending.reset();
+#endif
+	return result;
 }
 
