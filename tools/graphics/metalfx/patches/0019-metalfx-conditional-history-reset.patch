+Dictionary RendererViewport::viewport_request_temporal_history_reset_if_current(RID p_viewport, int64_t p_expected_render_buffer_generation, int64_t p_expected_requested_serial) {
+	Dictionary receipt;
+	receipt["accepted"] = false;
+	receipt["reason"] = "invalid_viewport";
+	receipt["generation"] = int64_t(-1);
+	receipt["previous_requested_serial"] = int64_t(-1);
+	receipt["requested_serial"] = int64_t(-1);
+	receipt["reset_request_attempt"] = int64_t(-1);
+	Viewport *viewport = viewport_owner.get_or_null(p_viewport);
+	if (!viewport) { return receipt; }
+	if (viewport->metal_fx_generation > uint64_t(INT64_MAX)) {
+		receipt["reason"] = "generation_out_of_range";
+		return receipt;
+	}
+	receipt["generation"] = int64_t(viewport->metal_fx_generation);
+	std::shared_ptr<MetalFXTemporalHistoryState> history;
+	uint64_t requested = 0;
+	if (viewport->render_buffers.is_valid()) {
+		history = viewport->render_buffers->get_metalfx_history_state();
+		if (history) {
+			requested = history->requested.load(std::memory_order_acquire);
+			if (requested <= uint64_t(INT64_MAX)) {
+				receipt["previous_requested_serial"] = int64_t(requested);
+				receipt["requested_serial"] = int64_t(requested);
+			}
+		}
+	}
+	if (p_expected_render_buffer_generation < 0 || p_expected_requested_serial < 0) {
+		receipt["reason"] = "invalid_expected_scope";
+		return receipt;
+	}
+	if (uint64_t(p_expected_render_buffer_generation) != viewport->metal_fx_generation) {
+		receipt["reason"] = "stale_generation";
+		return receipt;
+	}
+	if (!viewport->render_buffers.is_valid()) {
+		receipt["reason"] = "render_buffers_unavailable";
+		return receipt;
+	}
+	if (!history) {
+		receipt["reason"] = "history_unavailable";
+		return receipt;
+	}
+	if (requested > uint64_t(INT64_MAX)) {
+		receipt["reason"] = "requested_serial_out_of_range";
+		return receipt;
+	}
+	if (uint64_t(p_expected_requested_serial) != requested) {
+		receipt["reason"] = "stale_serial";
+		return receipt;
+	}
+	// The server wrapper serializes this entire method onto the render thread.
+	// Reuse the existing reset for readiness, observer and frame invalidation.
+	Dictionary reset = viewport_request_temporal_history_reset(p_viewport);
+	if (!bool(reset.get("accepted", false))) {
+		receipt["reason"] = "reset_unavailable";
+		return receipt;
+	}
+	receipt["accepted"] = true;
+	receipt["reason"] = "accepted";
+	receipt["requested_serial"] = reset["serial"];
+	receipt["reset_request_attempt"] = reset["reset_request_attempt"];
+	return receipt;
+}
