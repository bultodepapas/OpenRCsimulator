+/**************************************************************************/
+/*  metalfx_viewport_visibility.h                                         */
+/**************************************************************************/
+/* Copyright (c) 2026 OpenRC Simulator contributors.                      */
+/* SPDX-License-Identifier: MIT                                           */
+/**************************************************************************/
+#pragma once
+
+#include "servers/rendering/rendering_device.h"
+
+namespace RendererRD {
+
+// Internal, render-thread-only building block. A per-viewport owner must
+// supply a current, closed scenario generation with checked geometry metadata.
+// This does not certify admission, submission, GPU completion or presentation.
+class MetalFXViewportVisibility {
+public:
+	struct Inputs {
+		RID scene, geometry, primary_depth, world_normal, diffuse_albedo, specular_albedo, roughness, noisy_output;
+		Size2i size;
+		// Inverse of this frame's depth-corrected world-to-clip projection,
+		// including the renderer's jitter. Depth uses Godot's reversed 0..1.
+		Projection world_from_clip;
+		Color linear_environment;
+		Color linear_background;
+		float ray_epsilon = 0.005f;
+		float ray_distance = 1000.0f;
+		uint32_t sample = 0;
+		uint32_t instance_count = 0, normal_count = 0;
+		uint64_t epoch = 0;
+	};
+
+private:
+	RenderingDevice *owner = nullptr;
+	RID shader, pipeline, sampler, consumer_shader, consumer_pipeline, depth_shader, depth_pipeline;
+	RenderingDevice::FramebufferFormatID depth_pipeline_format = RenderingDevice::INVALID_ID;
+	uint64_t epoch = 0;
+	uint64_t last_epoch = 0;
+
+public:
+	MetalFXViewportVisibility() = default;
+	MetalFXViewportVisibility(const MetalFXViewportVisibility &) = delete;
+	MetalFXViewportVisibility &operator=(const MetalFXViewportVisibility &) = delete;
+	~MetalFXViewportVisibility();
+	bool begin_generation(uint64_t p_epoch);
+	void invalidate() { epoch = 0; }
+	bool dispatch(const Inputs &p_inputs);
+	bool convert_depth(RID p_primary_depth, RID p_denoised_depth, Size2i p_size);
+	RID get_trace_pipeline() const { return epoch ? pipeline : RID(); }
+	RID get_consumer_pipeline() const { return epoch ? consumer_pipeline : RID(); }
+	RID get_consumer_sampler() const { return epoch ? sampler : RID(); }
+};
+} // namespace RendererRD
