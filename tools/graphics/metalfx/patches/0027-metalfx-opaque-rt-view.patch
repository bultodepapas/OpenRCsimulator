--- /dev/null
+++ b/servers/rendering/storage/metalfx_rt_source_lifetime.h
@@ -0,0 +1,115 @@
+/**************************************************************************/
+/*  metalfx_rt_source_lifetime.h                                          */
+/**************************************************************************/
+/* Copyright (c) 2026 OpenRC Simulator contributors.                      */
+/* SPDX-License-Identifier: MIT                                           */
+/**************************************************************************/
+
+#pragma once
+
+#include "core/templates/hash_map.h"
+
+#include <cstdint>
+#include <limits>
+
+// Render-thread bookkeeping only. The containing MeshStorage supplies its
+// source mutex and frees returned resources through RD on the render thread.
+// A token retains its source, but it ceases to authorize new work as soon as
+// that source is retired. The owner must also validate its scene epoch.
+template <typename Resource>
+class OpenRCRTSourceLifetime {
+private:
+	struct Retired {
+		Resource resource;
+		bool probe_hold = false;
+	};
+	HashMap<uint64_t, uint64_t> tokens;
+	HashMap<uint64_t, uint32_t> references;
+	HashMap<uint64_t, Retired> retired;
+	uint64_t next_token = 1;
+	static constexpr uint32_t MAX_TOKENS = 4096;
+
+public:
+	bool acquire(uint64_t p_serial, uint64_t &r_token) {
+		r_token = 0;
+		if (!p_serial || retired.has(p_serial) || tokens.size() >= MAX_TOKENS || next_token == std::numeric_limits<uint64_t>::max()) {
+			return false;
+		}
+		uint32_t *count = references.getptr(p_serial);
+		if (count) {
+			++*count;
+		} else {
+			references.insert(p_serial, 1);
+		}
+		r_token = next_token++;
+		tokens.insert(r_token, p_serial);
+		return true;
+	}
+
+	bool current(uint64_t p_token) const {
+		const uint64_t *serial = tokens.getptr(p_token);
+		return serial && !retired.has(*serial);
+	}
+
+	// r_free receives a resource only if it can be handed to RD now. An
+	// invalidated source with outstanding tokens or a probe hold is retained.
+	bool retire(uint64_t p_serial, Resource p_resource, bool p_probe_hold, Resource &r_free) {
+		r_free = Resource();
+		if (!p_serial || retired.has(p_serial)) {
+			return false;
+		}
+		if (p_probe_hold || references.has(p_serial)) {
+			retired.insert(p_serial, Retired{ p_resource, p_probe_hold });
+		} else {
+			r_free = p_resource;
+		}
+		return true;
+	}
+
+	bool release(uint64_t p_token, Resource &r_free) {
+		r_free = Resource();
+		uint64_t *serial_ptr = tokens.getptr(p_token);
+		if (!serial_ptr) {
+			return false;
+		}
+		const uint64_t serial = *serial_ptr;
+		uint32_t *count = references.getptr(serial);
+		if (!count || !*count) {
+			return false; // Internal invariant violation; caller fails closed.
+		}
+		tokens.erase(p_token);
+		if (--*count == 0) {
+			references.erase(serial);
+			Retired *item = retired.getptr(serial);
+			if (item && !item->probe_hold) {
+				r_free = item->resource;
+				retired.erase(serial);
+			}
+		}
+		return true;
+	}
+
+	bool end_probe_hold(uint64_t p_serial, Resource &r_free) {
+		r_free = Resource();
+		Retired *item = retired.getptr(p_serial);
+		if (!item || !item->probe_hold) {
+			return false;
+		}
+		item->probe_hold = false;
+		if (!references.has(p_serial)) {
+			r_free = item->resource;
+			retired.erase(p_serial);
+		}
+		return true;
+	}
+
+	template <typename Callback>
+	void drain_retired(Callback p_callback) {
+		for (const KeyValue<uint64_t, Retired> &item : retired) {
+			p_callback(item.value.resource);
+		}
+		retired.clear();
+		tokens.clear();
+		references.clear();
+	}
+};
diff --git a/servers/rendering/storage/metalfx_viewport_callback.h b/servers/rendering/storage/metalfx_viewport_callback.h
new file mode 100644
--- /dev/null
+++ b/servers/rendering/storage/metalfx_viewport_callback.h
@@ -0,0 +1,103 @@
+// SPDX-License-Identifier: MIT
+// Internal conditional consumer ordering; callbacks all use the caller's
+// original driver command buffer. This does not claim GPU completion.
+#pragma once
+#include <atomic>
+#include <array>
+#include <cstddef>
+#include <cstdint>
+namespace MFXViewportCallback {
+struct CommandProof {
+	uint64_t frame = 0;
+	uint64_t pipeline = 0;
+	std::atomic<uint64_t> first_command{ 0 };
+	std::atomic<uint32_t> required_draw_stages{ 0 };
+	std::atomic<uint32_t> completed_draw_stages{ 0 };
+	std::atomic<bool> draw_failed{ false };
+};
+enum DrawStage : uint32_t { PRIMARY_DEPTH = 1u, PRIMARY_COLOR = 2u, GUIDES = 4u, DEPTH_CONVERSION = 8u, INPUT_CLEARS = 16u };
+inline bool draw_stages_ready(const CommandProof &p) {
+	const uint32_t required = p.required_draw_stages.load(std::memory_order_acquire);
+	const uint32_t minimum = DEPTH_CONVERSION | INPUT_CLEARS;
+	return (required & minimum) == minimum && !p.draw_failed.load(std::memory_order_acquire) &&
+			(p.completed_draw_stages.load(std::memory_order_acquire) & required) == required;
+}
+inline bool same_command(uint64_t p_first, uint64_t p_last) { return p_first != 0 && p_first == p_last; }
+inline bool producer_receipts_ready(bool p_same_command, bool p_dispatch, bool p_draws) {
+	return p_same_command && p_dispatch && p_draws;
+}
+inline bool required_set_valid(uint32_t p_expected, uint32_t p_actual, bool p_live) {
+	return !p_expected || (p_expected == p_actual && p_live);
+}
+inline bool build_commands_ready(uint64_t p_first, uint64_t p_last, bool p_acceleration_structure_ready) {
+	return same_command(p_first, p_last) && p_acceleration_structure_ready;
+}
+// Only instantiated on an explicitly requested Metal command buffer. Bounded
+// per-pipeline tracking prevents another viewport's dispatch satisfying ours.
+class DispatchLedger {
+	struct Entry { uint64_t pipeline = 0; uint32_t encoded = 0; bool failed = false; };
+	std::array<Entry, 16> entries{};
+public:
+	void clear() { entries = {}; }
+	bool begin(uint64_t p_pipeline) {
+		if (!p_pipeline) { return false; }
+		for (const Entry &entry : entries) { if (entry.pipeline == p_pipeline) { return false; } }
+		for (Entry &entry : entries) { if (!entry.pipeline) { entry.pipeline = p_pipeline; return true; } }
+		return false;
+	}
+	bool tracking(uint64_t p_pipeline) const {
+		for (const Entry &entry : entries) { if (entry.pipeline && entry.pipeline == p_pipeline) { return true; } }
+		return false;
+	}
+	void note(uint64_t p_pipeline, bool p_encoded) {
+		for (Entry &entry : entries) {
+			if (entry.pipeline && entry.pipeline == p_pipeline) {
+				if (!p_encoded || entry.encoded == UINT32_MAX) { entry.failed = true; } else { ++entry.encoded; }
+				return;
+			}
+		}
+	}
+	bool finish(uint64_t p_pipeline) {
+		for (Entry &entry : entries) {
+			if (entry.pipeline && entry.pipeline == p_pipeline) {
+				bool ok = !entry.failed && entry.encoded == 1;
+				entry = {};
+				return ok;
+			}
+		}
+		return false;
+	}
+};
+// One graph-delimited render stage at a time on this native command buffer.
+class DrawLedger {
+	uint64_t token = 0;
+	uint32_t encoded = 0;
+	uint32_t stage = 0;
+	bool failed = false;
+public:
+	void clear() { token = 0; encoded = 0; stage = 0; failed = false; }
+	bool begin(uint64_t p_token, uint32_t p_stage) {
+		if (!p_token || !p_stage || token) { return false; }
+		token = p_token; stage = p_stage; return true;
+	}
+	bool active() const { return token != 0; }
+	bool optional_pass() const { return stage == GUIDES || stage == DEPTH_CONVERSION; }
+	void note(bool p_encoded) {
+		if (!token) { return; }
+		if (!p_encoded || encoded == UINT32_MAX) { failed = true; } else { ++encoded; }
+	}
+	bool finish(uint64_t p_token, uint32_t p_expected) {
+		if (!token || token != p_token) { return false; }
+		const bool ok = p_expected && !failed && encoded == p_expected;
+		clear(); return ok;
+	}
+};
+enum class Result { NATIVE_FAILED, OBSERVER_FAILED, CONSUMED };
+template <class Observe, class Consume>
+Result after_native_encode(bool p_native_ok, Observe p_observe, Consume p_consume) {
+	if (!p_native_ok) { return Result::NATIVE_FAILED; }
+	if (!p_observe()) { return Result::OBSERVER_FAILED; }
+	p_consume();
+	return Result::CONSUMED;
+}
+} // namespace MFXViewportCallback
diff --git a/servers/rendering/storage/metalfx_viewport_geometry.h b/servers/rendering/storage/metalfx_viewport_geometry.h
new file mode 100644
--- /dev/null
+++ b/servers/rendering/storage/metalfx_viewport_geometry.h
@@ -0,0 +1,89 @@
+// SPDX-License-Identifier: MIT
+// Narrow immutable normal proof for Godot's uncompressed triangle streams.
+#pragma once
+#include "servers/rendering/storage/metalfx_rt_geometry.h"
+#include "servers/rendering/storage/metalfx_viewport_primary_geometry.h"
+#include <cmath>
+#include <cstring>
+
+namespace MFXViewportGeometry {
+struct Normal { double x, y, z; };
+inline Normal decode(uint16_t p_x, uint16_t p_y) {
+	double x = double(p_x) * (2.0 / 65535.0) - 1.0;
+	double y = double(p_y) * (2.0 / 65535.0) - 1.0;
+	double z = 1.0 - std::abs(x) - std::abs(y);
+	const double t = z < 0.0 ? -z : 0.0;
+	x += x > 0.0 ? -t : (x < 0.0 ? t : 0.0);
+	y += y > 0.0 ? -t : (y < 0.0 ? t : 0.0);
+	const double length = std::sqrt(x * x + y * y + z * z);
+	return { x / length, y / length, z / length };
+}
+inline double dot(const Normal &a, const Normal &b) { return a.x * b.x + a.y * b.y + a.z * b.z; }
+
+// Normals follow the float3 position block as two UNORM16 values per vertex;
+// an optional tangent adds another two UNORM16 values to each normal stride.
+// Pairwise dot >= 0.5 gives a substantial shared-hemisphere margin so no
+// perspective-correct interpolated normal of a triangle can approach zero.
+inline bool guide_geometry_safe(const OpenRCRTGeometry::Input &p, bool p_has_normal, bool p_has_tangent) {
+	uint64_t bytes = 0;
+	if (!p_has_normal || OpenRCRTGeometry::validate(p, bytes) != OpenRCRTGeometry::Result::OK) { return false; }
+	const uint64_t offset = p.vertex_count * 12, stride = p_has_tangent ? 8 : 4;
+	if (p.vertex_count > (UINT64_MAX - offset) / stride || offset + p.vertex_count * stride != p.position_bytes) { return false; }
+	for (uint64_t i = 0; i < p.vertex_count; ++i) {
+		float position[3];
+		std::memcpy(position, p.positions + i * 12, 12);
+		for (float value : position) { if (std::abs(value) > 1000000.0f) { return false; } }
+		// Forward+ reads four UNORM16 components even without tangents. In
+		// that case ZW are the next vertex's normal; the final padded ZW are
+		// explicitly zero. (0, 1) selects the compressed-normal shader path,
+		// which does not match the XY octahedral normal checked below.
+		uint16_t zw[2] = {};
+		if (p_has_tangent || i + 1 < p.vertex_count) {
+			std::memcpy(zw, p.positions + offset + i * stride + 4, sizeof(zw));
+		}
+		if (zw[0] == 0 && zw[1] == 65535) { return false; }
+	}
+	const uint64_t count = p.index_count ? p.index_count : p.vertex_count;
+	for (uint64_t i = 0; i < count; i += 3) {
+		Normal normals[3];
+		for (uint64_t j = 0; j < 3; ++j) {
+			uint32_t index = uint32_t(i + j);
+			if (p.index_count) {
+				if (p.index_width == 2) { uint16_t value; std::memcpy(&value, p.indices + (i + j) * 2, 2); index = value; }
+				else { std::memcpy(&index, p.indices + (i + j) * 4, 4); }
+			}
+			uint16_t encoded[2];
+			std::memcpy(encoded, p.positions + offset + uint64_t(index) * stride, sizeof(encoded));
+			normals[j] = decode(encoded[0], encoded[1]);
+		}
+		if (dot(normals[0], normals[1]) < 0.5 || dot(normals[0], normals[2]) < 0.5 || dot(normals[1], normals[2]) < 0.5) { return false; }
+	}
+	return true;
+}
+
+// The admitted fixed material must use the same oriented normal as the
+// captured triangle at all three vertices. This is a source-only check; it
+// does not prove the raster GPU upload or front-face convention.
+inline bool flat_normals_match(const OpenRCRTGeometry::Input &p, bool p_has_normal, bool p_has_tangent,
+		const MFXViewportPrimaryGeometry::Normal *p_triangles, uint64_t p_triangle_count) {
+	constexpr double MIN_FLAT_DOT = 0.9999;
+	const uint64_t count = p.index_count ? p.index_count : p.vertex_count;
+	if (!p_triangles || !p_triangle_count || count / 3 != p_triangle_count ||
+			!guide_geometry_safe(p, p_has_normal, p_has_tangent)) { return false; }
+	const uint64_t offset = p.vertex_count * 12, stride = p_has_tangent ? 8 : 4;
+	for (uint64_t i = 0; i < count; ++i) {
+		uint32_t index = uint32_t(i);
+		if (p.index_count) {
+			if (p.index_width == 2) { uint16_t value; std::memcpy(&value, p.indices + i * 2, 2); index = value; }
+			else { std::memcpy(&index, p.indices + i * 4, 4); }
+		}
+		uint16_t encoded[2];
+		std::memcpy(encoded, p.positions + offset + uint64_t(index) * stride, sizeof(encoded));
+		const Normal n = decode(encoded[0], encoded[1]);
+		const auto &triangle = p_triangles[i / 3];
+		const double alignment = n.x * triangle.x + n.y * triangle.y + n.z * triangle.z;
+		if (!std::isfinite(alignment) || alignment < MIN_FLAT_DOT) { return false; }
+	}
+	return true;
+}
+} // namespace MFXViewportGeometry
diff --git a/servers/rendering/storage/metalfx_viewport_numeric.h b/servers/rendering/storage/metalfx_viewport_numeric.h
new file mode 100644
--- /dev/null
+++ b/servers/rendering/storage/metalfx_viewport_numeric.h
@@ -0,0 +1,76 @@
+// SPDX-License-Identifier: MIT
+// Conservative bound for the half-float noisy-radiance input.
+#pragma once
+#include <cmath>
+namespace MFXViewportNumeric {
+inline bool environment_channel(float p_value) {
+	return std::isfinite(p_value) && p_value >= 0.0f && p_value <= 1024.0f;
+}
+inline bool position_component(float p_value) {
+	return std::isfinite(p_value) && std::abs(p_value) <= 1000000.0f;
+}
+// Column-major inverse projection. Bound all coefficients and the minimum
+// homogeneous w over x,y in [-1,1], depth in [0,1]. Since w is affine,
+// this lower bound covers the whole clip box, including raster interpolation.
+inline bool inverse_clip_matrix_safe(const float p_matrix[16]) {
+	for (int i = 0; i < 16; ++i) {
+		if (!std::isfinite(p_matrix[i]) || std::abs(p_matrix[i]) > 10000000.0f) { return false; }
+	}
+	const double minimum_w = double(p_matrix[15]) - std::abs(double(p_matrix[3])) - std::abs(double(p_matrix[7])) +
+			(p_matrix[11] < 0.0f ? double(p_matrix[11]) : 0.0);
+	const double scale = std::abs(double(p_matrix[15])) + std::abs(double(p_matrix[3])) +
+			std::abs(double(p_matrix[7])) + std::abs(double(p_matrix[11]));
+	// Leave room for GPU float rounding and cancellation, not just the exact
+	// real-valued lower bound computed above.
+	return minimum_w > 0.00001 * (1.0 + scale);
+}
+
+// Full-clip-box preflight relative to the near-center point. This keeps camera
+// translation correlated with w; independent absolute bounds reject ordinary
+// translated cameras. The error margins cover float matrix/divide/subtract
+// operations conservatively; exact shader arithmetic still needs native tests.
+inline bool primary_ray_domain_safe(const float p_matrix[16]) {
+	if (!inverse_clip_matrix_safe(p_matrix)) { return false; }
+	const double wx = p_matrix[3], wy = p_matrix[7], wz = p_matrix[11], wc = p_matrix[15];
+	const double min_w = wc - std::abs(wx) - std::abs(wy) + (wz < 0.0 ? wz : 0.0);
+	const double min_w0 = wc - std::abs(wx) - std::abs(wy);
+	const double min_w1 = wc + wz - std::abs(wx) - std::abs(wy);
+	const double max_w0 = wc + std::abs(wx) + std::abs(wy);
+	const double max_w1 = wc + wz + std::abs(wx) + std::abs(wy);
+	if (!(min_w > 0.0) || !(min_w0 > 0.0) || !(min_w1 > 0.0) || !(max_w0 > 0.0) || !(max_w1 > 0.0)) { return false; }
+	constexpr double FLOAT_MARGIN = 0.000001; // More than 16 float unit roundoffs.
+	const double err_w0 = FLOAT_MARGIN * (1.0 + std::abs(wc) + std::abs(wx) + std::abs(wy));
+	const double err_w1 = FLOAT_MARGIN * (1.0 + std::abs(wc) + std::abs(wx) + std::abs(wy) + std::abs(wz));
+	if (err_w0 >= min_w0 || err_w1 >= min_w1) { return false; }
+	double radius_squared = 0.0, error_squared = 0.0;
+	double axis_error[3] = {};
+	for (int axis = 0; axis < 3; ++axis) {
+		const double x = p_matrix[axis], y = p_matrix[4 + axis], z = p_matrix[8 + axis], c = p_matrix[12 + axis];
+		const double reference = (c + z) / (wc + wz);
+		const double numerator = std::abs(x - reference * wx) + std::abs(y - reference * wy) +
+				std::abs(z - reference * wz) + std::abs(c - reference * wc);
+		const double coordinate_bound = numerator / min_w;
+		radius_squared += coordinate_bound * coordinate_bound;
+		const double n0 = std::abs(x) + std::abs(y) + std::abs(c);
+		const double n1 = n0 + std::abs(z);
+		const double bound0 = n0 / min_w0, bound1 = n1 / min_w1;
+		const double err0 = (FLOAT_MARGIN * (1.0 + n0) + bound0 * err_w0) / (min_w0 - err_w0) + FLOAT_MARGIN * (1.0 + bound0);
+		const double err1 = (FLOAT_MARGIN * (1.0 + n1) + bound1 * err_w1) / (min_w1 - err_w1) + FLOAT_MARGIN * (1.0 + bound1);
+		axis_error[axis] = err0 + err1 + FLOAT_MARGIN * (1.0 + bound0 + bound1);
+		error_squared += axis_error[axis] * axis_error[axis];
+	}
+	const double radius = std::sqrt(radius_squared);
+	const double error = std::sqrt(error_squared);
+	if (!std::isfinite(radius) || !std::isfinite(error) || 2.0 * radius + error > 5000000.0) { return false; }
+	const double max_denominator = max_w0 * max_w1;
+	for (int axis = 0; axis < 3; ++axis) {
+		const double z = p_matrix[8 + axis], c = p_matrix[12 + axis];
+		const double constant = z * wc - c * wz;
+		const double x = z * wx - double(p_matrix[axis]) * wz;
+		const double y = z * wy - double(p_matrix[4 + axis]) * wz;
+		const double numerator_lower = std::abs(constant) - std::abs(x) - std::abs(y);
+		if (numerator_lower > 0.0 && numerator_lower / max_denominator > 0.25 * (1.0 + radius) + 2.0 * axis_error[axis]) { return true; }
+	}
+	return false;
+}
+}
diff --git a/servers/rendering/storage/metalfx_viewport_opt_in.h b/servers/rendering/storage/metalfx_viewport_opt_in.h
