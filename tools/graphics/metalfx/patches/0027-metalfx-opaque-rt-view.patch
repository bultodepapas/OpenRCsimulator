+namespace RendererRD {
+
+class MetalFXViewportDenoised {
+	MetalFXViewportRTScene scene;
+	MetalFXViewportVisibility visibility;
+	Vector<MetalFXViewportRTScene::Surface> previous_surfaces;
+	RID previous_scenario;
+	Transform3D previous_camera;
+	Projection previous_projection;
+	Color linear_environment;
+	bool have_previous = false;
+	uint64_t next_epoch = 0, active_epoch = 0, sample = 0, authorized_frame = 0;
+	uint64_t last_enqueued_frame = 0, last_enqueued_serial = 0, completed_frame = 0, completed_serial = 0;
+	Size2i size;
+	RenderingDevice *owner = nullptr;
+	RID context, primary_depth;
+	RID textures[9];
+	std::shared_ptr<RealGPUCompletion> completion;
+	std::shared_ptr<MFXViewportCallback::CommandProof> frame_proof;
+	String reason = "not_attempted";
+	bool faulted = false;
+	void clear_gpu();
+	bool allocate(Size2i p_size);
+
+public:
+	~MetalFXViewportDenoised();
+	bool admit(RID p_scenario, const Vector<MetalFXViewportRTScene::Surface> &p_surfaces, const Transform3D &p_camera, const Projection &p_projection, Color p_linear_environment, Size2i p_size);
+	void reject(const char *p_reason);
+	bool is_ready() const { return active_epoch && scene.is_current(active_epoch); }
+	bool consume_authorization(uint64_t p_frame) {
+		const bool allowed = p_frame && authorized_frame == p_frame && frame_proof && frame_proof->frame == p_frame && is_ready();
+		authorized_frame = 0;
+		return allowed;
+	}
+	Color get_linear_environment() const { return linear_environment; }
+	bool can_record();
+	bool begin_frame_proof(uint64_t p_frame);
+	bool begin_draw_stage(uint32_t p_stage);
+	bool end_draw_stage(uint32_t p_stage, uint32_t p_expected, bool p_enqueued);
+	bool record(RID p_target, const Projection &p_world_to_view, const Projection &p_clip, const Projection &p_world_from_clip, Color p_linear_environment, Color p_linear_background, uint64_t p_frame);
+	Dictionary status() const;
+};
+} // namespace RendererRD
diff --git a/servers/rendering/renderer_rd/effects/metalfx_viewport_rt_scene.cpp b/servers/rendering/renderer_rd/effects/metalfx_viewport_rt_scene.cpp
new file mode 100644
--- /dev/null
+++ b/servers/rendering/renderer_rd/effects/metalfx_viewport_rt_scene.cpp
@@ -0,0 +1,209 @@
+/**************************************************************************/
+/*  metalfx_viewport_rt_scene.cpp                                         */
+/**************************************************************************/
+/* Copyright (c) 2026 OpenRC Simulator contributors.                      */
+/* SPDX-License-Identifier: MIT                                           */
+/**************************************************************************/
+
+#include "metalfx_viewport_rt_scene.h"
+#include "servers/rendering/storage/real_gpu_completion.h"
+#include "servers/rendering/storage/metalfx_viewport_callback.h"
+
+#include <atomic>
+
+using namespace RendererRD;
+
+struct RendererRD::MetalFXViewportBuildReceipt {
+	std::shared_ptr<RealGPUCompletion> completion;
+	RealGPUCompletion::Reservation reservation;
+	RenderingDeviceDriver::AccelerationStructureID tlas;
+	std::atomic<uint64_t> first_command{ 0 };
+};
+namespace {
+// Cumulative rather than refundable: allocation and in-flight retirement never
+// exceed this experiment's explicit process budget.
+OpenRCRTGeometry::InputBudget primary_buffer_budget{ 0, 32u * 1024u * 1024u };
+struct BuildCallback { std::shared_ptr<MetalFXViewportBuildReceipt> receipt; };
+void mark_build_first(RenderingDeviceDriver *p_driver, RenderingDeviceDriver::CommandBufferID p_command, void *p_data) {
+	BuildCallback *callback = static_cast<BuildCallback *>(p_data);
+	callback->receipt->first_command.store(p_driver->metalfx_rt_command_buffer_identity(p_command), std::memory_order_release);
+	memdelete(callback);
+}
+void observe_build_last(RenderingDeviceDriver *p_driver, RenderingDeviceDriver::CommandBufferID p_command, void *p_data) {
+	BuildCallback *callback = static_cast<BuildCallback *>(p_data);
+	auto receipt = callback->receipt;
+	const uint64_t first = receipt->first_command.load(std::memory_order_acquire);
+	const uint64_t last = p_driver->metalfx_rt_command_buffer_identity(p_command);
+	if (!MFXViewportCallback::build_commands_ready(first, last, p_driver->metalfx_rt_acceleration_structure_ready(receipt->tlas)) || !p_driver->real_gpu_completion_register(p_command, receipt->completion, receipt->reservation)) {
+		receipt->completion->fail(receipt->reservation, "build_command_changed_or_registration_failed");
+	}
+	memdelete(callback);
+}
+} // namespace
+
+void MetalFXViewportRTScene::_clear() {
+	epoch = 0;
+	RD *rd = RD::get_singleton();
+	MeshStorage *storage = MeshStorage::get_singleton();
+	if (rd == owner && rd) {
+		// Order matters: source release recursively invalidates dependencies.
+		if (tlas.is_valid()) { rd->free_rid(tlas); }
+		for (RID blas : blases) { rd->free_rid(blas); }
+		if (primary_geometry.is_valid()) { rd->free_rid(primary_geometry); }
+		if (receipt_marker.is_valid()) { rd->free_rid(receipt_marker); }
+		if (storage == storage_owner && storage) {
+			for (uint64_t token : leases) { CRASH_COND(!storage->rt_source_release(token)); }
+		}
+	}
+	tlas = RID();
+	primary_geometry = RID();
+	primary_instance_count = primary_normal_count = 0;
+	receipt_marker = RID();
+	blases.clear();
+	leases.clear();
+	owner = nullptr;
+	storage_owner = nullptr;
+	build_receipt.reset();
+	build_completion_accepted = false;
+}
+
+bool MetalFXViewportRTScene::is_fresh(uint64_t p_epoch) const {
+	if (!epoch || p_epoch != epoch || !tlas.is_valid() || !primary_geometry.is_valid() || RD::get_singleton() != owner || MeshStorage::get_singleton() != storage_owner) { return false; }
+	for (uint64_t token : leases) { if (!storage_owner->rt_source_lease_current(token)) { return false; } }
+	return true;
+}
+
+MetalFXViewportRTScene::BuildStatus MetalFXViewportRTScene::build_status() const {
+	if (!build_receipt || !owner || RD::get_singleton() != owner) { return BuildStatus::INVALID; }
+	if (build_completion_accepted) { return BuildStatus::READY; }
+	auto snapshot = build_receipt->completion->snapshot(owner->real_gpu_completion_now());
+	if (snapshot.failed) { return BuildStatus::FAILED; }
+	if (snapshot.pending) { return BuildStatus::PENDING; }
+	if (snapshot.count != 1 || snapshot.samples[0].frame != epoch) { return BuildStatus::FAILED; }
+	build_completion_accepted = true;
+	return BuildStatus::READY;
+}
+
+bool MetalFXViewportRTScene::is_current(uint64_t p_epoch) const {
+	return is_fresh(p_epoch) && build_status() == BuildStatus::READY;
+}
+
+bool MetalFXViewportRTScene::build(uint64_t p_epoch, const Vector<Surface> &p_surfaces) {
+	RD *rd = RD::get_singleton();
+	MeshStorage *storage = MeshStorage::get_singleton();
+	if (!p_epoch || p_epoch <= last_epoch || !rd || !storage || !storage->rt_sources_requested() ||
+			!rd->has_feature(RD::SUPPORTS_METAL_TRIANGLE_QUERY) || !rd->real_gpu_completion_supported() || p_surfaces.is_empty() || p_surfaces.size() > 16) { _clear(); return false; }
+	_clear();
+	owner = rd;
+	storage_owner = storage;
+	bool ok = false;
+	{
+		// No new source generation can be published or freed between admission
+		// and graph recording. Existing probe semantics handle reentrancy.
+		MutexLock lock(*storage->rt_source_mutex());
+		if (!storage->rt_probe_source_begin()) { _clear(); return false; }
+		do {
+			build_receipt = std::make_shared<MetalFXViewportBuildReceipt>();
+			build_receipt->completion = std::make_shared<RealGPUCompletion>();
+			if (!build_receipt->completion->reset(true, rd->real_gpu_completion_now())) { break; }
+			build_receipt->reservation = build_receipt->completion->reserve(p_epoch, rd->real_gpu_completion_now());
+			if (!build_receipt->reservation.generation) { break; }
+			receipt_marker = rd->storage_buffer_create(4);
+			if (!receipt_marker.is_valid()) { break; }
+			RD::CallbackResource marker;
+			marker.rid = receipt_marker;
+			marker.type = RD::CALLBACK_RESOURCE_TYPE_BUFFER;
+			marker.usage = RD::CALLBACK_RESOURCE_USAGE_STORAGE_BUFFER_READ_WRITE;
+			BuildCallback *first = memnew(BuildCallback);
+			first->receipt = build_receipt;
+			if (rd->driver_callback_add(mark_build_first, first, VectorView<RD::CallbackResource>(&marker, 1)) != OK) { memdelete(first); break; }
+			rd->metalfx_rt_probe_barrier();
+			Vector<RID> source_vertices;
+			Vector<RID> source_blases;
+			Vector<RD::AccelerationStructureInstance> instances;
+			MFXViewportPrimaryGeometry::Range ranges[MFXViewportPrimaryGeometry::MAX_INSTANCES] = {};
+			Vector<MFXViewportPrimaryGeometry::Normal> world_normals;
+			for (const Surface &surface : p_surfaces) {
+				const real_t det = surface.transform.basis.determinant();
+				if (!surface.mesh.is_valid() || surface.surface < 0 || !surface.expected_source_serial || !surface.transform.is_finite() || !surface.transform.basis.is_orthonormal() || !Math::is_finite(det) || det == 0) { break; }
+				RID vertices;
+				uint32_t count = 0;
+				uint64_t serial = 0, token = 0;
+				if (!storage->rt_source_acquire(surface.mesh, surface.surface, vertices, count, serial, token)) { break; }
+				leases.push_back(token);
+				if (serial != surface.expected_source_serial) { break; }
+				Vector<MFXViewportPrimaryGeometry::Normal> local_normals;
+				if (!storage->rt_source_primary_normals(surface.mesh, surface.surface, serial, local_normals) ||
+						count % 3 || local_normals.size() != count / 3) { break; }
+				const uint32_t start = world_normals.size();
+				const uint32_t n = local_normals.size();
+				constexpr uint32_t MAX_NORMALS = (8u * 1024u * 1024u - sizeof(ranges)) / sizeof(MFXViewportPrimaryGeometry::Normal);
+				if (!n || start > MAX_NORMALS || n > MAX_NORMALS - start || world_normals.resize(start + n) != OK) { break; }
+				bool normal_ok = true;
+				for (uint32_t j = 0; j < n; ++j) {
+					const auto &local = local_normals[j];
+					Vector3 normal = surface.transform.basis.xform(Vector3(local.x, local.y, local.z));
+					if (det < 0) { normal = -normal; }
+					const real_t length2 = normal.length_squared();
+					if (!normal.is_finite() || !Math::is_finite(length2) || length2 < 0.99 || length2 > 1.01) { normal_ok = false; break; }
+					world_normals.write[start + j] = { float(normal.x), float(normal.y), float(normal.z), 0.0f };
+				}
+				if (!normal_ok) { break; }
+				ranges[instances.size()] = { start, n, uint32_t(instances.size() + 1), 0 };
+				RID blas;
+				for (int j = 0; j < source_vertices.size(); ++j) {
+					if (source_vertices[j] == vertices) { blas = source_blases[j]; break; }
+				}
+				if (!blas.is_valid()) {
+					RD::AccelerationStructureGeometry geometry;
+					geometry.flags = RD::ACCELERATION_STRUCTURE_GEOMETRY_OPAQUE_BIT;
+					geometry.vertex_buffer = vertices;
+					geometry.vertex_count = count;
+					geometry.vertex_stride = 12;
+					geometry.vertex_format = RD::DATA_FORMAT_R32G32B32_SFLOAT;
+					blas = rd->blas_create(Span<RD::AccelerationStructureGeometry>(&geometry, 1), {});
+					if (!blas.is_valid()) { break; }
+					blases.push_back(blas);
+					if (rd->blas_build(blas) != OK) { break; }
+				}
+				source_vertices.push_back(vertices);
+				source_blases.push_back(blas);
+				RD::AccelerationStructureInstance instance;
+				instance.blas = blas;
+				instance.transform = surface.transform;
+				instance.id = instances.size() + 1;
+				instances.push_back(instance);
+			}
+			if (instances.size() != p_surfaces.size() || storage->rt_probe_source_changed()) { break; }
+			if (!MFXViewportPrimaryGeometry::valid_ranges(ranges, instances.size(), world_normals.size())) { break; }
+			const uint64_t packed_size = sizeof(ranges) + uint64_t(world_normals.size()) * sizeof(MFXViewportPrimaryGeometry::Normal);
+			if (!primary_buffer_budget.consume(packed_size)) { break; }
+			Vector<uint8_t> packed;
+			if (packed.resize(packed_size) != OK) { break; }
+			memcpy(packed.ptrw(), ranges, sizeof(ranges));
+			memcpy(packed.ptrw() + sizeof(ranges), world_normals.ptr(), packed_size - sizeof(ranges));
+			primary_geometry = rd->storage_buffer_create_metalfx_primary(uint32_t(packed_size), packed);
+			if (!primary_geometry.is_valid()) { break; }
+			primary_instance_count = instances.size();
+			primary_normal_count = world_normals.size();
+			tlas = rd->tlas_create(instances.size(), {});
+			if (!tlas.is_valid() || rd->tlas_build(tlas, Span<RD::AccelerationStructureInstance>(instances.ptr(), instances.size())) != OK || storage->rt_probe_source_changed()) { break; }
+			build_receipt->tlas = rd->metalfx_rt_native_tlas(tlas);
+			if (!build_receipt->tlas.id) { break; }
+			rd->metalfx_rt_probe_barrier();
+			BuildCallback *last = memnew(BuildCallback);
+			last->receipt = build_receipt;
+			if (rd->driver_callback_add(observe_build_last, last, VectorView<RD::CallbackResource>(&marker, 1)) != OK) { memdelete(last); break; }
+			epoch = p_epoch;
+			if (!is_fresh(p_epoch)) { break; }
+			ok = true;
+		} while (false);
+		if (!ok) {
+			if (build_receipt && build_receipt->reservation.generation) { build_receipt->completion->fail(build_receipt->reservation, "build_enqueue_failed"); }
+			_clear();
+		}
+		storage->rt_probe_source_end();
+	}
+	if (ok) { last_epoch = p_epoch; }
+	return ok; // Builds are graph-enqueued, not GPU-completed.
+}
diff --git a/servers/rendering/renderer_rd/effects/metalfx_viewport_rt_scene.h b/servers/rendering/renderer_rd/effects/metalfx_viewport_rt_scene.h
