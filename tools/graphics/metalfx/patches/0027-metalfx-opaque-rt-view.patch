diff --git a/drivers/metal/openrc_immutable_argument_upload.h b/drivers/metal/openrc_immutable_argument_upload.h
new file mode 100644
--- /dev/null
+++ b/drivers/metal/openrc_immutable_argument_upload.h
@@ -0,0 +1,41 @@
+// SPDX-License-Identifier: MIT
+#pragma once
+
+#include <cstddef>
+#include <cstdint>
+#include <cstring>
+#include <utility>
+
+namespace OpenRCImmutableArguments {
+
+// Per-set requested bytes; excludes allocator/driver overhead and other sets.
+constexpr std::size_t MAX_BYTES = 1024 * 1024;
+
+inline bool eligible(bool p_triangle_query, bool p_tracked_mode, bool p_tracked_resource, bool p_unified, bool p_argument_buffers) {
+	return p_triangle_query && p_tracked_mode && p_tracked_resource && p_unified && p_argument_buffers;
+}
+
+inline bool slots_fit(std::size_t p_first, std::size_t p_count, std::size_t p_size) {
+	const std::size_t slots = p_size / sizeof(std::uint64_t);
+	return p_size % sizeof(std::uint64_t) == 0 && p_count != 0 && p_first < slots && p_count <= slots - p_first;
+}
+
+// Allocate an independent buffer and write once before publishing its owner.
+// It must never be rewritten while a command can reference it.
+template <typename Buffer, typename Allocate, typename Map, typename Release>
+bool create(Buffer &r_output, const void *p_data, std::size_t p_size, Allocate p_allocate, Map p_map, Release p_release) {
+	if (!p_data || p_size == 0 || p_size > MAX_BYTES) {
+		return false;
+	}
+	Buffer candidate = p_allocate(p_size);
+	void *destination = p_map(candidate);
+	if (!destination) {
+		p_release(candidate);
+		return false;
+	}
+	std::memcpy(destination, p_data, p_size);
+	r_output = std::move(candidate);
+	return true;
+}
+
+} // namespace OpenRCImmutableArguments
