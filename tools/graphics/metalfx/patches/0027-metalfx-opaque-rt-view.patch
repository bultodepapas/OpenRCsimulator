+/**************************************************************************/
+/*  metalfx_viewport_rt_scene.h                                           */
+/**************************************************************************/
+/* Copyright (c) 2026 OpenRC Simulator contributors.                      */
+/* SPDX-License-Identifier: MIT                                           */
+/**************************************************************************/
+#pragma once
+
+#include "servers/rendering/renderer_rd/storage_rd/mesh_storage.h"
+
+namespace RendererRD {
+struct MetalFXViewportBuildReceipt;
+
+// Private per-viewport generation. The caller must supply the conservative
+// whole-scenario admission result and revalidate its scene/material epoch.
+// Source leases alone do not validate instance, transform or material changes.
+class MetalFXViewportRTScene {
+public:
+	struct Surface {
+		RID instance;
+		uint64_t instance_version = 0;
+		RID mesh;
+		RID material;
+		int surface = -1;
+		uint64_t expected_source_serial = 0;
+		Transform3D transform;
+	};
+
+private:
+	RenderingDevice *owner = nullptr;
+	MeshStorage *storage_owner = nullptr;
+	RID tlas, primary_geometry;
+	RID receipt_marker;
+	Vector<RID> blases;
+	Vector<uint64_t> leases;
+	uint64_t epoch = 0;
+	uint64_t last_epoch = 0;
+	uint32_t primary_instance_count = 0, primary_normal_count = 0;
+	std::shared_ptr<MetalFXViewportBuildReceipt> build_receipt;
+	mutable bool build_completion_accepted = false;
+	void _clear();
+
+public:
+	MetalFXViewportRTScene() = default;
+	MetalFXViewportRTScene(const MetalFXViewportRTScene &) = delete;
+	MetalFXViewportRTScene &operator=(const MetalFXViewportRTScene &) = delete;
+	~MetalFXViewportRTScene() { _clear(); }
+	bool build(uint64_t p_epoch, const Vector<Surface> &p_surfaces);
+	enum class BuildStatus { INVALID, PENDING, READY, FAILED };
+	bool is_fresh(uint64_t p_epoch) const;
+	BuildStatus build_status() const;
+	bool is_current(uint64_t p_epoch) const;
+	RID get_current_tlas(uint64_t p_epoch) const { return is_current(p_epoch) ? tlas : RID(); }
+	RID get_current_primary_geometry(uint64_t p_epoch) const { return is_current(p_epoch) ? primary_geometry : RID(); }
+	uint32_t get_primary_instance_count(uint64_t p_epoch) const { return is_current(p_epoch) ? primary_instance_count : 0; }
+	uint32_t get_primary_normal_count(uint64_t p_epoch) const { return is_current(p_epoch) ? primary_normal_count : 0; }
+	void invalidate() { _clear(); }
+};
+} // namespace RendererRD
diff --git a/servers/rendering/renderer_rd/effects/metalfx_viewport_visibility.cpp b/servers/rendering/renderer_rd/effects/metalfx_viewport_visibility.cpp
new file mode 100644
--- /dev/null
+++ b/servers/rendering/renderer_rd/effects/metalfx_viewport_visibility.cpp
@@ -0,0 +1,297 @@
+/**************************************************************************/
+/*  metalfx_viewport_visibility.cpp                                       */
+/**************************************************************************/
+/* Copyright (c) 2026 OpenRC Simulator contributors.                      */
+/* SPDX-License-Identifier: MIT                                           */
+/**************************************************************************/
+
+#include "metalfx_viewport_visibility.h"
+
+#include "core/math/math_funcs.h"
+#include "servers/rendering/storage/metalfx_viewport_numeric.h"
+
+using namespace RendererRD;
+
+// Primary hits and one secondary visibility ray come from the captured TLAS.
+// This estimates only constant-environment diffuse visibility, not full GI.
+static const char *metalfx_viewport_visibility_shader = R"GLSL(#version 460
+#extension GL_EXT_ray_query : require
+layout(local_size_x=8,local_size_y=8,local_size_z=1) in;
+layout(set=0,binding=0) uniform accelerationStructureEXT scene;
+layout(set=0,binding=1,std430) readonly buffer Geometry { uvec4 ranges[16]; vec4 normals[]; } geometry;
+layout(set=0,binding=2,rgba16f) uniform writeonly image2D noisy_output;
+layout(set=0,binding=3,r32f) uniform writeonly image2D primary_depth;
+layout(set=0,binding=4,rgba16f) uniform writeonly image2D diffuse_albedo;
+layout(set=0,binding=5,rgba16f) uniform writeonly image2D specular_albedo;
+layout(set=0,binding=6,rgba16f) uniform writeonly image2D world_normal;
+layout(set=0,binding=7,r16f) uniform writeonly image2D roughness;
+layout(push_constant,std430) uniform Push {
+    mat4 world_from_clip;
+    vec4 environment_epsilon;
+    uvec4 dimensions; // width, height, sample, instance count
+    uvec4 limits; // normal count, reserved
+    vec4 background;
+} pc;
+uint hash32(uint x) {
+    x ^= x >> 16; x *= 0x7feb352du; x ^= x >> 15;
+    x *= 0x846ca68bu; x ^= x >> 16; return x;
+}
+float rand01(uint x) { return (float(hash32(x) & 0x00ffffffu) + 0.5) * (1.0 / 16777216.0); }
+void no_hit(ivec2 p) {
+    imageStore(noisy_output, p, vec4(pc.background.rgb, 1)); imageStore(primary_depth, p, vec4(0));
+    imageStore(diffuse_albedo, p, vec4(0)); imageStore(specular_albedo, p, vec4(0));
+    // There is no scene surface here. Supply finite SDK background values;
+    // primary_depth stays zero so the consumer writes the exact background.
+    imageStore(world_normal, p, vec4(0, 0, 1, 1)); imageStore(roughness, p, vec4(1));
+}
+void main() {
+    uvec2 p = gl_GlobalInvocationID.xy;
+    if (p.x >= pc.dimensions.x || p.y >= pc.dimensions.y) { return; }
+    ivec2 pixel = ivec2(p);
+    vec2 uv = (vec2(p) + vec2(0.5)) / vec2(pc.dimensions.xy);
+    vec4 hn = pc.world_from_clip * vec4(uv * 2.0 - 1.0, 1.0, 1.0);
+    vec4 hf = pc.world_from_clip * vec4(uv * 2.0 - 1.0, 0.0, 1.0);
+    vec3 near_point = hn.xyz / hn.w, far_point = hf.xyz / hf.w;
+    vec3 segment = far_point - near_point;
+    float distance_limit = length(segment);
+    if (any(isnan(near_point)) || any(isinf(near_point)) || any(isnan(far_point)) || any(isinf(far_point)) ||
+            isnan(distance_limit) || isinf(distance_limit) || distance_limit <= 0.0 || distance_limit > 1e7) { no_hit(pixel); return; }
+    vec3 direction_primary = segment / distance_limit;
+    rayQueryEXT primary;
+    rayQueryInitializeEXT(primary, scene, gl_RayFlagsOpaqueEXT, 0xff, near_point, 0.0, direction_primary, distance_limit);
+    while (rayQueryProceedEXT(primary)) {}
+    if (rayQueryGetIntersectionTypeEXT(primary, true) != gl_RayQueryCommittedIntersectionTriangleEXT) { no_hit(pixel); return; }
+    uint id = rayQueryGetIntersectionInstanceCustomIndexEXT(primary, true);
+    uint primitive = rayQueryGetIntersectionPrimitiveIndexEXT(primary, true);
+    if (id == 0 || id > pc.dimensions.w || id > 16) { no_hit(pixel); return; }
+    uvec4 range = geometry.ranges[id - 1];
+    if (range.z != id || range.w != 0 || primitive >= range.y || range.x >= pc.limits.x || primitive >= pc.limits.x - range.x) { no_hit(pixel); return; }
+    vec3 n = geometry.normals[range.x + primitive].xyz;
+    float n2 = dot(n,n);
+    float distance = rayQueryGetIntersectionTEXT(primary, true);
+    float fraction = clamp(distance / distance_limit, 0.0, 1.0);
+    float denominator = fraction * hn.w + (1.0 - fraction) * hf.w;
+    float depth = (1.0 - fraction) * hf.w / denominator;
+    if (any(isnan(n)) || any(isinf(n)) || n2 < 0.99 || n2 > 1.01 || isnan(depth) || isinf(depth) || depth <= 0.0 || depth > 1.0) { no_hit(pixel); return; }
+    n = normalize(n);
+    if (dot(n, direction_primary) > 0.0) { n = -n; }
+    vec3 position = near_point + direction_primary * distance;
+    vec3 albedo = vec3(0.6, 0.5, 0.3); // Exact admitted real material literals.
+    uint seed = (p.y * pc.dimensions.x + p.x) ^ (pc.dimensions.z * 0x9e3779b9u);
+    float u = rand01(seed), v = rand01(seed ^ 0x68bc21ebu);
+    float radius = sqrt(u), phi = 6.283185307179586 * v;
+    vec3 tangent = normalize(cross(abs(n.z) < 0.999 ? vec3(0,0,1) : vec3(0,1,0), n));
+    vec3 bitangent = cross(n, tangent);
+    vec3 direction = normalize(tangent * (radius * cos(phi)) + bitangent * (radius * sin(phi)) + n * sqrt(1.0 - u));
+    rayQueryEXT query;
+    rayQueryInitializeEXT(query, scene, gl_RayFlagsOpaqueEXT, 0xff,
+        position + n * pc.environment_epsilon.w, 0.0, direction, 1000.0);
+    while (rayQueryProceedEXT(query)) {}
+    bool blocked = rayQueryGetIntersectionTypeEXT(query, true) == gl_RayQueryCommittedIntersectionTriangleEXT;
+    imageStore(noisy_output, pixel, vec4(blocked ? vec3(0.0) : albedo * pc.environment_epsilon.rgb, 1.0));
+    imageStore(primary_depth, pixel, vec4(depth));
+    imageStore(diffuse_albedo, pixel, vec4(albedo, 1.0));
+    imageStore(specular_albedo, pixel, vec4(0, 0, 0, 1));
+    imageStore(world_normal, pixel, vec4(n, 1.0));
+    imageStore(roughness, pixel, vec4(0.6));
+}
+)GLSL";
+
+// Invoked in the native denoiser callback only after successful SDK encoding
+// and completion registration. Every target pixel belongs to this opaque RT view.
+static const char *metalfx_viewport_consumer_shader = R"GLSL(#version 460
+layout(local_size_x=8,local_size_y=8,local_size_z=1) in;
+layout(set=0,binding=0) uniform sampler2D denoised;
+layout(set=0,binding=1,rgba16f) uniform writeonly image2D target;
+layout(set=0,binding=2) uniform sampler2D primary_depth;
+layout(push_constant,std430) uniform Push { vec4 background; } pc;
+void main() {
+    ivec2 pixel = ivec2(gl_GlobalInvocationID.xy);
+    if (any(greaterThanEqual(pixel, imageSize(target)))) { return; }
+    float traced = texelFetch(primary_depth, pixel, 0).r;
+    vec3 filtered = texelFetch(denoised, pixel, 0).rgb;
+    bool valid_hit = !isnan(traced) && !isinf(traced) && traced > 0.0;
+    bool finite_output = !any(isnan(filtered)) && !any(isinf(filtered));
+    vec3 color = valid_hit && finite_output ? filtered : pc.background.rgb;
+    imageStore(target, pixel, vec4(color, 1.0));
+}
+)GLSL";
+
+static const char *metalfx_depth_vertex = R"GLSL(#version 450
+void main() {
+    vec2 p[3] = vec2[3](vec2(-1,-1), vec2(3,-1), vec2(-1,3));
+    gl_Position = vec4(p[gl_VertexIndex], 0, 1);
+}
+)GLSL";
+static const char *metalfx_depth_fragment = R"GLSL(#version 450
+layout(set=0,binding=0) uniform sampler2D reversed_depth;
+void main() { gl_FragDepth = 1.0 - texelFetch(reversed_depth, ivec2(gl_FragCoord.xy), 0).r; }
+)GLSL";
+
+MetalFXViewportVisibility::~MetalFXViewportVisibility() {
+	RenderingDevice *rd = RenderingDevice::get_singleton();
+	if (rd != owner || !rd) { return; }
+	if (pipeline.is_valid() && rd->compute_pipeline_is_valid(pipeline)) { rd->free_rid(pipeline); }
+	if (consumer_pipeline.is_valid() && rd->compute_pipeline_is_valid(consumer_pipeline)) { rd->free_rid(consumer_pipeline); }
+	if (depth_pipeline.is_valid() && rd->render_pipeline_is_valid(depth_pipeline)) { rd->free_rid(depth_pipeline); }
+	if (shader.is_valid()) { rd->free_rid(shader); }
+	if (consumer_shader.is_valid()) { rd->free_rid(consumer_shader); }
+	if (depth_shader.is_valid()) { rd->free_rid(depth_shader); }
+	if (sampler.is_valid()) { rd->free_rid(sampler); }
+}
+
+bool MetalFXViewportVisibility::begin_generation(uint64_t p_epoch) {
+	RenderingDevice *rd = RenderingDevice::get_singleton();
+	if (!p_epoch || p_epoch <= last_epoch || !rd || (owner && owner != rd) || !rd->has_feature(RD::SUPPORTS_METAL_TRIANGLE_QUERY)) { invalidate(); return false; }
+	invalidate();
+	if (!pipeline.is_valid()) {
+		String error;
+		RD::ShaderStageSPIRVData stage;
+		stage.shader_stage = RD::SHADER_STAGE_COMPUTE;
+		stage.spirv = rd->shader_compile_spirv_from_source(stage.shader_stage, metalfx_viewport_visibility_shader, RD::SHADER_LANGUAGE_GLSL, &error, false);
+		if (stage.spirv.is_empty()) { return false; }
+		Vector<RD::ShaderStageSPIRVData> stages;
+		stages.push_back(stage);
+		RID new_shader = rd->shader_create_from_spirv(stages, "openrc_metalfx_viewport_visibility");
+		if (!new_shader.is_valid()) { return false; }
+		RID new_pipeline = rd->compute_pipeline_create(new_shader);
+		if (!new_pipeline.is_valid()) { rd->free_rid(new_shader); return false; }
+		RD::SamplerState sampler_state;
+		RID new_sampler = rd->sampler_create(sampler_state);
+		if (!new_sampler.is_valid()) { rd->free_rid(new_pipeline); rd->free_rid(new_shader); return false; }
+		owner = rd;
+		shader = new_shader;
+		pipeline = new_pipeline;
+		sampler = new_sampler;
+	}
+	if (!consumer_pipeline.is_valid()) {
+		String error;
+		RD::ShaderStageSPIRVData stage;
+		stage.shader_stage = RD::SHADER_STAGE_COMPUTE;
+		stage.spirv = rd->shader_compile_spirv_from_source(stage.shader_stage, metalfx_viewport_consumer_shader, RD::SHADER_LANGUAGE_GLSL, &error, false);
+		if (stage.spirv.is_empty()) { return false; }
+		Vector<RD::ShaderStageSPIRVData> stages;
+		stages.push_back(stage);
+		RID new_shader = rd->shader_create_from_spirv(stages, "openrc_metalfx_viewport_consumer");
+		if (!new_shader.is_valid()) { return false; }
+		RID new_pipeline = rd->compute_pipeline_create(new_shader);
+		if (!new_pipeline.is_valid()) { rd->free_rid(new_shader); return false; }
+		consumer_shader = new_shader;
+		consumer_pipeline = new_pipeline;
+	}
+	if (!depth_shader.is_valid()) {
+		Vector<RD::ShaderStageSPIRVData> stages;
+		String error;
+		for (int i = 0; i < 2; ++i) {
+			RD::ShaderStageSPIRVData stage;
+			stage.shader_stage = i == 0 ? RD::SHADER_STAGE_VERTEX : RD::SHADER_STAGE_FRAGMENT;
+			stage.spirv = rd->shader_compile_spirv_from_source(stage.shader_stage, i == 0 ? metalfx_depth_vertex : metalfx_depth_fragment, RD::SHADER_LANGUAGE_GLSL, &error, false);
+			if (stage.spirv.is_empty()) { return false; }
+			stages.push_back(stage);
+		}
+		depth_shader = rd->shader_create_from_spirv(stages, "openrc_metalfx_viewport_depth");
+		if (!depth_shader.is_valid()) { return false; }
+	}
+	epoch = p_epoch;
+	last_epoch = p_epoch;
+	return true;
+}
+
+bool MetalFXViewportVisibility::dispatch(const Inputs &p) {
+	RD *rd = RD::get_singleton();
+	if (!rd || rd != owner || !epoch || p.epoch != epoch || !p.scene.is_valid() || !p.geometry.is_valid() || !pipeline.is_valid() ||
+			!p.instance_count || p.instance_count > 16 || !p.normal_count ||
+			p.size.x <= 0 || p.size.y <= 0 || p.size.x > 16384 || p.size.y > 16384 ||
+			!MFXViewportNumeric::environment_channel(p.linear_environment.r) || !MFXViewportNumeric::environment_channel(p.linear_environment.g) || !MFXViewportNumeric::environment_channel(p.linear_environment.b) ||
+			!MFXViewportNumeric::environment_channel(p.linear_background.r) || !MFXViewportNumeric::environment_channel(p.linear_background.g) || !MFXViewportNumeric::environment_channel(p.linear_background.b) ||
+			!Math::is_finite(p.ray_epsilon) || p.ray_epsilon <= 0 || p.ray_distance != 1000.0f) { invalidate(); return false; }
+	const RID textures[6] = { p.noisy_output, p.primary_depth, p.diffuse_albedo, p.specular_albedo, p.world_normal, p.roughness };
+	const RD::DataFormat formats[6] = { RD::DATA_FORMAT_R16G16B16A16_SFLOAT, RD::DATA_FORMAT_R32_SFLOAT,
+		RD::DATA_FORMAT_R16G16B16A16_SFLOAT, RD::DATA_FORMAT_R16G16B16A16_SFLOAT,
+		RD::DATA_FORMAT_R16G16B16A16_SFLOAT, RD::DATA_FORMAT_R16_SFLOAT };
+	for (int i = 0; i < 6; ++i) {
+		if (!rd->metalfx_viewport_texture_is_private(textures[i])) { invalidate(); return false; }
+		for (int j = 0; j < i; ++j) { if (textures[i] == textures[j]) { invalidate(); return false; } }
+		RD::TextureFormat f = rd->texture_get_format(textures[i]);
+		if (f.format != formats[i] || f.width != uint32_t(p.size.x) || f.height != uint32_t(p.size.y) ||
+				f.depth != 1 || f.array_layers != 1 || f.mipmaps != 1 || f.texture_type != RD::TEXTURE_TYPE_2D ||
+				f.samples != RD::TEXTURE_SAMPLES_1 || !(f.usage_bits & RD::TEXTURE_USAGE_STORAGE_BIT) ||
+				f.is_discardable || f.is_resolve_buffer || f.is_subsampled) { invalidate(); return false; }
+	}
+	Vector<RD::Uniform> uniforms;
+	uniforms.push_back(RD::Uniform(RD::UNIFORM_TYPE_ACCELERATION_STRUCTURE, 0, p.scene));
+	uniforms.push_back(RD::Uniform(RD::UNIFORM_TYPE_STORAGE_BUFFER, 1, p.geometry));
+	for (int i = 0; i < 6; ++i) { uniforms.push_back(RD::Uniform(RD::UNIFORM_TYPE_IMAGE, i + 2, textures[i])); }
+	RID set = rd->metalfx_shared_uniform_sets_supported() ? rd->metalfx_shared_uniform_set_create(uniforms, shader, 0) : rd->uniform_set_create(uniforms, shader, 0);
+	if (!set.is_valid()) { invalidate(); return false; }
+	struct Push { float world_from_clip[16]; float environment_epsilon[4]; uint32_t dimensions[4]; uint32_t limits[4]; float background[4]; } push = {};
+	static_assert(sizeof(Push) == 128, "primary shader push constant layout");
+	for (int c = 0; c < 4; ++c) {
+		for (int r = 0; r < 4; ++r) {
+			push.world_from_clip[c * 4 + r] = float(p.world_from_clip[c][r]);
+			if (!Math::is_finite(push.world_from_clip[c * 4 + r])) { rd->free_rid(set); invalidate(); return false; }
+		}
+	}
+	if (!MFXViewportNumeric::primary_ray_domain_safe(push.world_from_clip) ||
+			!Math::is_finite(p.world_from_clip.determinant()) || p.world_from_clip.determinant() == 0) { rd->free_rid(set); invalidate(); return false; }
+	push.environment_epsilon[0] = p.linear_environment.r;
+	push.environment_epsilon[1] = p.linear_environment.g;
+	push.environment_epsilon[2] = p.linear_environment.b;
+	push.environment_epsilon[3] = p.ray_epsilon;
+	push.dimensions[0] = uint32_t(p.size.x);
+	push.dimensions[1] = uint32_t(p.size.y);
+	push.dimensions[2] = p.sample;
+	push.dimensions[3] = p.instance_count;
+	push.limits[0] = p.normal_count;
+	push.background[0] = p.linear_background.r; push.background[1] = p.linear_background.g; push.background[2] = p.linear_background.b; push.background[3] = 1.0f;
+	RD::ComputeListID list = rd->compute_list_begin();
+	if (list < 0) { rd->free_rid(set); invalidate(); return false; }
+	if (!rd->compute_list_enable_metalfx_input_checks(list)) { rd->compute_list_end(); rd->free_rid(set); invalidate(); return false; }
+	rd->compute_list_bind_compute_pipeline(list, pipeline);
+	rd->compute_list_bind_uniform_set(list, set, 0);
+	rd->compute_list_set_push_constant(list, &push, sizeof(push));
+	rd->compute_list_dispatch(list, (uint32_t(p.size.x) + 7) / 8, (uint32_t(p.size.y) + 7) / 8, 1);
+	rd->compute_list_end();
+	rd->free_rid(set);
+	return true; // The same-command dispatch ledger and later GPU receipt remain required.
+}
+bool MetalFXViewportVisibility::convert_depth(RID p_viewport_depth, RID p_denoised_depth, Size2i p_size) {
+	RD *rd = RD::get_singleton();
+	if (!rd || rd != owner || !epoch || p_size.x <= 0 || p_size.y <= 0 || p_viewport_depth == p_denoised_depth ||
+			!rd->metalfx_viewport_texture_is_private(p_viewport_depth) || !rd->metalfx_viewport_texture_is_private(p_denoised_depth)) { invalidate(); return false; }
+	RD::TextureFormat src = rd->texture_get_format(p_viewport_depth);
+	RD::TextureFormat dst = rd->texture_get_format(p_denoised_depth);
+	bool source_format = src.format == RD::DATA_FORMAT_R32_SFLOAT;
+	if (!source_format || dst.format != RD::DATA_FORMAT_D32_SFLOAT || src.width != uint32_t(p_size.x) || src.height != uint32_t(p_size.y) || dst.width != src.width || dst.height != src.height ||
+			src.texture_type != RD::TEXTURE_TYPE_2D || dst.texture_type != RD::TEXTURE_TYPE_2D || src.array_layers != 1 || dst.array_layers != 1 || src.mipmaps != 1 || dst.mipmaps != 1 ||
+			src.samples != RD::TEXTURE_SAMPLES_1 || dst.samples != RD::TEXTURE_SAMPLES_1 || !(src.usage_bits & RD::TEXTURE_USAGE_SAMPLING_BIT) || !(dst.usage_bits & RD::TEXTURE_USAGE_DEPTH_STENCIL_ATTACHMENT_BIT)) { invalidate(); return false; }
+	RID framebuffer = rd->framebuffer_create(Vector<RID>({ p_denoised_depth }));
+	if (!framebuffer.is_valid()) { invalidate(); return false; }
+	RD::FramebufferFormatID format = rd->framebuffer_get_format(framebuffer);
+	if (!depth_pipeline.is_valid() || depth_pipeline_format != format) {
+		if (depth_pipeline.is_valid()) { rd->free_rid(depth_pipeline); }
+		RD::PipelineDepthStencilState depth_state;
+		depth_state.enable_depth_test = true;
+		depth_state.enable_depth_write = true;
+		depth_state.depth_compare_operator = RD::COMPARE_OP_ALWAYS;
+		depth_pipeline = rd->render_pipeline_create(depth_shader, format, RD::INVALID_ID, RD::RENDER_PRIMITIVE_TRIANGLES, RD::PipelineRasterizationState(), RD::PipelineMultisampleState(), depth_state, RD::PipelineColorBlendState());
+		depth_pipeline_format = format;
+	}
+	if (!depth_pipeline.is_valid()) { rd->free_rid(framebuffer); invalidate(); return false; }
+	Vector<RD::Uniform> uniforms;
+	uniforms.push_back(RD::Uniform(RD::UNIFORM_TYPE_SAMPLER_WITH_TEXTURE, 0, Vector<RID>({ sampler, p_viewport_depth })));
+	RID set = rd->metalfx_shared_uniform_sets_supported() ? rd->metalfx_shared_uniform_set_create(uniforms, depth_shader, 0) : rd->uniform_set_create(uniforms, depth_shader, 0);
+	if (!set.is_valid()) { rd->free_rid(framebuffer); invalidate(); return false; }
+	RD::DrawListID draw = rd->draw_list_begin(framebuffer, RD::DRAW_CLEAR_DEPTH);
+	if (draw < 0) { rd->free_rid(set); rd->free_rid(framebuffer); invalidate(); return false; }
+	if (!rd->draw_list_enable_metalfx_input_checks(draw, true)) { rd->draw_list_end(); rd->free_rid(set); rd->free_rid(framebuffer); invalidate(); return false; }
+	rd->draw_list_bind_render_pipeline(draw, depth_pipeline);
+	rd->draw_list_bind_uniform_set(draw, set, 0);
+	rd->draw_list_draw(draw, false, 1, 3);
+	const bool inputs_valid = rd->draw_list_metalfx_inputs_valid(draw);
+	rd->draw_list_end();
+	rd->free_rid(set);
+	rd->free_rid(framebuffer);
+	if (!inputs_valid) { invalidate(); return false; }
+	return true;
+}
