diff --git a/servers/rendering/renderer_rd/effects/metalfx_viewport_denoised.cpp b/servers/rendering/renderer_rd/effects/metalfx_viewport_denoised.cpp
new file mode 100644
--- /dev/null
+++ b/servers/rendering/renderer_rd/effects/metalfx_viewport_denoised.cpp
@@ -0,0 +1,309 @@
+/**************************************************************************/
+/*  metalfx_viewport_denoised.cpp                                         */
+/**************************************************************************/
+/* Copyright (c) 2026 OpenRC Simulator contributors.                      */
+/* SPDX-License-Identifier: MIT                                           */
+/**************************************************************************/
+
+#include "metalfx_viewport_denoised.h"
+
+using namespace RendererRD;
+
+namespace {
+// Remains false until the actual primary producer and input receipts qualify.
+constexpr bool GUIDE_INPUT_RECEIPT_IMPLEMENTED = false;
+struct FrameProofCallback { std::shared_ptr<MFXViewportCallback::CommandProof> proof; };
+struct DrawProofCallback {
+	std::shared_ptr<MFXViewportCallback::CommandProof> proof;
+	uint32_t stage = 0;
+	uint32_t expected = 0;
+	bool begin = false;
+};
+void mark_frame_first(RenderingDeviceDriver *p_driver, RenderingDeviceDriver::CommandBufferID p_command, void *p_data) {
+	FrameProofCallback *callback = static_cast<FrameProofCallback *>(p_data);
+	uint64_t command = p_driver->metalfx_rt_command_buffer_identity(p_command);
+	const auto proof = callback->proof;
+	if (!command || !p_driver->metalfx_rt_track_dispatch_begin(p_command, RenderingDeviceDriver::PipelineID(proof->pipeline))) { command = 0; }
+	callback->proof->first_command.store(command, std::memory_order_release);
+	memdelete(callback);
+}
+void mark_draw_stage(RenderingDeviceDriver *p_driver, RenderingDeviceDriver::CommandBufferID p_command, void *p_data) {
+	DrawProofCallback *callback = static_cast<DrawProofCallback *>(p_data);
+	auto proof = callback->proof;
+	if (callback->begin && proof->draw_failed.load(std::memory_order_acquire)) { memdelete(callback); return; }
+	const uint64_t first = proof->first_command.load(std::memory_order_acquire);
+	const uint64_t last = p_driver->metalfx_rt_command_buffer_identity(p_command);
+	const uint64_t token = reinterpret_cast<uint64_t>(proof.get());
+	bool ok = MFXViewportCallback::same_command(first, last);
+	if (ok) {
+		ok = callback->begin ? p_driver->metalfx_rt_track_draw_begin(p_command, token, callback->stage) :
+				p_driver->metalfx_rt_track_draw_finish(p_command, token, callback->expected);
+	}
+	if (!ok) { proof->draw_failed.store(true, std::memory_order_release); }
+	else if (!callback->begin) { proof->completed_draw_stages.fetch_or(callback->stage, std::memory_order_release); }
+	memdelete(callback);
+}
+} // namespace
+
+MetalFXViewportDenoised::~MetalFXViewportDenoised() { clear_gpu(); }
+
+void MetalFXViewportDenoised::clear_gpu() {
+	active_epoch = 0;
+	authorized_frame = 0;
+	scene.invalidate();
+	visibility.invalidate();
+	RD *rd = RD::get_singleton();
+	if (rd && rd == owner) {
+		if (primary_depth.is_valid() && rd->texture_is_valid(primary_depth)) { rd->free_rid(primary_depth); }
+		if (context.is_valid()) { rd->free_rid(context); }
+		for (RID texture : textures) { if (texture.is_valid() && rd->texture_is_valid(texture)) { rd->free_rid(texture); } }
+	}
+	primary_depth = RID();
+	context = RID();
+	for (RID &texture : textures) { texture = RID(); }
+	completion.reset();
+	last_enqueued_frame = last_enqueued_serial = completed_frame = completed_serial = 0;
+	frame_proof.reset();
+	size = Size2i();
+	owner = nullptr;
+}
+
+void MetalFXViewportDenoised::reject(const char *p_reason) {
+	scene.invalidate();
+	visibility.invalidate();
+	active_epoch = 0;
+	authorized_frame = 0;
+	frame_proof.reset();
+	previous_surfaces.clear();
+	previous_scenario = RID();
+	have_previous = false;
+	reason = p_reason;
+}
+
+bool MetalFXViewportDenoised::allocate(Size2i p_size) {
+	RD *rd = RD::get_singleton();
+	if (!rd || p_size.x <= 0 || p_size.y <= 0) { reason = "invalid_viewport_size"; return false; }
+	owner = rd;
+	Dictionary created = rd->metalfx_denoised_create(p_size, p_size);
+	if (String(created.get("status", "")) != "created") { reason = String(created.get("status", "factory_failed")); faulted = true; return false; }
+	context = created["context"];
+	const RD::DataFormat formats[9] = { RD::DATA_FORMAT_R16G16B16A16_SFLOAT, RD::DATA_FORMAT_D32_SFLOAT,
+		RD::DATA_FORMAT_R16G16_SFLOAT, RD::DATA_FORMAT_R16G16B16A16_SFLOAT, RD::DATA_FORMAT_R16G16B16A16_SFLOAT,
+		RD::DATA_FORMAT_R16G16B16A16_SFLOAT, RD::DATA_FORMAT_R16_SFLOAT, RD::DATA_FORMAT_R16_SFLOAT, RD::DATA_FORMAT_R16G16B16A16_SFLOAT };
+	const uint32_t sample = RD::TEXTURE_USAGE_SAMPLING_BIT;
+	const uint32_t storage = RD::TEXTURE_USAGE_STORAGE_BIT;
+	const uint32_t clear = RD::TEXTURE_USAGE_CAN_COPY_TO_BIT;
+	const uint32_t usage[9] = { sample | storage, sample | RD::TEXTURE_USAGE_DEPTH_STENCIL_ATTACHMENT_BIT,
+		sample | clear, sample | storage, sample | storage, sample | storage, sample | storage, sample | clear, sample | storage | RD::TEXTURE_USAGE_COLOR_ATTACHMENT_BIT };
+	for (int i = 0; i < 9; ++i) {
+		if (!rd->texture_is_format_supported_for_usage(formats[i], usage[i])) { clear_gpu(); reason = "texture_format_unsupported"; faulted = true; return false; }
+		RD::TextureFormat format;
+		format.format = formats[i];
+		format.width = i == 7 ? 1 : p_size.x;
+		format.height = i == 7 ? 1 : p_size.y;
+		format.usage_bits = usage[i];
+		textures[i] = rd->texture_create(format, RD::TextureView());
+		if (!textures[i].is_valid()) { clear_gpu(); reason = "texture_allocation_failed"; faulted = true; return false; }
+	}
+	RD::TextureFormat primary_format;
+	primary_format.format = RD::DATA_FORMAT_R32_SFLOAT;
+	primary_format.width = p_size.x; primary_format.height = p_size.y; primary_format.usage_bits = sample | storage;
+	if (!rd->texture_is_format_supported_for_usage(primary_format.format, primary_format.usage_bits)) { clear_gpu(); reason = "primary_depth_unsupported"; faulted = true; return false; }
+	primary_depth = rd->texture_create(primary_format, RD::TextureView());
+	if (!primary_depth.is_valid()) { clear_gpu(); reason = "primary_depth_allocation_failed"; faulted = true; return false; }
+	completion = std::make_shared<RealGPUCompletion>();
+	if (!completion->reset(true, rd->real_gpu_completion_now())) { clear_gpu(); reason = "completion_clock_failed"; faulted = true; return false; }
+	size = p_size;
+	return true;
+}
+
+bool MetalFXViewportDenoised::admit(RID p_scenario, const Vector<MetalFXViewportRTScene::Surface> &p_surfaces, const Transform3D &p_camera, const Projection &p_projection, Color p_linear_environment, Size2i p_size) {
+	RD *rd = RD::get_singleton();
+	authorized_frame = 0;
+	if (faulted) { return false; }
+	if (owner && rd != owner) { clear_gpu(); reason = "device_changed"; faulted = true; return false; }
+	if (!rd || !rd->real_gpu_completion_supported() || !p_scenario.is_valid() || p_surfaces.is_empty() || !p_camera.is_finite()) { reject("not_supported"); return false; }
+	if (!rd->metalfx_viewport_uniforms_safe() && !rd->metalfx_shared_uniform_sets_supported()) { reject("argument_buffer_upload_unqualified"); return false; }
+	// Remain closed until the compute-primary producer, shared-set path, exact
+	// build/dispatch receipts, and native input conventions are qualified.
+	if (!GUIDE_INPUT_RECEIPT_IMPLEMENTED) { reject("guide_inputs_unqualified"); return false; }
+	if (size != Size2i() && size != p_size) { clear_gpu(); have_previous = false; }
+	bool same = have_previous && previous_scenario == p_scenario && previous_camera == p_camera && previous_projection == p_projection && previous_surfaces.size() == p_surfaces.size();
+	if (same) {
+		for (int i = 0; i < p_surfaces.size(); ++i) {
+			const auto &a = previous_surfaces[i];
+			const auto &b = p_surfaces[i];
+			if (a.instance != b.instance || a.instance_version != b.instance_version || a.mesh != b.mesh || a.material != b.material || a.surface != b.surface || a.expected_source_serial != b.expected_source_serial || a.transform != b.transform) { same = false; break; }
+		}
+	}
+	previous_scenario = p_scenario;
+	previous_camera = p_camera;
+	previous_projection = p_projection;
+	previous_surfaces = p_surfaces;
+	linear_environment = p_linear_environment;
+	have_previous = true;
+	if (!same) { scene.invalidate(); visibility.invalidate(); active_epoch = 0; reason = "awaiting_static_scene"; return false; }
+	if (!context.is_valid() && !allocate(p_size)) { return false; }
+	if (!active_epoch || !scene.is_fresh(active_epoch)) {
+		if (next_epoch >= uint64_t(INT64_MAX)) { reject("epoch_exhausted"); faulted = true; return false; }
+		const uint64_t epoch = ++next_epoch;
+		if (!scene.build(epoch, p_surfaces) || !visibility.begin_generation(epoch)) { scene.invalidate(); visibility.invalidate(); active_epoch = 0; reason = "scene_or_shader_failed"; return false; }
+		active_epoch = epoch;
+	}
+	const auto build_status = scene.build_status();
+	if (build_status == MetalFXViewportRTScene::BuildStatus::PENDING) { reason = "build_gpu_pending"; return false; }
+	if (build_status != MetalFXViewportRTScene::BuildStatus::READY) {
+		scene.invalidate(); visibility.invalidate(); active_epoch = 0; faulted = true; reason = "build_gpu_failed"; return false;
+	}
+	authorized_frame = rd->get_frames_drawn();
+	if (!authorized_frame) { reject("frame_unavailable"); return false; }
+	return true;
+}
+
+bool MetalFXViewportDenoised::can_record() {
+	RD *rd = RD::get_singleton();
+	if (!rd || rd != owner || !completion || !is_ready()) { reason = "scene_stale"; return false; }
+	auto snapshot = completion->snapshot(rd->real_gpu_completion_now());
+	if (snapshot.failed) {
+		const String failure = snapshot.reason;
+		clear_gpu(); // RID destruction remains deferred behind the owning frame fence.
+		reason = failure;
+		faulted = true; return false;
+	}
+	if (snapshot.pending) { reason = "gpu_pending"; return false; } // No CPU wait; keep current raster.
+	if (snapshot.count && snapshot.samples[snapshot.count - 1].frame == last_enqueued_frame) {
+		completed_frame = last_enqueued_frame;
+		completed_serial = last_enqueued_serial;
+	}
+	return true;
+}
+
+bool MetalFXViewportDenoised::begin_frame_proof(uint64_t p_frame) {
+	frame_proof.reset();
+	RD *rd = RD::get_singleton();
+	if (!p_frame || p_frame != authorized_frame || !can_record() || !rd) { authorized_frame = 0; return false; }
+	frame_proof = std::make_shared<MFXViewportCallback::CommandProof>();
+	frame_proof->frame = p_frame;
+	frame_proof->pipeline = rd->metalfx_rt_compute_pipeline_id(visibility.get_trace_pipeline()).id;
+	if (!frame_proof->pipeline) { frame_proof.reset(); authorized_frame = 0; reason = "trace_pipeline_unavailable"; return false; }
+	FrameProofCallback *callback = memnew(FrameProofCallback);
+	callback->proof = frame_proof;
+	RD::CallbackResource marker;
+	marker.rid = textures[3];
+	marker.type = RD::CALLBACK_RESOURCE_TYPE_TEXTURE;
+	marker.usage = RD::CALLBACK_RESOURCE_USAGE_STORAGE_IMAGE_READ_WRITE;
+	if (rd->driver_callback_add(mark_frame_first, callback, VectorView<RD::CallbackResource>(&marker, 1)) != OK) {
+		memdelete(callback); frame_proof.reset(); authorized_frame = 0; reason = "frame_marker_failed"; return false;
+	}
+	// Force the marker before the depth prepass, opaque draw, guides and trace.
+	rd->metalfx_rt_probe_barrier();
+	return true;
+}
+
+bool MetalFXViewportDenoised::begin_draw_stage(uint32_t p_stage) {
+	RD *rd = RD::get_singleton();
+	if (!rd || rd != owner || !frame_proof || !p_stage || (p_stage & (p_stage - 1))) { return false; }
+	DrawProofCallback *callback = memnew(DrawProofCallback);
+	callback->proof = frame_proof; callback->stage = p_stage; callback->begin = true;
+	RD::CallbackResource marker;
+	marker.rid = textures[3]; marker.type = RD::CALLBACK_RESOURCE_TYPE_TEXTURE;
+	marker.usage = RD::CALLBACK_RESOURCE_USAGE_STORAGE_IMAGE_READ_WRITE;
+	rd->metalfx_rt_probe_barrier();
+	if (rd->driver_callback_add(mark_draw_stage, callback, VectorView<RD::CallbackResource>(&marker, 1)) != OK) {
+		memdelete(callback); frame_proof->draw_failed.store(true, std::memory_order_release); return false;
+	}
+	rd->metalfx_rt_probe_barrier();
+	return true;
+}
+
+bool MetalFXViewportDenoised::end_draw_stage(uint32_t p_stage, uint32_t p_expected, bool p_enqueued) {
+	RD *rd = RD::get_singleton();
+	if (!rd || rd != owner || !frame_proof || !p_enqueued || !p_expected || !p_stage || (p_stage & (p_stage - 1))) {
+		if (frame_proof) { frame_proof->draw_failed.store(true, std::memory_order_release); }
+		return false;
+	}
+	DrawProofCallback *callback = memnew(DrawProofCallback);
+	callback->proof = frame_proof; callback->stage = p_stage; callback->expected = p_expected;
+	RD::CallbackResource marker;
+	marker.rid = textures[3]; marker.type = RD::CALLBACK_RESOURCE_TYPE_TEXTURE;
+	marker.usage = RD::CALLBACK_RESOURCE_USAGE_STORAGE_IMAGE_READ_WRITE;
+	rd->metalfx_rt_probe_barrier();
+	if (rd->driver_callback_add(mark_draw_stage, callback, VectorView<RD::CallbackResource>(&marker, 1)) != OK) {
+		memdelete(callback); frame_proof->draw_failed.store(true, std::memory_order_release); return false;
+	}
+	frame_proof->required_draw_stages.fetch_or(p_stage, std::memory_order_release);
+	rd->metalfx_rt_probe_barrier();
+	return true;
+}
+
+bool MetalFXViewportDenoised::record(RID p_target, const Projection &p_world_to_view, const Projection &p_clip, const Projection &p_world_from_clip, Color p_linear_environment, Color p_linear_background, uint64_t p_frame) {
+	if (!can_record() || !frame_proof || frame_proof->frame != p_frame) { return false; }
+	RD *rd = RD::get_singleton();
+	if (!begin_draw_stage(MFXViewportCallback::INPUT_CLEARS)) { scene.invalidate(); visibility.invalidate(); active_epoch = 0; reason = "input_clear_failed"; faulted = true; return false; }
+	const bool cleared = rd->texture_clear(textures[2], Color(0, 0, 0, 0), 0, 1, 0, 1) == OK && rd->texture_clear(textures[7], Color(1, 0, 0, 0), 0, 1, 0, 1) == OK;
+	if (!end_draw_stage(MFXViewportCallback::INPUT_CLEARS, 2, cleared)) { scene.invalidate(); visibility.invalidate(); active_epoch = 0; reason = "input_clear_failed"; faulted = true; return false; }
+	MetalFXViewportVisibility::Inputs inputs;
+	inputs.scene = scene.get_current_tlas(active_epoch);
+	inputs.geometry = scene.get_current_primary_geometry(active_epoch);
+	inputs.primary_depth = primary_depth;
+	inputs.world_normal = textures[5];
+	inputs.diffuse_albedo = textures[3];
+	inputs.specular_albedo = textures[4];
+	inputs.roughness = textures[6];
+	inputs.noisy_output = textures[0];
+	inputs.size = size;
+	inputs.world_from_clip = p_world_from_clip;
+	inputs.linear_environment = p_linear_environment;
+	inputs.linear_background = p_linear_background;
+	inputs.sample = uint32_t(sample++);
+	inputs.epoch = active_epoch;
+	inputs.instance_count = scene.get_primary_instance_count(active_epoch);
+	inputs.normal_count = scene.get_primary_normal_count(active_epoch);
+	if (!visibility.dispatch(inputs)) { scene.invalidate(); visibility.invalidate(); active_epoch = 0; reason = "visibility_enqueue_failed"; faulted = true; return false; }
+	if (!begin_draw_stage(MFXViewportCallback::DEPTH_CONVERSION)) { scene.invalidate(); visibility.invalidate(); active_epoch = 0; reason = "depth_conversion_failed"; faulted = true; return false; }
+	const bool converted = visibility.convert_depth(primary_depth, textures[1], size);
+	if (!end_draw_stage(MFXViewportCallback::DEPTH_CONVERSION, 1, converted)) { scene.invalidate(); visibility.invalidate(); active_epoch = 0; reason = "depth_conversion_failed"; faulted = true; return false; }
+	TypedArray<RID> arguments;
+	for (RID texture : textures) { arguments.push_back(texture); }
+	Dictionary result = rd->metalfx_denoised_encode_viewport(context, arguments, p_world_to_view, p_clip, 1.0f, Vector2(), true,
+			visibility.get_consumer_pipeline(), visibility.get_consumer_sampler(), p_target, primary_depth, p_linear_background, completion, frame_proof, p_frame);
+	frame_proof.reset();
+	reason = String(result.get("status", "enqueue_failed"));
+	if (reason == "enqueued") {
+		last_enqueued_frame = p_frame;
+		last_enqueued_serial = uint64_t(int64_t(result.get("serial", 0)));
+	}
+	if (reason != "enqueued") { faulted = true; scene.invalidate(); visibility.invalidate(); active_epoch = 0; }
+	return reason == "enqueued";
+}
+
+Dictionary MetalFXViewportDenoised::status() const {
+	Dictionary result;
+	result["status"] = reason;
+	result["scene_epoch"] = int64_t(active_epoch);
+	result["faulted"] = faulted;
+	result["scope"] = "opaque_rt_view_constant_environment_diffuse";
+	result["pixel_values_validated"] = false;
+	result["invalid_hit_fallback"] = "linear_background";
+	result["maximum_ray_distance"] = 1000.0;
+	result["history_reset_each_frame"] = true;
+	RD *rd = RD::get_singleton();
+	if (rd && rd == owner && context.is_valid()) { result["denoiser"] = rd->metalfx_denoised_status(context); }
+	if (rd && rd == owner && completion) {
+		auto snapshot = completion->snapshot(rd->real_gpu_completion_now());
+		uint64_t matched_frame = completed_frame, matched_serial = completed_serial;
+		if (!snapshot.pending && !snapshot.failed && snapshot.count && snapshot.samples[snapshot.count - 1].frame == last_enqueued_frame) {
+			matched_frame = last_enqueued_frame; matched_serial = last_enqueued_serial;
+		}
+		result["completion_pending"] = int64_t(snapshot.pending);
+		result["completed_samples"] = int64_t(snapshot.count);
+		result["completion_failed"] = snapshot.failed;
+		result["completion_reason"] = snapshot.reason;
+		result["last_completed_frame"] = snapshot.count ? int64_t(snapshot.samples[snapshot.count - 1].frame) : int64_t(0);
+		result["completed_frame"] = int64_t(matched_frame);
+		result["completed_serial"] = int64_t(matched_serial);
+		result["enqueued_frame"] = int64_t(last_enqueued_frame);
+		result["enqueued_serial"] = int64_t(last_enqueued_serial);
+	}
+	return result;
+}
