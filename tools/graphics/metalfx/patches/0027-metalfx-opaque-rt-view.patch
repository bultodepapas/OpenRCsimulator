+// SPDX-License-Identifier: MIT
+// Startup-latched experiment switch. The per-frame read performs no lookup.
+#pragma once
+namespace MFXViewportOptIn {
+class StartupSwitch {
+	bool initialized = false;
+	bool requested_value = false;
+public:
+	template <typename Lookup>
+	void initialize(Lookup p_lookup) {
+		if (!initialized) { requested_value = p_lookup(); initialized = true; }
+	}
+	bool requested() const { return initialized && requested_value; }
+};
+inline StartupSwitch denoised;
+} // namespace MFXViewportOptIn
diff --git a/servers/rendering/storage/metalfx_viewport_primary_geometry.h b/servers/rendering/storage/metalfx_viewport_primary_geometry.h
new file mode 100644
--- /dev/null
+++ b/servers/rendering/storage/metalfx_viewport_primary_geometry.h
@@ -0,0 +1,65 @@
+// SPDX-License-Identifier: MIT
+// Geometric normals from the exact expanded, non-indexed BLAS input.
+#pragma once
+#include <cmath>
+#include <cstdint>
+#include <cstring>
+
+namespace MFXViewportPrimaryGeometry {
+struct Normal { float x, y, z, pad; };
+static_assert(sizeof(Normal) == 16, "std430 vec4 layout");
+struct Range { uint32_t offset, count, instance_id, reserved; };
+static_assert(sizeof(Range) == 16, "std430 uvec4 layout");
+constexpr uint32_t MAX_INSTANCES = 16;
+
+inline bool vertices_inside_bounds(const uint8_t *p_vertices, uint64_t p_bytes, uint64_t p_count, const double p_min[3], const double p_max[3]) {
+	if (!p_vertices || !p_min || !p_max || !p_count || p_count > UINT64_MAX / 12 || p_count * 12 > p_bytes) { return false; }
+	for (uint32_t axis = 0; axis < 3; ++axis) {
+		if (!std::isfinite(p_min[axis]) || !std::isfinite(p_max[axis]) || p_min[axis] > p_max[axis]) { return false; }
+	}
+	for (uint64_t i = 0; i < p_count; ++i) {
+		float v[3];
+		std::memcpy(v, p_vertices + i * 12, sizeof(v));
+		for (uint32_t axis = 0; axis < 3; ++axis) {
+			if (!std::isfinite(v[axis]) || double(v[axis]) < p_min[axis] || double(v[axis]) > p_max[axis]) { return false; }
+		}
+	}
+	return true;
+}
+
+inline bool valid_ranges(const Range *p_ranges, uint32_t p_instances, uint32_t p_normals) {
+	if (!p_ranges || !p_instances || p_instances > MAX_INSTANCES) { return false; }
+	uint32_t next = 0;
+	for (uint32_t i = 0; i < p_instances; ++i) {
+		const Range &r = p_ranges[i];
+		if (r.instance_id != i + 1 || r.reserved || !r.count || r.offset != next || r.count > p_normals - next) { return false; }
+		next += r.count;
+	}
+	return next == p_normals;
+}
+
+inline bool lookup(const Range *p_ranges, uint32_t p_instances, uint32_t p_normals, uint32_t p_instance_id, uint32_t p_primitive, uint32_t &r_index) {
+	if (!valid_ranges(p_ranges, p_instances, p_normals) || !p_instance_id || p_instance_id > p_instances) { return false; }
+	const Range &range = p_ranges[p_instance_id - 1];
+	if (p_primitive >= range.count) { return false; }
+	r_index = range.offset + p_primitive;
+	return true;
+}
+
+inline bool build_normals(const uint8_t *p_vertices, uint64_t p_bytes, Normal *r_normals, uint64_t p_count) {
+	if (!p_vertices || !r_normals || !p_count || p_count > UINT32_MAX || p_count > UINT64_MAX / 36 || p_bytes != p_count * 36) { return false; }
+	for (uint64_t i = 0; i < p_count; ++i) {
+		float v[9];
+		std::memcpy(v, p_vertices + i * 36, sizeof(v));
+		for (float x : v) { if (!std::isfinite(x) || std::abs(x) > 1000000.0f) { return false; } }
+		const double ax = double(v[3]) - v[0], ay = double(v[4]) - v[1], az = double(v[5]) - v[2];
+		const double bx = double(v[6]) - v[0], by = double(v[7]) - v[1], bz = double(v[8]) - v[2];
+		const double x = ay * bz - az * by, y = az * bx - ax * bz, z = ax * by - ay * bx;
+		const double len2 = x * x + y * y + z * z;
+		if (!std::isfinite(len2) || len2 < 1e-24) { return false; }
+		const double inv = 1.0 / std::sqrt(len2);
+		r_normals[i] = { float(x * inv), float(y * inv), float(z * inv), 0.0f };
+	}
+	return true;
+}
+} // namespace MFXViewportPrimaryGeometry
