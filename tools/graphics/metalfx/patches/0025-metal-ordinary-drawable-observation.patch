+		if (surface) {
+			Dictionary observed = surface->openrc_drawable_observation();
+			if (!observed.is_empty()) { result = observed; }
+		}
+	}
+#endif
+	const uint64_t after = OS::get_singleton()->get_ticks_usec();
+	if (before == 0 || after < before || after > uint64_t(std::numeric_limits<int64_t>::max())) {
+		result["status"] = "invalid_clock";
+	} else {
+		result["query_before_usec"] = int64_t(before);
+		result["query_after_usec"] = int64_t(after);
+	}
+	return result;
