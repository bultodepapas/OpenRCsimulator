diff --git a/drivers/metal/openrc_drawable_observation.h b/drivers/metal/openrc_drawable_observation.h
new file mode 100644
index 000000000..d993dfde4
--- /dev/null
+++ b/drivers/metal/openrc_drawable_observation.h
@@ -0,0 +1,56 @@
+#pragma once
+
+// Opt-in diagnostic value state.  It never retains a Metal object or asserts
+// that an acquired drawable was committed, presented, or scanned out.
+#include <atomic>
+#include <cstdint>
+#include <limits>
+#include <mutex>
+
+namespace OpenRCDrawableObservation {
+constexpr uint64_t LIMIT = uint64_t(std::numeric_limits<int64_t>::max());
+inline std::atomic<uint64_t> next_scope{ 0 };
+
+inline uint64_t allocate_scope() {
+	uint64_t current = next_scope.load(std::memory_order_relaxed);
+	for (;;) {
+		if (current >= LIMIT) { return 0; }
+		if (next_scope.compare_exchange_weak(current, current + 1, std::memory_order_relaxed)) { return current + 1; }
+	}
+}
+
+struct Snapshot {
+	uint64_t scope = 0, attempts = 0, observed = 0, missed = 0, changes = 0;
+	uint64_t width = 0, height = 0, pixel_format = 0;
+	bool failed = false;
+};
+
+class Tracker {
+	mutable std::mutex mutex;
+	Snapshot value;
+
+public:
+	explicit Tracker(uint64_t p_scope) { value.scope = p_scope; value.failed = p_scope == 0 || p_scope > LIMIT; }
+	void record(bool p_framebuffer_requested, uint64_t p_width, uint64_t p_height, uint64_t p_format) {
+		std::lock_guard<std::mutex> guard(mutex);
+		if (value.failed) { return; }
+		if (value.attempts == LIMIT) { value.failed = true; return; }
+		value.attempts++;
+		if (!p_framebuffer_requested || p_width == 0 || p_height == 0 || p_format == 0 || p_width > LIMIT || p_height > LIMIT || p_format > LIMIT) {
+			value.missed++;
+			return;
+		}
+		if (value.observed > 0 && (value.width != p_width || value.height != p_height || value.pixel_format != p_format)) {
+			value.changes++;
+		}
+		value.width = p_width;
+		value.height = p_height;
+		value.pixel_format = p_format;
+		value.observed++;
+	}
+	Snapshot snapshot() const {
+		std::lock_guard<std::mutex> guard(mutex);
+		return value;
+	}
+};
+} // namespace OpenRCDrawableObservation
