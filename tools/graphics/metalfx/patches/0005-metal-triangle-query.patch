+bool RenderingDevice::_compute_list_triangle_query_sets_valid() {
+	if (!has_feature(SUPPORTS_METAL_TRIANGLE_QUERY)) {
+		return true;
+	}
+	for (uint32_t i = 0; i < compute_list.state.set_count; i++) {
+		const ComputeList::SetState &set = compute_list.state.sets[i];
+		if (set.pipeline_expected_format == 0) {
+			continue;
+		}
+		const UniformSet *uniform_set = uniform_set_owner.get_or_null(set.uniform_set);
+		if (!uniform_set || set.pipeline_expected_format != set.uniform_set_format) {
+			return false;
+		}
+		for (RID id : uniform_set->acceleration_structures) {
+			const AccelerationStructure *tlas = acceleration_structure_owner.get_or_null(id);
+			if (!tlas || tlas->type != RDD::ACCELERATION_STRUCTURE_TYPE_TOP_LEVEL || tlas->invalidated || !driver->acceleration_structure_build_is_valid(tlas->driver_id)) {
+				return false;
+			}
+			for (RID blas_id : tlas->acceleration_structure_dependencies) {
+				const AccelerationStructure *blas = acceleration_structure_owner.get_or_null(blas_id);
+				if (!blas || blas->invalidated || !driver->acceleration_structure_build_is_valid(blas->driver_id)) {
+					return false;
+				}
+			}
+		}
+	}
+	return true;
