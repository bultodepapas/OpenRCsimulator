+#pragma once
+#include <cstdint>
+
+// A synchronous encode result is not a GPU completion observation.
+enum MFXDenoisedResult { MFX_DENOISED_OK = 0, MFX_DENOISED_UNAVAILABLE = 1,
+    MFX_DENOISED_UNSUPPORTED = 2, MFX_DENOISED_FACTORY_FAILED = 3,
+    MFX_DENOISED_INPUT_MISMATCH = 4, MFX_DENOISED_EXCEPTION = 5, MFX_DENOISED_HAZARD_REQUIRED = 6 };
+extern "C" {
+int mfx_denoised_capability(void *device);
+void *mfx_denoised_create(void *device, uint32_t iw, uint32_t ih, uint32_t ow, uint32_t oh, int *result);
+void mfx_denoised_retain(void *effect);
+void mfx_denoised_release(void *effect);
+int mfx_denoised_validate(void *effect, void *const *textures);
+int mfx_denoised_encode(void *effect, void *command, void *fence, void *const *textures,
+        float pre_exposure, float jitter_x, float jitter_y, const float *world, const float *clip, bool reset);
+}
diff --git a/drivers/metal/metalfx_denoised_bridge.mm b/drivers/metal/metalfx_denoised_bridge.mm
new file mode 100644
index 000000000..96b9c1576
--- /dev/null
+++ b/drivers/metal/metalfx_denoised_bridge.mm
@@ -0,0 +1,121 @@
+// SDK bridge for the experimental RenderingDevice denoiser. Uses Godot's device.
+#include "metalfx_denoised_bridge.h"
+#import <Foundation/Foundation.h>
+#import <Metal/Metal.h>
+#import <MetalFX/MetalFX.h>
+#include <AvailabilityMacros.h>
+#include <cstring>
+
+@interface OpenRCDenoised : NSObject
+@property(nonatomic, strong) id<MTLDevice> device;
+@property(nonatomic, strong) id effect;
+@end
+@implementation OpenRCDenoised
+@end
+
+int mfx_denoised_capability(void *p_device) {
+#if defined(__MAC_OS_X_VERSION_MAX_ALLOWED) && __MAC_OS_X_VERSION_MAX_ALLOWED >= 260000
+    @autoreleasepool {
+        if (@available(macOS 26.0, *)) {
+            id<MTLDevice> device = (__bridge id<MTLDevice>)p_device;
+            return device && [MTLFXTemporalDenoisedScalerDescriptor supportsDevice:device] ? MFX_DENOISED_OK : MFX_DENOISED_UNSUPPORTED;
+        }
+    }
+#endif
+    return MFX_DENOISED_UNAVAILABLE;
+}
+
+void *mfx_denoised_create(void *p_device, uint32_t iw, uint32_t ih, uint32_t ow, uint32_t oh, int *result) {
+    *result = mfx_denoised_capability(p_device);
+    if (*result != MFX_DENOISED_OK) return nullptr;
+#if defined(__MAC_OS_X_VERSION_MAX_ALLOWED) && __MAC_OS_X_VERSION_MAX_ALLOWED >= 260000
+    @autoreleasepool {
+        if (@available(macOS 26.0, *)) {
+            @try {
+                id<MTLDevice> device = (__bridge id<MTLDevice>)p_device;
+                MTLFXTemporalDenoisedScalerDescriptor *d = [MTLFXTemporalDenoisedScalerDescriptor new];
+                if (!d) { *result = MFX_DENOISED_FACTORY_FAILED; return nullptr; }
+                d.inputWidth = iw; d.inputHeight = ih; d.outputWidth = ow; d.outputHeight = oh;
+                d.colorTextureFormat = MTLPixelFormatRGBA16Float; d.depthTextureFormat = MTLPixelFormatDepth32Float;
+                d.motionTextureFormat = MTLPixelFormatRG16Float; d.diffuseAlbedoTextureFormat = MTLPixelFormatRGBA16Float;
+                d.specularAlbedoTextureFormat = MTLPixelFormatRGBA16Float; d.normalTextureFormat = MTLPixelFormatRGBA16Float;
+                d.roughnessTextureFormat = MTLPixelFormatR16Float; d.outputTextureFormat = MTLPixelFormatRGBA16Float;
+                d.autoExposureEnabled = NO; d.specularHitDistanceTextureEnabled = NO;
+                d.denoiseStrengthMaskTextureEnabled = NO; d.reactiveMaskTextureEnabled = NO;
+                d.transparencyOverlayTextureEnabled = NO;
+                id<MTLFXTemporalDenoisedScaler> fx = [d newTemporalDenoisedScalerWithDevice:device];
+                if (!fx) { *result = MFX_DENOISED_FACTORY_FAILED; return nullptr; }
+                OpenRCDenoised *holder = [OpenRCDenoised new];
+                if (!holder) { *result = MFX_DENOISED_FACTORY_FAILED; return nullptr; }
+                holder.device = device; holder.effect = fx; *result = MFX_DENOISED_OK;
+                return (__bridge_retained void *)holder;
+            } @catch (NSException *e) { (void)e; *result = MFX_DENOISED_EXCEPTION; return nullptr; }
+        }
+    }
+#endif
+    *result = MFX_DENOISED_UNAVAILABLE;
+    return nullptr;
+}
+void mfx_denoised_retain(void *p) { if (p) CFRetain((CFTypeRef)p); }
+void mfx_denoised_release(void *p) { if (p) CFRelease((CFTypeRef)p); }
+
+int mfx_denoised_validate(void *p_effect, void *const *p_textures) {
+#if defined(__MAC_OS_X_VERSION_MAX_ALLOWED) && __MAC_OS_X_VERSION_MAX_ALLOWED >= 260000
+    @autoreleasepool {
+        if (@available(macOS 26.0, *)) {
+            if (!p_effect || !p_textures) return MFX_DENOISED_INPUT_MISMATCH;
+            OpenRCDenoised *holder = (__bridge OpenRCDenoised *)p_effect;
+            id<MTLFXTemporalDenoisedScaler> fx = holder.effect;
+            if (!fx || !holder.device) return MFX_DENOISED_INPUT_MISMATCH;
+            const MTLPixelFormat formats[] = { fx.colorTextureFormat, fx.depthTextureFormat, fx.motionTextureFormat,
+                fx.diffuseAlbedoTextureFormat, fx.specularAlbedoTextureFormat, fx.normalTextureFormat,
+                fx.roughnessTextureFormat, MTLPixelFormatR16Float, fx.outputTextureFormat };
+            const MTLTextureUsage usage[] = { fx.colorTextureUsage, fx.depthTextureUsage, fx.motionTextureUsage,
+                fx.diffuseAlbedoTextureUsage, fx.specularAlbedoTextureUsage, fx.normalTextureUsage,
+                fx.roughnessTextureUsage, MTLTextureUsageShaderRead, fx.outputTextureUsage };
+            for (unsigned i=0; i<9; ++i) {
+                id<MTLTexture> texture = (__bridge id<MTLTexture>)p_textures[i];
+                NSUInteger w = i==7 ? 1 : (i==8 ? fx.outputWidth : fx.inputWidth);
+                NSUInteger h = i==7 ? 1 : (i==8 ? fx.outputHeight : fx.inputHeight);
+                if (!texture || texture.device != holder.device || texture.textureType != MTLTextureType2D ||
+                        texture.sampleCount != 1 || texture.mipmapLevelCount != 1 || texture.width != w || texture.height != h ||
+                        texture.pixelFormat != formats[i] || (texture.usage & usage[i]) != usage[i] ||
+                        (i == 8 && texture.storageMode != MTLStorageModePrivate)) return MFX_DENOISED_INPUT_MISMATCH;
+                for (unsigned j=0; j<i; ++j) if (p_textures[i] == p_textures[j]) return MFX_DENOISED_INPUT_MISMATCH;
+            }
+            return MFX_DENOISED_OK;
+        }
+    }
+#endif
+    return MFX_DENOISED_UNAVAILABLE;
+}
+
+int mfx_denoised_encode(void *p_effect, void *p_command, void *p_fence, void *const *t,
+        float exposure, float jx, float jy, const float *world, const float *clip, bool reset) {
+#if defined(__MAC_OS_X_VERSION_MAX_ALLOWED) && __MAC_OS_X_VERSION_MAX_ALLOWED >= 260000
+    @autoreleasepool {
+        if (@available(macOS 26.0, *)) {
+            int validation = mfx_denoised_validate(p_effect, t);
+            if (validation != MFX_DENOISED_OK || !p_command || !world || !clip) return MFX_DENOISED_INPUT_MISMATCH;
+            @try {
+                OpenRCDenoised *holder = (__bridge OpenRCDenoised *)p_effect;
+                id<MTLFXTemporalDenoisedScaler> fx = holder.effect;
+                id<MTLCommandBuffer> command = (__bridge id<MTLCommandBuffer>)p_command;
+                if (command.device != holder.device) return MFX_DENOISED_INPUT_MISMATCH;
+                fx.colorTexture = (__bridge id<MTLTexture>)t[0]; fx.depthTexture = (__bridge id<MTLTexture>)t[1];
+                fx.motionTexture = (__bridge id<MTLTexture>)t[2]; fx.diffuseAlbedoTexture = (__bridge id<MTLTexture>)t[3];
+                fx.specularAlbedoTexture = (__bridge id<MTLTexture>)t[4]; fx.normalTexture = (__bridge id<MTLTexture>)t[5];
+                fx.roughnessTexture = (__bridge id<MTLTexture>)t[6]; fx.exposureTexture = (__bridge id<MTLTexture>)t[7];
+                fx.outputTexture = (__bridge id<MTLTexture>)t[8]; fx.preExposure = exposure;
+                fx.jitterOffsetX = jx; fx.jitterOffsetY = jy; fx.motionVectorScaleX = 1; fx.motionVectorScaleY = 1;
+                fx.depthReversed = NO; fx.shouldResetHistory = reset;
+                simd_float4x4 w, c; std::memcpy(&w, world, sizeof(w)); std::memcpy(&c, clip, sizeof(c));
+                fx.worldToViewMatrix = w; fx.viewToClipMatrix = c; fx.fence = (__bridge id<MTLFence>)p_fence;
+                [fx encodeToCommandBuffer:command];
+                return MFX_DENOISED_OK;
+            } @catch (NSException *e) { (void)e; return MFX_DENOISED_EXCEPTION; }
+        }
+    }
+#endif
+    return MFX_DENOISED_UNAVAILABLE;
+}
