diff --git a/servers/rendering/storage/metalfx_denoised_contract.h b/servers/rendering/storage/metalfx_denoised_contract.h
new file mode 100644
index 000000000..2a8e70854
--- /dev/null
+++ b/servers/rendering/storage/metalfx_denoised_contract.h
@@ -0,0 +1,37 @@
+// Experimental fixed-format Temporal Denoised admission. This header is also
+// compiled with a fake driver on hosts without Metal. No GPU claim is implied.
+#pragma once
+#include <cstdint>
+#include <cmath>
+
+namespace MFXDenoisedContract {
+enum Slot { COLOR, DEPTH, MOTION, DIFFUSE, SPECULAR, NORMAL, ROUGHNESS, EXPOSURE, OUTPUT, COUNT };
+enum Format { RGBA16F, D32F, RG16F, R16F };
+struct Image {
+    uint64_t identity = 0;
+    uint32_t width = 0, height = 0;
+    Format format = RGBA16F;
+    bool regular = false, sampled = false, writable = false, external = false, shared = false;
+};
+inline bool dimensions(uint32_t iw, uint32_t ih, uint32_t ow, uint32_t oh) {
+    return iw > 0 && ih > 0 && ow > 0 && oh > 0 &&
+           iw <= 16384 && ih <= 16384 && ow <= 16384 && oh <= 16384;
+}
+inline bool images(const Image *v, uint32_t iw, uint32_t ih, uint32_t ow, uint32_t oh) {
+    if (!v || !dimensions(iw, ih, ow, oh)) return false;
+    const Format formats[COUNT] = { RGBA16F, D32F, RG16F, RGBA16F, RGBA16F, RGBA16F, R16F, R16F, RGBA16F };
+    for (unsigned i = 0; i < COUNT; ++i) {
+        uint32_t w = i == EXPOSURE ? 1 : (i == OUTPUT ? ow : iw);
+        uint32_t h = i == EXPOSURE ? 1 : (i == OUTPUT ? oh : ih);
+        if (!v[i].identity || !v[i].regular || v[i].external || v[i].shared || v[i].format != formats[i] ||
+            v[i].width != w || v[i].height != h || !v[i].sampled || (i == OUTPUT && !v[i].writable)) return false;
+        for (unsigned j = 0; j < i; ++j) if (v[i].identity == v[j].identity) return false;
+    }
+    return true;
+}
+inline bool frame(float exposure, float jx, float jy, const float *world, const float *clip, bool reset, uint64_t accepted) {
+    if (!std::isfinite(exposure) || exposure <= 0 || !std::isfinite(jx) || !std::isfinite(jy) || !world || !clip || (!accepted && !reset) || accepted == UINT64_MAX) return false;
+    for (unsigned i = 0; i < 16; ++i) if (!std::isfinite(world[i]) || !std::isfinite(clip[i])) return false;
+    return true;
+}
+} // namespace MFXDenoisedContract
