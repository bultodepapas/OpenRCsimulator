+// Fixed-layout experiment: [HDR, depth, motion, diffuse, specular, world normal,
+// roughness, 1x1 exposure, output]. Capability/factory/CPU encode are distinct
+// from GPU completion; no completion handler holds a RenderingDevice pointer.
+static const char *denoised_reason(int p_code) {
+	switch (p_code) {
+		case 0: return "available";
+		case 1: return "sdk_os_or_driver_unavailable";
+		case 2: return "device_unsupported";
+		case 3: return "factory_failed";
+		case 4: return "native_texture_mismatch";
+		case 5: return "native_exception";
+		case 6: return "native_hazard_tracking_required";
+		default: return "driver_error";
+	}
+}
+static Dictionary denoised_result(const char *p_status) {
+	Dictionary result; result["status"] = p_status; return result;
+}
+Dictionary RenderingDevice::metalfx_denoised_capability() const {
+	ERR_RENDER_THREAD_GUARD_V(Dictionary());
+	return denoised_result(denoised_reason(driver->denoised_capability()));
+}
+Dictionary RenderingDevice::metalfx_denoised_create(Size2i p_input, Size2i p_output) {
+	ERR_RENDER_THREAD_GUARD_V(Dictionary());
+	using namespace MFXDenoisedContract;
+	if (p_input.x <= 0 || p_input.y <= 0 || p_output.x <= 0 || p_output.y <= 0 ||
+			!dimensions(p_input.x, p_input.y, p_output.x, p_output.y)) return denoised_result("invalid_dimensions");
+	int code = driver->denoised_capability();
+	if (code) return denoised_result(denoised_reason(code));
+	void *effect = driver->denoised_create(p_input.x, p_input.y, p_output.x, p_output.y, code);
+	if (!effect || code) {
+		if (effect) driver->denoised_release(effect);
+		return denoised_result(denoised_reason(code ? code : 3));
+	}
+	RID id = denoised_owner.make_rid();
+	if (!id.is_valid()) { driver->denoised_release(effect); return denoised_result("allocation_failed"); }
+	DenoisedContext *ctx = denoised_owner.get_or_null(id);
+	ctx->effect = effect; ctx->input = p_input; ctx->output = p_output;
+	ctx->progress = std::make_shared<DenoisedProgress>();
+	Dictionary result = denoised_result("created"); result["context"] = id; return result;
+}
+Dictionary RenderingDevice::metalfx_denoised_status(RID p_context) {
+	ERR_RENDER_THREAD_GUARD_V(Dictionary());
+	DenoisedContext *ctx = denoised_owner.get_or_null(p_context);
+	if (!ctx) return denoised_result("invalid_context");
+	int code = ctx->progress->callback_error.load(std::memory_order_acquire);
+	Dictionary result = denoised_result(code ? denoised_reason(code) : "created");
+	result["accepted"] = ctx->accepted;
+	result["encoded"] = ctx->progress->encoded.load(std::memory_order_acquire);
+	result["gpu_completion_observed"] = false;
+	return result;
+}
+void RenderingDevice::_denoised_callback(RDD *p_driver, RDD::CommandBufferID p_command, void *p_userdata) {
+	DenoisedCallback *args = static_cast<DenoisedCallback *>(p_userdata);
+	if (!args->progress->callback_error.load(std::memory_order_acquire)) {
+		int code = p_driver->denoised_encode(args->effect, p_command, args->frame);
+		if (code) args->progress->callback_error.store(code, std::memory_order_release);
+		else args->progress->encoded.store(args->serial, std::memory_order_release);
+	}
+	p_driver->denoised_release(args->effect);
+	memdelete(args);
+}
+Dictionary RenderingDevice::metalfx_denoised_encode(RID p_context, const TypedArray<RID> &p_textures,
+		const Projection &p_world, const Projection &p_clip, float p_pre_exposure, Vector2 p_jitter, bool p_reset) {
+	ERR_RENDER_THREAD_GUARD_V(Dictionary());
+	using namespace MFXDenoisedContract;
+	DenoisedContext *ctx = denoised_owner.get_or_null(p_context);
+	if (!ctx) return denoised_result("invalid_context");
+	if (ctx->progress->callback_error.load(std::memory_order_acquire)) return denoised_result("callback_failed");
+	if (p_textures.size() != COUNT) return denoised_result("invalid_texture_count");
+	RDD::DenoisedFrame frame;
+	frame.exposure = p_pre_exposure; frame.jitter_x = p_jitter.x; frame.jitter_y = p_jitter.y; frame.reset = p_reset;
+	for (unsigned c=0; c<4; ++c) for (unsigned r=0; r<4; ++r) {
+		frame.world[c*4+r] = p_world[c][r]; frame.clip[c*4+r] = p_clip[c][r];
+	}
+	if (!MFXDenoisedContract::frame(frame.exposure, frame.jitter_x, frame.jitter_y, frame.world, frame.clip, p_reset, ctx->accepted)) return denoised_result("invalid_frame");
+	MFXDenoisedContract::Image info[COUNT]; CallbackResource resources[COUNT]; RID ids[COUNT];
+	for (unsigned i=0; i<COUNT; ++i) {
+		ids[i] = p_textures[i];
+		Texture *tex = texture_owner.get_or_null(ids[i]);
+		if (!tex) return denoised_result("invalid_textures");
+		info[i].identity = get_driver_resource(DRIVER_RESOURCE_TEXTURE, ids[i]);
+		info[i].width = tex->width; info[i].height = tex->height;
+		switch (tex->format) {
+			case DATA_FORMAT_R16G16B16A16_SFLOAT: info[i].format = RGBA16F; break;
+			case DATA_FORMAT_D32_SFLOAT: info[i].format = D32F; break;
+			case DATA_FORMAT_R16G16_SFLOAT: info[i].format = RG16F; break;
+			case DATA_FORMAT_R16_SFLOAT: info[i].format = R16F; break;
+			default: return denoised_result("invalid_textures");
+		}
+		info[i].external = tex->is_external;
+		info[i].shared = tex->owner.is_valid();
+		info[i].regular = tex->type == TEXTURE_TYPE_2D && tex->depth == 1 && tex->layers == 1 && tex->mipmaps == 1 &&
+				tex->samples == TEXTURE_SAMPLES_1 && !tex->is_discardable && !tex->is_resolve_buffer &&
+				!(tex->usage_flags & (TEXTURE_USAGE_TRANSIENT_BIT | TEXTURE_USAGE_CPU_READ_BIT));
+		info[i].sampled = (tex->usage_flags & TEXTURE_USAGE_SAMPLING_BIT) != 0;
+		info[i].writable = (tex->usage_flags & TEXTURE_USAGE_STORAGE_BIT) != 0;
+		frame.textures[i] = info[i].identity;
+		resources[i].rid = ids[i];
+		resources[i].usage = i == OUTPUT ? CALLBACK_RESOURCE_USAGE_STORAGE_IMAGE_READ_WRITE : CALLBACK_RESOURCE_USAGE_TEXTURE_SAMPLE;
+	}
+	if (!images(info, ctx->input.x, ctx->input.y, ctx->output.x, ctx->output.y)) return denoised_result("invalid_textures");
+	int code = driver->denoised_validate(ctx->effect, frame);
+	if (code) return denoised_result(denoised_reason(code));
+	for (unsigned i=0; i<COUNT; ++i) {
+		Texture *tex = texture_owner.get_or_null(ids[i]);
+		_check_transfer_worker_texture(tex);
+		_texture_check_pending_clear(ids[i], tex);
+	}
+	DenoisedCallback *args = memnew(DenoisedCallback);
+	args->effect = ctx->effect; args->frame = frame; args->progress = ctx->progress; args->serial = ctx->accepted + 1;
+	driver->denoised_retain(args->effect);
+	// History is stateful even if a caller switches all texture RIDs between frames.
+	draw_graph.add_synchronization();
+	Error error = driver_callback_add(_denoised_callback, args, VectorView<CallbackResource>(resources, COUNT));
+	if (error != OK) { driver->denoised_release(args->effect); memdelete(args); return denoised_result("enqueue_failed"); }
+	ctx->accepted++;
+	Dictionary result = denoised_result("enqueued"); result["serial"] = ctx->accepted; return result;
+}
