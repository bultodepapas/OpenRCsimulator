+#if defined(METAL_ENABLED) && defined(MACOS_ENABLED)
+RendererRD::MFXFrameContext *RenderSceneBuffersRD::ensure_metalfx_frame_context(RendererRD::MFXFrameEffect *p_effect, const RendererRD::MFXFrameEffect::CreateParams &p_params) {
+	if (!mfx_frame_context) {
+		mfx_frame_context = p_effect->create_context(p_params);
+		mfx_frame_reason = mfx_frame_context && mfx_frame_context->effect ? "none" : "factory_unavailable";
+	}
+	return mfx_frame_context;
+}
+
+void RenderSceneBuffersRD::reject_metalfx_frame(const char *p_reason) {
+	if (mfx_frame_context || has_texture(RB_SCOPE_METALFX_FRAME, RB_METALFX_FRAME_OUTPUT)) {
+		clear_metalfx_frame();
+	}
+	mfx_frame_reason = p_reason;
+}
+#endif
