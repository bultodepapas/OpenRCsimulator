@@ -0,0 +1,17 @@
+#pragma once
+
+#include <cstdint>
+
+// Only the Metal 3 driver calls this macOS SDK bridge. Returned objects carry
+// one retain; callbacks hold an additional retain until encoding is complete.
+enum MFXFrameBridgeResult { MFX_FRAME_OK = 0, MFX_FRAME_UNAVAILABLE = 1, MFX_FRAME_FACTORY_FAILED = 2, MFX_FRAME_INPUT_MISMATCH = 3, MFX_FRAME_ENQUEUE_FAILED = 4 };
+
+extern "C" {
+void *mfx_frame_create(void *p_device, uint32_t p_input_w, uint32_t p_input_h, uint32_t p_output_w, uint32_t p_output_h,
+		uint64_t p_color_format, uint64_t p_depth_format, uint64_t p_motion_format, uint64_t p_output_format, int *r_result);
+void mfx_frame_retain(void *p_effect);
+void mfx_frame_release(void *p_effect);
+int mfx_frame_encode(void *p_effect, void *p_command_buffer, void *p_fence, void *p_color, void *p_previous,
+		void *p_depth, void *p_motion, void *p_output, bool p_reset, float p_scale_x, float p_scale_y,
+		float p_jitter_x, float p_jitter_y, float p_delta, float p_fov_degrees, float p_near, float p_far, float p_aspect);
+}
diff --git a/drivers/metal/metalfx_frame_bridge.mm b/drivers/metal/metalfx_frame_bridge.mm
new file mode 100644
index 0000000..908573d
--- /dev/null
+++ b/drivers/metal/metalfx_frame_bridge.mm
@@ -0,0 +1,81 @@
+// SDK Metal 3 bridge for experimental scene-only interpolation. No presenter.
+#include "metalfx_frame_bridge.h"
+
+#import <Foundation/Foundation.h>
+#import <Metal/Metal.h>
+#import <MetalFX/MetalFX.h>
+#include <AvailabilityMacros.h>
+
+void *mfx_frame_create(void *p_device, uint32_t p_input_w, uint32_t p_input_h, uint32_t p_output_w, uint32_t p_output_h,
+		uint64_t p_color_format, uint64_t p_depth_format, uint64_t p_motion_format, uint64_t p_output_format, int *r_result) {
+	*r_result = MFX_FRAME_UNAVAILABLE;
+#if defined(__MAC_OS_X_VERSION_MAX_ALLOWED) && __MAC_OS_X_VERSION_MAX_ALLOWED >= 260000
+	@autoreleasepool {
+		if (@available(macOS 26.0, *)) {
+			id<MTLDevice> device = (__bridge id<MTLDevice>)p_device;
+			if (!device || ![MTLFXFrameInterpolatorDescriptor supportsDevice:device]) {
+				return nullptr;
+			}
+			MTLFXFrameInterpolatorDescriptor *d = [[MTLFXFrameInterpolatorDescriptor alloc] init];
+			if (!d) { *r_result = MFX_FRAME_FACTORY_FAILED; return nullptr; }
+			d.inputWidth = p_input_w; d.inputHeight = p_input_h;
+			d.outputWidth = p_output_w; d.outputHeight = p_output_h;
+			d.colorTextureFormat = (MTLPixelFormat)p_color_format;
+			d.depthTextureFormat = (MTLPixelFormat)p_depth_format;
+			d.motionTextureFormat = (MTLPixelFormat)p_motion_format;
+			d.outputTextureFormat = (MTLPixelFormat)p_output_format;
+			id<MTLFXFrameInterpolator> effect = [d newFrameInterpolatorWithDevice:device];
+			*r_result = effect ? MFX_FRAME_OK : MFX_FRAME_FACTORY_FAILED;
+			return (__bridge_retained void *)effect;
+		}
+	}
+#endif
+	return nullptr;
+}
+
+void mfx_frame_retain(void *p_effect) { if (p_effect) CFRetain((CFTypeRef)p_effect); }
+void mfx_frame_release(void *p_effect) { if (p_effect) CFRelease((CFTypeRef)p_effect); }
+
+int mfx_frame_encode(void *p_effect, void *p_command_buffer, void *p_fence, void *p_color, void *p_previous,
+		void *p_depth, void *p_motion, void *p_output, bool p_reset, float p_scale_x, float p_scale_y,
+		float p_jitter_x, float p_jitter_y, float p_delta, float p_fov_degrees, float p_near, float p_far, float p_aspect) {
+#if defined(__MAC_OS_X_VERSION_MAX_ALLOWED) && __MAC_OS_X_VERSION_MAX_ALLOWED >= 260000
+	@autoreleasepool {
+		if (@available(macOS 26.0, *)) {
+			id<MTLFXFrameInterpolator> fx = (__bridge id<MTLFXFrameInterpolator>)p_effect;
+			id<MTLCommandBuffer> command = (__bridge id<MTLCommandBuffer>)p_command_buffer;
+			id<MTLTexture> color = (__bridge id<MTLTexture>)p_color, prev = (__bridge id<MTLTexture>)p_previous;
+			id<MTLTexture> depth = (__bridge id<MTLTexture>)p_depth, motion = (__bridge id<MTLTexture>)p_motion;
+			id<MTLTexture> output = (__bridge id<MTLTexture>)p_output;
+			if (!fx || !command || !color || !prev || !depth || !motion || !output ||
+					color.width != fx.outputWidth || color.height != fx.outputHeight ||
+					prev.width != fx.outputWidth || prev.height != fx.outputHeight ||
+					depth.width != fx.inputWidth || depth.height != fx.inputHeight ||
+					motion.width != fx.inputWidth || motion.height != fx.inputHeight ||
+					output.width != fx.outputWidth || output.height != fx.outputHeight ||
+					color.pixelFormat != fx.colorTextureFormat || prev.pixelFormat != fx.colorTextureFormat ||
+					depth.pixelFormat != fx.depthTextureFormat || motion.pixelFormat != fx.motionTextureFormat ||
+					output.pixelFormat != fx.outputTextureFormat || output.storageMode != MTLStorageModePrivate ||
+					(color.usage & fx.colorTextureUsage) != fx.colorTextureUsage ||
+					(prev.usage & fx.colorTextureUsage) != fx.colorTextureUsage ||
+					(depth.usage & fx.depthTextureUsage) != fx.depthTextureUsage ||
+					(motion.usage & fx.motionTextureUsage) != fx.motionTextureUsage ||
+					(output.usage & fx.outputTextureUsage) != fx.outputTextureUsage) {
+				return MFX_FRAME_INPUT_MISMATCH;
+			}
+			fx.colorTexture = color;
+			fx.prevColorTexture = p_reset ? color : prev;
+			fx.depthTexture = depth; fx.motionTexture = motion; fx.outputTexture = output;
+			fx.shouldResetHistory = p_reset;
+			fx.motionVectorScaleX = p_scale_x; fx.motionVectorScaleY = p_scale_y;
+			fx.jitterOffsetX = p_jitter_x; fx.jitterOffsetY = p_jitter_y;
+			fx.deltaTime = p_delta; fx.fieldOfView = p_fov_degrees;
+			fx.nearPlane = p_near; fx.farPlane = p_far; fx.aspectRatio = p_aspect;
+			fx.depthReversed = YES; fx.uiTexture = nil; fx.fence = (__bridge id<MTLFence>)p_fence;
+			[fx encodeToCommandBuffer:command];
+			return MFX_FRAME_OK; // CPU encode returned; GPU completion is not observed.
+		}
+	}
+#endif
+	return MFX_FRAME_UNAVAILABLE;
+}
