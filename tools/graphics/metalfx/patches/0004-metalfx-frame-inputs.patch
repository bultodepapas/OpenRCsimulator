+// The render-buffer generation and queued Metal callbacks share this state.
+// Counts acknowledge CPU encoding only; they never imply GPU completion.
+struct MetalFXFrameHistoryState {
+	std::atomic<uint64_t> submitted{ 0 };
+	std::atomic<uint64_t> encoded{ 0 };
+	std::atomic<uint64_t> requested_epoch{ 0 };
+	std::atomic<uint64_t> encoded_epoch{ 0 };
+	std::atomic<uint32_t> encoded_in_epoch{ 0 };
+	std::atomic<int> callback_error{ 0 };
+	bool ready_for_debug_readback() const {
+		uint64_t last_submitted = submitted.load(std::memory_order_acquire);
+		uint64_t requested = requested_epoch.load(std::memory_order_acquire);
+		return !callback_error.load(std::memory_order_acquire) && last_submitted && requested &&
+				encoded.load(std::memory_order_acquire) == last_submitted &&
+				encoded_epoch.load(std::memory_order_acquire) == requested &&
+				encoded_in_epoch.load(std::memory_order_acquire) >= 5;
+	}
+};
