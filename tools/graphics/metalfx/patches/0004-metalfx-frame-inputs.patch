+
+MFXFrameContext::~MFXFrameContext() {
+	if (effect) {
+		mfx_frame_release(effect);
+	}
+}
+
+MFXFrameContext *MFXFrameEffect::create_context(const CreateParams &p_params) const {
+	MFXFrameContext *context = memnew(MFXFrameContext);
+	context->history = std::make_shared<MetalFXFrameHistoryState>();
+	context->input_size = p_params.input_size;
+	context->output_size = p_params.output_size;
+	context->color_format = p_params.color_format;
+	context->depth_format = p_params.depth_format;
+	context->motion_format = p_params.motion_format;
+	RenderingDeviceDriverMetal *driver = (RenderingDeviceDriverMetal *)RD::get_singleton()->get_device_driver();
+	if (!driver) {
+		context->allocation = MFX_FRAME_UNAVAILABLE;
+		return context;
+	}
+	PixelFormats &formats = driver->get_pixel_formats();
+	context->effect = mfx_frame_create(driver->get_device(), p_params.input_size.x, p_params.input_size.y,
+			p_params.output_size.x, p_params.output_size.y,
+			uint64_t(formats.getMTLPixelFormat(p_params.color_format)), uint64_t(formats.getMTLPixelFormat(p_params.depth_format)),
+			uint64_t(formats.getMTLPixelFormat(p_params.motion_format)), uint64_t(formats.getMTLPixelFormat(p_params.output_format)), &context->allocation);
+	return context;
+}
+
+bool MFXFrameEffect::process(MFXFrameContext *p_ctx, const Params &p_params) const {
+	if (!p_ctx || !p_ctx->effect || !p_ctx->history || p_ctx->history->callback_error.load(std::memory_order_acquire)) {
+		return false;
+	}
+	RD *rd = RD::get_singleton();
+	CallbackArgs *args = memnew(CallbackArgs);
+	args->effect = p_ctx->effect;
+	args->color = RDD::TextureID(rd->get_driver_resource(RDC::DRIVER_RESOURCE_TEXTURE, p_params.color));
+	args->previous = RDD::TextureID(rd->get_driver_resource(RDC::DRIVER_RESOURCE_TEXTURE, p_params.previous));
+	args->depth = RDD::TextureID(rd->get_driver_resource(RDC::DRIVER_RESOURCE_TEXTURE, p_params.depth));
+	args->motion = RDD::TextureID(rd->get_driver_resource(RDC::DRIVER_RESOURCE_TEXTURE, p_params.motion));
+	args->output = RDD::TextureID(rd->get_driver_resource(RDC::DRIVER_RESOURCE_TEXTURE, p_params.output));
+	args->history = p_ctx->history;
+	args->serial = p_ctx->history->submitted.load(std::memory_order_relaxed) + 1;
+	args->epoch = p_params.epoch;
+	args->scale_x = p_params.motion_scale.x; args->scale_y = p_params.motion_scale.y;
+	args->jitter_x = p_params.jitter.x; args->jitter_y = p_params.jitter.y;
+	args->delta = p_params.delta; args->fov = p_params.fov;
+	args->z_near = p_params.z_near; args->z_far = p_params.z_far; args->aspect = p_params.aspect;
+	args->reset = p_params.reset;
+	if (!args->color.id || !args->previous.id || !args->depth.id || !args->motion.id || !args->output.id || !args->serial) {
+		memdelete(args);
+		return false;
+	}
+	RD::CallbackResource resources[5] = {
+		{ .rid = p_params.color, .usage = RD::CALLBACK_RESOURCE_USAGE_TEXTURE_SAMPLE },
+		{ .rid = p_params.previous, .usage = RD::CALLBACK_RESOURCE_USAGE_TEXTURE_SAMPLE },
+		{ .rid = p_params.depth, .usage = RD::CALLBACK_RESOURCE_USAGE_TEXTURE_SAMPLE },
+		{ .rid = p_params.motion, .usage = RD::CALLBACK_RESOURCE_USAGE_TEXTURE_SAMPLE },
+		{ .rid = p_params.output, .usage = RD::CALLBACK_RESOURCE_USAGE_STORAGE_IMAGE_READ_WRITE },
+	};
+	mfx_frame_retain(args->effect);
+	uint64_t serial = args->serial;
+	Error error = rd->driver_callback_add((RDD::DriverCallback)MFXFrameEffect::callback, args, VectorView<RD::CallbackResource>(resources, 5));
+	if (error != OK) {
+		mfx_frame_release(args->effect);
+		memdelete(args);
+		return false;
+	}
+	p_ctx->history->submitted.store(serial, std::memory_order_release);
+	return true;
+}
+
+void MFXFrameEffect::callback(RDD *p_driver, RDD::CommandBufferID p_command_buffer, CallbackArgs *p_userdata) {
+	(void)p_driver;
+	std::shared_ptr<MetalFXFrameHistoryState> history = p_userdata->history;
+	if (!history->callback_error.load(std::memory_order_acquire)) {
+		MDCommandBufferBase *obj = (MDCommandBufferBase *)(p_command_buffer.id);
+		obj->end();
+		MTL3::MDCommandBuffer *cmd = (MTL3::MDCommandBuffer *)(p_command_buffer.id);
+		int result = mfx_frame_encode(p_userdata->effect, cmd->get_command_buffer(), obj->external_pass_fence(),
+				(void *)p_userdata->color.id, (void *)p_userdata->previous.id, (void *)p_userdata->depth.id,
+				(void *)p_userdata->motion.id, (void *)p_userdata->output.id, p_userdata->reset,
+				p_userdata->scale_x, p_userdata->scale_y, p_userdata->jitter_x, p_userdata->jitter_y,
+				p_userdata->delta, p_userdata->fov, p_userdata->z_near, p_userdata->z_far, p_userdata->aspect);
+		if (result == MFX_FRAME_OK) {
+			obj->retain_resource((CFTypeRef)p_userdata->effect);
+			if (p_userdata->reset) {
+				history->encoded_in_epoch.store(1, std::memory_order_relaxed);
+				history->encoded_epoch.store(p_userdata->epoch, std::memory_order_release);
+			} else if (history->encoded_epoch.load(std::memory_order_acquire) == p_userdata->epoch) {
+				history->encoded_in_epoch.fetch_add(1, std::memory_order_release);
+			} else {
+				history->callback_error.store(MFX_FRAME_INPUT_MISMATCH, std::memory_order_release);
+			}
+			history->encoded.store(p_userdata->serial, std::memory_order_release);
+		} else {
+			history->callback_error.store(result, std::memory_order_release);
+		}
+	}
+	mfx_frame_release(p_userdata->effect);
+	memdelete(p_userdata);
+}
+
+#endif // MACOS_ENABLED
+
+#endif // METAL_ENABLED
