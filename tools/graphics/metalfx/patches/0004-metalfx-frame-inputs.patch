+Dictionary RenderSceneBuffersRD::get_metalfx_frame_status() const {
+	Dictionary result = RenderSceneBuffers::get_metalfx_frame_status();
+	result["gpu_completion"] = "unobserved";
+	result["input_color"] = "scene_hdr_before_tonemap";
+	result["motion_convention"] = "previous_minus_current_uv_scaled_to_input_pixels";
+	result["jitter_convention"] = "temporal_input_hypothesis_not_scene_verified";
+	result["output_initialization"] = "magenta_sentinel_each_encode";
+	result["purpose"] = "experiment_not_presentable";
+#if defined(METAL_ENABLED) && defined(MACOS_ENABLED)
+	result["reason"] = mfx_frame_reason;
+	if (mfx_frame_context) {
+		const RendererRD::MFXFrameContext *ctx = mfx_frame_context;
+		result["allocation"] = ctx->effect ? "created" : (ctx->allocation == MFX_FRAME_UNAVAILABLE ? "device_or_os_unavailable" : "factory_failed");
+		result["input_size"] = ctx->input_size;
+		result["output_size"] = ctx->output_size;
+		result["color_format"] = int(ctx->color_format);
+		result["depth_format"] = int(ctx->depth_format);
+		result["motion_format"] = int(ctx->motion_format);
+		if (ctx->history) {
+			uint64_t submitted = ctx->history->submitted.load(std::memory_order_acquire);
+			uint64_t encoded = ctx->history->encoded.load(std::memory_order_acquire);
+			uint64_t requested_epoch = ctx->history->requested_epoch.load(std::memory_order_acquire);
+			uint64_t encoded_epoch = ctx->history->encoded_epoch.load(std::memory_order_acquire);
+			uint32_t encoded_in_epoch = ctx->history->encoded_in_epoch.load(std::memory_order_acquire);
+			int error = ctx->history->callback_error.load(std::memory_order_acquire);
+			result["submission"] = error == MFX_FRAME_ENQUEUE_FAILED ? "enqueue_failed" : (submitted ? "enqueued" : "not_attempted");
+			result["submitted"] = int64_t(submitted);
+			result["encoded_not_gpu_complete"] = int64_t(encoded);
+			result["requested_epoch"] = int64_t(requested_epoch);
+			result["encoded_epoch"] = int64_t(encoded_epoch);
+			result["encoded_in_epoch"] = int64_t(encoded_in_epoch);
+			result["required_encodes_after_reset"] = 5; // reset + 3 warmups + one output
+			result["callback_error"] = error;
+			result["ready_for_debug_readback"] = ctx->effect && ctx->history->ready_for_debug_readback() &&
+					has_texture(RB_SCOPE_METALFX_FRAME, RB_METALFX_FRAME_OUTPUT);
+		}
+	}
+#endif
+	return result;
+}
+
+Dictionary RenderSceneBuffersRD::read_metalfx_frame() {
+	Dictionary result = get_metalfx_frame_status();
+	if (!bool(result.get("ready_for_debug_readback", false))) {
+		result["readback"] = "not_ready";
+		return result;
+	}
+#if defined(METAL_ENABLED) && defined(MACOS_ENABLED)
+	// Explicit diagnostic only: this existing RD operation flushes and stalls.
+	RID output = get_texture(RB_SCOPE_METALFX_FRAME, RB_METALFX_FRAME_OUTPUT);
+	Vector<uint8_t> bytes = RD::get_singleton()->texture_get_data(output, 0);
+	Size2i size = mfx_frame_context->output_size;
+	if (bytes.size() != int64_t(size.x) * size.y * 8) {
+		result["readback"] = "failed";
+		return result;
+	}
+	Ref<Image> image = Image::create_from_data(size.x, size.y, false, Image::FORMAT_RGBAH, bytes);
+	result["image"] = image;
+	result["readback"] = image.is_valid() ? "returned" : "failed";
+#endif
+	return result;
+}
