+
+void RenderForwardClustered::_process_metalfx_frame(const RenderDataRD *p_render_data, Ref<RenderSceneBuffersRD> p_buffers, bool p_temporal_submitted, bool p_temporal_reset) {
+	if (!p_buffers->is_metalfx_frame_requested()) {
+		return;
+	}
+	RSE::EnvironmentBG background = is_environment(p_render_data->environment) ? environment_get_background(p_render_data->environment) : RSE::ENV_BG_CLEAR_COLOR;
+	const char *scene_rejection = metalfx_frame_scene_rejection(!render_list[RENDER_LIST_ALPHA].elements.is_empty(), background);
+	if (scene_rejection) {
+		p_buffers->reject_metalfx_frame(scene_rejection);
+		return;
+	}
+	const Projection &projection = p_render_data->scene_data->cam_projection;
+	if (!p_temporal_submitted || p_buffers->get_view_count() != 1 || p_render_data->scene_data->cam_orthogonal ||
+			p_buffers->get_msaa_3d() != RSE::VIEWPORT_MSAA_DISABLED || p_render_data->transparent_bg ||
+			!Math::is_zero_approx(projection.columns[2][0]) || !Math::is_zero_approx(projection.columns[2][1])) {
+		p_buffers->reject_metalfx_frame("requires_temporal_single_view_symmetric_perspective_opaque_no_msaa");
+		return;
+	}
+	Size2i input_size = p_buffers->get_internal_size();
+	Size2i output_size = p_buffers->get_target_size();
+	float aspect = projection.get_aspect();
+	if (!Math::is_finite(aspect) || aspect <= 0) {
+		p_buffers->reject_metalfx_frame("invalid_camera_or_extent");
+		return;
+	}
+	float fov = Projection::get_fovy(projection.get_fov(), 1.0 / aspect);
+	float z_near = p_render_data->scene_data->z_near;
+	float z_far = p_render_data->scene_data->z_far;
+	Vector2 jitter = p_render_data->scene_data->taa_jitter * 0.5f * Vector2(1.0f, -1.0f);
+	if (input_size.x <= 0 || input_size.y <= 0 || output_size.x <= 0 || output_size.y <= 0 ||
+			!Math::is_finite(aspect) || aspect <= 0 || !Math::is_finite(fov) || fov <= 0 || fov >= 180 ||
+			!Math::is_finite(z_near) || !Math::is_finite(z_far) || z_near <= 0 || z_far <= z_near ||
+			!Math::is_finite(jitter.x) || !Math::is_finite(jitter.y)) {
+		p_buffers->reject_metalfx_frame("invalid_camera_or_extent");
+		return;
+	}
+	RD *rd = RD::get_singleton();
+	RID source = p_buffers->get_upscaled_texture(0);
+	RID depth = p_buffers->get_depth_texture(0);
+	RID motion = p_buffers->get_velocity_buffer(false, 0);
+	if (!source.is_valid() || !depth.is_valid() || !motion.is_valid()) {
+		p_buffers->reject_metalfx_frame("missing_temporal_inputs");
+		return;
+	}
+	RD::TextureFormat source_format = rd->texture_get_format(source);
+	RD::TextureFormat depth_format = rd->texture_get_format(depth);
+	RD::TextureFormat motion_format = rd->texture_get_format(motion);
+	if (source_format.format != RD::DATA_FORMAT_R16G16B16A16_SFLOAT || motion_format.format != RD::DATA_FORMAT_R16G16_SFLOAT ||
+			source_format.width != uint32_t(output_size.x) || source_format.height != uint32_t(output_size.y) ||
+			depth_format.width != uint32_t(input_size.x) || depth_format.height != uint32_t(input_size.y) ||
+			motion_format.width != uint32_t(input_size.x) || motion_format.height != uint32_t(input_size.y) ||
+			source_format.texture_type != RD::TEXTURE_TYPE_2D || depth_format.texture_type != RD::TEXTURE_TYPE_2D || motion_format.texture_type != RD::TEXTURE_TYPE_2D ||
+			source_format.samples != RD::TEXTURE_SAMPLES_1 || depth_format.samples != RD::TEXTURE_SAMPLES_1 || motion_format.samples != RD::TEXTURE_SAMPLES_1) {
+		p_buffers->reject_metalfx_frame("unsupported_input_formats_or_extents");
+		return;
+	}
+	RendererRD::MFXFrameEffect effect;
+	RendererRD::MFXFrameEffect::CreateParams create;
+	create.input_size = input_size; create.output_size = output_size;
+	create.color_format = source_format.format; create.depth_format = depth_format.format;
+	create.motion_format = motion_format.format; create.output_format = source_format.format;
+	RendererRD::MFXFrameContext *ctx = p_buffers->ensure_metalfx_frame_context(&effect, create);
+	if (!ctx || !ctx->effect || ctx->history->callback_error.load(std::memory_order_acquire)) {
+		return;
+	}
+	uint32_t capture_usage = RD::TEXTURE_USAGE_SAMPLING_BIT | RD::TEXTURE_USAGE_STORAGE_BIT;
+	RID captures[2] = {
+		p_buffers->create_texture(RB_SCOPE_METALFX_FRAME, RB_METALFX_FRAME_CAPTURE_0, RD::DATA_FORMAT_R16G16B16A16_SFLOAT, capture_usage, RD::TEXTURE_SAMPLES_1, output_size),
+		p_buffers->create_texture(RB_SCOPE_METALFX_FRAME, RB_METALFX_FRAME_CAPTURE_1, RD::DATA_FORMAT_R16G16B16A16_SFLOAT, capture_usage, RD::TEXTURE_SAMPLES_1, output_size),
+	};
+	RID output = p_buffers->create_texture(RB_SCOPE_METALFX_FRAME, RB_METALFX_FRAME_OUTPUT, RD::DATA_FORMAT_R16G16B16A16_SFLOAT,
+			RD::TEXTURE_USAGE_SAMPLING_BIT | RD::TEXTURE_USAGE_STORAGE_BIT | RD::TEXTURE_USAGE_COLOR_ATTACHMENT_BIT |
+					RD::TEXTURE_USAGE_CAN_COPY_FROM_BIT | RD::TEXTURE_USAGE_CAN_COPY_TO_BIT, RD::TEXTURE_SAMPLES_1, output_size);
+	if (!captures[0].is_valid() || !captures[1].is_valid() || !output.is_valid()) {
+		p_buffers->reject_metalfx_frame("capture_allocation_failed");
+		return;
+	}
+	uint64_t frame = RSG::rasterizer->get_frame_number();
+	uint64_t now = OS::get_singleton()->get_ticks_usec();
+	RendererRD::MFXFrameTimeline::Decision decision = ctx->timeline.decide(frame, now, p_temporal_reset, fov, z_near, z_far, aspect);
+	bool reset = decision.reset;
+	float delta = decision.delta;
+	if (reset) {
+		delta = 1.0f / 60.0f; // first/reset frame has no usable previous pair
+		if (!p_buffers->next_metalfx_frame_epoch(ctx->epoch)) {
+			p_buffers->reject_metalfx_frame("generation_exhausted");
+			return;
+		}
+		ctx->history->requested_epoch.store(ctx->epoch, std::memory_order_release);
+	}
+	uint32_t current = ctx->next_capture;
+	uint32_t previous = current ^ 1;
+	// Exact texel copy to owned HDR storage. The graph tracks this write, the
+	// callback's reads and the next reuse of either ring texture.
+	copy_effects->copy_to_rect(source, captures[current], Rect2i(Point2i(), output_size));
+	if (rd->texture_clear(output, Color(1, 0, 1, 1), 0, 1, 0, 1) != OK) {
+		p_buffers->reject_metalfx_frame("output_clear_failed");
+		return;
+	}
+	RendererRD::MFXFrameEffect::Params params;
+	params.color = captures[current]; params.previous = captures[previous];
+	params.depth = depth; params.motion = motion; params.output = output;
+	params.motion_scale = Vector2(input_size);
+	params.jitter = jitter;
+	params.delta = delta; params.fov = fov; params.z_near = z_near; params.z_far = z_far; params.aspect = aspect;
+	params.reset = reset; params.epoch = ctx->epoch;
+	if (!effect.process(ctx, params)) {
+		ctx->history->callback_error.store(MFX_FRAME_ENQUEUE_FAILED, std::memory_order_release);
+		return;
+	}
+	ctx->timeline.commit(frame, now, fov, z_near, z_far, aspect);
+	ctx->next_capture = previous;
+}
