+void RenderSceneBuffersRD::clear_metalfx_frame() {
+#if defined(METAL_ENABLED) && defined(MACOS_ENABLED)
+	if (mfx_frame_context) {
+		memdelete(mfx_frame_context);
+		mfx_frame_context = nullptr;
+		clear_context(RB_SCOPE_METALFX_FRAME);
+	}
+	mfx_frame_reason = "not_attempted";
+#endif
+}
