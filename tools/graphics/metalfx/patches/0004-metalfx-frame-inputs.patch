+// Only commit this timeline after RD admits the callback. A missing frame,
+// backward clock, camera projection edit or Temporal reset restarts history.
+struct MFXFrameTimeline {
+	bool has_previous = false;
+	uint64_t last_frame = 0, last_usec = 0;
+	float previous_fov = 0, previous_near = 0, previous_far = 0, previous_aspect = 0;
+	struct Decision { bool reset; float delta; };
+	Decision decide(uint64_t p_frame, uint64_t p_usec, bool p_temporal_reset, float p_fov, float p_near, float p_far, float p_aspect) const {
+		bool clock_valid = !has_previous || p_usec > last_usec;
+		float delta = has_previous && clock_valid ? float(double(p_usec - last_usec) / 1000000.0) : 1.0f / 60.0f;
+		bool consecutive = has_previous && p_frame > last_frame && p_frame - last_frame == 1;
+		bool projection_changed = has_previous && (previous_fov != p_fov || previous_near != p_near || previous_far != p_far || previous_aspect != p_aspect);
+		bool reset = p_temporal_reset || !consecutive || projection_changed || !clock_valid || !Math::is_finite(delta) || delta <= 0.0f || delta > 0.25f;
+		return { reset, reset ? 1.0f / 60.0f : delta };
+	}
+	void commit(uint64_t p_frame, uint64_t p_usec, float p_fov, float p_near, float p_far, float p_aspect) {
+		last_frame = p_frame; last_usec = p_usec; has_previous = true;
+		previous_fov = p_fov; previous_near = p_near; previous_far = p_far; previous_aspect = p_aspect;
+	}
+};
+
+struct MFXFrameContext {
+	void *effect = nullptr;
+	int allocation = 0;
+	std::shared_ptr<MetalFXFrameHistoryState> history;
+	MFXFrameTimeline timeline;
+	uint64_t epoch = 0;
+	uint32_t next_capture = 0;
+	RDD::DataFormat color_format = RDD::DATA_FORMAT_MAX;
+	RDD::DataFormat depth_format = RDD::DATA_FORMAT_MAX;
+	RDD::DataFormat motion_format = RDD::DATA_FORMAT_MAX;
+	Vector2i input_size, output_size;
+	MFXFrameContext() = default;
+	~MFXFrameContext();
+};
+
+class MFXFrameEffect {
+	struct CallbackArgs {
+		void *effect = nullptr;
+		RDD::TextureID color, previous, depth, motion, output;
+		std::shared_ptr<MetalFXFrameHistoryState> history;
+		uint64_t serial = 0, epoch = 0;
+		float scale_x = 0, scale_y = 0, jitter_x = 0, jitter_y = 0;
+		float delta = 0, fov = 0, z_near = 0, z_far = 0, aspect = 0;
+		bool reset = false;
+	};
+	static void callback(RDD *p_driver, RDD::CommandBufferID p_command_buffer, CallbackArgs *p_userdata);
+
+public:
+	struct CreateParams {
+		Vector2i input_size, output_size;
+		RDD::DataFormat color_format, depth_format, motion_format, output_format;
+	};
+	struct Params {
+		RID color, previous, depth, motion, output;
+		Vector2 motion_scale, jitter;
+		float delta = 0, fov = 0, z_near = 0, z_far = 0, aspect = 0;
+		bool reset = false;
+		uint64_t epoch = 0;
+	};
+	MFXFrameContext *create_context(const CreateParams &p_params) const;
