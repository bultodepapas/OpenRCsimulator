+// Shared by a buffer generation and its queued callbacks. Reconfiguration
+// replaces the state; late callbacks can only acknowledge their old generation.
+struct MetalFXTemporalHistoryState {
+	std::atomic<uint64_t> requested{ 0 };
+	std::atomic<uint64_t> submitted{ 0 }; // Admitted to the RD callback graph, not GPU submission.
+	std::atomic<uint64_t> encoded{ 0 }; // The CPU-side MetalFX encode call returned, not GPU completion.
+	std::atomic<uint64_t> temporal_attempts{ 0 }; // Actual entries into the Temporal render branch.
+	// A reused scaler still needs a reset after its viewport generation changes.
+	std::atomic<bool> initial_reset_encoded{ false };
+
+	static void advance(std::atomic<uint64_t> &p_counter, uint64_t p_value) {
+		uint64_t previous = p_counter.load(std::memory_order_relaxed);
+		while (previous < p_value && !p_counter.compare_exchange_weak(previous, p_value, std::memory_order_release, std::memory_order_relaxed)) {
+		}
+	}
+};
 
