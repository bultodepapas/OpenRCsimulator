+Dictionary RendererViewport::viewport_request_temporal_history_reset(RID p_viewport) {
+	Viewport *viewport = viewport_owner.get_or_null(p_viewport);
+	ERR_FAIL_NULL_V(viewport, Dictionary());
+	Dictionary receipt;
+	receipt["accepted"] = false;
+	receipt["generation"] = int64_t(viewport->metal_fx_generation);
+	receipt["serial"] = int64_t(0);
+	receipt["reset_request_attempt"] = int64_t(0);
+	if (viewport->disable_3d || viewport->view_count != 1 || !viewport->render_buffers.is_valid() ||
+			!viewport->render_buffers->is_metalfx_temporal_ready() || viewport->metal_fx_reset_serial >= uint64_t(INT64_MAX)) {
+		return receipt;
+	}
+	std::shared_ptr<MetalFXTemporalHistoryState> history = viewport->render_buffers->get_metalfx_history_state();
+	uint64_t attempts = history->temporal_attempts.load(std::memory_order_acquire);
+	// Leave room to observe the two render attempts used by the caller's bound.
+	if (attempts > uint64_t(INT64_MAX) - 2) {
+		return receipt;
+	}
+	uint64_t serial = ++viewport->metal_fx_reset_serial;
+	history->requested.store(serial, std::memory_order_release);
+	receipt["reset_request_attempt"] = int64_t(attempts);
+	receipt["accepted"] = true;
+	receipt["serial"] = int64_t(serial);
+	return receipt;
 }
 
