+// SPDX-License-Identifier: MIT
+// Bounded per-main-viewport real-render completion receipts. A GPU callback
+// retains only this state and its reservation; no render target is retained.
+#pragma once
+
+#include <algorithm>
+#include <array>
+#include <cmath>
+#include <cstdint>
+#include <limits>
+#include <mutex>
+
+class RealGPUCompletion {
+public:
+    static constexpr size_t CAPACITY = 1024;
+    static constexpr double RETENTION_SECONDS = 3.0;
+    static constexpr uint64_t MAX_ID = uint64_t(std::numeric_limits<int64_t>::max());
+    struct Reservation { uint64_t generation = 0; uint64_t frame = 0; double reserved_at = 0; };
+    struct Sample { uint64_t generation = 0; uint64_t frame = 0; double gpu_end_seconds = 0; };
+    struct Snapshot {
+        bool enabled = false, failed = false, overflow = false, invalid_clock = false;
+        uint64_t generation = 0, stale_callbacks = 0;
+        size_t pending = 0, count = 0;
+        double now_seconds = 0, observed_through_seconds = 0, coverage_start_seconds = 0;
+        const char *reason = "not_requested";
+        std::array<Sample, CAPACITY> samples{};
+    };
+private:
+    struct Pending { bool active = false; Reservation reservation; };
+    mutable std::mutex gate;
+    std::array<Pending, CAPACITY> pending{};
+    std::array<Sample, CAPACITY> samples{};
+    size_t pending_count = 0, outstanding_count = 0, sample_count = 0;
+    uint64_t generation = 0, last_frame = 0, stale_callbacks = 0;
+    bool have_frame = false, enabled = false, failed = false, overflow = false, invalid_clock = false;
+    double started_at = 0, last_reserved_at = 0, evicted_through = 0;
+    const char *reason = "not_requested";
+    static bool valid_time(double p_time) { return std::isfinite(p_time) && p_time > 0; }
+    void fail_locked(const char *p_reason) { failed = true; reason = p_reason; }
+    void prune_locked(double p_now) {
+        const double cutoff = p_now - RETENTION_SECONDS;
+        size_t keep = 0;
+        for (size_t i = 0; i < sample_count; ++i) {
+            if (samples[i].gpu_end_seconds < cutoff) {
+                evicted_through = std::max(evicted_through, samples[i].gpu_end_seconds);
+            } else { samples[keep++] = samples[i]; }
+        }
+        sample_count = keep;
+    }
+public:
+    // Invalidate prior callbacks without replacing the shared state object.
+    bool reset(bool p_enabled, double p_now) {
+        std::lock_guard<std::mutex> lock(gate);
+        if (generation == MAX_ID) { failed = true; reason = "generation_exhausted"; return false; }
+        ++generation;
+        pending_count = sample_count = 0;
+        // Old-generation callbacks retain their slots until they arrive. A
+        // stalled GPU therefore cannot grow memory across repeated resets.
+        have_frame = false; enabled = p_enabled; failed = overflow = invalid_clock = false;
+        started_at = last_reserved_at = p_now; evicted_through = 0;
+        reason = p_enabled ? "ok" : "not_requested";
+        if (p_enabled && !valid_time(p_now)) { invalid_clock = true; fail_locked("invalid_clock"); return false; }
+        return true;
+    }
+    Reservation reserve(uint64_t p_frame, double p_now) {
+        std::lock_guard<std::mutex> lock(gate);
+        if (!enabled || failed || overflow || invalid_clock) { return {}; }
+        if (!valid_time(p_now) || p_now < last_reserved_at) { invalid_clock = true; fail_locked("invalid_clock"); return {}; }
+        if (p_frame > MAX_ID || (have_frame && p_frame <= last_frame)) { fail_locked("duplicate_or_stale_frame"); return {}; }
+        if (outstanding_count == CAPACITY) { overflow = true; fail_locked("pending_overflow"); return {}; }
+        for (auto &p : pending) {
+            if (!p.active) {
+                p.active = true; p.reservation = { generation, p_frame, p_now };
+                ++pending_count; ++outstanding_count; last_frame = p_frame; have_frame = true; last_reserved_at = p_now;
+                return p.reservation;
+            }
+        }
+        overflow = true; fail_locked("pending_overflow"); return {};
+    }
+    void fail(const Reservation &p_reservation, const char *p_reason) {
+        std::lock_guard<std::mutex> lock(gate);
+        for (auto &p : pending) {
+            if (p.active && p.reservation.generation == p_reservation.generation && p.reservation.frame == p_reservation.frame && p.reservation.reserved_at == p_reservation.reserved_at) {
+                p.active = false; --outstanding_count;
+                if (p_reservation.generation == generation && pending_count) { --pending_count; }
+                break;
+            }
+        }
+        if (p_reservation.generation == generation && enabled) { fail_locked(p_reason); }
+    }
+    void invalidate(const char *p_reason) {
+        std::lock_guard<std::mutex> lock(gate);
+        if (enabled) { fail_locked(p_reason); }
+    }
+    void complete(const Reservation &p_reservation, bool p_success, double p_gpu_end, double p_now) {
+        std::lock_guard<std::mutex> lock(gate);
+        const bool current = enabled && p_reservation.generation == generation;
+        Pending *slot = nullptr;
+        for (auto &p : pending) {
+            if (p.active && p.reservation.frame == p_reservation.frame && p.reservation.generation == p_reservation.generation && p.reservation.reserved_at == p_reservation.reserved_at) { slot = &p; break; }
+        }
+        if (!slot) { if (current) { fail_locked("unexpected_callback"); } return; }
+        slot->active = false; --outstanding_count;
+        if (!current) { if (stale_callbacks < MAX_ID) { ++stale_callbacks; } return; }
+        --pending_count;
+        if (!p_success) { fail_locked("gpu_failure"); return; }
+        if (!valid_time(p_now) || !valid_time(p_gpu_end) || p_gpu_end < p_reservation.reserved_at || p_gpu_end > p_now) {
+            invalid_clock = true; fail_locked("invalid_clock"); return;
+        }
+        // Different frames with the same or reversed GPU end cannot establish
+        // per-frame cadence, even if callbacks arrive out of order.
+        for (size_t i = 0; i < sample_count; ++i) {
+            if ((samples[i].frame < p_reservation.frame && samples[i].gpu_end_seconds >= p_gpu_end) ||
+                    (samples[i].frame > p_reservation.frame && samples[i].gpu_end_seconds <= p_gpu_end)) {
+                invalid_clock = true; fail_locked("nonmonotonic_gpu_completion"); return;
+            }
+        }
+        prune_locked(p_now);
+        if (p_gpu_end < p_now - RETENTION_SECONDS) { evicted_through = std::max(evicted_through, p_gpu_end); return; }
+        if (sample_count == CAPACITY) { overflow = true; fail_locked("sample_overflow"); return; }
+        samples[sample_count++] = { generation, p_reservation.frame, p_gpu_end };
+    }
+    Snapshot snapshot(double p_now) const {
+        std::lock_guard<std::mutex> lock(gate);
+        Snapshot out;
+        out.enabled = enabled; out.failed = failed; out.overflow = overflow; out.invalid_clock = invalid_clock;
+        out.generation = generation; out.stale_callbacks = stale_callbacks; out.pending = pending_count;
+        out.reason = reason; out.now_seconds = p_now;
+        if (!enabled) { return out; }
+        if (!valid_time(p_now) || p_now < started_at) { out.invalid_clock = out.failed = true; out.reason = "invalid_clock"; return out; }
+        out.coverage_start_seconds = std::max(started_at, p_now - RETENTION_SECONDS);
+        if (evicted_through > 0) { out.coverage_start_seconds = std::max(out.coverage_start_seconds, std::nextafter(evicted_through, std::numeric_limits<double>::infinity())); }
+        out.observed_through_seconds = p_now;
+        for (const auto &p : pending) { if (p.active && p.reservation.generation == generation) { out.observed_through_seconds = std::min(out.observed_through_seconds, p.reservation.reserved_at); } }
+        if (out.observed_through_seconds < out.coverage_start_seconds) { out.failed = true; out.reason = "pending_history_lost"; }
+        for (size_t i = 0; i < sample_count; ++i) {
+            if (samples[i].gpu_end_seconds >= out.coverage_start_seconds && samples[i].gpu_end_seconds <= p_now) { out.samples[out.count++] = samples[i]; }
+        }
+        std::sort(out.samples.begin(), out.samples.begin() + out.count, [](const Sample &a, const Sample &b) { return a.gpu_end_seconds < b.gpu_end_seconds; });
+        return out;
+    }
+};
