+bool RenderingDeviceDriverMetal::real_gpu_completion_register(CommandBufferID p_buffer, const std::shared_ptr<RealGPUCompletion> &p_state, const RealGPUCompletion::Reservation &p_reservation) {
+	if (!p_buffer.id || !p_state) { return false; }
+	MDCommandBuffer *cmd = (MDCommandBuffer *)p_buffer.id;
+	cmd->end();
+	MTL::CommandBuffer *native = cmd->ensure_command_buffer();
+	if (!native) { return false; }
+	native->addCompletedHandler([state = p_state, reservation = p_reservation](MTL::CommandBuffer *completed) {
+		const bool success = completed && completed->status() == MTL::CommandBufferStatusCompleted && completed->error() == nullptr;
+		const double gpu_end = success ? completed->GPUEndTime() : 0;
+		state->complete(reservation, success, gpu_end, mfx_real_gpu_now());
+	});
+	return true;
+}
