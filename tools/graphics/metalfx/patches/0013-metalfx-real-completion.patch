+void RendererViewport::_real_gpu_reset_main() {
+	if (!real_gpu_observer || real_gpu_observer_viewport.is_null()) { return; }
+	Viewport *viewport = viewport_owner.get_or_null(real_gpu_observer_viewport);
+	if (!viewport || !viewport->real_gpu_observation_requested) { return; }
+	viewport->real_gpu_observation_eligible = false;
+	RD *rd = RD::get_singleton();
+	real_gpu_observer->reset(true, rd ? rd->real_gpu_completion_now() : 0);
+}
+
+void RendererViewport::_real_gpu_observe_viewport(Viewport *p_viewport) {
+	if (!real_gpu_observer || p_viewport->self != real_gpu_observer_viewport) { return; }
+	RD *rd = RD::get_singleton();
+	if (!rd || !rd->real_gpu_completion_supported()) { real_gpu_observer->invalidate("backend_unavailable"); return; }
+	const Size2i screen_size(rd->screen_get_width(DisplayServerEnums::MAIN_WINDOW_ID), rd->screen_get_height(DisplayServerEnums::MAIN_WINDOW_ID));
+	const Rect2 screen_rect{ Vector2(), Size2(screen_size) };
+	if (p_viewport->viewport_to_screen != DisplayServerEnums::MAIN_WINDOW_ID || p_viewport->use_xr || p_viewport->view_count != 1 ||
+			p_viewport->viewport_render_direct_to_screen || screen_size.x <= 1 || screen_size.y <= 1 || p_viewport->size != screen_size ||
+			(p_viewport->viewport_to_screen_rect != Rect2() && p_viewport->viewport_to_screen_rect != screen_rect)) {
+		real_gpu_observer->invalidate("ineligible_viewport"); return;
+	}
+	int main_count = 0;
+	for (Viewport *candidate : sorted_active_viewports) {
+		if (candidate->last_pass == draw_viewports_pass && candidate->viewport_to_screen == DisplayServerEnums::MAIN_WINDOW_ID) { ++main_count; }
+	}
+	if (main_count != 1) { real_gpu_observer->invalidate("multiple_main_viewports"); return; }
+	// A repeated untouched RT is not a new real 3D scene render.
+#ifdef _3D_DISABLED
+	real_gpu_observer->invalidate("scene_unavailable"); return;
+#else
+	if (p_viewport->disable_3d || !p_viewport->render_buffers.is_valid() || !RSG::scene->is_camera(p_viewport->camera) || !RSG::scene->is_scenario(p_viewport->scenario)) { real_gpu_observer->invalidate("scene_unavailable"); return; }
+#endif
+	if (RSG::texture_storage->render_target_get_override_color(p_viewport->render_target).is_valid()) { real_gpu_observer->invalidate("overridden_real_target"); return; }
+	RID texture = RSG::texture_storage->texture_get_rd_texture(RSG::texture_storage->render_target_get_texture(p_viewport->render_target));
+	if (texture.is_null()) { real_gpu_observer->invalidate("missing_real_texture"); return; }
+	if (rd->real_gpu_completion_observe(texture, real_gpu_observer, RSG::rasterizer->get_frame_number()) == OK) {
+		p_viewport->real_gpu_observation_eligible = true;
+	}
+}
+
+void RendererViewport::viewport_set_real_gpu_observation_requested(RID p_viewport, bool p_enabled) {
+	Viewport *viewport = viewport_owner.get_or_null(p_viewport);
+	ERR_FAIL_NULL(viewport);
+	if (viewport->real_gpu_observation_requested == p_enabled && (!p_enabled || real_gpu_observer_viewport == p_viewport)) { return; }
+	viewport->real_gpu_observation_requested = p_enabled;
+	viewport->real_gpu_observation_eligible = false;
+	if (!p_enabled) {
+		if (real_gpu_observer_viewport == p_viewport) {
+			if (real_gpu_observer) { real_gpu_observer->reset(false, 0); }
+			real_gpu_observer_viewport = RID();
+		}
+		return;
+	}
+	RD *rd = RD::get_singleton();
+	if (!rd || !rd->real_gpu_completion_supported() || real_gpu_observer_viewport.is_valid()) { return; }
+	if (!real_gpu_observer) { real_gpu_observer = std::make_shared<RealGPUCompletion>(); }
+	real_gpu_observer_viewport = p_viewport;
+	real_gpu_observer->reset(true, rd->real_gpu_completion_now());
+}
+
+void RendererViewport::viewport_reset_real_gpu_observation(RID p_viewport) {
+	Viewport *viewport = viewport_owner.get_or_null(p_viewport);
+	ERR_FAIL_NULL(viewport);
+	if (!viewport->real_gpu_observation_requested) { return; }
+	if (p_viewport == real_gpu_observer_viewport) { _real_gpu_reset_main(); }
+	else { viewport_set_real_gpu_observation_requested(p_viewport, true); }
+}
+
+Dictionary RendererViewport::viewport_get_real_gpu_observation(RID p_viewport) const {
+	Viewport *viewport = viewport_owner.get_or_null(p_viewport);
+	ERR_FAIL_NULL_V(viewport, Dictionary());
+	RD *rd = RD::get_singleton();
+	bool supported = rd && rd->real_gpu_completion_supported();
+	Dictionary result;
+	result["requested"] = viewport->real_gpu_observation_requested;
+	result["supported"] = supported;
+	result["valid"] = false;
+	result["eligible"] = viewport->real_gpu_observation_eligible;
+	result["reason"] = !viewport->real_gpu_observation_requested ? "not_requested" : (!supported ? "backend_unavailable" : "observer_busy");
+	result["clock"] = supported ? "mach_seconds" : "unavailable";
+	result["retention_seconds"] = RealGPUCompletion::RETENTION_SECONDS;
+	result["capacity"] = int64_t(RealGPUCompletion::CAPACITY);
+	result["samples"] = Array();
+	if (!viewport->real_gpu_observation_requested || !supported || p_viewport != real_gpu_observer_viewport || !real_gpu_observer) { return result; }
+	auto snapshot = real_gpu_observer->snapshot(rd->real_gpu_completion_now());
+	result["generation"] = int64_t(snapshot.generation);
+	result["now_seconds"] = snapshot.now_seconds;
+	result["observed_through_seconds"] = snapshot.observed_through_seconds;
+	result["coverage_start_seconds"] = snapshot.coverage_start_seconds;
+	result["pending"] = int64_t(snapshot.pending);
+	result["stale_callbacks"] = int64_t(snapshot.stale_callbacks);
+	result["failed"] = snapshot.failed;
+	result["overflow"] = snapshot.overflow;
+	result["invalid_clock"] = snapshot.invalid_clock;
+	result["valid"] = snapshot.enabled && !snapshot.failed && !snapshot.overflow && !snapshot.invalid_clock && viewport->real_gpu_observation_eligible;
+	result["reason"] = !viewport->real_gpu_observation_eligible && !snapshot.failed ? "awaiting_frame" : snapshot.reason;
+	Array records;
+	for (size_t i = 0; i < snapshot.count; ++i) {
+		Dictionary record;
+		record["generation"] = int64_t(snapshot.samples[i].generation);
+		record["frame"] = int64_t(snapshot.samples[i].frame);
+		record["gpu_end_seconds"] = snapshot.samples[i].gpu_end_seconds;
+		records.push_back(record);
+	}
+	result["samples"] = records;
+	return result;
+}
+
+Dictionary RendererViewport::viewport_get_metalfx_frame_capability(RID p_viewport) const {
+	ERR_FAIL_NULL_V(viewport_owner.get_or_null(p_viewport), Dictionary());
+	RD *rd = RD::get_singleton();
+	const int code = rd ? rd->metalfx_frame_device_capability() : 0;
+	Dictionary result;
+	result["compiled"] = code == 3 ? "no" : (code >= 1 && code <= 5 ? "yes" : "unknown");
+	result["os_available"] = code == 4 ? "no" : (code == 1 || code == 2 || code == 5 ? "yes" : "unknown");
+	result["device_support"] = code == 1 ? "supported" : (code == 2 ? "unsupported" : "unknown");
+	result["reason"] = code == 1 ? "supported" : (code == 2 ? "device_unsupported" : (code == 3 ? "sdk_unavailable" : (code == 4 ? "os_unavailable" : (code == 5 ? "device_unavailable" : "backend_unknown"))));
+	return result;
 }
 
