+bool openrc_same_image_contract(RID p_reference, RID p_candidate, Size2i p_size) {
+	RD *rd = RD::get_singleton();
+	if (p_reference.is_null() || p_candidate.is_null() || !rd->texture_is_valid(p_reference) || !rd->texture_is_valid(p_candidate) || rd->texture_is_shared(p_candidate)) { return false; }
+	RD::TextureFormat reference = rd->texture_get_format(p_reference);
+	RD::TextureFormat candidate = rd->texture_get_format(p_candidate);
+	return candidate.texture_type == RD::TEXTURE_TYPE_2D && candidate.array_layers == 1 && candidate.mipmaps == 1 &&
+			candidate.samples == RD::TEXTURE_SAMPLES_1 && candidate.width == uint32_t(p_size.x) && candidate.height == uint32_t(p_size.y) &&
+			candidate.format == reference.format && (candidate.usage_bits & RD::TEXTURE_USAGE_SAMPLING_BIT) != 0;
+}
