+void openrc_blit_completed(RDD *, RDD::CommandBufferID p_command, void *p_userdata) {
+	OpenRCBlitCallback *args = static_cast<OpenRCBlitCallback *>(p_userdata);
+	auto *command = reinterpret_cast<MTL3::MDCommandBuffer *>(p_command.id);
+	if (!args || !command) { memdelete(args); return; }
+	command->end();
+	MTL::CommandBuffer *metal = command->ensure_command_buffer();
+	if (!metal) { memdelete(args); return; }
+	metal->addCompletedHandler([args](MTL::CommandBuffer *p_completed) {
+		if (p_completed && p_completed->status() == MTL::CommandBufferStatusCompleted) {
+			OpenRCMetalPresent::submit(args->presenter, std::move(args->job));
+		}
+		memdelete(args);
+	});
+}
