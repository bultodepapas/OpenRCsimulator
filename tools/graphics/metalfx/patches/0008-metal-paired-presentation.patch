@@ -0,0 +1,67 @@
+#pragma once
+
+#include <atomic>
+#include <cstdint>
+#include <memory>
+#include <mutex>
+#include <utility>
+
+namespace OpenRCMetalPresent {
+
+struct CancelGate {
+	void request_cancel() {
+		cancelled.store(true, std::memory_order_release);
+	}
+	bool is_cancelled() const { return cancelled.load(std::memory_order_acquire); }
+	bool try_cancel_complete() const {
+		std::unique_lock<std::mutex> guard(presentation_gate, std::try_to_lock);
+		return guard.owns_lock();
+	}
+	std::unique_lock<std::mutex> lock_for_presentation() const { return std::unique_lock<std::mutex>(presentation_gate); }
+
+private:
+	mutable std::mutex presentation_gate;
+	std::atomic<bool> cancelled{ false };
+};
+
+struct SourceGeneration : CancelGate {};
+
+struct Proof : CancelGate {
+	const uint64_t previous_frame;
+	const uint64_t frame;
+	const uint64_t epoch;
+	const uint64_t serial;
+	std::atomic<unsigned> warm_count{ 0 };
+	// 0 means unobserved, 1 means the exact SDK encode returned, -1 means failed.
+	std::atomic<int> encode_result{ 0 };
+	// Exact SDK command-buffer completion, independently of conversion work.
+	std::atomic<int> sdk_completion{ 0 };
+	Proof(uint64_t p_previous_frame, uint64_t p_frame, uint64_t p_epoch, uint64_t p_serial) : previous_frame(p_previous_frame), frame(p_frame), epoch(p_epoch), serial(p_serial) {}
+};
+
+struct Lease {
+	std::atomic<bool> held{ false };
+};
+
+// The producer retains Lease, not Ticket. The last consumer reference therefore
+// releases a slot even when a blit is dropped before it reaches the compositor.
+struct Ticket {
+	static std::shared_ptr<Ticket> acquire(const std::shared_ptr<Lease> &p_lease) {
+		if (!p_lease) { return {}; }
+		bool expected = false;
+		if (!p_lease->held.compare_exchange_strong(expected, true, std::memory_order_acq_rel)) { return {}; }
+		return std::shared_ptr<Ticket>(new Ticket(p_lease));
+	}
+
+	Ticket(const Ticket &) = delete;
+	Ticket &operator=(const Ticket &) = delete;
+	~Ticket() {
+		lease->held.store(false, std::memory_order_release);
+	}
+
+private:
+	std::shared_ptr<Lease> lease;
+	explicit Ticket(std::shared_ptr<Lease> p_lease) : lease(std::move(p_lease)) {}
+};
+
+} // namespace OpenRCMetalPresent
