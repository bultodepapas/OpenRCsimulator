+bool RendererCompositorRD::_openrc_blit(DisplayServerEnums::WindowID p_screen, const RenderingServerTypes::BlitToScreen *p_render_targets, int p_amount) {
+	if (p_screen != DisplayServerEnums::MAIN_WINDOW_ID) { return false; }
+	RD *rd = RD::get_singleton();
+	if (!openrc_start_decided) {
+		openrc_start_decided = true;
+		if (!RenderingContextDriverMetal::openrc_presenter_requested() ||
+				OS::get_singleton()->get_current_rendering_driver_name() != "metal" || p_amount != 1 || !p_render_targets ||
+				DisplayServer::get_singleton()->get_window_list().size() != 1 || p_render_targets[0].multi_view.use_layer ||
+				p_render_targets[0].lens_distortion.apply || p_render_targets[0].src_rect != Rect2(0, 0, 1, 1)) { return false; }
+		bool resized = false;
+		if (rd->screen_prepare_for_external_drawing(p_screen, resized) != OK) { return false; }
