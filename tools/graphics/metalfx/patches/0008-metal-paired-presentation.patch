+#pragma once
+
+#include "openrc_mfx_present_state.h"
+
+namespace OpenRCMetalPresent {
+
+struct Presenter;
+using Handle = std::shared_ptr<Presenter>;
+
+struct Snapshot {
+	uint64_t generation = 0;
+	uint64_t real_accepted_jobs = 0;
+	uint64_t pair_accepted_candidates = 0;
+	uint64_t real_present_requested = 0;
+	uint64_t generated_present_requested = 0;
+	uint64_t real_command_scheduled = 0;
+	uint64_t generated_command_scheduled = 0;
+	uint64_t real_presented = 0;
+	uint64_t generated_presented = 0;
+	uint64_t retired_real_unresolved = 0;
+	uint64_t retired_generated_unresolved = 0;
+	uint64_t gpu_failed = 0;
+	uint64_t last_presented_frame = 0;
+	uint64_t blocked_source_epoch = 0;
+	uint64_t discontinuities = 0;
+	double last_os_presented_time = 0.0;
+	double last_callback_time = 0.0;
+};
+
+// p_layer and p_device are actual CAMetalLayer and MTLDevice objects. The
+// returned object owns its run loop and uses only the display-link drawable.
+Handle create(void *p_layer, void *p_device);
+void stop(const Handle &p_presenter);
+double native_time();
+uint64_t generation(const Handle &p_presenter);
+void retire_generation(const Handle &p_presenter);
+bool try_retire_complete(const Handle &p_presenter);
+bool submit(const Handle &p_presenter, Job p_job);
+Snapshot snapshot(const Handle &p_presenter);
+
+} // namespace OpenRCMetalPresent
diff --git a/drivers/metal/openrc_mfx_present_bridge.mm b/drivers/metal/openrc_mfx_present_bridge.mm
new file mode 100644
--- /dev/null
+++ b/drivers/metal/openrc_mfx_present_bridge.mm
@@ -0,0 +1,381 @@
+// Optional macOS display-link output. All source images are already converted
+// by Godot's screen blit and complete on the producer GPU queue before submit.
+#include "openrc_mfx_present_bridge.h"
+
+#import <Foundation/Foundation.h>
+#import <Metal/Metal.h>
+#import <QuartzCore/QuartzCore.h>
+#include <AvailabilityMacros.h>
+#include <chrono>
+#include <condition_variable>
+#include <mutex>
+#include <pthread.h>
+
+#if defined(__MAC_OS_X_VERSION_MAX_ALLOWED) && __MAC_OS_X_VERSION_MAX_ALLOWED >= 260000
+namespace OpenRCMetalPresent {
+struct Shared {
+	// Gate serializes stop/retire against the commit-and-present critical section.
+	// GPU and OS callbacks never acquire it and may therefore run inline safely.
+	std::mutex gate;
+	std::mutex mutex;
+	std::condition_variable started_condition;
+	Scheduler scheduler;
+	std::atomic<uint64_t> requested_generation{ 1 };
+	Snapshot stats;
+	bool stopping = false;
+	bool started = false;
+	bool valid = false;
+	unsigned in_flight = 0;
+	double previous_display_target = 0.0;
+	double display_period = 0.0;
+	CFRunLoopRef run_loop = nullptr;
+	__strong CAMetalLayer *layer = nil;
+	__strong id<MTLDevice> device = nil;
+	__strong id<MTLCommandQueue> queue = nil;
+	__strong id<MTLRenderPipelineState> pipeline_sdr = nil;
+	__strong id<MTLRenderPipelineState> pipeline_hdr = nil;
+};
+
+struct Presenter {
+	std::shared_ptr<Shared> state;
+	pthread_t worker{};
+	bool worker_started = false;
+};
+
+static void retire_stats(Shared &p_state) {
+	uint64_t real = p_state.stats.retired_real_unresolved;
+	uint64_t generated = p_state.stats.retired_generated_unresolved;
+	if (p_state.stats.real_present_requested > p_state.stats.real_presented) { real += p_state.stats.real_present_requested - p_state.stats.real_presented; }
+	if (p_state.stats.generated_present_requested > p_state.stats.generated_presented) { generated += p_state.stats.generated_present_requested - p_state.stats.generated_presented; }
+	uint64_t failures = p_state.stats.gpu_failed;
+	p_state.stats = {};
+	p_state.stats.retired_real_unresolved = real;
+	p_state.stats.retired_generated_unresolved = generated;
+	p_state.stats.gpu_failed = failures;
+}
+
+static void synchronize_generation(Shared &p_state) {
+	uint64_t requested = p_state.requested_generation.load(std::memory_order_acquire);
+	if (!requested) { return; }
+	if (requested != p_state.scheduler.current_generation()) {
+		p_state.scheduler.reset_to(requested);
+		retire_stats(p_state);
+		p_state.previous_display_target = 0.0;
+		p_state.display_period = 0.0;
+	}
+}
+} // namespace OpenRCMetalPresent
+
+API_AVAILABLE(macos(26.0))
+@interface OpenRCMetalDisplayDelegate : NSObject <CAMetalDisplayLinkDelegate> {
+@public
+	std::shared_ptr<OpenRCMetalPresent::Shared> state;
+}
+@end
+
+@implementation OpenRCMetalDisplayDelegate
+- (void)metalDisplayLink:(CAMetalDisplayLink *)p_link needsUpdate:(CAMetalDisplayLinkUpdate *)p_update {
+	(void)p_link;
+	@autoreleasepool {
+		auto s = state;
+		if (!s || !p_update || !p_update.drawable) { return; }
+		std::unique_lock<std::mutex> gate(s->gate);
+		std::unique_lock<std::mutex> lock(s->mutex);
+		if (s->stopping) { return; }
+		OpenRCMetalPresent::synchronize_generation(*s);
+		if (!s->requested_generation.load(std::memory_order_acquire)) { return; }
+		double target = p_update.targetPresentationTimestamp;
+		if (std::isfinite(target) && target > s->previous_display_target) {
+			double interval = target - s->previous_display_target;
+			s->display_period = s->previous_display_target > 0.0 && interval >= 0.001 && interval <= 0.1 ? interval : 0.0;
+			s->previous_display_target = target;
+		} else {
+			s->display_period = 0.0;
+		}
+		if (s->in_flight != 0) { return; }
+		double now = CACurrentMediaTime();
+		OpenRCMetalPresent::Choice choice = s->scheduler.choose(now, p_update.targetTimestamp, target, s->display_period, true);
+		if (choice.kind == OpenRCMetalPresent::Kind::NONE || !choice.texture) { return; }
+		std::unique_lock<std::mutex> source_gate;
+		if (choice.source_generation) {
+			source_gate = choice.source_generation->lock_for_presentation();
+			if (choice.source_generation->is_cancelled()) { return; }
+		}
+		std::unique_lock<std::mutex> proof_gate;
+		if (choice.proof) {
+			proof_gate = choice.proof->lock_for_presentation();
+			if (choice.proof->is_cancelled()) { return; }
+		}
+		id<MTLTexture> src = (__bridge id<MTLTexture>)choice.texture;
+		id<CAMetalDrawable> drawable = p_update.drawable;
+		id<MTLTexture> dst = drawable.texture;
+		if (!src || !dst || src.device != s->device || dst.device != s->device ||
+				src.width != dst.width || src.height != dst.height ||
+				src.pixelFormat != dst.pixelFormat ||
+				(src.usage & MTLTextureUsageShaderRead) == 0) { return; }
+		id<MTLRenderPipelineState> pipeline = dst.pixelFormat == MTLPixelFormatBGRA8Unorm ? s->pipeline_sdr :
+				(dst.pixelFormat == MTLPixelFormatRGBA16Float ? s->pipeline_hdr : nil);
+		if (!pipeline) { return; }
+		id<MTLCommandBuffer> command = [s->queue commandBuffer];
+		if (!command) { return; }
+		MTLRenderPassDescriptor *pass = [MTLRenderPassDescriptor renderPassDescriptor];
+		pass.colorAttachments[0].texture = dst;
+		pass.colorAttachments[0].loadAction = MTLLoadActionDontCare;
+		pass.colorAttachments[0].storeAction = MTLStoreActionStore;
+		id<MTLRenderCommandEncoder> encoder = [command renderCommandEncoderWithDescriptor:pass];
+		if (!encoder) { return; }
+		[encoder setRenderPipelineState:pipeline];
+		[encoder setFragmentTexture:src atIndex:0];
+		[encoder drawPrimitives:MTLPrimitiveTypeTriangle vertexStart:0 vertexCount:3];
+		[encoder endEncoding];
+		// The display-link contract requires a committed command before the
+		// drawable's direct present, both before this update's deadline.
+		if (CACurrentMediaTime() >= p_update.targetTimestamp) { return; }
+		if (choice.proof && choice.proof->is_cancelled()) { return; }
+		if (choice.source_generation && choice.source_generation->is_cancelled()) { return; }
+		if (choice.generation != s->requested_generation.load(std::memory_order_acquire)) { return; }
+		if (!s->scheduler.commit(choice)) { return; }
+		const uint64_t sample_generation = choice.generation;
+		const uint64_t sample_frame = choice.frame;
+		const bool is_generated = choice.kind == OpenRCMetalPresent::Kind::GENERATED;
+		std::weak_ptr<OpenRCMetalPresent::Shared> weak = s;
+		auto completion_choice = choice;
+		[drawable addPresentedHandler:^(id<MTLDrawable> p_drawable) {
+			auto shared = weak.lock();
+			if (!shared) { return; }
+			double presented = p_drawable.presentedTime;
+			double observed = CACurrentMediaTime();
+			std::lock_guard<std::mutex> guard(shared->mutex);
+			if (sample_generation != shared->requested_generation.load(std::memory_order_acquire) || !std::isfinite(presented) || presented <= 0.0) { return; }
+			if (is_generated) { shared->stats.generated_presented++; } else { shared->stats.real_presented++; }
+			if (presented > shared->stats.last_os_presented_time) {
+				shared->stats.last_presented_frame = sample_frame;
+				shared->stats.last_os_presented_time = presented;
+				shared->stats.last_callback_time = observed;
+			}
+		}];
+		[command addScheduledHandler:^(id<MTLCommandBuffer> p_command) {
+			(void)p_command;
+			auto shared = weak.lock();
+			if (!shared) { return; }
+			std::lock_guard<std::mutex> guard(shared->mutex);
+			if (sample_generation != shared->requested_generation.load(std::memory_order_acquire)) { return; }
+			if (is_generated) { shared->stats.generated_command_scheduled++; } else { shared->stats.real_command_scheduled++; }
+		}];
+		[command addCompletedHandler:^(id<MTLCommandBuffer> p_command) {
+			// Captures the converted slot through this GPU read and can requeue
+			// the exact current-real fallback if this present command fails.
+			auto shared = weak.lock();
+			if (!shared) { return; }
+			std::lock_guard<std::mutex> guard(shared->mutex);
+			if (shared->in_flight > 0) { shared->in_flight--; }
+			if (sample_generation == shared->scheduler.current_generation() && p_command.status != MTLCommandBufferStatusCompleted) {
+				uint64_t expected = sample_generation;
+				uint64_t replacement = expected == UINT64_MAX ? 0 : expected + 1;
+				if (shared->requested_generation.compare_exchange_strong(expected, replacement, std::memory_order_acq_rel)) {
+					OpenRCMetalPresent::retire_stats(*shared);
+					shared->stats.gpu_failed++;
+					if (replacement) { shared->scheduler.recover_failed(completion_choice); }
+					else { shared->scheduler.reset(); }
+				} else {
+					OpenRCMetalPresent::synchronize_generation(*shared);
+				}
+			}
+		}];
+		s->in_flight++;
+		if (is_generated) { s->stats.generated_present_requested++; } else { s->stats.real_present_requested++; }
+		lock.unlock();
+		[command commit];
+		[drawable present];
+	}
+}
+@end
+
+namespace OpenRCMetalPresent {
+static id<MTLRenderPipelineState> make_pipeline(id<MTLDevice> p_device, MTLPixelFormat p_format) {
+	NSString *source = @"#include <metal_stdlib>\n"
+			"using namespace metal;\n"
+			"vertex float4 orc_vertex(uint i [[vertex_id]]) {\n"
+			"  const float2 p[3] = {float2(-1,-1),float2(3,-1),float2(-1,3)};\n"
+			"  return float4(p[i],0,1);\n"
+			"}\n"
+			"fragment float4 orc_fragment(float4 pos [[position]], texture2d<float,access::read> img [[texture(0)]]) {\n"
+			"  return img.read(uint2(pos.xy));\n"
+			"}\n";
+	NSError *error = nil;
+	id<MTLLibrary> library = [p_device newLibraryWithSource:source options:nil error:&error];
+	if (!library) { return nil; }
+	id<MTLFunction> vertex = [library newFunctionWithName:@"orc_vertex"];
+	id<MTLFunction> fragment = [library newFunctionWithName:@"orc_fragment"];
+	if (!vertex || !fragment) { return nil; }
+	MTLRenderPipelineDescriptor *descriptor = [[MTLRenderPipelineDescriptor alloc] init];
+	descriptor.vertexFunction = vertex;
+	descriptor.fragmentFunction = fragment;
+	descriptor.colorAttachments[0].pixelFormat = p_format;
+	return [p_device newRenderPipelineStateWithDescriptor:descriptor error:&error];
+}
+
+API_AVAILABLE(macos(26.0))
+static void *present_worker(void *p_userdata) {
+	auto *holder = static_cast<std::shared_ptr<Shared> *>(p_userdata);
+	auto shared = std::move(*holder);
+	delete holder;
+	@autoreleasepool {
+		OpenRCMetalDisplayDelegate *delegate = [[OpenRCMetalDisplayDelegate alloc] init];
+		delegate->state = shared;
+		CAMetalDisplayLink *link = [[CAMetalDisplayLink alloc] initWithMetalLayer:shared->layer];
+		CFRunLoopRef loop = CFRunLoopGetCurrent();
+		if (link && loop) {
+			link.delegate = delegate;
+			[link addToRunLoop:[NSRunLoop currentRunLoop] forMode:NSDefaultRunLoopMode];
+		}
+		{
+			std::lock_guard<std::mutex> guard(shared->mutex);
+			shared->run_loop = loop;
+			if (loop) { CFRetain(loop); }
+			shared->valid = link != nil && loop != nullptr;
+			shared->started = true;
+			shared->started_condition.notify_all();
+		}
+		for (;;) {
+			{
+				std::lock_guard<std::mutex> guard(shared->mutex);
+				if (shared->stopping || !shared->valid) { break; }
+			}
+			@autoreleasepool { CFRunLoopRunInMode(kCFRunLoopDefaultMode, 0.25, true); }
+		}
+		[link invalidate];
+		std::lock_guard<std::mutex> guard(shared->mutex);
+		if (shared->run_loop) { CFRelease(shared->run_loop); shared->run_loop = nullptr; }
+	}
+	return nullptr;
+}
+
+API_AVAILABLE(macos(26.0))
+static bool start_worker(Presenter *p_presenter) {
+	if (!p_presenter || !p_presenter->state || p_presenter->worker_started) { return false; }
+	auto *holder = new std::shared_ptr<Shared>(p_presenter->state);
+	if (pthread_create(&p_presenter->worker, nullptr, present_worker, holder) != 0) {
+		delete holder;
+		return false;
+	}
+	p_presenter->worker_started = true;
+	return true;
+}
+
+static void stop_impl(Presenter *p_presenter) {
+	if (!p_presenter || !p_presenter->state) { return; }
+	auto shared = p_presenter->state;
+	CFRunLoopRef loop = nullptr;
+	{
+		std::lock_guard<std::mutex> gate(shared->gate);
+		std::lock_guard<std::mutex> guard(shared->mutex);
+		shared->stopping = true;
+		shared->scheduler.reset();
+		shared->requested_generation.store(shared->scheduler.current_generation(), std::memory_order_release);
+		loop = shared->run_loop;
+		if (loop) { CFRetain(loop); }
+	}
+	if (loop) { CFRunLoopStop(loop); CFRunLoopWakeUp(loop); CFRelease(loop); }
+	if (p_presenter->worker_started) {
+		pthread_join(p_presenter->worker, nullptr);
+		p_presenter->worker_started = false;
+	}
+}
+
+Handle create(void *p_layer, void *p_device) {
+	@autoreleasepool {
+		if (@available(macOS 26.0, *)) {
+			CAMetalLayer *layer = (__bridge CAMetalLayer *)p_layer;
+			id<MTLDevice> device = (__bridge id<MTLDevice>)p_device;
+			if (!layer || !device || layer.device != device || layer.pixelFormat != MTLPixelFormatBGRA8Unorm) { return {}; }
+			auto shared = std::make_shared<Shared>();
+			shared->layer = layer;
+			shared->device = device;
+			shared->queue = [device newCommandQueueWithMaxCommandBufferCount:2];
+			shared->pipeline_sdr = make_pipeline(device, MTLPixelFormatBGRA8Unorm);
+			shared->pipeline_hdr = make_pipeline(device, MTLPixelFormatRGBA16Float);
+			if (!shared->queue || !shared->pipeline_sdr || !shared->pipeline_hdr) { return {}; }
+			Handle presenter(new Presenter(), [](Presenter *p_value) {
+				if (p_value) {
+					stop_impl(p_value);
+					delete p_value;
+				}
+			});
+			presenter->state = shared;
+			if (!start_worker(presenter.get())) { return {}; }
+			std::unique_lock<std::mutex> lock(shared->mutex);
+			bool started = shared->started_condition.wait_for(lock, std::chrono::seconds(2), [&]() { return shared->started; });
+			bool valid = started && shared->valid;
+			lock.unlock();
+			if (!valid) { stop(presenter); return {}; }
+			return presenter;
+		}
+	}
+	return {};
+}
+
+void stop(const Handle &p_presenter) {
+	stop_impl(p_presenter.get());
+}
+
+double native_time() { return CACurrentMediaTime(); }
+
+uint64_t generation(const Handle &p_presenter) {
+	if (!p_presenter) { return 0; }
+	return p_presenter->state->requested_generation.load(std::memory_order_acquire);
+}
+
+void retire_generation(const Handle &p_presenter) {
+	if (!p_presenter) { return; }
+	auto &requested = p_presenter->state->requested_generation;
+	uint64_t prior = requested.load(std::memory_order_acquire);
+	while (prior) {
+		uint64_t next = prior == UINT64_MAX ? 0 : prior + 1;
+		if (requested.compare_exchange_weak(prior, next, std::memory_order_acq_rel)) { return; }
+	}
+}
+
+bool try_retire_complete(const Handle &p_presenter) {
+	if (!p_presenter) { return true; }
+	std::unique_lock<std::mutex> guard(p_presenter->state->gate, std::try_to_lock);
+	return guard.owns_lock();
+}
+
+bool submit(const Handle &p_presenter, Job p_job) {
+	if (!p_presenter) { return false; }
+	auto shared = p_presenter->state;
+	std::lock_guard<std::mutex> guard(shared->mutex);
+	if (shared->stopping || !shared->requested_generation.load(std::memory_order_acquire)) { return false; }
+	synchronize_generation(*shared);
+	bool paired = p_job.generated && p_job.paired_real;
+	if (!shared->scheduler.submit(std::move(p_job))) { return false; }
+	shared->stats.real_accepted_jobs++;
+	if (paired) { shared->stats.pair_accepted_candidates++; }
+	return true;
+}
+
+Snapshot snapshot(const Handle &p_presenter) {
+	if (!p_presenter) { return {}; }
+	std::lock_guard<std::mutex> guard(p_presenter->state->mutex);
+	synchronize_generation(*p_presenter->state);
+	Snapshot result = p_presenter->state->stats;
+	result.generation = p_presenter->state->requested_generation.load(std::memory_order_acquire);
+	result.blocked_source_epoch = p_presenter->state->scheduler.blocked_source_epoch();
+	result.discontinuities = p_presenter->state->scheduler.discontinuity_count();
+	return result;
+}
+} // namespace OpenRCMetalPresent
+#else
+namespace OpenRCMetalPresent {
+struct Presenter {};
+Handle create(void *, void *) { return {}; }
+void stop(const Handle &) {}
+double native_time() { return 0.0; }
+uint64_t generation(const Handle &) { return 0; }
+void retire_generation(const Handle &) {}
+bool try_retire_complete(const Handle &) { return true; }
+bool submit(const Handle &, Job) { return false; }
+Snapshot snapshot(const Handle &) { return {}; }
+}
+#endif
diff --git a/drivers/metal/openrc_mfx_present_state.h b/drivers/metal/openrc_mfx_present_state.h
new file mode 100644
--- /dev/null
+++ b/drivers/metal/openrc_mfx_present_state.h
@@ -0,0 +1,216 @@
+#pragma once
+
+// CPU-only scheduling and observation state for the opt-in display-link path.
+// It is deliberately independent of Objective-C and Godot ownership so callback
+// races can be tested without a display or GPU. The caller serializes Scheduler.
+#include "servers/rendering/storage/metalfx_presentation.h"
+#include <cmath>
+#include <cstdint>
+#include <memory>
+
+namespace OpenRCMetalPresent {
+
+struct Job {
+	uint64_t generation = 0;
+	uint64_t frame = 0;
+	uint64_t epoch = 0;
+	uint64_t serial = 0;
+	double reserved_at = 0.0;
+	double generated_deadline = 0.0;
+	double real_deadline = 0.0;
+	double real_interval = 0.0;
+	void *fallback = nullptr;
+	void *generated = nullptr;
+	void *paired_real = nullptr;
+	std::shared_ptr<Proof> proof;
+	std::shared_ptr<SourceGeneration> source_generation;
+	std::shared_ptr<void> output_lease;
+	bool generated_scheduled = false;
+};
+
+enum class Kind { NONE, GENERATED, REAL };
+
+struct Choice {
+	Kind kind = Kind::NONE;
+	uint64_t generation = 0;
+	uint64_t frame = 0;
+	void *texture = nullptr;
+	double target_time = 0.0;
+	std::shared_ptr<void> output_lease;
+	uint64_t abandoned_epoch = 0;
+	void *fallback_texture = nullptr;
+	std::shared_ptr<Proof> proof;
+	std::shared_ptr<SourceGeneration> source_generation;
+};
+
+// Fixed-capacity latest-complete scheduler. A successfully scheduled generated
+// image reserves its matching real image until the next eligible callback.
+class Scheduler {
+	static constexpr unsigned CAPACITY = 4;
+	Job slots[CAPACITY];
+	bool occupied[CAPACITY] = {};
+	uint64_t generation = 1;
+	uint64_t last_real_scheduled = 0;
+	uint64_t last_generated_scheduled = 0;
+	double last_real_target = 0.0;
+	double last_generated_target = 0.0;
+	uint64_t blocked_epoch = 0;
+	uint64_t last_pair_epoch = 0;
+	uint64_t discontinuities = 0;
+	int reserved = -1;
+
+	void erase(unsigned p_index) {
+		if (reserved == int(p_index)) {
+			reserved = -1;
+		}
+		occupied[p_index] = false;
+		slots[p_index] = Job();
+	}
+
+public:
+	uint64_t current_generation() const { return generation; }
+	uint64_t last_real() const { return last_real_scheduled; }
+	uint64_t blocked_source_epoch() const { return blocked_epoch; }
+	uint64_t discontinuity_count() const { return discontinuities; }
+
+	void reset_to(uint64_t p_generation) {
+		if (!p_generation || p_generation == generation) { return; }
+		const uint64_t retired_epoch = last_pair_epoch ? last_pair_epoch : blocked_epoch;
+		for (unsigned i = 0; i < CAPACITY; ++i) {
+			erase(i);
+		}
+		generation = p_generation;
+		last_real_scheduled = 0;
+		last_generated_scheduled = 0;
+		last_real_target = 0.0;
+		last_generated_target = 0.0;
+		blocked_epoch = retired_epoch;
+		last_pair_epoch = 0;
+		if (retired_epoch) { discontinuities++; }
+	}
+
+	void reset() {
+		uint64_t next = generation + 1;
+		reset_to(next ? next : 1);
+	}
+
+	bool submit(Job p_job) {
+		if (p_job.generation != generation || p_job.frame == 0 || p_job.frame <= last_real_scheduled || !p_job.fallback || !p_job.output_lease ||
+				(p_job.proof && p_job.proof->is_cancelled()) || (p_job.source_generation && p_job.source_generation->is_cancelled())) {
+			return false;
+		}
+		if (p_job.generated_scheduled) { return false; }
+		for (unsigned i = 0; i < CAPACITY; ++i) {
+			if (occupied[i] && slots[i].frame == p_job.frame) { return false; }
+		}
+		int free_index = -1;
+		for (unsigned i = 0; i < CAPACITY; ++i) {
+			if (!occupied[i]) { free_index = int(i); break; }
+		}
+		if (free_index < 0) {
+			// Do not displace an image after scheduling its generated partner.
+			int oldest = -1;
+			for (unsigned i = 0; i < CAPACITY; ++i) {
+				if (int(i) != reserved && (oldest < 0 || slots[i].frame < slots[oldest].frame)) { oldest = int(i); }
+			}
+			if (oldest < 0 || slots[oldest].frame >= p_job.frame) { return false; }
+			erase(unsigned(oldest));
+			free_index = oldest;
+		}
+		if (p_job.proof && p_job.epoch) { last_pair_epoch = p_job.epoch; }
+		slots[free_index] = std::move(p_job);
+		occupied[free_index] = true;
+		return true;
+	}
+
+	Choice choose(double p_now, double p_deadline, double p_target, double p_display_period, bool p_drawable) const {
+		if (!p_drawable || !std::isfinite(p_now) || !std::isfinite(p_deadline) || !std::isfinite(p_target) ||
+				p_now >= p_deadline || p_target <= p_now || p_target <= last_real_target || p_target <= last_generated_target) { return {}; }
+		int newest = -1;
+		for (unsigned i = 0; i < CAPACITY; ++i) {
+			if (occupied[i] && (!slots[i].proof || !slots[i].proof->is_cancelled()) &&
+					(!slots[i].source_generation || !slots[i].source_generation->is_cancelled()) &&
+					slots[i].frame > last_real_scheduled && (newest < 0 || slots[i].frame > slots[newest].frame)) { newest = int(i); }
+		}
+		if (newest < 0) { return {}; }
+		if (reserved >= 0 && occupied[reserved] && (!slots[reserved].proof || !slots[reserved].proof->is_cancelled()) &&
+				(!slots[reserved].source_generation || !slots[reserved].source_generation->is_cancelled())) {
+			const Job &old_real = slots[reserved];
+			// A stopped display link cannot reserve an old real indefinitely.
+			// Prefer the newest current-real fallback once the endpoint expires.
+			bool abandoned = p_target > old_real.real_deadline && newest != reserved;
+			const Job &real = abandoned ? slots[newest] : old_real;
+			return { Kind::REAL, generation, real.frame, real.generated_scheduled ? real.paired_real : real.fallback, p_target, real.output_lease,
+					abandoned ? old_real.epoch : 0, real.fallback, real.proof, real.source_generation };
+		}
+		const Job &job = slots[newest];
+		bool match = job.proof && job.epoch != blocked_epoch && job.proof->previous_frame == last_real_scheduled && job.proof->frame == job.frame && job.proof->epoch == job.epoch && job.proof->serial == job.serial &&
+				!job.proof->is_cancelled() && job.proof->encode_result.load(std::memory_order_acquire) == 1 && job.proof->sdk_completion.load(std::memory_order_acquire) == 1 &&
+				job.proof->warm_count.load(std::memory_order_acquire) >= 5;
+		bool cadence = last_real_target > 0 && std::isfinite(p_display_period) && p_display_period >= 0.001 && p_display_period <= 0.1 &&
+				std::isfinite(job.real_interval) && job.real_interval >= 0.01 && job.real_interval <= 0.2 &&
+				p_display_period * 2.0 <= job.real_interval * 1.05 &&
+				p_target >= last_real_target + p_display_period * 0.75 && p_target <= last_real_target + p_display_period * 1.25 &&
+				p_target + p_display_period <= last_real_target + job.real_interval * 1.1;
+		bool bounded = std::isfinite(job.reserved_at) && job.reserved_at > 0.0 && std::isfinite(job.generated_deadline) &&
+				std::isfinite(job.real_deadline) && job.generated_deadline > job.reserved_at &&
+				job.real_deadline > job.generated_deadline && job.real_deadline - job.reserved_at <= 0.2 &&
+				p_target <= job.generated_deadline && p_target + p_display_period <= job.real_deadline;
+		if (!job.generated_scheduled && job.frame > last_generated_scheduled && job.generated && job.paired_real && match && cadence && bounded) {
+			return { Kind::GENERATED, generation, job.frame, job.generated, p_target, job.output_lease, 0, job.fallback, job.proof, job.source_generation };
+		}
+		return { Kind::REAL, generation, job.frame, job.generated_scheduled ? job.paired_real : job.fallback, p_target, job.output_lease, 0, job.fallback, job.proof, job.source_generation };
+	}
+
+	// On a presenter GPU failure, do not let a merely requested real frame be
+	// the left endpoint for later generated frames. Requeue its real fallback
+	// into a new generation; an old completion cannot reset a newer generation.
+	bool recover_failed(const Choice &p_choice) {
+		if (p_choice.generation != generation || !p_choice.fallback_texture || !p_choice.output_lease) { return false; }
+		reset();
+		Job fallback;
+		fallback.generation = generation;
+		fallback.frame = p_choice.frame;
+		fallback.fallback = p_choice.fallback_texture;
+		fallback.output_lease = p_choice.output_lease;
+		fallback.proof = p_choice.proof;
+		fallback.source_generation = p_choice.source_generation;
+		fallback.epoch = p_choice.proof ? p_choice.proof->epoch : 0;
+		return submit(std::move(fallback));
+	}
+
+	bool commit(const Choice &p_choice) {
+		if (p_choice.kind == Kind::NONE || p_choice.generation != generation || !p_choice.texture || !std::isfinite(p_choice.target_time) ||
+				p_choice.target_time <= last_real_target || p_choice.target_time <= last_generated_target) { return false; }
+		int index = -1;
+		for (unsigned i = 0; i < CAPACITY; ++i) {
+			if (occupied[i] && slots[i].frame == p_choice.frame) { index = int(i); break; }
+		}
+		if (index < 0 || p_choice.frame <= last_real_scheduled) { return false; }
+		Job &job = slots[index];
+		if (job.proof != p_choice.proof || job.source_generation != p_choice.source_generation || (job.proof && job.proof->is_cancelled()) ||
+				(job.source_generation && job.source_generation->is_cancelled())) { return false; }
+		if (p_choice.kind == Kind::GENERATED) {
+			if (job.generated_scheduled || job.generated != p_choice.texture || job.frame <= last_generated_scheduled) { return false; }
+			if (reserved >= 0 && reserved != index) { erase(unsigned(reserved)); }
+			job.generated_scheduled = true;
+			last_generated_scheduled = job.frame;
+			last_generated_target = p_choice.target_time;
+			reserved = index;
+			return true;
+		}
+		if ((job.generated_scheduled ? job.paired_real : job.fallback) != p_choice.texture) { return false; }
+		last_real_scheduled = job.frame;
+		last_real_target = p_choice.target_time;
+		if (p_choice.abandoned_epoch) {
+			blocked_epoch = p_choice.abandoned_epoch;
+			discontinuities++;
+		}
+		for (unsigned i = 0; i < CAPACITY; ++i) {
+			if (occupied[i] && slots[i].frame <= last_real_scheduled) { erase(i); }
+		}
+		return true;
+	}
+};
+
