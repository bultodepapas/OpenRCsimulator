+void RendererCompositorRD::_openrc_free_slot(OpenRCOutputSlot &r_slot) {
+	RD *rd = RD::get_singleton();
+	for (int i = 0; i < 3; ++i) {
+		if (r_slot.framebuffers[i].is_valid()) { rd->free_rid(r_slot.framebuffers[i]); }
+		if (r_slot.textures[i].is_valid()) { rd->free_rid(r_slot.textures[i]); }
+	}
+	r_slot = OpenRCOutputSlot();
+}
+
+void RendererCompositorRD::_openrc_collect_slots(bool p_all) {
+	for (int i = openrc_retired_slots.size() - 1; i >= 0; --i) {
+		OpenRCOutputSlot &slot = openrc_retired_slots.write[i];
+		if (p_all || !slot.lease || !slot.lease->held.load(std::memory_order_acquire)) {
+			_openrc_free_slot(slot);
+			openrc_retired_slots.remove_at(i);
+		}
+	}
+}
+
+bool RendererCompositorRD::_openrc_allocate_slots(Size2i p_size, RD::DataFormat p_format) {
+	if (p_size.x <= 0 || p_size.y <= 0) { return false; }
+	RD *rd = RD::get_singleton();
+	RD::TextureFormat format;
+	format.format = p_format;
+	format.width = p_size.x;
+	format.height = p_size.y;
+	format.usage_bits = RD::TEXTURE_USAGE_SAMPLING_BIT | RD::TEXTURE_USAGE_COLOR_ATTACHMENT_BIT;
+	auto *context = static_cast<RenderingContextDriverMetal *>(rd->get_context_driver());
+	MTL::Device *device = context->get_metal_device();
+	if (!device) { return false; }
+	MTL::PixelFormat pixel = p_format == RD::DATA_FORMAT_B8G8R8A8_UNORM ? MTL::PixelFormatBGRA8Unorm : MTL::PixelFormatRGBA16Float;
+	for (OpenRCOutputSlot &slot : openrc_slots) {
+		slot.size = p_size;
+		slot.format = p_format;
+		slot.lease = std::make_shared<OpenRCMetalPresent::Lease>();
+		for (int i = 0; i < 3; ++i) {
+			// Committed, device-owned textures have no Godot heap suballocation.
+			// Their native retain remains sufficient if the present queue outlives
+			// RD's imported wrapper during a bounded stop or resize.
+			NS::SharedPtr<MTL::TextureDescriptor> descriptor = NS::TransferPtr(MTL::TextureDescriptor::alloc()->init());
+			if (!descriptor) { goto failed; }
+			descriptor->setTextureType(MTL::TextureType2D);
+			descriptor->setPixelFormat(pixel);
+			descriptor->setWidth(p_size.x);
+			descriptor->setHeight(p_size.y);
+			descriptor->setResourceOptions(MTL::ResourceStorageModePrivate | MTL::ResourceHazardTrackingModeTracked);
+			descriptor->setUsage(MTL::TextureUsageRenderTarget | MTL::TextureUsageShaderRead);
+			NS::SharedPtr<MTL::Texture> native = NS::TransferPtr(device->newTexture(descriptor.get()));
+			if (!native) { goto failed; }
+			slot.textures[i] = rd->texture_create_from_extension(RD::TEXTURE_TYPE_2D, p_format, RD::TEXTURE_SAMPLES_1,
+					format.usage_bits, uint64_t(uintptr_t(native.get())), p_size.x, p_size.y, 1, 1, 1);
+			if (slot.textures[i].is_null()) { goto failed; }
+			Vector<RID> attachments;
+			attachments.push_back(slot.textures[i]);
+			slot.framebuffers[i] = rd->framebuffer_create(attachments);
+			if (slot.framebuffers[i].is_null()) { goto failed; }
+		}
+	}
+	return true;
+failed:
+	for (OpenRCOutputSlot &slot : openrc_slots) { _openrc_free_slot(slot); }
+	return false;
+}
