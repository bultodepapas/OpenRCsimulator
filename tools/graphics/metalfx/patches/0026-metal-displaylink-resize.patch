 	void openrc_presenter_stop() override {
+		const bool had_presenter = bool(openrc_presenter);
 		OpenRCMetalPresent::stop(openrc_presenter);
 		openrc_presenter.reset();
+		// Once the display link has stopped, the ordinary swap chain must
