+			// Preserve the pre-link ring; no ordinary drawable is acquired here.
+			p_desired_framebuffer_count = frame_buffers.size();
+			ERR_FAIL_COND_V_MSG(p_desired_framebuffer_count == 0, ERR_CANT_CREATE, "Display-link surface has no initialized framebuffer ring.");
+		} else
+#endif
