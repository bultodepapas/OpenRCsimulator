+Dictionary RenderSceneBuffersRD::get_metalfx_frame_composition_status() const {
+	Dictionary status = RenderSceneBuffers::get_metalfx_frame_composition_status();
+	status["scope"] = "offscreen_composed_pair_not_presentation";
+	status["color_convention"] = "experimental_unverified";
+#if defined(METAL_ENABLED) && defined(MACOS_ENABLED)
+	status["latest_submission"] = mfx_composition_reason;
+	int index = _metalfx_composition_ready_slot();
+	status["ready"] = index >= 0;
+	status["reason"] = index >= 0 ? "ready" : mfx_composition_reason;
+	status["frame_age_scope"] = "global_frame_delta_at_last_viewport_draw_not_current";
+	if (index >= 0) {
+		status["source_frame"] = int64_t(mfx_composition_slots[index].state->frame);
+		status["previous_frame"] = int64_t(mfx_composition_slots[index].state->previous_frame);
+		status["epoch"] = int64_t(mfx_composition_slots[index].state->epoch);
+		status["serial"] = int64_t(mfx_composition_slots[index].state->serial);
+		status["source_age_at_last_viewport_draw_frames"] = int64_t(mfx_composition_current_frame - mfx_composition_slots[index].state->frame);
+	}
+#endif
+	return status;
+}
