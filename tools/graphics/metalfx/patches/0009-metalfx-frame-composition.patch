+Dictionary RenderSceneBuffersRD::read_metalfx_frame_composition() {
+	Dictionary result = get_metalfx_frame_composition_status();
+	result["readback"] = "not_ready";
+#if defined(METAL_ENABLED) && defined(MACOS_ENABLED)
+	int index = _metalfx_composition_ready_slot();
+	if (index >= 0) {
+		RendererRD::TextureStorage *storage = RendererRD::TextureStorage::get_singleton();
+		bool hdr = storage->render_target_is_using_hdr(render_target);
+		Image::Format format = hdr ? Image::FORMAT_RGBAH : Image::FORMAT_RGBA8;
+		int bytes_per_pixel = hdr ? 8 : 4;
+		Vector<uint8_t> generated = RD::get_singleton()->texture_get_data(storage->render_target_get_rd_texture(mfx_composition_slots[index].generated_target), 0);
+		Vector<uint8_t> real = RD::get_singleton()->texture_get_data(storage->render_target_get_rd_texture(mfx_composition_slots[index].real_target), 0);
+		if (generated.size() == int64_t(target_size.x) * target_size.y * bytes_per_pixel && real.size() == generated.size()) {
+			result["generated_image"] = Image::create_from_data(target_size.x, target_size.y, false, format, generated);
+			result["real_image"] = Image::create_from_data(target_size.x, target_size.y, false, format, real);
+			result["readback"] = "returned";
+		} else {
+			result["readback"] = "failed";
+		}
+	}
+#endif
+	return result;
 }
 
