+// One SDK encode and one later, whole-pair completion. No callback retains a
+// viewport or render buffer; retirement only leaves this value state alive.
+struct MetalFXCompositionFrame {
+	uint64_t frame = 0;
+	uint64_t previous_frame = 0; // Actual previous SDK input, not last presented frame.
+	uint64_t epoch = 0;
+	uint64_t serial = 0;
+	std::atomic<uint32_t> warm_count{ 0 };
+	std::atomic<int> encode_result{ 0 }; // 0 pending, 1 success, -1 failure.
+	std::shared_ptr<MetalFXGPUObservation> sdk_completion = std::make_shared<MetalFXGPUObservation>();
+	std::shared_ptr<MetalFXGPUObservation> completion = std::make_shared<MetalFXGPUObservation>();
+
+	bool ready(uint64_t p_frame, uint64_t p_epoch) const {
+		if (!frame || !serial || frame != p_frame || epoch != p_epoch ||
+				encode_result.load(std::memory_order_acquire) != 1 || warm_count.load(std::memory_order_acquire) < 5) {
+			return false;
+		}
+		for (const auto &observer : { sdk_completion, completion }) {
+			MetalFXGPUObservation::Snapshot s = observer->snapshot();
+			if (s.counter_exhausted || s.unexpected_callback || s.first_observed_failure.ticket ||
+					s.encoded.ticket != 1 || s.completed.ticket != 1 || !s.completed.succeeded ||
+					s.completed.frame != frame || s.completed.epoch != epoch) {
+				return false;
+			}
+		}
+		return true;
+	}
+};
+
+// Diagnostic render-thread snapshot only. A presenter must first add a lease:
+// these texture RIDs can be retired or reused on the next viewport draw.
+struct MetalFXCompletedPair {
+	RID generated_texture;
+	RID real_texture;
+	uint64_t frame = 0;
+	uint64_t previous_frame = 0;
+	uint64_t epoch = 0;
+	uint64_t serial = 0;
+};
