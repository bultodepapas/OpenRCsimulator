+bool RenderSceneBuffersRD::get_metalfx_completed_pair(MetalFXCompletedPair &r_pair) const {
+#if defined(METAL_ENABLED) && defined(MACOS_ENABLED)
+	int index = _metalfx_composition_ready_slot();
+	if (index >= 0) {
+		const MFXCompositionSlot &slot = mfx_composition_slots[index];
+		RendererRD::TextureStorage *storage = RendererRD::TextureStorage::get_singleton();
+		r_pair.generated_texture = storage->render_target_get_rd_texture(slot.generated_target);
+		r_pair.real_texture = storage->render_target_get_rd_texture(slot.real_target);
+		r_pair.frame = slot.state->frame;
+		r_pair.previous_frame = slot.state->previous_frame;
+		r_pair.epoch = slot.state->epoch;
+		r_pair.serial = slot.state->serial;
+		return r_pair.generated_texture.is_valid() && r_pair.real_texture.is_valid() && r_pair.generated_texture != r_pair.real_texture;
+	}
+#endif
+	return false;
+}
