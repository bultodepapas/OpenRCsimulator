+bool MFXCompositionEffect::observe_completion(RID p_generated, RID p_real, const std::shared_ptr<MetalFXCompositionFrame> &p_state) const {
+	if (!p_generated.is_valid() || !p_real.is_valid() || p_generated == p_real || !p_state) {
+		return false;
+	}
+	CallbackArgs *args = memnew(CallbackArgs);
+	args->state = p_state;
+	RD::CallbackResource resources[2] = {
+		{ .rid = p_generated, .usage = RD::CALLBACK_RESOURCE_USAGE_TEXTURE_SAMPLE },
+		{ .rid = p_real, .usage = RD::CALLBACK_RESOURCE_USAGE_TEXTURE_SAMPLE },
+	};
+	Error error = RD::get_singleton()->driver_callback_add((RDD::DriverCallback)MFXCompositionEffect::callback, args, VectorView<RD::CallbackResource>(resources, 2));
+	if (error != OK) {
+		memdelete(args);
+		return false;
+	}
+	return true;
+}
+
+void MFXCompositionEffect::callback(RDD *p_driver, RDD::CommandBufferID p_command_buffer, CallbackArgs *p_userdata) {
+	(void)p_driver;
+	MDCommandBufferBase *obj = (MDCommandBufferBase *)(p_command_buffer.id);
+	obj->end();
+	MTL3::MDCommandBuffer *cmd = (MTL3::MDCommandBuffer *)(p_command_buffer.id);
+	mfx_observe_gpu(cmd->ensure_command_buffer(), p_userdata->state->completion,
+			p_userdata->state->frame, p_userdata->state->epoch);
+	memdelete(p_userdata);
+}
+
