+void RenderSceneBuffersRD::finish_metalfx_frame_composition(bool p_canvas_compatible) {
+#if defined(METAL_ENABLED) && defined(MACOS_ENABLED)
+	if (mfx_composition_active < 0) {
+		return;
+	}
+	MFXCompositionSlot &slot = mfx_composition_slots[mfx_composition_active];
+	mfx_composition_active = -1;
+	if (!slot.tonemapped) {
+		mfx_composition_invalid_through = slot.state->frame;
+		slot.state.reset();
+		mfx_composition_reason = "unsupported_scene_or_postprocess";
+		return;
+	}
+	RendererRD::TextureStorage *storage = RendererRD::TextureStorage::get_singleton();
+	RID generated = storage->render_target_get_rd_texture(slot.generated_target);
+	RID real = storage->render_target_get_rd_texture(slot.real_target);
+	RID source = storage->render_target_get_rd_texture(render_target);
+	if (!generated.is_valid() || !real.is_valid() || !source.is_valid()) {
+		slot.submitted = true; // Quarantine: do not reuse unobserved work.
+		mfx_composition_faulted = true;
+		mfx_composition_reason = "invalid_render_target";
+		return;
+	}
+	// Both RTs use the same raw UNORM/HDR encoding. This is a texel copy, not
+	// a second UI render or an sRGB conversion.
+	RendererRD::CopyEffects *copy_effects = RendererRD::CopyEffects::get_singleton();
+	bool copy_recorded = copy_effects && copy_effects->copy_to_rect_checked(source, real, Rect2i(Point2i(), target_size), false, false, false, !storage->render_target_is_using_hdr(render_target));
+	slot.eligible = p_canvas_compatible && copy_recorded;
+	if (!slot.eligible) {
+		mfx_composition_invalid_through = slot.state->frame;
+	}
+	RendererRD::MFXCompositionEffect observer;
+	slot.submitted = true;
+	if (!observer.observe_completion(generated, real, slot.state)) {
+		mfx_composition_faulted = true; // Keep the slot quarantined until retirement.
+		mfx_composition_reason = "completion_observer_rejected";
+		return;
+	}
+	mfx_composition_reason = !copy_recorded ? "copy_record_failed" : (slot.eligible ? "completion_pending" : "incompatible_canvas");
+#endif
+}
+
+#if defined(METAL_ENABLED) && defined(MACOS_ENABLED)
+int RenderSceneBuffersRD::_metalfx_composition_ready_slot() const {
+	if (!is_metalfx_frame_composition_requested() || !mfx_frame_context || !mfx_frame_context->history || mfx_composition_faulted ||
+			mfx_frame_context->history->callback_error.load(std::memory_order_acquire)) {
+		return -1;
+	}
+	for (const MFXCompositionSlot &slot : mfx_composition_slots) {
+		if (slot.submitted && slot.state) {
+			for (const auto &observer : { slot.state->sdk_completion, slot.state->completion }) {
+				MetalFXGPUObservation::Snapshot observed = observer->snapshot();
+				if (observed.first_observed_failure.ticket || observed.counter_exhausted || observed.unexpected_callback) {
+					return -1;
+				}
+			}
+		}
+	}
+	uint64_t epoch = mfx_frame_context->history->requested_epoch.load(std::memory_order_acquire);
+	int latest = -1;
+	for (int i = 0; i < 2; ++i) {
+		const MFXCompositionSlot &slot = mfx_composition_slots[i];
+		if (slot.submitted && slot.eligible && slot.state && slot.state->frame > mfx_composition_invalid_through &&
+				slot.state->frame <= mfx_composition_current_frame && mfx_composition_current_frame - slot.state->frame <= 1 &&
+				slot.state->ready(slot.state->frame, epoch) &&
+				(latest < 0 || slot.state->frame > mfx_composition_slots[latest].state->frame)) {
+			latest = i;
+		}
+	}
+	return latest;
+}
+#endif
