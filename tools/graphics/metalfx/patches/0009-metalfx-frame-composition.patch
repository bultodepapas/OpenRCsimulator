+void RenderSceneBuffersRD::clear_metalfx_frame_composition() {
+#if defined(METAL_ENABLED) && defined(MACOS_ENABLED)
+	// RD defers native resource destruction until the owning frame fence. The
+	// callbacks themselves retain only their shared value state.
+	RendererRD::TextureStorage *storage = RendererRD::TextureStorage::get_singleton();
+	for (MFXCompositionSlot &slot : mfx_composition_slots) {
+		if (slot.generated_target.is_valid()) {
+			storage->render_target_free(slot.generated_target);
+		}
+		if (slot.real_target.is_valid()) {
+			storage->render_target_free(slot.real_target);
+		}
+		slot = MFXCompositionSlot();
+	}
+	mfx_composition_active = -1;
+	mfx_composition_invalid_through = 0;
+	mfx_composition_current_frame = 0;
+	mfx_composition_faulted = false;
+	mfx_composition_reason = "not_attempted";
+#endif
+}
+
+void RenderSceneBuffersRD::begin_metalfx_frame_composition(uint64_t p_frame, bool p_compatible) {
+#if defined(METAL_ENABLED) && defined(MACOS_ENABLED)
+	if (!is_metalfx_frame_composition_requested()) {
+		return;
+	}
+	mfx_composition_active = -1;
+	mfx_composition_current_frame = p_frame;
+	if (!p_compatible || !is_metalfx_frame_requested() || !p_frame || target_size.x <= 0 || target_size.y <= 0) {
+		mfx_composition_invalid_through = p_frame;
+		mfx_composition_reason = "incompatible_viewport";
+		return;
+	}
+	RendererRD::TextureStorage *storage = RendererRD::TextureStorage::get_singleton();
+	bool hdr = storage->render_target_is_using_hdr(render_target);
+	bool debanding = storage->render_target_is_using_debanding(render_target);
+	for (MFXCompositionSlot &slot : mfx_composition_slots) {
+		if (slot.generated_target.is_valid() &&
+				(storage->render_target_get_size(slot.generated_target) != target_size ||
+						storage->render_target_is_using_hdr(slot.generated_target) != hdr ||
+						storage->render_target_is_using_debanding(slot.generated_target) != debanding)) {
+			clear_metalfx_frame_composition();
+			mfx_composition_invalid_through = p_frame - 1;
+			mfx_composition_current_frame = p_frame;
+			break;
+		}
+	}
+	for (MFXCompositionSlot &slot : mfx_composition_slots) {
+		if (slot.submitted && slot.state) {
+			for (const auto &observer : { slot.state->sdk_completion, slot.state->completion }) {
+				MetalFXGPUObservation::Snapshot observed = observer->snapshot();
+				if (observed.first_observed_failure.ticket || observed.counter_exhausted || observed.unexpected_callback) {
+					mfx_composition_faulted = true;
+				}
+			}
+		}
+	}
+	if (mfx_composition_faulted) {
+		mfx_composition_invalid_through = p_frame;
+		mfx_composition_reason = "gpu_completion_failed";
+		return;
+	}
+	// Preserve the newest completed pair while there is another free slot.
+	int latest = _metalfx_composition_ready_slot();
+	for (int attempt = 0; attempt < 2; ++attempt) {
+		int index = latest < 0 ? attempt : ((latest + 1 + attempt) % 2);
+		MFXCompositionSlot &slot = mfx_composition_slots[index];
+		if (slot.submitted && slot.state && !slot.state->completion->snapshot().completed.ticket) {
+			continue; // Pending or unobservable work must never be reused.
+		}
+		if (slot.submitted && slot.state && slot.state->encode_result.load(std::memory_order_acquire) == 1 &&
+				!slot.state->sdk_completion->snapshot().completed.ticket) {
+			continue;
+		}
+		if (!slot.generated_target.is_valid()) {
+			slot.generated_target = storage->render_target_create();
+			slot.real_target = storage->render_target_create();
+			if (!slot.generated_target.is_valid() || !slot.real_target.is_valid()) {
+				if (slot.generated_target.is_valid()) {
+					storage->render_target_free(slot.generated_target);
+				}
+				if (slot.real_target.is_valid()) {
+					storage->render_target_free(slot.real_target);
+				}
+				slot = MFXCompositionSlot();
+				mfx_composition_reason = "render_target_allocation_failed";
+				return;
+			}
+			for (RID target : { slot.generated_target, slot.real_target }) {
+				storage->render_target_set_use_hdr(target, hdr);
+				storage->render_target_set_use_debanding(target, debanding);
+				storage->render_target_set_size(target, target_size.x, target_size.y, 1);
+			}
+		}
+		slot.state = std::make_shared<MetalFXCompositionFrame>();
+		slot.state->frame = p_frame;
+		slot.submitted = false;
+		slot.encode_enqueued = false;
+		slot.tonemapped = false;
+		slot.eligible = false;
+		mfx_composition_active = index;
+		mfx_composition_reason = "pending_scene";
+		return;
+	}
+	mfx_composition_reason = "both_slots_pending";
+#endif
+}
+
+RID RenderSceneBuffersRD::get_metalfx_frame_composition_target() const {
+#if defined(METAL_ENABLED) && defined(MACOS_ENABLED)
+	if (mfx_composition_active >= 0 && mfx_composition_slots[mfx_composition_active].tonemapped) {
+		return mfx_composition_slots[mfx_composition_active].generated_target;
+	}
+#endif
+	return RID();
+}
