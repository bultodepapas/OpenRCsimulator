+// BEGIN SDK24 VULKAN FEATURE HELPERS
+// Query only a supported KHR extension and keep 1.2 aggregate structures unique.
+static void openrc_fsr24_query_features(VkPhysicalDevice p_device, PFN_vkGetPhysicalDeviceFeatures2 p_query,
+		bool p_has_khr, uint32_t p_api_version, bool &r_linear, bool &r_separate) {
+	r_linear = false;
+	r_separate = false;
+	if (p_query == nullptr || !p_has_khr || p_api_version < VK_API_VERSION_1_2) {
+		return;
+	}
+	VkPhysicalDeviceComputeShaderDerivativesFeaturesKHR derivatives = {};
+	derivatives.sType = VK_STRUCTURE_TYPE_PHYSICAL_DEVICE_COMPUTE_SHADER_DERIVATIVES_FEATURES_KHR;
+	VkPhysicalDeviceVulkan12Features vulkan12 = {};
+	vulkan12.sType = VK_STRUCTURE_TYPE_PHYSICAL_DEVICE_VULKAN_1_2_FEATURES;
+	vulkan12.pNext = &derivatives;
+	VkPhysicalDeviceFeatures2 features = {};
+	features.sType = VK_STRUCTURE_TYPE_PHYSICAL_DEVICE_FEATURES_2;
+	features.pNext = &vulkan12;
+	p_query(p_device, &features);
+	r_linear = derivatives.computeDerivativeGroupLinear == VK_TRUE;
+	r_separate = vulkan12.separateDepthStencilLayouts == VK_TRUE;
+}
+
+static void openrc_fsr24_append_device_features(bool p_linear, bool p_separate,
+		VkPhysicalDeviceComputeShaderDerivativesFeaturesKHR &r_derivatives,
+		VkPhysicalDeviceVulkan12Features &r_vulkan12, void *&r_next) {
+	if (p_linear) {
+		r_derivatives.sType = VK_STRUCTURE_TYPE_PHYSICAL_DEVICE_COMPUTE_SHADER_DERIVATIVES_FEATURES_KHR;
+		r_derivatives.pNext = r_next;
+		r_derivatives.computeDerivativeGroupLinear = VK_TRUE;
+		r_next = &r_derivatives;
+	}
+	r_vulkan12.separateDepthStencilLayouts = p_separate ? VK_TRUE : VK_FALSE;
+}
+
+// Record what was actually requested, only after vkCreateDevice succeeds.
+static void openrc_fsr24_publish_enabled(const VkDeviceCreateInfo &p_create, RDD::Capabilities &r_capabilities) {
+	bool has_khr = false;
+	for (uint32_t i = 0; i < p_create.enabledExtensionCount; i++) {
+		if (std::strcmp(p_create.ppEnabledExtensionNames[i], VK_KHR_COMPUTE_SHADER_DERIVATIVES_EXTENSION_NAME) == 0) {
+			has_khr = true;
+		}
+	}
+	bool linear = false;
+	bool separate = false;
+	uint32_t derivative_count = 0;
+	uint32_t vulkan12_count = 0;
+	for (const VkBaseInStructure *next = static_cast<const VkBaseInStructure *>(p_create.pNext); next != nullptr; next = next->pNext) {
+		if (next->sType == VK_STRUCTURE_TYPE_PHYSICAL_DEVICE_COMPUTE_SHADER_DERIVATIVES_FEATURES_KHR) {
+			derivative_count++;
+			linear = reinterpret_cast<const VkPhysicalDeviceComputeShaderDerivativesFeaturesKHR *>(next)->computeDerivativeGroupLinear == VK_TRUE;
+		} else if (next->sType == VK_STRUCTURE_TYPE_PHYSICAL_DEVICE_VULKAN_1_2_FEATURES) {
+			vulkan12_count++;
+			separate = reinterpret_cast<const VkPhysicalDeviceVulkan12Features *>(next)->separateDepthStencilLayouts == VK_TRUE;
+		}
+	}
+	r_capabilities.fsr24_vulkan_derivative_linear = has_khr && derivative_count == 1 && linear;
+	r_capabilities.fsr24_vulkan_separate_depth_stencil = vulkan12_count == 1 && separate;
+}
+// END SDK24 VULKAN FEATURE HELPERS
