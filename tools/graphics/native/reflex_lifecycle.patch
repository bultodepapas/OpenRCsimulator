+Dictionary Streamline::get_reflex_status() const {
+	Dictionary status;
+#ifdef STREAMLINE_ENABLED
+	_THREAD_SAFE_METHOD_
+	const StreamlineContext &ctx = StreamlineContext::get();
+	const bool plugin_supported = ctx.is_game && ctx.streamline_capabilities.reflex_available;
+	const bool plugin_ready = plugin_supported && ctx.slReflexSetOptions && ctx.slReflexGetState && ctx.slReflexSleep;
+	const bool pcl_supported = ctx.is_game && ctx.streamline_capabilities.pcl_available;
+	const bool pcl_ready = pcl_supported && ctx.slPCLSetOptions && ctx.slPCLSetMarker;
+	const bool failed = ctx.reflex_failed.load() || ctx.pcl_failed.load();
+	status["plugin_supported"] = plugin_supported;
+	status["plugin_ready"] = plugin_ready;
+	status["pcl_supported"] = pcl_supported;
+	status["pcl_ready"] = pcl_ready;
+	status["low_latency_available"] = ctx.reflex_low_latency_available.load();
+	status["available"] = plugin_ready && pcl_ready && ctx.reflex_low_latency_available.load() && !failed;
+	status["backend_failed"] = failed;
+	status["requested_mode"] = int(ctx.reflex_options.mode);
+	status["applied_mode"] = ctx.reflex_applied_mode.load();
+	status["state_result"] = ctx.reflex_state_result.load();
+	status["set_result"] = ctx.reflex_set_result.load();
+	status["sleep_result"] = ctx.reflex_sleep_result.load();
+	status["failure_result"] = ctx.reflex_failure_result.load();
+	status["pcl_options_result"] = ctx.pcl_options_result.load();
+	status["pcl_marker_result"] = ctx.pcl_marker_result.load();
+	status["pcl_failure_result"] = ctx.pcl_failure_result.load();
+	status["set_calls"] = int64_t(ctx.reflex_set_calls.load());
+	status["sleep_calls"] = int64_t(ctx.reflex_sleep_calls.load());
+	status["sleep_successes"] = int64_t(ctx.reflex_sleep_successes.load());
+	status["sleep_frame_id"] = int64_t(ctx.reflex_sleep_frame_id.load());
+	status["pcl_marker_calls"] = int64_t(ctx.pcl_marker_calls.load());
+	status["pcl_marker_successes"] = int64_t(ctx.pcl_marker_successes.load());
+	status["simulation_start_successes"] = int64_t(ctx.pcl_simulation_start_successes.load());
+	status["render_start_successes"] = int64_t(ctx.pcl_render_start_successes.load());
+	status["render_end_successes"] = int64_t(ctx.pcl_render_end_successes.load());
+	status["present_start_successes"] = int64_t(ctx.pcl_present_start_successes.load());
+	status["present_end_successes"] = int64_t(ctx.pcl_present_end_successes.load());
+	status["expired_tokens"] = int64_t(ctx.pcl_expired_tokens.load());
+	status["simulation_frame_id"] = int64_t(ctx.pcl_simulation_frame_id.load());
+	status["render_frame_id"] = int64_t(ctx.pcl_render_frame_id.load());
+	status["present_frame_id"] = int64_t(ctx.pcl_present_frame_id.load());
+#else
+	status["plugin_supported"] = false;
+	status["available"] = false;
+	status["backend_failed"] = false;
+	status["requested_mode"] = 0;
+	status["applied_mode"] = -1;
+#endif
+	return status;
