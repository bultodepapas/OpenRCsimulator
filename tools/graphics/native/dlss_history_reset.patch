 namespace RendererRD {
 
+// BEGIN DLSS HISTORY RESET STATE
+// Owned by one DLSS context. The render graph serializes its callbacks.
+class DLSSHistoryResetState {
+	bool has_evaluated = false;
+	uint64_t completed_generation = 0;
+
+public:
+	bool should_reset(uint64_t p_generation) const {
+		return !has_evaluated || p_generation > completed_generation;
+	}
+	void evaluated(uint64_t p_generation) {
+		has_evaluated = true;
+		if (p_generation > completed_generation) {
+			completed_generation = p_generation;
+		}
+	}
+};
+// END DLSS HISTORY RESET STATE
+
