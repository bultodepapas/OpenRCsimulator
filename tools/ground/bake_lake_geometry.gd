# DT-11a: reproducible default-lake CPU buffers; run with the pinned Godot build.
# godot --headless --path app --script <absolute-script-path> -- [--check] [--out=<path>]
extends SceneTree

const SOURCES: Array[String] = [
	"res://render/lake/lake_terrain.gd", "res://physics/ground_terrain.gd",
	"res://physics/lake_surface.gd", "res://physics/math3d.gd",
]
const STAMP_PATH := "res://render/lake/generated_geometry_stamp.gd"


func _initialize() -> void:
	_run.call_deferred()


func _run() -> void:
	var terrain: Script = load("res://render/lake/lake_terrain.gd")
	var output: String = terrain.BAKED_PATH
	var check := false
	for arg in OS.get_cmdline_user_args():
		if arg == "--check":
			check = true
		elif arg.begins_with("--out="):
			output = arg.trim_prefix("--out=")
		else:
			_fail("Unknown option: " + arg)
			return
	var field_loader: Script = load("res://data/field_loader.gd")
	var lake_loader: Script = load("res://data/lake_loader.gd")
	var surfaces_script: Script = load("res://physics/ground_surfaces.gd")
	var field: Dictionary = field_loader.load_from()
	var lake: Dictionary = lake_loader.load_from()
	var table: Dictionary = surfaces_script.load_table()
	if not field.ok or not lake.ok or not table.ok:
		_fail("Default field, lake or surface table failed validation")
		return
	var surfaces: Dictionary = surfaces_script.build(table.table, field.field)
	if not surfaces.ok:
		_fail("Default ground surfaces failed validation")
		return
	var minimum := Vector2(INF, INF)
	var maximum := Vector2(-INF, -INF)
	var polygon: PackedFloat64Array = lake.lake.bank_ne_m
	for i in range(0, polygon.size(), 2):
		minimum.x = minf(minimum.x, polygon[i])
		minimum.y = minf(minimum.y, polygon[i + 1])
		maximum.x = maxf(maximum.x, polygon[i])
		maximum.y = maxf(maximum.y, polygon[i + 1])
	# Call procedural builders directly, bypassing both the file and in-memory caches.
	var basin: Array = terrain._build_basin_arrays(lake.lake, surfaces.rects, minimum, maximum)
	var water: Array = terrain._build_water_arrays(lake.lake)
	var source_hashes := {}
	for path: String in SOURCES:
		source_hashes[path] = FileAccess.get_file_as_string(path).replace("\r\n", "\n").sha256_text()
	var expected := {
		"format": terrain.BAKED_FORMAT, "engine_hex": Engine.get_version_info().hex,
		"double_precision": OS.has_feature("double"), "sources": source_hashes,
		"basin_key": var_to_bytes([lake.lake, surfaces.rects]), "water_key": var_to_bytes(lake.lake),
		"basin_arrays": basin, "water_arrays": water,
		"basin_sha256": terrain.geometry_digest(basin), "water_sha256": terrain.geometry_digest(water),
	}
	var stamp := "# Generated by tools/ground/bake_lake_geometry.gd. Do not edit.\nextends RefCounted\nconst SOURCE_SHA256 := \"%s\"\n" % terrain.geometry_digest([source_hashes])
	if check:
		if FileAccess.get_file_as_string(STAMP_PATH).replace("\r\n", "\n") != stamp:
			_fail("Stale lake geometry source stamp; regenerate both outputs")
			return
		if not ResourceLoader.exists(output):
			_fail("Missing generated lake geometry: " + output)
			return
		var existing: Resource = ResourceLoader.load(output, "Resource", ResourceLoader.CACHE_MODE_IGNORE)
		if existing == null:
			_fail("Cannot load generated lake geometry")
			return
		for key: String in expected:
			if var_to_bytes(existing.get_meta(key, null)) != var_to_bytes(expected[key]):
				_fail("Stale lake geometry field: " + key + "; regenerate with tools/ground/bake_lake_geometry.gd")
				return
		print("Lake geometry matches procedural buffers and source hashes: ", output)
		quit()
		return
	if not output.ends_with(".res"):
		_fail("Generated output must use .res")
		return
	var directory_error := DirAccess.make_dir_recursive_absolute(output.get_base_dir())
	if directory_error != OK:
		_fail("Cannot create output directory")
		return
	var resource := Resource.new()
	for key: String in expected:
		resource.set_meta(key, expected[key])
	var error := ResourceSaver.save(resource, output, ResourceSaver.FLAG_COMPRESS)
	if error != OK:
		_fail("Cannot save generated geometry: " + error_string(error))
		return
	if output == terrain.BAKED_PATH:
		var stamp_file := FileAccess.open(STAMP_PATH, FileAccess.WRITE)
		if stamp_file == null:
			_fail("Cannot write geometry source stamp")
			return
		stamp_file.store_string(stamp)
		stamp_file.close()
	print("Generated lake geometry: ", output, " basin=", expected.basin_sha256, " water=", expected.water_sha256)
	quit()


func _fail(message: String) -> void:
	push_error(message)
	quit(1)
