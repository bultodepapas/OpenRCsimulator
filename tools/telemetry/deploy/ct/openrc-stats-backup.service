[Unit]
Description=OpenRC stats: daily copy of the GitHub history archive (TELEM-24c)

[Service]
Type=oneshot
User=openrc-stats
Group=openrc-stats
ExecStart=/usr/bin/python3 /opt/openrc-stats/current/tools/telemetry/deploy/ct/backup_archive.py \
  /var/lib/openrc-stats/github /var/lib/openrc-stats/backups
NoNewPrivileges=yes
ProtectSystem=strict
ProtectHome=yes
ReadWritePaths=/var/lib/openrc-stats/backups
CapabilityBoundingSet=
