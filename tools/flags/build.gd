## L15c-F03: rasterize the pinned, locally vendored SVGs with OpenRC's pinned Godot.
## Run from the repository root with --path app --script <absolute path> -- [--check].
extends SceneTree

const SOURCE_DIR := "res://../assets/landscape/flags/"
const OUTPUT_DIR := "res://assets/flags/"
const ENGINE_VERSION := "4.8.beta2.official.cafc17a19"
const LONG_EDGE := 512


func _initialize() -> void:
	var check_only := "--check" in OS.get_cmdline_user_args()
	var version := Engine.get_version_info()
	if version.major != 4 or version.minor != 8 or version.patch != 0 \
			or version.status != "beta2" or version.build != "official" \
			or version.hash != "cafc17a192acf67903910a68aeb3c076c0907a4b":
		_fail("Use pinned Godot %s" % ENGINE_VERSION)
		return
	var source: Variant = JSON.parse_string(FileAccess.get_file_as_string(SOURCE_DIR + "SOURCES.json"))
	if not source is Dictionary or source.get("schema", "") != "openrc-flag-sources-v1":
		_fail("Invalid source manifest")
		return
	var flags: Dictionary = source.get("flags", {})
	var countries := flags.keys()
	countries.sort()
	if countries.size() != int(source.get("country_count", -1)) or not flags.has("US"):
		_fail("Invalid source country count or missing US fallback")
		return
	var outputs := {}
	var generated := "## Generated by tools/flags/build.gd from assets/landscape/flags/SOURCES.json.\n"
	generated += "## Width / height are original artwork dimensions; no texture is preloaded.\n"
	generated += "extends RefCounted\n\nconst FLAGS := {\n"
	var notice := "Country flag artwork — Wikimedia Commons\n\n"
	notice += "The listed source files were retrieved on %s. Wikimedia Commons lists each\n" % source.retrieved_utc_date
	notice += "as public domain. Follow each source page for the basis and independent\n"
	notice += "restrictions on official insignia. The source SVG revision and SHA-256 are\n"
	notice += "listed below; images were rasterized to 512 px with the pinned Godot engine.\n\n"
	for country: String in countries:
		var item: Dictionary = flags[country]
		var source_path: String = SOURCE_DIR + str(item.source_file)
		var width: int = int(item.width)
		var height: int = int(item.height)
		if country.length() != 2 or width < height or height <= 0 \
				or item.reverse_policy != "mirror_front" \
				or item.license_as_recorded != "Public domain" \
				or FileAccess.get_sha256(source_path) != item.sha256:
			_fail("Invalid or changed source for %s" % country)
			return
		var image := Image.new()
		var err := image.load_svg_from_buffer(FileAccess.get_file_as_bytes(source_path), float(LONG_EDGE) / width)
		if err != OK or image.get_width() != LONG_EDGE \
				or image.get_height() != roundi(float(LONG_EDGE) * height / width):
			_fail("SVG rasterization failed for %s: %s (%dx%d)" % [
				country, error_string(err), image.get_width(), image.get_height()])
			return
		# Panama's adjacent source shapes leave two antialiased edge pixels with
		# fractional coverage. Reject substantive transparency before compositing
		# those rasterization artifacts over the flag's own white ground.
		if image.detect_alpha() != Image.ALPHA_NONE:
			var partial := 0
			for y in image.get_height():
				for x in image.get_width():
					var alpha := image.get_pixel(x, y).a
					if alpha < 0.9:
						_fail("Substantive transparency in %s" % country)
						return
					if alpha < 1.0:
						partial += 1
			if partial > 4:
				_fail("Unexpected partially covered pixels in %s" % country)
				return
			var opaque := Image.create(image.get_width(), image.get_height(), false, Image.FORMAT_RGBA8)
			opaque.fill(Color.WHITE)
			opaque.blend_rect(image, Rect2i(Vector2i.ZERO, image.get_size()), Vector2i.ZERO)
			image = opaque
		image.convert(Image.FORMAT_RGB8)
		var png := image.save_png_to_buffer()
		if png.is_empty():
			_fail("PNG encoding failed for %s" % country)
			return
		var texture_path := OUTPUT_DIR + country.to_lower() + ".png"
		outputs[texture_path] = png
		generated += "\t\"%s\": {\n" % country
		generated += "\t\t\"front_path\": \"%s\", \"reverse_path\": \"%s\",\n" % [texture_path, texture_path]
		generated += "\t\t\"reverse_policy\": \"mirror_front\", \"width\": %d, \"height\": %d,\n" % [width, height]
		generated += "\t\t\"spanish_selection\": %s,\n\t},\n" % ("true" if item.spanish_selection else "false")
		notice += "%s — %s\n" % [country, item.source_page]
		notice += "  Revision %s; SVG SHA-256 %s\n" % [item.revision_utc, item.sha256]
		notice += "  Creator as recorded: %s\n\n" % item.creator_as_recorded
	generated += "}\n"
	outputs[OUTPUT_DIR + "manifest.gd"] = generated.to_utf8_buffer()
	outputs[OUTPUT_DIR + "NOTICE.txt"] = notice.to_utf8_buffer()
	# Render and validate every source before modifying any output.
	for path: String in outputs:
		var expected: PackedByteArray = outputs[path]
		var identical := FileAccess.file_exists(path) and FileAccess.get_file_as_bytes(path) == expected
		if check_only:
			if not identical:
				_fail("Generated output differs: %s" % path)
				return
		elif not identical:
			var output := FileAccess.open(path, FileAccess.WRITE)
			if output == null:
				_fail("Cannot write %s" % path)
				return
			output.store_buffer(expected)
	print("flag asset %s passed: %d countries" % ["check" if check_only else "build", countries.size()])
	quit(0)


func _fail(message: String) -> void:
	push_error(message)
	quit(1)
