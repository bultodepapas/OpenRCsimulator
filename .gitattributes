# Keep hashed glow profiles, schemas and flight evidence byte-stable across checkouts.
# Workshop descriptors bind exact aircraft bytes on every platform.
/app/data/aircraft/*.json text eol=crlf
/app/data/rotorcraft/*.json text eol=crlf
/app/data/workshop/*.json text eol=lf
/app/data/ground/wheel_profiles.json text eol=lf
/app/data/glow/*_candidate.json text eol=lf
/app/data/glow/profile_contract.json text eol=lf
/app/data/glow/*.schema.json text eol=lf
/research/glow-engines/flight-240.json text eol=lf
/research/glow-engines/flight-480.json text eol=lf
/research/glow-engines/flight-960.json text eol=lf

# These generated Stik installation and aircraft records intentionally retain CRLF.
/app/data/glow/stik_55ax_2t.json text eol=crlf
/app/data/glow/stik_55ax_2t_apc_13x6.json text eol=crlf
/app/data/glow/stik_fs64v_4t.json text eol=crlf
/app/data/glow/stik_fs64v_4t_apc_13x6.json text eol=crlf
/app/data/aircraft/stik_glow_55ax_2t.json text eol=crlf
/app/data/aircraft/stik_glow_55ax_2t_apc_13x6.json text eol=crlf
/app/data/aircraft/stik_glow_fs64v_4t.json text eol=crlf
/app/data/aircraft/stik_glow_fs64v_4t_apc_13x6.json text eol=crlf
/app/data/glow/stik_61fx_2t.json text eol=crlf
/app/data/aircraft/stik_glow_61fx_2t.json text eol=crlf

# Model manifests are exact-byte Workshop dependencies. Source-script hashes normalize text to LF.
/app/data/aircraft_models/*.json text eol=lf

# HX-700 source and runtime rotor profiles share the manifest's exact SHA-256.
/assets/aircraft/hx-700/rotor_profiles.json text eol=lf
/app/assets/aircraft/hx-700/rotor_profiles.json text eol=lf

# RCV bench identity and generated independent oracle are byte-stable.
/research/rc-monster-truck/suspension_bench.json text eol=lf
/research/rc-monster-truck/support_bench.json text eol=lf
/research/rc-monster-truck/fixtures/*.json text eol=lf

# RCV-14a pins the author's delivery bytes, including the supplied visual rig.
"RC CARS/**" -text
/docs/research/rc-monster-truck/RCV-14a/intake.json text eol=lf

# Timber r2 is an immutable author delivery; manifests hash its original bytes.
"Timber Trubo Evolucion V2 BLENDER/turbo_timber_evolution_r2/r2/**" -text
/app/assets/aircraft/turbo-lumber-evolution/LICENSE.txt -text
/assets/aircraft/turbo-lumber-evolution/source-manifest.json text eol=lf
/assets/aircraft/turbo-lumber-evolution/mesh-measurements.json text eol=lf
/assets/aircraft/turbo-lumber-evolution/geometry.json text eol=lf

# Authorized Bisonte runtime bundle preserves the exact reviewed author bytes.
/app/vehicles/ground/mt8_rig.gd -text
/app/assets/vehicles/mt8-bisonte/mt8_spec.json -text
/app/assets/vehicles/mt8-bisonte/SOURCE.txt text eol=lf
/assets/vehicles/mt8-bisonte/source-manifest.json text eol=lf
/app/data/vehicles/ground/*.json text eol=lf
/app/data/ground_vehicle/*.json text eol=lf

# AV-31 preserves the supplied Blender master bytes and hash-bound collision metadata.
/assets/aircraft/avanti-s-a200/source/** -text
/assets/aircraft/avanti-s-a200/blender-geometry.json text eol=lf
/assets/aircraft/avanti-s-a200/source-manifest.json text eol=lf
