template<class T> struct VectorView { const std::vector<T> &values; VectorView(const std::vector<T> &v) : values(v) {} VectorView(const SmallVector<T> &v) : values(v.values) {} uint32_t size() const { return uint32_t(values.size()); } const T &operator[](uint32_t i) const { return values.at(i); } };
template<class T> using BitField = uint32_t;
enum AccelerationStructureFlagBits { UNUSED_FLAG };
struct AccelerationStructureGeometry { uint32_t flags = 0, vertex_format = 0, vertex_count = 0, index_format = 0, index_count = 0; uint64_t vertex_offset = 0, index_offset = 0, vertex_stride = 0; RDD::BufferID vertex_buffer, index_buffer; };
constexpr uint32_t INDEX_BUFFER_FORMAT_UINT16 = 1;
struct AccelerationStructureInstance { Transform3D transform; uint32_t id = 0, mask = 0, hit_sbt_offset = 0, flags = 0; RDD::AccelerationStructureID blas; };
struct BufferInfo { uint64_t vk_buffer = 22; };
static std::vector<std::string> events;
static int live_wrappers = 0, live_buffers = 0;
static bool fail_storage = false, fail_native_create = false, null_native = false, zero_address = false;
static uint64_t scratch_request = 128;
static constexpr uint64_t buffer_address = 0x11110000;
static constexpr uint64_t as_address = 0x22220000;
static constexpr uint64_t handle = 0x3333;
static constexpr uint64_t poisoned_handle = 0xdead;
struct VersatileResource {
    template<class T> static T *allocate(int) { ++live_wrappers; return new T; }
    template<class T> static void free(int, T *p) { assert(p); --live_wrappers; events.push_back("wrapper_free"); delete p; }
};
static void fake_sizes(int, uint32_t, const VkAccelerationStructureBuildGeometryInfoKHR *, const uint32_t *, VkAccelerationStructureBuildSizesInfoKHR *out) { events.push_back("sizes"); out->accelerationStructureSize = 512; out->buildScratchSize = scratch_request; }
static VkResult fake_create(int, const VkAccelerationStructureCreateInfoKHR *info, const void *, VkAccelerationStructureKHR *out) {
    assert(info->buffer == 22); events.push_back("native_create");
    if (fail_native_create) { *out = poisoned_handle; return -1; }
    *out = null_native ? 0 : handle; return VK_SUCCESS;
}
static void fake_destroy(int, VkAccelerationStructureKHR value, const void *) { assert(value == handle); events.push_back("native_destroy"); }
static VkDeviceAddress fake_address(int, const VkAccelerationStructureDeviceAddressInfoKHR *info) { assert(info->accelerationStructure == handle); events.push_back("as_query"); return zero_address ? 0 : as_address; }
static void fake_build() {}
struct DeviceFunctions {
    decltype(&fake_sizes) GetAccelerationStructureBuildSizesKHR = fake_sizes;
    decltype(&fake_create) CreateAccelerationStructureKHR = fake_create;
    decltype(&fake_destroy) DestroyAccelerationStructureKHR = fake_destroy;
    decltype(&fake_address) GetAccelerationStructureDeviceAddressKHR = fake_address;
    decltype(&fake_build) CmdBuildAccelerationStructuresKHR = fake_build;
};
struct RenderingDeviceDriverVulkan {
    using BufferID = RDD::BufferID;
    using AccelerationStructureID = RDD::AccelerationStructureID;
    @ACCEL_INFO@
    DeviceFunctions device_functions;
    int vk_device = 0, resources_allocator = 0;
    struct { uint32_t min_acceleration_structure_scratch_offset_alignment = 256; } acceleration_structure_capabilities;
    BufferID buffer_create(uint64_t, uint32_t, uint32_t, uint64_t) { events.push_back("buffer_create"); if (fail_storage) return {}; ++live_buffers; return BufferID(new BufferInfo); }
    void buffer_free(BufferID id) { assert(id); --live_buffers; events.push_back("buffer_free"); delete reinterpret_cast<BufferInfo *>(id.id); }
    VkDeviceAddress buffer_get_device_address(BufferID) { return buffer_address; }
    RDD::AccelerationStructureID blas_create(VectorView<AccelerationStructureGeometry>, BitField<AccelerationStructureFlagBits>);
    RDD::AccelerationStructureID tlas_create(uint32_t, BitField<AccelerationStructureFlagBits>);
    void acceleration_structure_instance_write(uint8_t *, const AccelerationStructureInstance &);
    bool _acceleration_structure_create(VkAccelerationStructureTypeKHR, VkAccelerationStructureBuildSizesInfoKHR, AccelerationStructureInfo *);
    void acceleration_structure_free(AccelerationStructureID);
};
