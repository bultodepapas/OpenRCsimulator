#define ERR_FAIL_COND_V_MSG(c, v, m) do { if (c) return v; } while (false)
#define ERR_FAIL_COND_V(c, v) do { if (c) return v; } while (false)
#define ERR_FAIL_NULL_V_MSG(p, v, m) do { if (!(p)) return v; } while (false)
#define ERR_FAIL_NULL_V(p, v) do { if (!(p)) return v; } while (false)
#define ERR_FAIL_NULL_MSG(p, m) do { if (!(p)) return; } while (false)
