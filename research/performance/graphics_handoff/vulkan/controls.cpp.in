#define unlikely(x) (x)

template<class Tag> struct ID {
    uintptr_t id = 0;
    ID() = default;
    explicit ID(uintptr_t n) : id(n) {}
    template<class T> explicit ID(T *p) : id(reinterpret_cast<uintptr_t>(p)) {}
    explicit operator bool() const { return id != 0; }
    bool operator!=(const ID &rhs) const { return id != rhs.id; }
};
template<class T> struct SmallVector {
    std::vector<T> values;
    void resize(uint32_t n) { values.resize(n); }
    void resize_initialized(uint32_t n) { values.resize(n); }
    uint32_t size() const { return uint32_t(values.size()); }
    T *ptr() { return values.data(); }
    void push_back(const T &x) { values.push_back(x); }
    void clear() { values.clear(); }
    T &operator[](uint32_t i) { return values.at(i); }
    const T &operator[](uint32_t i) const { return values.at(i); }
};
template<class T> using TightLocalVector = SmallVector<T>;
template<class T> using LocalVector = SmallVector<T>;

