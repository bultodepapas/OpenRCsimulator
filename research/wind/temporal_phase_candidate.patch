+## Prepare one pure stage's repeated point queries, preserving overridden providers.
+## Turbulence callbacks retain the original per-query dispatch and refusal order.
+func prepare_wind_world_query(time_s: float) -> Callable:
+	if get_script() != load("res://sim/environment.gd") or weather == null \
+			or weather.get_script() != WeatherField:
+		return wind_world
+	var provider := weather
+	var query := provider.prepare_world_query(time_s)
+	if not query.is_valid():
+		return wind_world
+	return func(position: PackedFloat64Array, at: float) -> PackedFloat64Array:
+		if weather != provider or at != time_s:
+			return wind_world(position, at)
+		if not _valid_ned_vector(position) or not is_finite(at) or at < 0.0:
+			return _invalid_world_wind()
+		var out: PackedFloat64Array = query.call(position, at)
+		if not _valid_ned_vector(out):
+			return _invalid_world_wind()
+		# Keep this sequence identical to wind_world: callbacks may reject or rebind.
+		if not turbulence.is_valid():
+			return out
+		var noise_value: Variant = turbulence.call(at)
+		if typeof(noise_value) != TYPE_PACKED_FLOAT64_ARRAY:
+			return _invalid_world_wind()
+		if noise_value.is_empty():
+			return out
+		if not _valid_ned_vector(noise_value):
+			return _invalid_world_wind()
+		for axis: int in 3:
+			var combined: float = out[axis] + float(noise_value[axis])
+			if not is_finite(combined):
+				return _invalid_world_wind()
+			out[axis] = combined
+		return out
+
+
 ## Atmosphere at `down_m` (NED down of the datum): {ok, rho_kgm3, engine_charge_ratio, ...} per the weather law.
 func air(down_m: float = 0.0) -> Dictionary:
 	return weather.atmosphere(down_m)
