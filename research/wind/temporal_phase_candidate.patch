index 000000000..02d6a094b
--- /dev/null
+++ b/app/tests/test_spatial_wind_temporal.gd
@@ -0,0 +1,189 @@
+# M5-W05d-R6 / WOPT-03: stage-owned temporal reuse, exact bytes and live ownership.
+extends SceneTree
+
+const Spatial := preload("res://physics/wind_spatial_field.gd")
+const SpatialConfig := preload("res://physics/wind_spatial_config.gd")
+const Weather := preload("res://physics/wind_field.gd")
+const Config := preload("res://physics/wind_config.gd")
+const SimEnvironment := preload("res://sim/environment.gd")
+const Flight := preload("res://sim/flight_session.gd")
+const Catalog := preload("res://app_state/aircraft_catalog.gd")
+
+class DerivedEnvironment extends "res://sim/environment.gd":
+	var calls := 0
+	func wind_world(_position: PackedFloat64Array, _time: float) -> PackedFloat64Array:
+		calls += 1
+		return PackedFloat64Array([9.0, 8.0, 7.0])
+
+class DerivedWeather extends "res://physics/wind_field.gd":
+	var calls := 0
+	func prepare_world_query(_time: float) -> Callable:
+		return func(_position: PackedFloat64Array, _at: float) -> PackedFloat64Array:
+			return PackedFloat64Array([NAN, NAN, NAN])
+	func sample_world(_position: PackedFloat64Array, _time: float) -> PackedFloat64Array:
+		calls += 1
+		return PackedFloat64Array([6.0, 5.0, 4.0])
+
+class DerivedSpatial extends "res://physics/wind_spatial_field.gd":
+	func prepare_world_query(_time: float) -> Callable:
+		return func(_position: PackedFloat64Array, _at: float) -> Dictionary:
+			return {ok = false}
+	func sample_world(_position: PackedFloat64Array, _time: float) -> Dictionary:
+		return {ok = true, wind_ned_mps = PackedFloat64Array([3.0, 2.0, 1.0])}
+
+var _checks := 0
+var _failed := 0
+var _noise_calls := 0
+var _noise: Variant = PackedFloat64Array()
+
+func _check(label: String, ok: bool) -> void:
+	_checks += 1
+	if not ok:
+		_failed += 1
+		printerr("FAIL " + label)
+
+func _same(a: PackedFloat64Array, b: PackedFloat64Array) -> bool:
+	return a.to_byte_array() == b.to_byte_array()
+
+func _initialize() -> void:
+	_run.call_deferred()
+
+func _run() -> void:
+	_check("negative zero fixture retains its sign bit", PackedFloat64Array([_negative_zero()]).to_byte_array().hex_encode() == "0000000000000080")
+	_boundary_fixture()
+	_mode_and_refusal_matrix()
+	_live_owners_and_callbacks()
+	_virtual_providers()
+	_real_session()
+	print("spatial temporal reuse: %d checks, %d failed" % [_checks, _failed])
+	quit(1 if _failed else 0)
+
+func _boundary_fixture() -> void:
+	if OS.get_name() not in ["Windows", "Linux"]:
+		# Historical byte fixtures exist only for these hosts; direct parity runs everywhere.
+		return
+	var suffix := "_linux" if OS.get_name() == "Linux" else ""
+	var path := "res://tests/fixtures/spatial_wind_boundary_before%s.json" % suffix
+	var fixture: Dictionary = JSON.parse_string(FileAccess.get_file_as_string(path))
+	for item: Dictionary in fixture.cases:
+		var field: RefCounted = Spatial.build(item.config).field
+		for index: int in fixture.queries.size():
+			var point: Dictionary = fixture.queries[index]
+			var time_s := float(point.time_s)
+			var position := PackedFloat64Array(point.position_ned_m)
+			var query: Callable = field.prepare_world_query(time_s)
+			var result: Dictionary = query.call(position, time_s) if query.is_valid() else field.sample_world(position, time_s)
+			_check("prepared original bytes %s/%d" % [item.id, index], result.ok
+				and result.wind_ned_mps.to_byte_array().hex_encode() == item.wind_bytes_hex[index])
+			result.wind_ned_mps[0] = NAN
+
+func _mode_and_refusal_matrix() -> void:
+	for count: int in [8, 24, 64]:
+		for epoch: float in [_negative_zero(), 0.0, 7.125]:
+			var raw := SpatialConfig.defaults()
+			raw.identity.epoch_offset_s = epoch
+			raw.turbulence.mode_count = count
+			raw.turbulence.rms_mps = 0.3
+			var field: RefCounted = Spatial.build(raw).field
+			var query: Callable = field.prepare_world_query(5.25)
+			_check("nonzero field prepares", query.is_valid())
+			for time_s: float in [5.25, 0.0, _negative_zero(), 8.0, -1.0, INF, NAN, 86401.0]:
+				for position: PackedFloat64Array in [PackedFloat64Array([1.0, -2.0, -10.0]),
+					PackedFloat64Array([0.0, 0.0, -0.0]), PackedFloat64Array([1.0, 2.0, 0.25]),
+					PackedFloat64Array([1.0, 2.0, 0.251]), PackedFloat64Array([10001.0, 0.0, -1.0]),
+					PackedFloat64Array([0.0, 10001.0, -1.0]), PackedFloat64Array([0.0, 0.0, -201.0]),
+					PackedFloat64Array([NAN, 0.0, 0.0]), PackedFloat64Array()]:
+					_check("query exact output or refusal", var_to_bytes(query.call(position, time_s))
+						== var_to_bytes(field.sample_world(position, time_s)))
+			var other: Callable = field.prepare_world_query(6.5)
+			var point := PackedFloat64Array([23.0, 17.0, -1.1])
+			other.call(point, 6.5)
+			_check("interleaved contexts", var_to_bytes(query.call(point, 5.25)) == var_to_bytes(field.sample_world(point, 5.25)))
+			var changed := SpatialConfig.resolve(raw)
+			changed.config.identity.seed_u32 += 1
+			changed = SpatialConfig.resolve(changed.config)
+			field._apply_config(changed.config, changed.content_hash, null, "", "")
+			_check("same spatial owner reconfigured", var_to_bytes(query.call(point, 5.25)) == var_to_bytes(field.sample_world(point, 5.25)))
+	var zero: RefCounted = Spatial.build(SpatialConfig.defaults()).field
+	_check("disabled turbulence prepares no scratch", not zero.prepare_world_query(5.25).is_valid())
+
+func _negative_zero() -> float:
+	return PackedByteArray([0, 0, 0, 0, 0, 0, 0, 128]).to_float64_array()[0]
+
+func _config() -> Dictionary:
+	var raw := Config.spatial_defaults()
+	raw.spatial_wind.turbulence.rms_mps = 0.1
+	return raw
+
+func _noise_sample(_time: float) -> Variant:
+	_noise_calls += 1
+	return _noise
+
+func _live_owners_and_callbacks() -> void:
+	var environment := SimEnvironment.new()
+	environment.weather = Weather.build(_config()).field
+	environment.turbulence = _noise_sample
+	var query := environment.prepare_wind_world_query(1.5)
+	_check("valid empty session noise permits preparation", query.get_method() != "wind_world")
+	var point := PackedFloat64Array([1.0, 2.0, -10.0])
+	for noise: Variant in [PackedFloat64Array(), PackedFloat64Array([0.25, -0.5, 0.0]),
+		PackedFloat64Array([NAN, 0.0, 0.0]), PackedFloat64Array([1.0]), null, [0.0, 0.0, 0.0]]:
+		_noise = noise
+		_noise_calls = 0
+		_check("noise refusal and bytes", _same(query.call(point, 1.5), environment.wind_world(point, 1.5)))
+		_check("one noise callback per valid weather sample", _noise_calls == 2)
+	_noise_calls = 0
+	query.call(PackedFloat64Array([10001.0, 0.0, -1.0]), 1.5)
+	_check("weather refusal precedes noise", _noise_calls == 0)
+	_noise = PackedFloat64Array()
+	environment.turbulence = Callable()
+	_check("callback removal remains live", _same(query.call(point, 1.5), environment.wind_world(point, 1.5)))
+	var changed := _config()
+	changed.spatial_wind.identity.seed_u32 += 10
+	environment.weather._apply_config(Config.validate(changed).config)
+	_check("same weather owner reconfigured", _same(query.call(point, 1.5), environment.wind_world(point, 1.5)))
+	environment.weather = Weather.build(Config.defaults()).field
+	_check("weather replacement", _same(query.call(point, 1.5), environment.wind_world(point, 1.5)))
+	environment.turbulence = func(_time: float) -> PackedFloat64Array:
+		environment.weather = Weather.build(changed).field
+		return PackedFloat64Array()
+	query.call(point, 1.5)
+	environment.turbulence = Callable()
+	_check("callback rebind observed on next query", _same(query.call(point, 1.5), environment.wind_world(point, 1.5)))
+
+func _virtual_providers() -> void:
+	var point := PackedFloat64Array([1.0, 2.0, -10.0])
+	var derived := DerivedEnvironment.new()
+	var query := derived.prepare_wind_world_query(2.0)
+	_check("environment override preserved", _same(query.call(point, 2.0), PackedFloat64Array([9.0, 8.0, 7.0])) and derived.calls == 1)
+	var environment := SimEnvironment.new()
+	var weather := DerivedWeather.new()
+	environment.weather = weather
+	query = environment.prepare_wind_world_query(2.0)
+	_check("weather override preserved", _same(query.call(point, 2.0), PackedFloat64Array([6.0, 5.0, 4.0])) and weather.calls == 1)
+	environment.weather = Weather.build(_config()).field
+	environment.weather._spatial = DerivedSpatial.new()
+	query = environment.prepare_wind_world_query(2.0)
+	_check("spatial override preserved", _same(query.call(point, 2.0), PackedFloat64Array([3.0, 2.0, 1.0])))
+
+func _real_session() -> void:
+	var session := Flight.new()
+	session.input_enabled = false
+	session.physics_enabled = false
+	session.setup(Catalog.data_for("jensen-das-ugly-stik-60"))
+	root.add_child(session)
+	_check("stock aircraft loads", session.is_flyable())
