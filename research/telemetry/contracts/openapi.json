                        "rate_limited",
                        "unavailable",
                        "suspended"
                      ]
                    }
                  }
                }
              }
            }
          },
          "503": {
            "description": "No durable acceptance; bounded retry",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "additionalProperties": false,
                  "required": [
                    "code"
                  ],
                  "properties": {
                    "code": {
                      "type": "string",
                      "enum": [
                        "invalid_request",
                        "conflict",
                        "too_large",
                        "unsupported_media",
                        "rate_limited",
                        "unavailable",
                        "suspended"
                      ]
                    }
                  }
                }
              }
            }
          },
          "429": {
            "description": "No acceptance; bounded retry subject to consent and queue expiry",
            "headers": {
              "Retry-After": {
                "description": "Delay seconds or HTTP date; never shorten to fit queue TTL",
                "schema": {
                  "type": "string"
                }
              }
            },
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "additionalProperties": false,
                  "required": [
                    "code"
                  ],
                  "properties": {
                    "code": {
                      "type": "string",
                      "enum": [
                        "invalid_request",
                        "conflict",
                        "too_large",
                        "unsupported_media",
                        "rate_limited",
                        "unavailable",
                        "suspended"
                      ]
                    }
                  }
                }
              }
            }
          }
        }
      }
    }
  }
}
