diff --git a/app/sim/simulation.gd b/.tools/el2a-p3-inertia/app/sim/simulation.gd
index a8e7d65..14d31a9 100644
--- a/app/sim/simulation.gd
+++ b/.tools/el2a-p3-inertia/app/sim/simulation.gd
@@ -64,6 +64,7 @@ var stop_at_tick := -1
 var step_usec := 0.0
 var _inertia_inv := PackedFloat64Array()
 var _inertia_cache := PackedFloat64Array()
+var _inertia_cache_bytes := PackedByteArray()
 ## A numerical fault is sticky until an explicit, valid reset succeeds.
 var fault_reason := ""
 var _last_valid_state := PackedFloat64Array()
@@ -115,6 +116,7 @@ func reset(initial: PackedFloat64Array) -> bool:
 	_fixed_dt = 1.0 / Engine.physics_ticks_per_second
 	_inertia_inv = next_inertia_inv
 	_inertia_cache = inertia.duplicate()
+	_inertia_cache_bytes = inertia.to_byte_array()
 	last_loads = reset_loads
 	fault_reason = ""
 	_remember_valid_state()
@@ -344,9 +346,20 @@ func _refresh_inertia_inverse() -> bool:
 		return false
 	_inertia_inv = next_inverse
 	_inertia_cache = inertia.duplicate()
+	_inertia_cache_bytes = inertia.to_byte_array()
 	return true
 
 
+## Inverse for an owner callback. Reuse the reset/step cache only while the public inertia
+## tensor still matches it. A mid-step edit gets a fresh inverse without replacing the
+## body's tick-local derivative cache, matching the old direct-inversion call sites.
+func _inertia_inverse_for_callback() -> PackedFloat64Array:
+	if _same_array(inertia, _inertia_cache) and inertia.to_byte_array() == _inertia_cache_bytes \
+			and _array_is_finite(_inertia_inv, 6):
+		return _inertia_inv.duplicate()
+	return RB.inertia_inverse(inertia)
+
+
 func _same_array(left: PackedFloat64Array, right: PackedFloat64Array) -> bool:
 	if left.size() != right.size():
 		return false
@@ -467,6 +480,7 @@ func restore_checkpoint(candidate: Dictionary) -> bool:
 	stop_at_tick = candidate.stop_at_tick
 	_inertia_inv = RB.inertia_inverse(inertia)
 	_inertia_cache = inertia.duplicate()
+	_inertia_cache_bytes = inertia.to_byte_array()
 	fault_reason = ""
 	_remember_valid_state()
 	set_paused(true)

