# RCV-14a: local inspection adapter for the immutable MT8 author delivery.
# Presentation only. No physical parameters, state integration or collision solver.
extends RefCounted

const CORNERS := ["FL", "FR", "RL", "RR"]
const DELIVERY := "RC CARS/MT8_Bisonte_entrega1_1/MT8_Bisonte"
const FILES := {
	"out/MT8_Bisonte.glb": "7967bb46673ae5b4178a3d40ad8c3b8e1a9d0350b1cc73e2084f52ab496bb0a6",
	"out/mt8_spec.json": "8d9a2ba3b41400fa934376ede5b110fcc046a05819b3f251076ea90e3fb2b5ef",
	"godot/mt8_rig.gd": "b120b5d202b78d537bb3c71a61339af95463209eb918966535e3c34f760e65a2",
}


static func load_delivery(directory: String = "") -> Dictionary:
	if directory.is_empty():
		directory = ProjectSettings.globalize_path("res://..").path_join(DELIVERY).simplify_path()
	# Verify the reviewed script bytes before loading/executing the author's rig.
	# New deliveries require explicit review and pin changes, never auto-acceptance.
	for relative in FILES:
		var path := directory.path_join(relative)
		if not FileAccess.file_exists(path) or FileAccess.get_sha256(path) != FILES[relative]:
			return {"ok": false, "error": "Missing or unreviewed delivery file: " + relative}
	var spec: Dictionary = JSON.parse_string(FileAccess.get_file_as_string(directory.path_join("out/mt8_spec.json")))
	var document := GLTFDocument.new()
	var state := GLTFState.new()
	var err := document.append_from_file(directory.path_join("out/MT8_Bisonte.glb"), state)
	if err != OK:
		return {"ok": false, "error": "GLB import failed: " + error_string(err)}
	var imported := document.generate_scene(state) as Node3D
	if imported == null:
		return {"ok": false, "error": "GLB has no 3D scene"}
	var nodes := {}
	var validation := _collect(imported, nodes)
	if not validation.is_empty():
		imported.free()
		return {"ok": false, "error": validation}
	var required := ["MT8_Root", "Chassis", "Body", "Collision", "Propulsion", "Bumper_F", "Bumper_R"]
	for corner in CORNERS:
		for part in ["ArmLower", "ArmUpper", "Suspension", "Spin", "WheelMesh", "DriveshaftIn", "DriveshaftOut", "ShockA_Body", "ShockA_Spring", "ShockA_Shaft", "ShockB_Body", "ShockB_Spring", "ShockB_Shaft"]:
			required.append(corner + "_" + part)
		required.append(corner + ("_Steer" if corner.begins_with("F") else "_Carrier"))
	for proxy in spec.collision_boxes:
		required.append(proxy)
	for name in required:
		if not nodes.has(name):
			imported.free()
			return {"ok": false, "error": "Missing visual binding: " + name}
	var rest := {}
	for name in nodes:
		rest[name] = nodes[name].transform
	# The received script is generated by gen_rig_gd.py and remains unchanged.
	var rig_script := ResourceLoader.load(directory.path_join("godot/mt8_rig.gd"), "GDScript", ResourceLoader.CACHE_MODE_IGNORE) as GDScript
	if rig_script == null or not rig_script.can_instantiate():
		imported.free()
		return {"ok": false, "error": "Author rig cannot be instantiated"}
	var rig: Node3D = rig_script.new()
	rig.name = "MT8Visual"
	rig.add_child(imported)
	rig.set("root_path", rig.get_path_to(nodes.MT8_Root))
	var result := {"ok": true, "error": "", "root": rig, "model_root": nodes.MT8_Root, "nodes": nodes, "rest": rest, "spec": spec, "identity": FILES.duplicate()}
	set_proxies_visible(result, false)
	return result


static func _collect(node: Node, nodes: Dictionary) -> String:
	if node is CollisionObject3D or node is CollisionShape3D or node is AnimationPlayer:
		return "Unexpected physical/animation authority: " + str(node.name)
	if node is Node3D:
		if nodes.has(str(node.name)):
			return "Ambiguous visual binding: " + str(node.name)
		if not node.transform.is_finite() or node.basis.determinant() <= 0.0:
			return "Invalid visual transform: " + str(node.name)
		nodes[str(node.name)] = node
	for child in node.get_children():
		var error := _collect(child, nodes)
		if not error.is_empty():
			return error
	return ""


## All-or-nothing pose validation. Travel: +compression, steer: +left,
## spin: +forward travel (converted once to the delivered local -X rotation).
## Display ranges are author geometry limits, never physical travel clamps.
static func apply_pose(model: Dictionary, travel_m: PackedFloat64Array, steer_left_rad: float, forward_spin_rad: PackedFloat64Array) -> bool:
	if not model.get("ok", false) or not is_instance_valid(model.get("root")):
		return false
	if not model.root.is_inside_tree() or travel_m.size() != 4 or forward_spin_rad.size() != 4:
		return false
	var spec: Dictionary = model.spec
	if not is_finite(steer_left_rad) or absf(steer_left_rad) > deg_to_rad(float(spec.steer_max_deg)):
		return false
	for i in 4:
		if not is_finite(travel_m[i]) or not is_finite(forward_spin_rad[i]):
			return false
		if travel_m[i] < -float(spec.travel_droop) or travel_m[i] > float(spec.travel_bump):
			return false
	# Supply one complete pose before invoking the visual rig; no partial mutation.
	var travel := {}
	var spin := {}
	for i in 4:
		travel[CORNERS[i]] = travel_m[i]
		spin[CORNERS[i]] = -fmod(forward_spin_rad[i], TAU)
	model.root.set("travel", travel)
	model.root.set("spin", spin)
	model.root.set("steer", steer_left_rad)
	model.root.call("_apply")
	return true


static func set_body_visible(model: Dictionary, shown: bool) -> void:
	model.nodes.Body.visible = shown


static func set_proxies_visible(model: Dictionary, shown: bool) -> void:
	# COL_* remain debug meshes. They never become Godot collision objects.
	model.nodes.Collision.visible = shown


static func visual_bounds(model: Dictionary) -> AABB:
	var bounds := AABB()
	var first := true
	var datum: Node3D = model.model_root
	for name in model.nodes:
		var node: Node = model.nodes[name]
		if node is MeshInstance3D and not name.begins_with("COL_"):
			var local: Transform3D = datum.global_transform.affine_inverse() * node.global_transform
			var box: AABB = local * node.mesh.get_aabb()
			bounds = box if first else bounds.merge(box)
			first = false
	return bounds
