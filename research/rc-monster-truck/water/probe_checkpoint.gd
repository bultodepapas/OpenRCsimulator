extends SceneTree
const S = preload("res://sim/ground_vehicle/session.gd")
const F = preload("res://data/field_loader.gd")
const L = preload("res://data/lake_loader.gd")
func _initialize() -> void:
	var a=S.new()
	var b=S.new()
	print("prepare ",a.prepare_airfield(F.load_from(),{},L.load_from().lake)," ",b.prepare_airfield(F.load_from(),{},L.load_from().lake))
	print("spawn ",a.reset("lake_shore"))
	a.tick_once({"throttle":0.0,"steering":0.0,"brake":0.0,"reverse":false,"armed":true})
	a.resume()
	for i in 10: a.tick_once({"throttle":0.48923721839283,"steering":0.0238527823,"brake":0.0,"reverse":false,"armed":true})
	var c:Dictionary=a.checkpoint()
	print("solvermatch ",b._solver_identity_matches(c.solver_identity)," identities ",a.identities_snapshot()==b.identities_snapshot()," selfcan ",a.can_restore_checkpoint(c)," forkcan ",b.can_restore_checkpoint(c))
	print("solver ",c.solver_identity)
	print("current ",b._solver_identity())
	a.free()
	b.free()
	quit()
