+		return PackedFloat64Array()
+	var model: Dictionary = evaluator._model
+	var settings: Dictionary = evaluator._settings
+	if str(state.family) != str(model.family):
+		return PackedFloat64Array()
+	var operation: Dictionary = model.operation
+	if not _finite_number(rpm) or rpm < 0.0 or rpm > float(operation.max_rpm) \
+			or not _finite_number(throttle) or throttle < 0.0 or throttle > 1.0 \
+			or not _finite_number(mixture) or mixture < 0.0 \
+			or not _finite_number(dry_density_kg_m3) or dry_density_kg_m3 <= 0.0 \
+			or not _finite_number(ambient_k) or ambient_k <= 0.0 \
+			or not _finite_number(cooling_airspeed_mps) or cooling_airspeed_mps < 0.0:
+		return PackedFloat64Array()
+	var raw_servo: float = float(state.servo_fraction)
+	var raw_air: float = float(state.air_fraction)
+	var servo: float = clampf(raw_servo, 0.0, 1.0)
+	var admission: float = clampf(raw_air, 0.0, 1.0)
+	var air_target: float = float(settings.idle_admission) + servo * (1.0 - float(settings.idle_admission))
+	var servo_rate: float = (throttle - raw_servo) / float(settings.servo_time_constant_s)
+	var air_rate: float = (air_target - raw_air) / float(settings.air_time_constant_s)
+	var active: bool = bool(state.running) and float(state.fuel_kg) > 0.0
+	var target_fuel_flow: float = 0.0
+	var actual_mixture: float = mixture
+	var current_transport: float = maxf(0.0, float(state.fuel_transport_kg_s))
+	if active and admission > 0.0:
+		var baseline_mixture: float = mixture if mixture > 0.0 else float(operation.nominal_mixture)
+		var flow_result: Dictionary = Source.unit_fuel_flow_prepared(
+			evaluator._source, rpm, admission, baseline_mixture, dry_density_kg_m3
+		)
+		if not flow_result.get("ok", false):
+			return PackedFloat64Array()
+		var unit_flow: float = float(flow_result.unit_fuel_flow_kg_s_per_mixture)
+		target_fuel_flow = unit_flow * mixture
+		if unit_flow > LOW_FLOW:
+			actual_mixture = current_transport / unit_flow
+		else:
+			actual_mixture = mixture
+	var firing_fraction: float = 0.0
+	if active:
+		firing_fraction = _firing_fraction(
+			settings, float(operation.nominal_mixture), actual_mixture, float(state.temperature_k)
+		)
+	var source: PackedFloat64Array = Source.evaluate_prepared_packed(
+		evaluator._source, rpm, admission, actual_mixture, dry_density_kg_m3, active, firing_fraction
+	)
+	if source.is_empty():
+		return source
+	var temperature_rate: float = Thermal._rate_prepared(source[Source.PACKED_CHEMICAL_POWER],
+		source[Source.PACKED_INDICATED_POWER], source[Source.PACKED_MECHANICAL_LOSS],
+		source[Source.PACKED_PUMPING_LOSS], source[Source.PACKED_VALVE_LOSS],
+		source[Source.PACKED_DELIVERED_FUEL], float(state.temperature_k), ambient_k,
+		cooling_airspeed_mps, settings.thermal)
+	if is_nan(temperature_rate):
+		return PackedFloat64Array()
+	var fuel_transport_rate: float = 0.0
+	if active:
+		fuel_transport_rate = (target_fuel_flow - current_transport) / float(settings.fuel_transport_time_constant_s)
+	else:
+		fuel_transport_rate = -current_transport / float(settings.fuel_transport_time_constant_s)
+	var fuel_rate: float = -float(source[Source.PACKED_DELIVERED_FUEL])
+	var phase_rate: float = rpm / 60.0
+	if not is_finite(fuel_rate) or not is_finite(temperature_rate) or not is_finite(servo_rate) \
+			or not is_finite(air_rate) or not is_finite(fuel_transport_rate) or not is_finite(phase_rate):
+		return PackedFloat64Array()
+	return PackedFloat64Array([fuel_rate, temperature_rate, servo_rate, air_rate, fuel_transport_rate,
+		phase_rate, source[Source.PACKED_SHAFT_TORQUE], source[Source.PACKED_BRAKE_POWER],
+		source[Source.PACKED_CHEMICAL_POWER], firing_fraction])
