+## RK-stage evaluation over a prepared evaluator: evaluate_prepared()'s predicates and
+## arithmetic without telemetry, source or thermal Dictionaries. Returns
+## [six CONTINUOUS_KEYS rates, shaft_torque_nm, brake_power_w, chemical_power_w,
+## firing_fraction], or an empty array wherever evaluate_prepared() fails.
+static func stage_prepared(
+		evaluator: PreparedEvaluator,
+		state: Dictionary,
+		rpm: float,
+		throttle: float,
+		mixture: float,
+		dry_density_kg_m3: float,
+		ambient_k: float,
+		cooling_airspeed_mps: float
